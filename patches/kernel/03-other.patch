+				{ REG_A6XX_RBBM_CLOCK_CNTL_SP1,	"CLOCK_CNTL_SP1" },
+			};
+			struct a6xx_gmu *gmu = &to_a6xx_gpu(to_adreno_gpu(gpu))->gmu;
+			unsigned int c;
+
