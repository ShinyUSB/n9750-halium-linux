+	 * MEASURED (the ground-truth diff against the WORKING Android device):
+	 * our table is shifted by exactly one slot, because we merged CAF's two
+	 * entries {0xE00,1} and {0xE03,0xB} into a single {0xE00,0xE}.  The
+	 * hardware confirms it: on our device 0x8e01..0x8e77 read back as
+	 * 0xdeadbead (Adreno's "register protected" answer) while the working
+	 * device has real values there.  Every protection range from slot 14 on
+	 * lands in the wrong slot, and the 0x8E00 block -- the render block's
+	 * sub-block selection and the context-switch GMEM save/restore -- ends
+	 * up protected on ours and open on the working one.
+	 *
+	 * CAF also appends the MMU/SMMU register range from the DT property
+	 * qcom,protect = <0xa0000 0xc000> ("CB5(ATOS) & CB5/6/7 are protected
+	 * by HYP"), as extra read-protected slots of 0x2000 each, up to the
+	 * hardware's num_protected_regs (0x20 for a6xx).  We never applied it.
+	 */
+	if (cp_protect_caf) {
+		static const struct { u32 base, count; int read_protect; } prot[] = {
+			{ 0x600, 0x51, 0 },
+			{ 0xAE50, 0x2, 1 },
+			{ 0x9624, 0x13, 1 },
+			{ 0x8630, 0x8, 1 },
+			{ 0x9E70, 0x1, 1 },
+			{ 0x9E78, 0x187, 1 },
+			{ 0xF000, 0x810, 1 },
+			{ 0xFC00, 0x3, 0 },
+			{ 0x50E, 0x0, 1 },
+			{ 0x50F, 0x0, 0 },
+			{ 0x510, 0x0, 1 },
+			{ 0x0, 0x4F9, 0 },
+			{ 0x501, 0xA, 0 },
+			{ 0x511, 0x44, 0 },
+			{ 0xE00, 0x1, 1 },
+			{ 0xE03, 0xB, 1 },
+			{ 0x8E00, 0x0, 1 },
+			{ 0x8E50, 0xF, 1 },
+			{ 0xBE02, 0x0, 1 },
+			{ 0xBE20, 0x11F3, 1 },
+			{ 0x800, 0x82, 1 },
+			{ 0x8A0, 0x8, 1 },
+			{ 0x8AB, 0x19, 1 },
+			{ 0x900, 0x4D, 1 },
+			{ 0x98D, 0x76, 1 },
+			{ 0x8D0, 0x23, 0 },
+			{ 0x980, 0x4, 0 },
+			{ 0xA630, 0x0, 1 },
+		};
+		const int max_sets = 0x20;	/* a6xx num_protected_regs */
+		u32 mmu_base = 0xa0000, mmu_range = 0xc000;	/* DT: qcom,protect */
+		int i, num;
+
+		num = min_t(int, (int)ARRAY_SIZE(prot), max_sets);
+		for (i = 0; i < num; i++)
+			gpu_write(gpu, REG_A6XX_CP_PROTECT(i),
+				prot[i].base | (prot[i].count << 18) |
+				(prot[i].read_protect << 31));
+
+		while ((i < max_sets) && (mmu_range > 0)) {
+			u32 cur = min_t(u32, mmu_range, 0x2000);
+
+			gpu_write(gpu, REG_A6XX_CP_PROTECT(i),
+				mmu_base | ((cur - 1) << 18) | (1 << 31));
+			mmu_base += cur;
+			mmu_range -= cur;
+			i++;
+		}
+		pr_info("CPCAF285: CP_PROTECT slots: %d table + %d MMU (max %d)\n",
+			num, i - num, max_sets);
+	} else {
+	gpu_write(gpu, REG_A6XX_CP_PROTECT(0),
+		A6XX_PROTECT_RDONLY(0x600, 0x51));
+	gpu_write(gpu, REG_A6XX_CP_PROTECT(1), A6XX_PROTECT_RW(0xae50, 0x2));
+	gpu_write(gpu, REG_A6XX_CP_PROTECT(2), A6XX_PROTECT_RW(0x9624, 0x13));
+	gpu_write(gpu, REG_A6XX_CP_PROTECT(3), A6XX_PROTECT_RW(0x8630, 0x8));
+	gpu_write(gpu, REG_A6XX_CP_PROTECT(4), A6XX_PROTECT_RW(0x9e70, 0x1));
+	gpu_write(gpu, REG_A6XX_CP_PROTECT(5), A6XX_PROTECT_RW(0x9e78, 0x187));
+	gpu_write(gpu, REG_A6XX_CP_PROTECT(6), A6XX_PROTECT_RW(0xf000, 0x810));
+	gpu_write(gpu, REG_A6XX_CP_PROTECT(7),
+		A6XX_PROTECT_RDONLY(0xfc00, 0x3));
+	gpu_write(gpu, REG_A6XX_CP_PROTECT(8), A6XX_PROTECT_RW(0x50e, 0x0));
+	gpu_write(gpu, REG_A6XX_CP_PROTECT(9), A6XX_PROTECT_RDONLY(0x50f, 0x0));
+	gpu_write(gpu, REG_A6XX_CP_PROTECT(10), A6XX_PROTECT_RW(0x510, 0x0));
+	gpu_write(gpu, REG_A6XX_CP_PROTECT(11),
+		A6XX_PROTECT_RDONLY(0x0, 0x4f9));
+	gpu_write(gpu, REG_A6XX_CP_PROTECT(12),
+		A6XX_PROTECT_RDONLY(0x501, 0xa));
+	gpu_write(gpu, REG_A6XX_CP_PROTECT(13),
+		A6XX_PROTECT_RDONLY(0x511, 0x44));
+	gpu_write(gpu, REG_A6XX_CP_PROTECT(14), A6XX_PROTECT_RW(0xe00, 0xe));
+	gpu_write(gpu, REG_A6XX_CP_PROTECT(15), A6XX_PROTECT_RW(0x8e00, 0x0));
+	gpu_write(gpu, REG_A6XX_CP_PROTECT(16), A6XX_PROTECT_RW(0x8e50, 0xf));
+	gpu_write(gpu, REG_A6XX_CP_PROTECT(17), A6XX_PROTECT_RW(0xbe02, 0x0));
+	gpu_write(gpu, REG_A6XX_CP_PROTECT(18),
+		A6XX_PROTECT_RW(0xbe20, 0x11f3));
+	gpu_write(gpu, REG_A6XX_CP_PROTECT(19), A6XX_PROTECT_RW(0x800, 0x82));
+	gpu_write(gpu, REG_A6XX_CP_PROTECT(20), A6XX_PROTECT_RW(0x8a0, 0x8));
+	gpu_write(gpu, REG_A6XX_CP_PROTECT(21), A6XX_PROTECT_RW(0x8ab, 0x19));
+	gpu_write(gpu, REG_A6XX_CP_PROTECT(22), A6XX_PROTECT_RW(0x900, 0x4d));
+	gpu_write(gpu, REG_A6XX_CP_PROTECT(23), A6XX_PROTECT_RW(0x98d, 0x76));
+	gpu_write(gpu, REG_A6XX_CP_PROTECT(24),
+			A6XX_PROTECT_RDONLY(0x8d0, 0x23));
+	gpu_write(gpu, REG_A6XX_CP_PROTECT(25),
+			A6XX_PROTECT_RDONLY(0x980, 0x4));
+	gpu_write(gpu, REG_A6XX_CP_PROTECT(26), A6XX_PROTECT_RW(0xa630, 0x0));
+	}
+
+	pr_info("HWINIT[17] before interrupt-mask programming\n");
+	/* Enable interrupts */
+	if (reg_match) {
+		gpu_write(gpu, REG_A6XX_RBBM_INT_0_MASK, 0x13d0e3c2);
+		pr_info("REG286: INT_0_MASK=0x%x HANG_INT_CNTL=0x%x CP_RB_CNTL=0x%x\n",
+			gpu_read(gpu, REG_A6XX_RBBM_INT_0_MASK),
+			gpu_read(gpu, REG_A6XX_RBBM_INTERFACE_HANG_INT_CNTL),
+			gpu_read(gpu, REG_A6XX_CP_RB_CNTL));
+	} else
+		gpu_write(gpu, REG_A6XX_RBBM_INT_0_MASK, A6XX_INT_MASK);
+	pr_info("HWINIT[18] after interrupt-mask programming\n");
+
+	/* IMAGE 241: the image-240 inline SCID block stood here. It hung the
+	 * bring-up thread (R state, 5+ min) writing dword 0xF008 (= byte
+	 * 0x3C020, unmapped; correct canonical address is 0x3c02). The write is
+	 * now runtime-triggered via llcc_scid (default off): a bad address can
+	 * only wedge the triggering shell, never bring-up. See the param
+	 * setter near the module params. The SMMU-attr half of image 240 stays
+	 * inline (accepted = 0, safe). */
+	rbobs_gpu_stash = gpu;
+
+	pr_info("HWINIT[13] zap/secure: no zap init in this tree; SECVID_TRUST later\n");
+	pr_info("HWINIT[19] before adreno_hw_init\n");
+	gxstate_snap(gpu, "2");
+	ret = adreno_hw_init(gpu);
+	pr_info("HWINIT[20] after adreno_hw_init ret=%d\n", ret);
+	if (ret)
+		goto out;
+
+	ret = a6xx_ucode_init(gpu);
+	if (ret)
+		goto out;
+
+	/* Always come up on rb 0 */
+	pr_info("HWINIT[21] before SQE/ringbuffer base (cur_ring)\n");
+	a6xx_gpu->cur_ring = gpu->rb[0];
+	/*
+	 * TEMPORARY image 129 diagnostics -- REMOVE AFTER RESULT. Read-only
+	 * verification that ring HW programming (RB_BASE/CNTL/RPTR_ADDR in
+	 * adreno_hw_init, SQE_INSTR_BASE in ucode_init) already precedes SQE.
+	 * No move performed: the presumed post-cp_init ordering does not
+	 * exist in this tree.
+	 */
+	pr_info("RINGHW[00] SQE_INSTR_BASE=iova:0x%llx hw=0x%llx\n",
+		(unsigned long long)a6xx_gpu->sqe_iova,
+		(unsigned long long)gpu_read64(gpu,
+			REG_A6XX_CP_SQE_INSTR_BASE_LO,
+			REG_A6XX_CP_SQE_INSTR_BASE_HI));
+	pr_info("RINGHW[01] CP_RB_BASE=iova:0x%llx hw=0x%llx\n",
+		(unsigned long long)gpu->rb_iova,
+		(unsigned long long)gpu_read64(gpu,
+			REG_A6XX_CP_RB_BASE, REG_A6XX_CP_RB_BASE_HI));
+	pr_info("RINGHW[02] CP_RB_CNTL hw=0x%x\n",
+		gpu_read(gpu, REG_A6XX_CP_RB_CNTL));
+	pr_info("RINGHW[03] CP_RB_RPTR_ADDR hw=0x%llx\n",
+		(unsigned long long)gpu_read64(gpu,
+			REG_A6XX_CP_RB_RPTR_ADDR_LO,
+			REG_A6XX_CP_RB_RPTR_ADDR_HI));
+	pr_info("RINGHW: rb_iova=0x%llx rb_size=%d sw_wptr_dw=%u\n",
+		(unsigned long long)gpu->rb_iova, gpu->rb[0]->size,
+		(unsigned)(gpu->rb[0]->cur - gpu->rb[0]->start));
+
+	/*
+	 * TEMPORARY image 209, condensed in 211 -- MEASUREMENT ONLY.
+	 *
+	 * memptrs_iova has been measured as 0 on three boots, which makes
+	 * rbmemptr(ring, fence) == 4, i.e. the CACHE_FLUSH_TS event is told to
+	 * write the fence at IOVA 0x4. memptrs_iova has never been printed
+	 * anywhere in this driver, so that zero was invisible for 200+ images.
+	 *
+	 * Condensed from three printk calls to one: this is the bring-up path,
+	 * and images 179-181 established that a printk here can wedge the
+	 * caller inside console_unlock and cost the machine its
+	 * responsiveness. One line, one format string, same information.
+	 */
+	pr_info("RINGHW[10] memptrs_iova=0x%llx rbmemptr_rptr=0x%llx rbmemptr_fence=0x%llx aspace=%px mmu=%px gmu_domain=%px\n",
+		(unsigned long long)adreno_gpu->memptrs_iova,
+		(unsigned long long)rbmemptr(gpu->rb[0], rptr),
+		(unsigned long long)rbmemptr(gpu->rb[0], fence),
+		(void *)gpu->aspace,
+		(gpu->aspace && gpu->aspace->mmu) ? (void *)gpu->aspace->mmu : NULL,
+		(void *)a6xx_gpu->gmu.domain);
+	gxstate_snap(gpu, "3");
+	if (gx_vote_done)
+		pr_info("GX132-CP: vote was sent this boot (see GX132-* above)\n");
+	pr_info("HWINIT[09] before CP_SQE_CNTL\n");
+	pr_info("RINGHW[04] CP_SQE_CNTL = 1\n");
+	/* Enable the SQE_to start the CP engine */
+	gpu_write(gpu, REG_A6XX_CP_SQE_CNTL, 1);
+	pr_info("HWINIT[10] after CP_SQE_CNTL RBBM_STATUS=0x%x\n",
+		gpu_read(gpu, REG_A6XX_RBBM_STATUS));
+
+	pr_info("HWINIT[11] before a6xx_cp_init\n");
+	pr_info("RINGHW[05] a6xx_cp_init enter\n");
+	ret = a6xx_cp_init(gpu);
+	pr_info("HWINIT[12] after a6xx_cp_init ret=%d\n", ret);
+	if (ret)
+		goto out;
+
+	/*
+	 * TEMPORARY image 134 secure probe -- REMOVE AFTER RESULT.
+	 * secure_probe=0: direct write (baseline). =1: skip it, continue.
+	 * =2: ZAP unavailable in this tree (no firmware, no zap-shader DT
+	 * child, no a6xx hookup) -> log and fall back to mode 0 path.
+	 */
+	pr_info("SECVID134: TRUST_CNTL=0x%x TSB_CNTL=0x%x TSB_BASE=0x%x SIZE=0x%x STATUS=0x%x RPTR=0x%x WPTR=0x%x OOB_H2G=0x%x OOB_G2H=0x%x RPMHPWR=0x%x mode=%d\n",
+		gpu_read(gpu, REG_A6XX_RBBM_SECVID_TRUST_CNTL),
+		gpu_read(gpu, REG_A6XX_RBBM_SECVID_TSB_CNTL),
+		gpu_read(gpu, REG_A6XX_RBBM_SECVID_TSB_TRUSTED_BASE_LO),
+		gpu_read(gpu, REG_A6XX_RBBM_SECVID_TSB_TRUSTED_SIZE),
+		gpu_read(gpu, REG_A6XX_RBBM_STATUS),
+		gpu_read(gpu, REG_A6XX_CP_RB_RPTR),
+		gpu_read(gpu, REG_A6XX_CP_RB_WPTR),
+		gmu_read(&a6xx_gpu->gmu, REG_A6XX_GMU_HOST2GMU_INTR_RAW_INFO),
+		gmu_read(&a6xx_gpu->gmu, REG_A6XX_GMU_GMU2HOST_INTR_INFO),
+		gmu_read(&a6xx_gpu->gmu, REG_A6XX_GPU_GMU_CX_GMU_RPMH_POWER_STATE),
+		secure_probe);
+
+	/*
+	 * IMAGE 277 -- switch out of secure mode the way the GPU's own CP is
+	 * asked to do it.  Stock KGSL (adreno.c:1870-1875) and mainline a5xx
+	 * (a5xx_gpu.c:578-588) both do exactly this once the ZAP shader has
+	 * authorised the CP; only the "no zap" fallback writes the register
+	 * from the host, and image 273 proved that fallback wedges this part.
+	 */
+	if (cp_secure_off) {
+		struct msm_ringbuffer *ring = gpu->rb[0];
+
+		pr_info("SECVID277: CP path: before TRUST_CNTL=0x%x TSB_CNTL=0x%x TSB_BASE=0x%x SIZE=0x%x\n",
+			gpu_read(gpu, REG_A6XX_RBBM_SECVID_TRUST_CNTL),
+			gpu_read(gpu, REG_A6XX_RBBM_SECVID_TSB_CNTL),
+			gpu_read(gpu, REG_A6XX_RBBM_SECVID_TSB_TRUSTED_BASE_LO),
+			gpu_read(gpu, REG_A6XX_RBBM_SECVID_TSB_TRUSTED_SIZE));
+		OUT_PKT7(ring, CP_SET_SECURE_MODE, 1);
+		OUT_RING(ring, 0x00000000);
+		a6xx_flush(gpu, ring);
+		if (!a6xx_idle(gpu, ring)) {
+			pr_err("SECVID277: a6xx_idle TIMEOUT after CP_SET_SECURE_MODE(0)\n");
+			pr_info("SECVID277: RPTR=0x%x WPTR=0x%x STATUS=0x%x INT0=0x%x\n",
+				gpu_read(gpu, REG_A6XX_CP_RB_RPTR),
+				gpu_read(gpu, REG_A6XX_CP_RB_WPTR),
+				gpu_read(gpu, REG_A6XX_RBBM_STATUS),
+				gpu_read(gpu, REG_A6XX_RBBM_INT_0_STATUS));
+			ret = -ETIMEDOUT;
+			goto out;
+		}
+		pr_info("SECVID277: CP path: after TRUST_CNTL=0x%x TSB_CNTL=0x%x TSB_BASE=0x%x SIZE=0x%x\n",
+			gpu_read(gpu, REG_A6XX_RBBM_SECVID_TRUST_CNTL),
+			gpu_read(gpu, REG_A6XX_RBBM_SECVID_TSB_CNTL),
+			gpu_read(gpu, REG_A6XX_RBBM_SECVID_TSB_TRUSTED_BASE_LO),
+			gpu_read(gpu, REG_A6XX_RBBM_SECVID_TSB_TRUSTED_SIZE));
+		pr_info("SECVID277: RPTR=0x%x WPTR=0x%x STATUS=0x%x\n",
+			gpu_read(gpu, REG_A6XX_CP_RB_RPTR),
+			gpu_read(gpu, REG_A6XX_CP_RB_WPTR),
+			gpu_read(gpu, REG_A6XX_RBBM_STATUS));
+	} else if (secure_probe == 1 || experimental_nonlegacy) {
+		/*
+		 * IMAGE 273 -- decouple the secure-video trust setup from the
+		 * HFI path.
+		 *
+		 * The condition above conflates two unrelated things.  The
+		 * `experimental_nonlegacy` flag selects the non-legacy HFI v2
+		 * path (a640/a650) and has nothing to do with the secure-video
+		 * trust configuration.  But because our cmdline sets
+		 * a6xx.experimental_nonlegacy=1, the SECVID_TRUST_CNTL write is
+		 * skipped on every boot -- and the tree's own HWINIT[13] message
+		 * says what it intended:
+		 *
+		 *   "HWINIT[13] zap/secure: no zap init in this tree; SECVID_TRUST later"
+		 *
+		 * i.e. "no ZAP init, so we will use SECVID_TRUST instead" --
+		 * and then the SECVID_TRUST write is skipped.  Neither trust
+		 * mechanism runs.
+		 *
+		 * a6xx.secvid=1 forces the write anyway, so the two concerns can
+		 * be tested separately.  The before/after readbacks make the
+		 * experiment falsifiable even if the render does not change: we
+		 * will see whether the write has any effect on the registers at
+		 * all.
+		 */
+		if (secvid) {
+			pr_info("SECVID273: FORCING SECVID_TRUST_CNTL write (a6xx.secvid=1) despite nonlegacy=%d\n",
+				(int)experimental_nonlegacy);
+			pr_info("SECVID273: before: TRUST_CNTL=0x%x TSB_CNTL=0x%x TSB_BASE=0x%x SIZE=0x%x\n",
+				gpu_read(gpu, REG_A6XX_RBBM_SECVID_TRUST_CNTL),
+				gpu_read(gpu, REG_A6XX_RBBM_SECVID_TSB_CNTL),
+				gpu_read(gpu, REG_A6XX_RBBM_SECVID_TSB_TRUSTED_BASE_LO),
+				gpu_read(gpu, REG_A6XX_RBBM_SECVID_TSB_TRUSTED_SIZE));
+			gpu_write(gpu, REG_A6XX_RBBM_SECVID_TRUST_CNTL, 0x0);
+			pr_info("SECVID273: after: TRUST_CNTL=0x%x TSB_CNTL=0x%x TSB_BASE=0x%x SIZE=0x%x\n",
+				gpu_read(gpu, REG_A6XX_RBBM_SECVID_TRUST_CNTL),
+				gpu_read(gpu, REG_A6XX_RBBM_SECVID_TSB_CNTL),
+				gpu_read(gpu, REG_A6XX_RBBM_SECVID_TSB_TRUSTED_BASE_LO),
+				gpu_read(gpu, REG_A6XX_RBBM_SECVID_TSB_TRUSTED_SIZE));
+		} else {
+			pr_info("SECVID134: mode=%d/nonlegacy=%d SKIP direct SECVID_TRUST_CNTL write\n",
+				secure_probe, (int)experimental_nonlegacy);
+		}
+	} else {
+		if (secure_probe == 2)
+			pr_info("SECVID134: mode=2 ZAP-UNAVAILABLE (no a640_zap fw, no zap-shader DT child, no a6xx hookup); using mode-0 write\n");
+		pr_info("SECVID134: mode=%d before direct SECVID_TRUST_CNTL write\n",
+			secure_probe);
+		gpu_write(gpu, REG_A6XX_RBBM_SECVID_TRUST_CNTL, 0x0);
+		pr_info("SECVID134: after direct SECVID_TRUST_CNTL write\n");
+	}
+
+out:
+	/*
+	 * Tell the GMU that we are done touching the GPU and it can start power
+	 * management
+	 */
+	pr_info("HWINIT[15] secure-submit: no secure path in this tree\n");
+	pr_info("HWINIT[23] before final OOB clear\n");
+	if (hold_boot) {
+		pr_info("HOLD150: keeping GPU_SET+BOOT_SLUMBER OOBs (no GMU power handoff)\n");
+	} else {
+		a6xx_gmu_clear_oob(&a6xx_gpu->gmu, GMU_OOB_GPU_SET);
+
+		/* Take the GMU out of its special boot mode */
+		a6xx_gmu_clear_oob(&a6xx_gpu->gmu, GMU_OOB_BOOT_SLUMBER);
+	}
+	pr_info("HWINIT[24] after final OOB clear\n");
+
+	/* TEMPORARY image 137 self-test + image 142 confidence loop.
+	 * Re-proves CPU->ring->CP->idle with the proven CP_ME_INIT sequence,
+	 * 10x. Timeout-bounded inside a6xx_idle; stops at first failure. */
+	if (experimental_nonlegacy && a6xx_selftest && !ret) {
+		int iter, stret = 0;
+		for (iter = 0; iter < 10; iter++) {
+			stret = a6xx_cp_init(gpu);
+			pr_info("SELFTEST142: iter=%d cp_init ret=%d RPTR=0x%x WPTR=0x%x STATUS=0x%x\n",
+				iter, stret,
+				gpu_read(gpu, REG_A6XX_CP_RB_RPTR),
+				gpu_read(gpu, REG_A6XX_CP_RB_WPTR),
+				gpu_read(gpu, REG_A6XX_RBBM_STATUS));
+			bc132("SELFTEST", stret);
+			if (stret)
+				break;
+		}
+		pr_info("SELFTEST142: done last_iter=%d %s\n", iter,
+			stret ? "FAILED" : "ALL 10 PASS");
+	}
+
+	if (experimental_nonlegacy && !ret && a6xx_instr) {
+		dw161_ag = a6xx_gpu;
+		dw161_shot = 0;
+		/* SHOT-1: synchronous baseline (always lands, even if
+		 * death is <50ms out). Runs BEFORE [25] return, i.e.
+		 * before enable_irq in the caller. */
+		dw161_regs(a6xx_gpu, "SHOTN1");
+		schedule_delayed_work(&dw161_work,
+			msecs_to_jiffies(50));
+		sw165_arm(a6xx_gpu);
+		pr_info("DW161: armed (sync+50/250ms/1/5/30s)\n");
+	}
+
+	/*
+	 * TEMPORARY image 178 -- PROMOTE IFF SURVIVAL EXTENDS. Halt the
+	 * GMU firmware before slumber (clocks still on, GMU accessible).
+	 * See the param description for the rationale.
+	 */
+	if (halt_gmu && !ret) {
+		gmu_write(&a6xx_gpu->gmu, REG_A6XX_GMU_CM3_SYSRESET, 1);
+		pr_info("HALT178: GMU CM3 halted after successful hw_init\n");
+	}
+
+	/*
+	 * TEMPORARY image 165 -- PROMOTE IFF SURVIVAL EXTENDS. First
+	 * managed power cycle: instead of leaving the GPU awake at the
+	 * firmware's mercy (every prior image), drive it into proper
+	 * slumber via the existing suspend path (VBIF halt + wait_idle +
+	 * notify_slumber + hfi_stop + irq_disable + rpmh_stop + clocks
+	 * off). SHOTN1 above captured the awake state for comparison;
+	 * SHOT0 will verify slumber (RPMHPWR should read 0xf). Failure
+	 * logs loudly and continues awake (old behavior, instruments live).
+	 */
+	if (slumber165 && !ret) {
+		int sret = a6xx_pm_suspend(gpu);
+		pr_info("SLUM165: pm_suspend returned %d (RPMHPWR=0x%x BUSY=0x%x)\n",
+			sret,
+			gmu_read(&a6xx_gpu->gmu,
+				REG_A6XX_GPU_GMU_CX_GMU_RPMH_POWER_STATE),
+			gmu_read(&a6xx_gpu->gmu,
+				REG_A6XX_GPU_GMU_AO_GPU_CX_BUSY_STATUS));
+		if (sret)
+			pr_info("SLUM165: slumber failed, continuing awake (old behavior)\n");
+	}
+
+	pr_info("HWINIT[25] return ret=%d\n", ret);
+	return ret;
+}
+
+static void a6xx_dump(struct msm_gpu *gpu)
+{
+	dev_info(&gpu->pdev->dev, "status:   %08x\n",
+			gpu_read(gpu, REG_A6XX_RBBM_STATUS));
+	adreno_dump(gpu);
+}
+
+#define VBIF_RESET_ACK_TIMEOUT	100
+#define VBIF_RESET_ACK_MASK	0x00f0
+
+static void a6xx_recover(struct msm_gpu *gpu)
+{
+	struct adreno_gpu *adreno_gpu = to_adreno_gpu(gpu);
+	struct a6xx_gpu *a6xx_gpu = to_a6xx_gpu(adreno_gpu);
+	int i;
+
+	adreno_dump_info(gpu);
+
+	for (i = 0; i < 8; i++)
+		dev_info(&gpu->pdev->dev, "CP_SCRATCH_REG%d: %u\n", i,
+			gpu_read(gpu, REG_A6XX_CP_SCRATCH_REG(i)));
+
+	if (hang_debug)
+		a6xx_dump(gpu);
+
+	/*
+	 * Turn off keep alive that might have been enabled by the hang
+	 * interrupt
+	 */
+	gmu_write(&a6xx_gpu->gmu, REG_A6XX_GMU_GMU_PWR_COL_KEEPALIVE, 0);
+
+	/*
+	 * TEMPORARY image 205 -- DIAGNOSTIC. The power cycle that used to be
+	 * here is removed on purpose.
+	 *
+	 * Measured on image 204. The hangcheck fired exactly once, at t=118s,
+	 * triggered by fence=0 while submitted=5. This function then ran
+	 * pm_suspend + pm_resume + msm_gpu_hw_init, and the machine never
+	 * recovered:
+	 *
+	 *   t=69.8   CPDUMP[auto-post]/auto-rest MMIO reads succeed
+	 *   t=100-118  five glstage runs PASS, render node healthy
+	 *   t=118.3  HANGCHK141 LOCKUP -> recover_worker -> a6xx_recover
+	 *   t=130+   a6xx_gpu_cpstate_show permanently D, 0 bytes returned
+	 *   t=700+   glstage HANGS AT STARTUP (was 5/5 passing minutes earlier)
+	 *
+	 * The post-recover symptom is MMIO that never returns: the cpstate
+	 * reader wedges inside its register reads, and EGL initialisation
+	 * blocks. An ioremap read against a power domain this tree left in a
+	 * half-transitioned state has no timeout and no watchdog, so it is D
+	 * forever with nothing in dmesg.
+	 *
+	 * That matters because it destroys the only instrument we have. The
+	 * one question left is whether the GPU actually EXECUTES the ring --
+	 * and answering it needs live register reads, which this power cycle
+	 * switches off permanently after a single spurious hangcheck.
+	 *
+	 * The power cycle is also the wrong tool on this tree by construction:
+	 * the GPU is powered by the on-demand sysfs trigger, which bypasses
+	 * runtime PM entirely, so calling pm_suspend/pm_resume here drives a
+	 * state machine the hardware was never put into. That is the same
+	 * mismatch that made pm_runtime_get_sync deadlock in image 203/204.
+	 *
+	 * So: keep the dumps (they are pure reads and are the whole point of
+	 * calling recover), drop the reset. If the GPU genuinely hangs, the
+	 * right response is a real fix to the hang, not a power cycle that
+	 * also takes out register access.
+	 */
+}
+
+static int a6xx_fault_handler(void *arg, unsigned long iova, int flags)
+{
+	struct msm_gpu *gpu = arg;
+
+	pr_warn_ratelimited("*** gpu fault: iova=%08lx, flags=%d (%u,%u,%u,%u)\n",
+			iova, flags,
+			gpu_read(gpu, REG_A6XX_CP_SCRATCH_REG(4)),
+			gpu_read(gpu, REG_A6XX_CP_SCRATCH_REG(5)),
+			gpu_read(gpu, REG_A6XX_CP_SCRATCH_REG(6)),
+			gpu_read(gpu, REG_A6XX_CP_SCRATCH_REG(7)));
+
+	return -EFAULT;
+}
+
+static void a6xx_cp_hw_err_irq(struct msm_gpu *gpu)
+{
+	u32 status = gpu_read(gpu, REG_A6XX_CP_INTERRUPT_STATUS);
+
+	if (status & A6XX_CP_INT_CP_OPCODE_ERROR) {
+		u32 val;
+
+		gpu_write(gpu, REG_A6XX_CP_SQE_STAT_ADDR, 1);
+		val = gpu_read(gpu, REG_A6XX_CP_SQE_STAT_DATA);
+		dev_err_ratelimited(&gpu->pdev->dev,
+			"CP | opcode error | possible opcode=0x%8.8X\n",
+			val);
+	}
+
+	if (status & A6XX_CP_INT_CP_UCODE_ERROR)
+		dev_err_ratelimited(&gpu->pdev->dev,
+			"CP ucode error interrupt\n");
+
+	if (status & A6XX_CP_INT_CP_HW_FAULT_ERROR)
+		dev_err_ratelimited(&gpu->pdev->dev, "CP | HW fault | status=0x%8.8X\n",
+			gpu_read(gpu, REG_A6XX_CP_HW_FAULT));
+
+	if (status & A6XX_CP_INT_CP_REGISTER_PROTECTION_ERROR) {
+		u32 val = gpu_read(gpu, REG_A6XX_CP_PROTECT_STATUS);
+
+		dev_err_ratelimited(&gpu->pdev->dev,
+			"CP | protected mode error | %s | addr=0x%8.8X | status=0x%8.8X\n",
+			val & (1 << 20) ? "READ" : "WRITE",
+			(val & 0x3ffff), val);
+	}
+
+	if (status & A6XX_CP_INT_CP_AHB_ERROR)
+		dev_err_ratelimited(&gpu->pdev->dev, "CP AHB error interrupt\n");
+
+	if (status & A6XX_CP_INT_CP_VSD_PARITY_ERROR)
+		dev_err_ratelimited(&gpu->pdev->dev, "CP VSD decoder parity error\n");
+
+	if (status & A6XX_CP_INT_CP_ILLEGAL_INSTR_ERROR)
+		dev_err_ratelimited(&gpu->pdev->dev, "CP illegal instruction error\n");
+
+}
+
+static void a6xx_fault_detect_irq(struct msm_gpu *gpu)
+{
+	struct adreno_gpu *adreno_gpu = to_adreno_gpu(gpu);
+	struct a6xx_gpu *a6xx_gpu = to_a6xx_gpu(adreno_gpu);
+	struct drm_device *dev = gpu->dev;
+	struct msm_drm_private *priv = dev->dev_private;
+	struct msm_ringbuffer *ring = gpu->funcs->active_ring(gpu);
+
+	/*
+	 * Force the GPU to stay on until after we finish
+	 * collecting information
+	 */
+	gmu_write(&a6xx_gpu->gmu, REG_A6XX_GMU_GMU_PWR_COL_KEEPALIVE, 1);
+
+	/*
+	 * IMAGE 231: we have been blind at exactly the wrong moment.
+	 *
+	 * RBBM_STATUS alone cannot tell an SMMU stall from a shader-pipe
+	 * launch failure from a CP fault -- three very different bugs with
+	 * three different fixes. Upstream master reads STATUS3 FIRST and
+	 * bails on SMMU_STALLED_ON_FAULT (donor/master:1831-1832); our handler
+	 * never read STATUS3 at all, so that case has always been misread as a
+	 * generic hang.
+	 *
+	 * Dump the discriminating registers alongside the status.
+	 */
+	{
+		u32 status3 = gpu_read(gpu, REG_A6XX_RBBM_STATUS3);
+		u32 int0 = gpu_read(gpu, REG_A6XX_RBBM_INT_0_STATUS);
+		u32 cpi = gpu_read(gpu, REG_A6XX_CP_INTERRUPT_STATUS);
+		u32 cphw = gpu_read(gpu, REG_A6XX_CP_HW_FAULT);
+
+		DRM_DEV_ERROR(&gpu->pdev->dev,
+			"  DIAG231 status3=0x%08x%s int0=0x%08x cp_int=0x%08x cp_hw_fault=0x%08x\n",
+			status3,
+			(status3 & A6XX_RBBM_STATUS3_SMMU_STALLED_ON_FAULT) ?
+				" *** SMMU_STALLED_ON_FAULT ***" : "",
+			int0, cpi, cphw);
+	}
+
+	DRM_DEV_ERROR(&gpu->pdev->dev,
+		"gpu fault ring %d fence %x status %8.8X rb %4.4x/%4.4x ib1 %16.16llX/%4.4x ib2 %16.16llX/%4.4x\n",
+		ring ? ring->id : -1, ring ? ring->seqno : 0,
+		gpu_read(gpu, REG_A6XX_RBBM_STATUS),
+		gpu_read(gpu, REG_A6XX_CP_RB_RPTR),
+		gpu_read(gpu, REG_A6XX_CP_RB_WPTR),
+		gpu_read64(gpu, REG_A6XX_CP_IB1_BASE, REG_A6XX_CP_IB1_BASE_HI),
+		gpu_read(gpu, REG_A6XX_CP_IB1_REM_SIZE),
+		gpu_read64(gpu, REG_A6XX_CP_IB2_BASE, REG_A6XX_CP_IB2_BASE_HI),
+		gpu_read(gpu, REG_A6XX_CP_IB2_REM_SIZE));
+
+	/* Turn off the hangcheck timer to keep it from bothering us */
+	del_timer(&gpu->hangcheck_timer);
+
+	queue_work(priv->wq, &gpu->recover_work);
+}
+
+static irqreturn_t a6xx_irq(struct msm_gpu *gpu)
+{
+	u32 status = gpu_read(gpu, REG_A6XX_RBBM_INT_0_STATUS);
+
+	gpu_write(gpu, REG_A6XX_RBBM_INT_CLEAR_CMD, status);
+
+	if (status & A6XX_RBBM_INT_0_MASK_RBBM_HANG_DETECT)
+		a6xx_fault_detect_irq(gpu);
+
+	if (status & A6XX_RBBM_INT_0_MASK_CP_AHB_ERROR)
+		dev_err_ratelimited(&gpu->pdev->dev, "CP | AHB bus error\n");
+
+	if (status & A6XX_RBBM_INT_0_MASK_CP_HW_ERROR)
+		a6xx_cp_hw_err_irq(gpu);
+
+	if (status & A6XX_RBBM_INT_0_MASK_RBBM_ATB_ASYNCFIFO_OVERFLOW)
+		dev_err_ratelimited(&gpu->pdev->dev, "RBBM | ATB ASYNC overflow\n");
+
+	if (status & A6XX_RBBM_INT_0_MASK_RBBM_ATB_BUS_OVERFLOW)
+		dev_err_ratelimited(&gpu->pdev->dev, "RBBM | ATB bus overflow\n");
+
+	if (status & A6XX_RBBM_INT_0_MASK_UCHE_OOB_ACCESS)
+		dev_err_ratelimited(&gpu->pdev->dev, "UCHE | Out of bounds access\n");
+
+	if (status & A6XX_RBBM_INT_0_MASK_CP_CACHE_FLUSH_TS)
+		msm_gpu_retire(gpu);
+
+	return IRQ_HANDLED;
+}
+
+/*
+ * TEMPORARY image 185 -- DIAGNOSTIC ONLY, safe to keep until answered.
+ *
+ * Dump the CP ring + interrupt state on demand. This exists because the
+ * first-pixels run (MESA-RENDER-ATTEMPT-2.md) produced a fully working
+ * EGL/GLES context on FD640 -- glClear and glFlush both return error 0 --
+ * yet glFinish and glReadPixels block forever. /proc/interrupts shows the
+ * GPU core IRQ (Linux 487, "A640") at ZERO while the HFI IRQ counted 7, so
+ * a6xx_irq() never runs and msm_gpu_retire() never releases the fence.
+ *
+ * Two very different bugs hide behind that, and they are not distinguishable
+ * from userspace: no /proc/gpu, no /dev/mem, debugfs dri/0/gpu is empty.
+ *
+ *   (A) The CP is not running the render ring at all.
+ *   (B) The CP runs it but never raises the completion interrupt.
+ *
+ * This answers it directly. The bring-up already proves the ring is
+ * programmed correctly (RINGHW[01] CP_RB_BASE=iova:0x1000 hw=0x1000, and
+ * rp_iova is 0x1000, so the HW ring IS the real render ring, not a scratch
+ * one), and RPTR demonstrably advances across the selftest -- so the
+ * "scratch ring" theory is already dead. What is unknown is the state of
+ * that ring *after* Mesa has submitted to it and is blocked in glFinish.
+ *
+ * Read-only. No register is written.
+ */
+/*
+ * TEMPORARY image 196 -- READABLE cpstate for userspace polling.
+ *
+ * Once the GPU actually executes (image 195), submitting GL work hard-resets
+ * the system with NO kernel record: no panic, no oops, no SMMU fault, no
+ * watchdog. dmesg just stops mid-stream and /proc/last_kmsg cannot help,
+ * because a hard reset writes no pstore record.
+ *
+ * The existing dump therefore fails exactly when needed -- its output goes to
+ * the ring buffer, which the reset discards. And there is no pure-userspace
+ * route: /dev/mem does not exist on this system, and msm's debugfs register
+ * interface is non-functional in this CAF tree (the `gpu` file is empty and
+ * writes are rejected).
+ *
+ * So the probe must RETURN values rather than print them. A userspace poller
+ * can then sample at high rate and fsync each sample itself, so the last
+ * samples before the reset survive on disk. The kernel hands values over
+ * early; userspace decides when they are durable.
+ *
+ * Caller holds gpu->dev->struct_mutex.
+ */
+int a6xx_cp_state_read(struct msm_gpu *gpu, char *page, size_t size)
+{
+	struct adreno_gpu *adreno = to_adreno_gpu(gpu);
+	struct a6xx_gpu *a6xx = to_a6xx_gpu(adreno);
+	struct a6xx_gmu *gmu = &a6xx->gmu;
+	size_t n = 0;
+
+	/* Values we most want at the instant the machine dies. */
+	n += scnprintf(page + n, size - n, "RBBM_STATUS 0x%08x\n",
+			gpu_read(gpu, REG_A6XX_RBBM_STATUS));
+	n += scnprintf(page + n, size - n, "RBBM_STATUS3 0x%08x\n",
+			gpu_read(gpu, REG_A6XX_RBBM_STATUS3));
+	n += scnprintf(page + n, size - n, "CP_RB_CNTL 0x%08x\n",
+			gpu_read(gpu, REG_A6XX_CP_RB_CNTL));
+	n += scnprintf(page + n, size - n, "CP_RB_WPTR 0x%08x\n",
+			gpu_read(gpu, REG_A6XX_CP_RB_WPTR));
+	n += scnprintf(page + n, size - n, "CP_RB_RPTR 0x%08x\n",
+			gpu_read(gpu, REG_A6XX_CP_RB_RPTR));
+	n += scnprintf(page + n, size - n, "CP_SQE_CNTL 0x%08x\n",
+			gpu_read(gpu, REG_A6XX_CP_SQE_CNTL));
+	n += scnprintf(page + n, size - n, "CP_INTERRUPT_STATUS 0x%08x\n",
+			gpu_read(gpu, REG_A6XX_CP_INTERRUPT_STATUS));
+	n += scnprintf(page + n, size - n, "SPTPRAC_PWR_CLK_STATUS 0x%08x\n",
+			gmu_read(gmu, REG_A6XX_GMU_SPTPRAC_PWR_CLK_STATUS));
+	n += scnprintf(page + n, size - n, "RPMH_POWER_STATE 0x%08x\n",
+			gmu_read(gmu, REG_A6XX_GPU_GMU_CX_GMU_RPMH_POWER_STATE));
+	n += scnprintf(page + n, size - n, "GMU2HOST_INTR_INFO 0x%08x\n",
+			gmu_read(gmu, REG_A6XX_GMU_GMU2HOST_INTR_INFO));
+	n += scnprintf(page + n, size - n, "sw_rb_iova 0x%llx\n",
+			(unsigned long long)gpu->rb_iova);
+
+	/*
+	 * CP clock test, mirroring the CPF logic used by the auto-rest dump.
+	 * If this counter is not advancing the CP is not fetching, which is
+	 * the single most useful thing to know at the moment of death.
+	 */
+	{
+		u64 t0, t1;
+
+		t0 = gpu_read64(gpu, REG_A6XX_RBBM_PERFCTR_CP_0_LO,
+				REG_A6XX_RBBM_PERFCTR_CP_0_HI);
+		udelay(1000);
+		t1 = gpu_read64(gpu, REG_A6XX_RBBM_PERFCTR_CP_0_LO,
+				REG_A6XX_RBBM_PERFCTR_CP_0_HI);
+		n += scnprintf(page + n, size - n,
+				"CP_TIMESTAMP 0x%016llx delta %llu clocking %d\n",
+				(unsigned long long)t1,
+				(unsigned long long)(t1 - t0),
+				(t1 != t0));
+	}
+
+	return n;
+}
+
+/*
+ * IMAGE 283 -- read a list of GPU register offsets and print their values.
+ *
+ * WHY: the ground truth.  The WORKING device (Android/KGSL) has been
+ * captured: 2342 register entries, decoded against a6xx_reg.h, and saved as
+ * artifacts/gpu-bringup/ground-truth/android-gpu-regs.txt.  To compare, the
+ * same registers have to be read on THIS device.
+ *
+ * /dev/mem is no help: this kernel's devmem_is_allowed() refuses exclusive
+ * device regions, and the GPU's MMIO is claimed exclusively by the driver.
+ * But the driver has the ioremap, so it can read the registers itself.
+ *
+ * The offset list is read from /userdata/gpuwork/reg_offsets.txt (one hex
+ * offset per line), so the same list can be changed without a rebuild.
+ * Offsets are word indices, the same convention as the XML header and as
+ * CAF's a6xx_reg.h, and the same convention the Android snapshot uses.
+ */
+static void a6xx_cp_state_regs(struct msm_gpu *gpu)
+{
+	struct file *f;
+	char *buf, *line, *p;
+	loff_t pos = 0;
+	ssize_t n;
+	unsigned long count = 0;
+
+	f = filp_open("/userdata/gpuwork/reg_offsets.txt", O_RDONLY, 0);
+	if (IS_ERR(f)) {
+		pr_info("REGS: cannot open the offset list: %ld\n", PTR_ERR(f));
+		return;
+	}
+
+	buf = kzalloc(256 * 1024, GFP_KERNEL);
+	if (!buf) {
+		filp_close(f, NULL);
+		return;
+	}
+
+	n = kernel_read(f, buf, 256 * 1024 - 1, &pos);
+	filp_close(f, NULL);
+	if (n <= 0) {
+		pr_info("REGS: offset list is empty (%zd)\n", n);
+		kfree(buf);
+		return;
+	}
+	buf[n] = '\0';
+
+	p = buf;
+	while ((line = strsep(&p, "\n")) != NULL) {
+		unsigned long off;
+
+		if (!*line)
+			continue;
+		off = simple_strtoul(line, NULL, 0);
+		if (off >= 0x10000)	/* outside the a6xx register window */
+			continue;
+		pr_info("REGS %05lx %08x\n", off, gpu_read(gpu, (u32)off));
+		count++;
+	}
+	pr_info("REGS: %lu registers read\n", count);
+	kfree(buf);
+}
+
+int a6xx_cp_state_dump(struct msm_gpu *gpu, const char *tag)
+{
+	struct adreno_gpu *adreno_gpu = to_adreno_gpu(gpu);
+	struct a6xx_gpu *a6xx_gpu = to_a6xx_gpu(adreno_gpu);
+	struct msm_ringbuffer *rb = gpu->rb[0];
+	u64 t0, t1;
+
+	if (!strcmp(tag, "REGS"))
+		a6xx_cp_state_regs(gpu);
+
+	pr_info("CPDUMP[%s] ---- a6xx CP state ----\n", tag);
+
+	pr_info("CPDUMP[%s] sw : rb_iova=0x%llx rb_size=%d wptr_dw=%u next_dw=%u\n",
+		tag,
+		(unsigned long long)gpu->rb_iova,
+		rb ? rb->size : -1,
+		rb ? (unsigned)(rb->cur - rb->start) : 0,
+		rb ? (unsigned)(rb->next - rb->start) : 0);
+
+	pr_info("CPDUMP[%s] hw : RB_BASE=0x%llx RB_CNTL=0x%x RB_RPTR_ADDR=0x%llx\n",
+		tag,
+		(unsigned long long)gpu_read64(gpu,
+			REG_A6XX_CP_RB_BASE, REG_A6XX_CP_RB_BASE_HI),
+		gpu_read(gpu, REG_A6XX_CP_RB_CNTL),
+		(unsigned long long)gpu_read64(gpu,
+			REG_A6XX_CP_RB_RPTR_ADDR_LO, REG_A6XX_CP_RB_RPTR_ADDR_HI));
+
+	pr_info("CPDUMP[%s] hw : RB_RPTR=0x%x RB_WPTR=0x%x SQE_CNTL=0x%x SQE_BASE=0x%llx (sw 0x%llx)\n",
+		tag,
+		gpu_read(gpu, REG_A6XX_CP_RB_RPTR),
+		gpu_read(gpu, REG_A6XX_CP_RB_WPTR),
+		gpu_read(gpu, REG_A6XX_CP_SQE_CNTL),
+		(unsigned long long)gpu_read64(gpu,
+			REG_A6XX_CP_SQE_INSTR_BASE_LO,
+			REG_A6XX_CP_SQE_INSTR_BASE_HI),
+		(unsigned long long)a6xx_gpu->sqe_iova);
+
+	pr_info("CPDUMP[%s] irq: INT_0_STATUS=0x%x INT_0_MASK=0x%x CP_INTERRUPT_STATUS=0x%x\n",
+		tag,
+		gpu_read(gpu, REG_A6XX_RBBM_INT_0_STATUS),
+		gpu_read(gpu, REG_A6XX_RBBM_INT_0_MASK),
+		gpu_read(gpu, REG_A6XX_CP_INTERRUPT_STATUS));
+
+	pr_info("CPDUMP[%s] st : RBBM_STATUS=0x%x RBBM_STATUS3=0x%x linux_irq=%u irqs=%lu\n",
+		tag,
+		gpu_read(gpu, REG_A6XX_RBBM_STATUS),
+		gpu_read(gpu, REG_A6XX_RBBM_STATUS3),
+		gpu->irq,
+		gpu->irq >= 0 ? kstat_irqs((unsigned int)gpu->irq) : 0UL);
+
+	/*
+	 * The decisive bit. PERFCTR_CP_0 is clocked by the command processor
+	 * itself, so if it advances over a short interval the CP is genuinely
+	 * running right now -- independently of whether the interrupt ever
+	 * fires. That is exactly the (A)/(B) discriminator, and it works even
+	 * though the IRQ path is the thing that is broken.
+	 */
+	t0 = gpu_read64(gpu, REG_A6XX_RBBM_PERFCTR_CP_0_LO,
+		REG_A6XX_RBBM_PERFCTR_CP_0_HI);
+	msleep(50);
+	t1 = gpu_read64(gpu, REG_A6XX_RBBM_PERFCTR_CP_0_LO,
+		REG_A6XX_RBBM_PERFCTR_CP_0_HI);
+	pr_info("CPDUMP[%s] CPF: t0=0x%llx t1=0x%llx delta=%llu => CP is %s\n",
+		tag, t0, t1, (unsigned long long)(t1 - t0),
+		(t1 != t0) ? "CLOCKING (running, problem is the IRQ)"
+			   : "NOT CLOCKING (stalled, problem is the ring)");
+
+	pr_info("CPDUMP[%s] ---- end ----\n", tag);
+	return 0;
+}
+
+static const u32 a6xx_register_offsets[REG_ADRENO_REGISTER_MAX] = {
+	REG_ADRENO_DEFINE(REG_ADRENO_CP_RB_BASE, REG_A6XX_CP_RB_BASE),
+	REG_ADRENO_DEFINE(REG_ADRENO_CP_RB_BASE_HI, REG_A6XX_CP_RB_BASE_HI),
+	REG_ADRENO_DEFINE(REG_ADRENO_CP_RB_RPTR_ADDR,
+		REG_A6XX_CP_RB_RPTR_ADDR_LO),
+	REG_ADRENO_DEFINE(REG_ADRENO_CP_RB_RPTR_ADDR_HI,
+		REG_A6XX_CP_RB_RPTR_ADDR_HI),
+	REG_ADRENO_DEFINE(REG_ADRENO_CP_RB_RPTR, REG_A6XX_CP_RB_RPTR),
+	REG_ADRENO_DEFINE(REG_ADRENO_CP_RB_WPTR, REG_A6XX_CP_RB_WPTR),
+	REG_ADRENO_DEFINE(REG_ADRENO_CP_RB_CNTL, REG_A6XX_CP_RB_CNTL),
+};
+
+static const u32 a6xx_registers[] = {
+	0x0000, 0x0002, 0x0010, 0x0010, 0x0012, 0x0012, 0x0018, 0x001b,
