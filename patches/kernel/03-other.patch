+static irqreturn_t a6xx_hfi_irq(int irq, void *data)
+{
+	struct a6xx_gmu *gmu = data;
+	u32 status;
+
+	bw124_hfi_irqs++;
+
+	status = gmu_read(gmu, REG_A6XX_GMU_GMU2HOST_INTR_INFO);
+	gmu_write(gmu, REG_A6XX_GMU_GMU2HOST_INTR_CLR, status);
+
+	if (status & A6XX_GMU_GMU2HOST_INTR_INFO_MSGQ)
+		tasklet_schedule(&gmu->hfi_tasklet);
+
+	if (status & A6XX_GMU_GMU2HOST_INTR_INFO_CM3_FAULT) {
+		dev_err_ratelimited(gmu->dev, "GMU firmware fault\n");
+		/* TEMPORARY image 139 WDT forensics -- state before BUG. */
+		pr_info("WDT139: CM3FAULT INITRES=0x%x FWBUSY=0x%x NMI=0x%x SPTPRAC=0x%x\n",
+			gmu_read(gmu, REG_A6XX_GMU_CM3_FW_INIT_RESULT),
+			gmu_read(gmu, REG_A6XX_GMU_CM3_FW_BUSY),
+			gmu_read(gmu, REG_A6XX_GMU_NMI_CONTROL_STATUS),
+			gmu_read(gmu, REG_A6XX_GMU_SPTPRAC_PWR_CLK_STATUS));
+
+		/*
+		 * TEMPORARY image 166 -- PROMOTE: never BUG in an IRQ
+		 * handler on a firmware event. Recover instead.
+		 */
+		pr_info("RECOVER166: GMU CM3 fault, scheduling recovery\n");
+		recover166_ag = container_of(gmu, struct a6xx_gpu, gmu);
+		schedule_work(&recover166_work);
+	}
+
+	return IRQ_HANDLED;
+}
