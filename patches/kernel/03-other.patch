+static int a6xx_gmu_clocks_probe(struct a6xx_gmu *gmu)
+{
+	int ret = msm_clk_bulk_get(gmu->dev, &gmu->clocks);
+
+	if (ret < 1)
+		return ret;
+
+	gmu->nr_clocks = ret;
+
+	pr_info("A6XX_TRACE: GMU clocks: count=%d array=%zu bytes (%zu each)\n",
+		gmu->nr_clocks,
+		gmu->nr_clocks * sizeof(struct clk_bulk_data),
+		sizeof(struct clk_bulk_data));
+
+	gmu->core_clk = msm_clk_bulk_get_clock(gmu->clocks,
+		gmu->nr_clocks, "gmu");
+
+	return 0;
+}
