+
+module_param(experimental_nonlegacy, bool, 0444);
+MODULE_PARM_DESC(experimental_nonlegacy,
+	"1=HFI vote + skip legacy DCVS/SECVID at boot (default off)");
+
+/*
+ * IMAGE 226: enable the GPU GX power domain (vdd-supply -> gpu_gx_gdsc) from
+ * the host. This is a DISCRIMINATOR, not a fix -- see the GXGDSC226 block in
+ * a6xx_gmu_resume(). Default ON because the whole point of image 226 is to run
+ * the experiment; turn it off (a6xx.enable_gx_gdsc=0) to reproduce the
+ * image-225 behaviour exactly.
+ */
+static bool enable_gx_gdsc = true;
+module_param(enable_gx_gdsc, bool, 0444);
+MODULE_PARM_DESC(enable_gx_gdsc,
+	"1=host regulator_enable() the GX GDSC at resume (default 1, image 226 experiment)");
