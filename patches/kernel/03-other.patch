+/*
+ * TEMPORARY bring-up tracing -- REMOVE ONCE GMU PROBE IS STABLE.
+ *
+ * The probe wedges the device with no panic record, so the last marker seen
+ * on /dev/kmsg names the statement that killed it.
+ */
+#define a6xx_trace(step) pr_info("a6xx-trace: %s\n", (step))
+
