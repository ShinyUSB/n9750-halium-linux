+static int a6xx_gmu_set_freq(struct a6xx_gmu *gmu, int index)
+{
+	int oob_ret;
+
+	/*
+	 * IMAGE 226: don't take power (or block in the 5s HFI waiter) for a
+	 * devfreq event that arrives while the GPU is idle. Upstream v5.8 does
+	 * this check in its public wrapper; our entry point is the internal
+	 * function and had lost it.
+	 */
+	if (pm_runtime_suspended(gmu->dev))
+		return 0;
+
+	/*
+	 * IMAGE 225 -- THE FIX. Non-legacy (HFI v2: A640/A650) must go over HFI.
+	 *
+	 * Upstream v5.8 a6xx_gmu.c:
+	 *
+	 *	if (gmu->legacy)
+	 *		__a6xx_gmu_set_freq(gmu, perf_index);
+	 *	else
+	 *		a6xx_hfi_set_freq(gmu, perf_index);
+	 *
+	 * and again at the tail of a6xx_gmu_resume(). Our port had only the
+	 * first half and called it unconditionally, so an A640 ran the v1
+	 * DCVS-register + DCVS-OOB path that v2 firmware does not implement.
+	 *
+	 * HFI_H2F_MSG_GX_BW_PERF_VOTE is the only message that carries a GX
+	 * corner to v2 firmware, and acting on it is what raises the GX rail
+	 * and gpu_cc_gx_gmu_clk. Without it the firmware is never asked, and
+	 * holding GX collapsed is the correct behaviour. Every observed symptom
+	 * follows: GMU alive and ACKing HFI, CX domain running, GX_VOTE_IDX
+	 * consumed and cleared, and gpu_cc_gx_gmu_clk permanently en=0.
+	 *
+	 * The DCVS OOB ack-wait timeout observed on every boot is the *same*
+	 * bug seen from the other side: DCVS OOB request bit 23 is undefined
+	 * on v2, so it is never acknowledged. Do not treat that timeout as an
+	 * independent fault.
+	 */
+	if (!gmu->legacy)
+		return a6xx_hfi_set_freq(gmu, index);
+
+	/* TEMPORARY image 132 DCVS audit -- REMOVE AFTER RESULT. */
+	pr_info("DCVS132-A: enter index=%d PERF_SET=0x%x BW_SET=0x%x RETURN(before)=0x%x SPTPRAC=0x%x RPMHPWR=0x%x ms=%u\n",
+		index,
+		gmu_read(gmu, REG_A6XX_GMU_DCVS_PERF_SETTING),
+		gmu_read(gmu, REG_A6XX_GMU_DCVS_BW_SETTING),
+		gmu_read(gmu, REG_A6XX_GMU_DCVS_RETURN),
+		gmu_read(gmu, REG_A6XX_GMU_SPTPRAC_PWR_CLK_STATUS),
+		gmu_read(gmu, REG_A6XX_GPU_GMU_CX_GMU_RPMH_POWER_STATE),
+		jiffies_to_msecs(jiffies));
+	gmu_write(gmu, REG_A6XX_GMU_DCVS_ACK_OPTION, 0);
+
+	/*
+	 * IMAGE 225: also fix the packing. Upstream is
+	 * `((3 & 0xf) << 28) | index`. Ours was `((index << 24) & 0xff)`, whose
+	 * 0xff mask discards every bit at or above 8, so the perf index could
+	 * never reach the register even on legacy hardware.
+	 */
+	gmu_write(gmu, REG_A6XX_GMU_DCVS_PERF_SETTING,
+		((3 & 0xf) << 28) | index);
+
+	/*
+	 * Send an invalid index as a vote for the bus bandwidth and let the
+	 * firmware decide on the right vote
+	 */
+	gmu_write(gmu, REG_A6XX_GMU_DCVS_BW_SETTING, 0xff);
+
+	/* Set and clear the OOB for DCVS to trigger the GMU */
+	oob_ret = a6xx_gmu_set_oob(gmu, GMU_OOB_DCVS_SET);
+	pr_info("DCVS132-B: OOB set ret=%d\n", oob_ret);
+	a6xx_gmu_clear_oob(gmu, GMU_OOB_DCVS_SET);
+	pr_info("DCVS132-C: OOB cleared\n");
+
+	pr_info("DCVS132-D: RETURN(after)=0x%x SPTPRAC=0x%x RPMHPWR=0x%x\n",
+		gmu_read(gmu, REG_A6XX_GMU_DCVS_RETURN),
+		gmu_read(gmu, REG_A6XX_GMU_SPTPRAC_PWR_CLK_STATUS),
+		gmu_read(gmu, REG_A6XX_GPU_GMU_CX_GMU_RPMH_POWER_STATE));
+	return gmu_read(gmu, REG_A6XX_GMU_DCVS_RETURN);
+}
