+module_param(uche_gbif_rw, bool, 0444);
+MODULE_PARM_DESC(uche_gbif_rw,
+	"1=write UCHE_GBIF_GX_CONFIG=0x10200f9 (default 0; KGSL gates this on an unknown DT quirk)");
+module_param(force_gx_clk, bool, 0444);
+MODULE_PARM_DESC(force_gx_clk,
+	"1=force gpu_cc_gx_gmu_clk gate at GPU_CC+0x162 (default 0, image 227 diagnostic)");
+
+/*
+ * IMAGE 230: send the ACD state to AOP over the qmp_aop mailbox. Default ON
+ * because this is the ported vendor behaviour, not an experiment: KGSL
+ * enables ACD unconditionally at gmu_aop_mailbox_init() and sends "value: 1"
+ * on the first gmu_start(). Set a6xx.send_acd=0 to disable.
+ */
+static bool send_acd = true;
+module_param(send_acd, bool, 0444);
+MODULE_PARM_DESC(send_acd,
+	"1=notify AOP of GPU ACD state at resume (default 1, ported from KGSL gmu_aop_send_acd_state)");
+
+
+module_param(a6xx_selftest, bool, 0444);
+MODULE_PARM_DESC(a6xx_selftest,
+	"1=re-run CP_ME_INIT self-test after hw_init (needs nonlegacy, default off)");
+
+/*
+ * IMAGE 274c: set the CX GDSC regulator's MODE. Default OFF; enable with
+ * a6xx.cxgdm=1 on the cmdline.
+ *
+ * KGSL does this and we never do:
+ *   kgsl_gmu.c:1599  regulator_set_mode(gmu->cx_gdsc, REGULATOR_MODE_IDLE);
+ *   kgsl_gmu.c:1604  regulator_set_mode(gmu->cx_gdsc, REGULATOR_MODE_NORMAL);
+ *
+ * and, because the DT sets qcom,gpu-quirk-cx-gdsc, KGSL answers "is CX on"
+ * from the regulator rather than from a register
+ * (adreno_a6xx_gmu.c:842-846).  Our DT sets the quirk and our driver parses
+ * no gpu-quirk property at all.
+ */
+module_param(cxgdm, uint, 0644);
+MODULE_PARM_DESC(cxgdm,
+	"regulator mode to set on vddcx at GPU bring-up: 0=off, 2=REGULATOR_MODE_NORMAL, 4=REGULATOR_MODE_IDLE (default 0; image 274 found that NORMAL kills the GPU's secure firmware, so IDLE is the next thing to try)");
+module_param(skip_bw, bool, 0444);
+MODULE_PARM_DESC(skip_bw,
+	"1=skip BW_TABLE send, continue as if ACKed (default off)");
+module_param(keepalive156, bool, 0444);
+MODULE_PARM_DESC(keepalive156,
+	"1=re-send HFI GX vote every 10s (default off)");
+module_param(hold_boot, bool, 0444);
+MODULE_PARM_DESC(hold_boot,
+	"1=keep boot OOBs, no GMU power handoff (default off)");
+module_param(skip_gpuset, bool, 0444);
+MODULE_PARM_DESC(skip_gpuset,
+	"1=skip GPU_SET OOB in hw_init (default off)");
+/*
+ * Image 182 -- default OFF (was on since 165). Post-success pm_suspend
+ * wedges the trigger thread inside printk (console_unlock, CPU3,
+ * images 179-181: SSH and OTG die while the phone looks alive), and
+ * even when it returns the VBIF poll never completes (79/79 archives:
+ * wait_for_idle done, never vbif halt done). Mesa needs a POWERED GPU
+ * anyway -- a slumbered GPU has no resume-on-submit yet, so slumbering
+ * before first render just guarantees userspace finds it asleep.
+ * Stay awake; power management returns after first pixels.
+ */
+bool slumber165 = false;
+module_param(slumber165, bool, 0444);
+MODULE_PARM_DESC(slumber165,
+	"1=post-hw_init slumber via suspend path (default off since 182)");
+/*
+ * Image 182 -- PROMOTE (quiet bring-up). Every post-success diagnostic
+ * thread (dw161 SHOTs, sw165 spinwatch with its cross-CPU IPI ping and
+ * 15s hot spin) is off unless explicitly armed. The bring-up flood
+ * (HFI/BС132/SELFTEST) already proved it can wedge console_unlock;
+ * post-success prints buy forensics at the price of the machine's
+ * responsiveness. Mesa needs the CPUs more than the logs do.
+ */
+bool a6xx_instr;
+module_param(a6xx_instr, bool, 0444);
+MODULE_PARM_DESC(a6xx_instr,
+	"1=arm post-success instruments (SHOTs, spinwatch; default off)");
+/*
+ * TEMPORARY image 178 -- PROMOTE IFF SURVIVAL EXTENDS. Halt the GMU
+ * firmware (CM3 SYSRESET) right after a successful bring-up, before
+ * slumber. If the firmware's autonomous post-boot activity (NoC
+ * floods/death throes/power games) is what destabilizes the system,
+ * a halted firmware can't do any of it; the GPU stays usable at
+ * fixed clocks for submits (no GMU needed for CP/fences).
+ * Default off (normal bring-up).
+ */
+bool halt_gmu;
+module_param(halt_gmu, bool, 0444);
+MODULE_PARM_DESC(halt_gmu,
+	"1=halt GMU CM3 firmware after successful hw_init (default off)");
+
