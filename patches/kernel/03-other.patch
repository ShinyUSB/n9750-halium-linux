+		gpu_write(gpu, REG_A6XX_UCHE_WRITE_RANGE_MAX_LO, 0x0);
+		gpu_write(gpu, REG_A6XX_UCHE_WRITE_RANGE_MAX_HI, 0x0);
+		gpu_write(gpu, REG_A6XX_UCHE_TRAP_BASE_LO, 0x0);
+		gpu_write(gpu, REG_A6XX_UCHE_TRAP_BASE_HI, 0x0);
+		gpu_write(gpu, REG_A6XX_UCHE_WRITE_THRU_BASE_LO, 0x0);
+		gpu_write(gpu, REG_A6XX_UCHE_WRITE_THRU_BASE_HI, 0x0);
+		pr_info("UCHE279: filters CLEARED (CAF values): RANGE_MAX=0x%llx TRAP_BASE=0x%llx WRITE_THRU=0x%llx\n",
+			(unsigned long long)(((uint64_t)gpu_read(gpu, REG_A6XX_UCHE_WRITE_RANGE_MAX_HI) << 32) |
+					     gpu_read(gpu, REG_A6XX_UCHE_WRITE_RANGE_MAX_LO)),
+			(unsigned long long)(((uint64_t)gpu_read(gpu, REG_A6XX_UCHE_TRAP_BASE_HI) << 32) |
+					     gpu_read(gpu, REG_A6XX_UCHE_TRAP_BASE_LO)),
+			(unsigned long long)(((uint64_t)gpu_read(gpu, REG_A6XX_UCHE_WRITE_THRU_BASE_HI) << 32) |
+					     gpu_read(gpu, REG_A6XX_UCHE_WRITE_THRU_BASE_LO)));
