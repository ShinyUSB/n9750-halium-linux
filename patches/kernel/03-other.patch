+static int a6xx_ucode_init(struct msm_gpu *gpu)
+{
+	struct adreno_gpu *adreno_gpu = to_adreno_gpu(gpu);
+	struct a6xx_gpu *a6xx_gpu = to_a6xx_gpu(adreno_gpu);
+
+	if (!a6xx_gpu->sqe_bo) {
+		a6xx_gpu->sqe_bo = adreno_fw_create_bo(gpu,
+			adreno_gpu->fw[ADRENO_FW_SQE], &a6xx_gpu->sqe_iova);
+
+		if (IS_ERR(a6xx_gpu->sqe_bo)) {
+			int ret = PTR_ERR(a6xx_gpu->sqe_bo);
+
+			a6xx_gpu->sqe_bo = NULL;
+			DRM_DEV_ERROR(&gpu->pdev->dev,
+				"Could not allocate SQE ucode: %d\n", ret);
+
+			return ret;
+		}
+	}
+
+	/*
+	 * TEMPORARY image 213 -- identify the SQE microcode we actually loaded.
+	 *
+	 * Image 212 showed the CP retires nothing at all, including the
+	 * CP_ME_INIT that a6xx_cp_init() wrote during bring-up, while still
+	 * advancing RPTR. That points at the SQE itself never starting, so
+	 * the first thing to rule out is that we are running the wrong
+	 * microcode for an A640.
+	 *
+	 * Upstream a6xx_ucode_check_version() gates on these nibbles:
+	 *
+	 *   if (!strcmp(sqe_name, "a630_sqe.fw")) {
+	 *       if ((((buf[0] & 0xf) == 0xa) && (buf[2] & 0xf) >= 1) ||
+	 *           (buf[0] & 0xfff) >= 0x190)
+	 *               a6xx_gpu->has_whereami = true;
+	 *   }
+	 *
+	 * has_whereami gates whether upstream allocates shadow_bo and therefore
+	 * whether CP_RB_RPTR_ADDR is programmed at all. Our tree never calls
+	 * that check, so print the raw nibbles and let them be judged.
+	 */
+	{
+		const struct firmware *fw = adreno_gpu->fw[ADRENO_FW_SQE];
+
+		if (fw && fw->data && fw->size >= 8)
+			pr_info("SQE213: name=%s size=%zu b0=0x%02x b2=0x%02x ver=0x%03x nib0=0x%x nib2=0x%x would_whereami=%d\n",
+				adreno_gpu->info->fw[ADRENO_FW_SQE], fw->size,
+				fw->data[0], fw->data[2],
+				fw->data[0] & 0xfff, fw->data[0] & 0xf,
+				fw->data[2] & 0xf,
+				(((fw->data[0] & 0xf) == 0xa) &&
+				  ((fw->data[2] & 0xf) >= 1)) ||
+				((fw->data[0] & 0xfff) >= 0x190));
+		else
+			pr_info("SQE213: SQE firmware missing or too small (fw=%px size=%zu)\n",
+				(void *)fw, fw ? fw->size : 0);
+	}
+
+	/*
+	 * IMAGE 266 -- no capture buffer is allocated here. It lives in the
+	 * tail of the memptrs BO (see ADRENO_IBCAP_OFF in adreno_gpu.h).
+	 * Allocating one at this point, or in a6xx_submit(), deadlocked the
+	 * machine on images 264 and 265 respectively.
+	 */
+
+	pr_info("RINGHW-W: CP_SQE_INSTR_BASE before=0x%llx val=0x%llx\n",
+		(unsigned long long)gpu_read64(gpu,
+			REG_A6XX_CP_SQE_INSTR_BASE_LO,
+			REG_A6XX_CP_SQE_INSTR_BASE_HI),
+		(unsigned long long)a6xx_gpu->sqe_iova);
+	gpu_write64(gpu, REG_A6XX_CP_SQE_INSTR_BASE_LO,
+		REG_A6XX_CP_SQE_INSTR_BASE_HI, a6xx_gpu->sqe_iova);
+	pr_info("RINGHW-W: CP_SQE_INSTR_BASE after=0x%llx\n",
+		(unsigned long long)gpu_read64(gpu,
+			REG_A6XX_CP_SQE_INSTR_BASE_LO,
+			REG_A6XX_CP_SQE_INSTR_BASE_HI));
+
+	return 0;
+}
