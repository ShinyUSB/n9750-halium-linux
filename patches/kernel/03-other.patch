+/*
+ * TEMPORARY diagnostic checkpoint -- REMOVE AFTER RESULT. Sentinel first
+ * four words; answers who-zeroed-what at each host step.
+ */
+static void a6xx_gmu_scratch_check(struct a6xx_gmu *gmu, const char *when)
+{
+	if (gmu->sentinel && gmu->sentinel->virt)
+		A6XX_TRACE("SCRATCH %s %08x %08x %08x %08x",
+			when,
+			((u32 *)gmu->sentinel->virt)[0], ((u32 *)gmu->sentinel->virt)[1],
+			((u32 *)gmu->sentinel->virt)[2], ((u32 *)gmu->sentinel->virt)[3]);
+	else
+		A6XX_TRACE("SCRATCH %s no-sentinel", when);
+}
