+#if defined(CONFIG_DEBUG_FS) || defined(CONFIG_DEV_COREDUMP)
+static void a6xx_show(struct msm_gpu *gpu, struct msm_gpu_state *state,
+		struct drm_printer *p)
+{
+	struct msm_ringbuffer *ring = gpu->rb[0];
+	struct adreno_gpu *ag = to_adreno_gpu(gpu);
+
+	/*
+	 * Upstream's adreno_show() takes (msm_gpu_state *, drm_printer *).
+	 * This tree's adreno_show() is the older CAF form taking a seq_file,
+	 * so the full register dump is not reproduced here; the ring and
+	 * firmware state that matters for bring-up is reported instead.
+	 */
+	drm_printf(p, "rb wptr: %d\n", get_wptr(ring));
+	if (ring->memptrs)
+		drm_printf(p, "rb rpdr: %d\n", ring->memptrs->rptr);
+	if (ring->memptrs)
+		drm_printf(p, "rb fence: %u\n", ring->memptrs->fence);
+
+	drm_printf(p, "sqe: %d bytes\n",
+		ag->fw[ADRENO_FW_SQE] ? ag->fw[ADRENO_FW_SQE]->size : 0);
+	drm_printf(p, "gmu: %d bytes\n",
+		ag->fw[ADRENO_FW_GMU] ? ag->fw[ADRENO_FW_GMU]->size : 0);
+}
+#endif
