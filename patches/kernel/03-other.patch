+static void bw124_decode_span(struct a6xx_gmu *gmu, u32 start, u32 end)
+{
+	u32 i = start, n = 0;
+	while (i != end && n < 256) {
+		u32 w0 = gmu->queues[HFI_RESPONSE_QUEUE].data[i & 1023];
+		u32 id = HFI_HEADER_ID(w0);
+		u32 type = HFI_HEADER_TYPE(w0);
+		u32 size = HFI_HEADER_SIZE(w0);
+		u32 seq = HFI_HEADER_SEQNUM(w0);
+		u32 k, m = size;
+		if (m > 12)
+			m = 12;
+		pr_info("BW124-PKT off=%u header=0x%08x id=%u type=%u size=%u seq=%u\n",
+			i, w0, id, type, size, seq);
+		for (k = 0; k < m; k++)
+			pr_info("BW124-WORD off=%u %08x\n", i + k,
+				gmu->queues[HFI_RESPONSE_QUEUE].data[(i + k) & 1023]);
+		if (type == HFI_MSG_ACK && m >= 3) {
+			u32 rh = gmu->queues[HFI_RESPONSE_QUEUE].data[(i + 1) & 1023];
+			u32 err = gmu->queues[HFI_RESPONSE_QUEUE].data[(i + 2) & 1023];
+			pr_info("BW124-ACK ret_id=%u ret_type=%u ret_size=%u ret_seq=%u error=%u\n",
+				HFI_HEADER_ID(rh), HFI_HEADER_TYPE(rh),
+				HFI_HEADER_SIZE(rh), HFI_HEADER_SEQNUM(rh), err);
+		}
+		if (size == 0)
+			break;
+		i += size;
+		n += size;
+	}
+	pr_info("BW124-SPAN done span_words=%u\n", n);
+}
+
+static void bw124_on_bw_timeout(struct a6xx_gmu *gmu)
+{
+	struct a6xx_hfi_queue *q1 = &gmu->queues[HFI_RESPONSE_QUEUE];
+	u32 rd = q1->header->read_index;
+	u32 wr = q1->header->write_index;
+	pr_info("BW124-TIMEOUT: q1 rd=%u wr=%u hfi_irqs=%lu gmu_irqs=%lu G2HINFO=0x%08x\n",
+		rd, wr, bw124_hfi_irqs, bw124_gmu_irqs,
+		gmu_read(gmu, REG_A6XX_GMU_GMU2HOST_INTR_INFO));
+	pr_info("BW124-NOTE: G2HRAW absent on this GMU (no such register)\n");
+	bw124_decode_span(gmu, bw124_q1_rd_before, wr);
+}
+static int a6xx_hfi_send_bw_table(struct a6xx_gmu *gmu)
+{
+	struct a6xx_hfi_msg_bw_table msg = { 0 };
+	int i;
+
+	/*
+	 * TEMPORARY experiment image 110 -- REMOVE OR PROMOTE ON RESULT.
+	 * Canonical A640 bring-up table (minimal single "off" entry): same
+	 * shape as before, but ddr_wait 0x01 (was 0x07), ddr addrs[1] 0x5003c
+	 * (was 0x5005c), cnoc_wait 0x01 (was 0x05). All other words identical.
+	 */
+	msg.bw_level_num = 1;
+
+	msg.ddr_cmds_num = 3;
+	msg.ddr_wait_bitmask = 0x01;
+
+	msg.ddr_cmds_addrs[0] = 0x50000;
+	msg.ddr_cmds_addrs[1] = 0x5003c;
+	msg.ddr_cmds_addrs[2] = 0x5000c;
+
+	msg.ddr_cmds_data[0][0] =  0x40000000;
+	msg.ddr_cmds_data[0][1] =  0x40000000;
+	msg.ddr_cmds_data[0][2] =  0x40000000;
+
+	msg.cnoc_cmds_num = 3;
+	msg.cnoc_wait_bitmask = 0x01;
+
+	msg.cnoc_cmds_addrs[0] = 0x50034;
+	msg.cnoc_cmds_addrs[1] = 0x5007c;
+	msg.cnoc_cmds_addrs[2] = 0x5004c;
+
+	msg.cnoc_cmds_data[0][0] =  0x40000000;
+	msg.cnoc_cmds_data[0][1] =  0x00000000;
+	msg.cnoc_cmds_data[0][2] =  0x40000000;
+
+	msg.cnoc_cmds_data[1][0] =  0x60000001;
+	msg.cnoc_cmds_data[1][1] =  0x20000001;
+	msg.cnoc_cmds_data[1][2] =  0x60000001;
+
+	pr_info("BW_TABLE: size=%u bw_levels=%u cnoc_num=%u ddr_num=%u cnoc_wait=0x%x ddr_wait=0x%x\n",
+		(unsigned)(sizeof(msg) >> 2), msg.bw_level_num,
+		msg.cnoc_cmds_num, msg.ddr_cmds_num,
+		msg.cnoc_wait_bitmask, msg.ddr_wait_bitmask);
+	for (i = 0; i < 3; i++)
+		pr_info("BW_TABLE: ddr[%d] addr=0x%x data=0x%x cnoc[%d] addr=0x%x data0=0x%x data1=0x%x\n",
+			i, msg.ddr_cmds_addrs[i], msg.ddr_cmds_data[0][i],
+			i, msg.cnoc_cmds_addrs[i], msg.cnoc_cmds_data[0][i],
+			msg.cnoc_cmds_data[1][i]);
+
+	{
+		struct a6xx_hfi_queue *q0 = &gmu->queues[HFI_COMMAND_QUEUE];
+		struct a6xx_hfi_queue *q1 = &gmu->queues[HFI_RESPONSE_QUEUE];
+		int r, c, ret;
+		pr_info("BW124-SEND: bw_level_num=%u cnoc_num=%u ddr_num=%u cnoc_wait=0x%x ddr_wait=0x%x sizeof_dw=%u\n",
+			msg.bw_level_num, msg.cnoc_cmds_num, msg.ddr_cmds_num,
+			msg.cnoc_wait_bitmask, msg.ddr_wait_bitmask,
+			(unsigned)(sizeof(msg) >> 2));
+		for (c = 0; c < 6; c++)
+			pr_info("BW124-SEND: cnoc_addr[%d]=0x%08x\n", c, msg.cnoc_cmds_addrs[c]);
+		for (r = 0; r < 2; r++)
+			for (c = 0; c < 6; c++)
+				pr_info("BW124-SEND: cnoc_data[%d][%d]=0x%08x\n", r, c, msg.cnoc_cmds_data[r][c]);
+		for (c = 0; c < 8; c++)
+			pr_info("BW124-SEND: ddr_addr[%d]=0x%08x\n", c, msg.ddr_cmds_addrs[c]);
+		for (r = 0; r < (int)msg.bw_level_num; r++)
+			for (c = 0; c < 8; c++)
+				pr_info("BW124-SEND: ddr_data[%d][%d]=0x%08x\n", r, c, msg.ddr_cmds_data[r][c]);
+		pr_info("BW124-Q: q0 rd=%u wr=%u q1 rd=%u wr=%u (before)\n",
+			q0->header->read_index, q0->header->write_index,
+			q1->header->read_index, q1->header->write_index);
+		bw124_q1_rd_before = q1->header->read_index;
+		ret = a6xx_hfi_send_msg(gmu, HFI_H2F_MSG_BW_TABLE, &msg, sizeof(msg),
+			NULL, 0);
+		pr_info("BW124-Q: q0 rd=%u wr=%u q1 rd=%u wr=%u header=0x%08x hdr_size=%u ret=%d (after)\n",
+			q0->header->read_index, q0->header->write_index,
+			q1->header->read_index, q1->header->write_index,
+			msg.header, HFI_HEADER_SIZE(msg.header), ret);
+		if (ret)
+			bw124_on_bw_timeout(gmu);
+		return ret;
+	}
+}
