+/*
+ * IMAGE 230: notify AOP of the GPU's ACD state.
+ *
+ * THE MISSING STEP. KGSL calls this as the FIRST statement of gmu_start(),
+ * before gmu_enable_gdsc(), before gmu_enable_clks() and before the RPMh/GX
+ * vote. Both reference implementations have it; our port never did, and the
+ * project logged it as "open" in KGSL-DRM-POWER-COMPARE.md:46 from image 77
+ * onward without ever attempting it.
+ *
+ * Transcribed verbatim from vendor KGSL drivers/gpu/msm/kgsl_gmu.c:1255
+ * (/home/usb/ShinyKernel/Kernel, Samsung SM8150/d2q 4.14 tree for this board):
+ *
+ *	msg.len = scnprintf(msg_buf, sizeof(msg_buf),
+ *			"{class: gpu, res: acd, value: %d}", state);
+ *	msg.msg = msg_buf;
+ *	ret = mbox_send_message(mailbox->channel, &msg);
+ *
+ * Three details that are NOT optional:
+ *
+ *  1. The key is "value", not upstream msm's "val". Different strings.
+ *  2. KGSL sends state=1 (ACD ON), because gmu_aop_mailbox_init() does
+ *     set_bit(ADRENO_ACD_CTRL) and the cached "enabled" starts false. My
+ *     earlier assumption that this was an "off notification, zero risk" was
+ *     backwards. A faithful port turns ACD ON.
+ *  3. struct mbox_message { u32 len; void *msg; } in KGSL is a layout shim
+ *     for struct qmp_pkt { u32 size; void *data; }; qmp_send_data() in
+ *     drivers/mailbox/msm_qmp.c:376 casts the argument to struct qmp_pkt.
+ *     We use qmp_pkt directly since it is the same layout.
+ *
+ * tx_block = true with a 1 s timeout means the stack buffer is only alive
+ * for the duration of the call -- do not set tx_block = false here.
+ */
+static int a6xx_gmu_send_acd_state(struct a6xx_gmu *gmu, bool state)
+{
+	struct qmp_pkt pkt = { 0 };
+	char msg_buf[33];
+	int ret;
+
+	if (!gmu->aop_chan)
+		return -ENODEV;
+
+	if (gmu->aop_sent && state)
+		return 0;	/* already ON; KGSL caches and early-returns */
+
+	pkt.size = scnprintf(msg_buf, sizeof(msg_buf),
+			     "{class: gpu, res: acd, value: %d}", state);
+	pkt.data = msg_buf;
+
+	ret = mbox_send_message(gmu->aop_chan, &pkt);
+
+	pr_info("ACD230: '{class: gpu, res: acd, value: %d}' len=%u mbox_send_message ret=%d\n",
+		state, pkt.size, ret);
+
+	if (!ret && state)
+		gmu->aop_sent = true;
+
+	return ret;
+}
