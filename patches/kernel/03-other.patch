+/*
+ * TEMPORARY image 174 -- PROMOTE with firmware visibility. Dump the GMU
+ * firmware log buffer (written by the firmware via CP_MSG since img 102,
+ * never read until now) to debugfs. Read-only host RAM, no MMIO: safe
+ * on a dead/hung GMU. This kernel only ever drives A640.
+ */
+void a6xx_gmu_log_show(struct msm_gpu *gpu, struct seq_file *m)
+{
+	struct a6xx_gpu *a6xx_gpu = to_a6xx_gpu(to_adreno_gpu(gpu));
+	struct a6xx_gmu *gmu = &a6xx_gpu->gmu;
+	u32 *v;
+	int i, n;
+
+	if (!gmu->log || !gmu->log->virt) {
+		seq_printf(m, "no GMU log buffer\n");
+		return;
+	}
+	v = (u32 *)gmu->log->virt;
+	n = gmu->log->size >> 2;
+	seq_printf(m, "GMU log: iova=0x%llx size=0x%zx\n",
+		(unsigned long long)gmu->log->iova, gmu->log->size);
+	for (i = 0; i < n; i += 4)
+		seq_printf(m, "%04x: %08x %08x %08x %08x\n", i,
+			v[i], v[i + 1], v[i + 2], v[i + 3]);
+}
