+void a6xx_hfi_init(struct a6xx_gmu *gmu)
+{
+	struct a6xx_gmu_bo *hfi = gmu->hfi;
+	struct a6xx_hfi_queue_table_header *table = hfi->virt;
+	struct a6xx_hfi_queue_header *headers = hfi->virt + sizeof(*table);
+	u64 offset;
+	int table_size;
+
+	/*
+	 * The table size is the size of the table header plus all of the queue
+	 * headers
+	 */
+	table_size = sizeof(*table);
+	table_size += (ARRAY_SIZE(gmu->queues) *
+		sizeof(struct a6xx_hfi_queue_header));
+
+	table->version = 0;
+	/*
+	 * TEMPORARY experiment -- REMOVE OR PROMOTE ON RESULT. Vendor KGSL
+	 * documents size in dwords (its 4-queue table reports 0x36 = 216 bytes
+	 * >> 2); the sibling fields below already use >> 2. For our 2-queue
+	 * table: 120 bytes >> 2 = 30 = 0x1E. Queues/layout untouched.
+	 */
+	table->size = table_size >> 2;
+	/* First queue header is located immediately after the table header */
+	table->qhdr0_offset = sizeof(*table) >> 2;
+	table->qhdr_size = sizeof(struct a6xx_hfi_queue_header) >> 2;
+	table->num_queues = ARRAY_SIZE(gmu->queues);
+	table->active_queues = ARRAY_SIZE(gmu->queues);
+
+	/*
+	 * TEMPORARY experiment image 101 -- REMOVE OR PROMOTE ON RESULT.
+	 * Exact vendor KGSL 4-queue topology (CMD/MSG/DBG enabled, DSP defined
+	 * but disabled). Data pages at base+0x1000..+0x4000.
+	 */
+	/* Command queue */
+	offset = SZ_4K;
+	a6xx_hfi_queue_init(&gmu->queues[0], &headers[0], hfi->virt + offset,
+		hfi->iova + offset, 0, 10, 1);
+
+	/* GMU response queue */
+	offset += SZ_4K;
+	a6xx_hfi_queue_init(&gmu->queues[1], &headers[1], hfi->virt + offset,
+		hfi->iova + offset, 1, 10, 1);
+
+	/* Debug queue */
+	offset += SZ_4K;
+	a6xx_hfi_queue_init(&gmu->queues[2], &headers[2], hfi->virt + offset,
+		hfi->iova + offset, 2, 40, 1);
+
+	/* Dispatch queue (defined but disabled, per vendor) */
+	offset += SZ_4K;
+	a6xx_hfi_queue_init(&gmu->queues[3], &headers[3], hfi->virt + offset,
+		hfi->iova + offset, 3, 20, 0);
+}
