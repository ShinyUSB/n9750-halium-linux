+/*
+ * TEMPORARY post-mortem dump -- REMOVE AFTER RESULT. Full ITCM (16K),
+ * DTCM low 16K, DEADB scratch (4K) and HFI (16K) contents, 4 words/line.
+ * ITCM/DTCM via the same MMIO aperture used for loading (proven safe by
+ * image-90 IRQ-context reads); buffers via host virt. No locks, no allocs.
+ */
+static void __maybe_unused a6xx_gmu_dump_tcm(struct a6xx_gmu *gmu, const char *tag)
+{
+	int i;
+	u32 w0, w1, w2, w3;
+
+	for (i = 0; i < 0x4000; i += 16) {
+		w0 = gmu_read(gmu, REG_A6XX_GMU_CM3_ITCM_START + (i >> 2));
+		w1 = gmu_read(gmu, REG_A6XX_GMU_CM3_ITCM_START + (i >> 2) + 1);
+		w2 = gmu_read(gmu, REG_A6XX_GMU_CM3_ITCM_START + (i >> 2) + 2);
+		w3 = gmu_read(gmu, REG_A6XX_GMU_CM3_ITCM_START + (i >> 2) + 3);
+		pr_info("A6XX_DUMP %s ITCM+%04x %08x %08x %08x %08x\n",
+			tag, i, w0, w1, w2, w3);
+	}
+	for (i = 0; i < 0x4000; i += 16) {
+		w0 = gmu_read(gmu, REG_A6XX_GMU_CM3_DTCM_START + (i >> 2));
+		w1 = gmu_read(gmu, REG_A6XX_GMU_CM3_DTCM_START + (i >> 2) + 1);
+		w2 = gmu_read(gmu, REG_A6XX_GMU_CM3_DTCM_START + (i >> 2) + 2);
+		w3 = gmu_read(gmu, REG_A6XX_GMU_CM3_DTCM_START + (i >> 2) + 3);
+		pr_info("A6XX_DUMP %s DTCM+%04x %08x %08x %08x %08x\n",
+			tag, 0x40000 + i, w0, w1, w2, w3);
+	}
+	if (gmu->sentinel && gmu->sentinel->virt) {
+		u32 *v = gmu->sentinel->virt;
+		for (i = 0; i < 0x1000; i += 16)
+			pr_info("A6XX_DUMP %s DEADB+%03x %08x %08x %08x %08x\n",
+				tag, i, v[i>>2], v[(i>>2)+1], v[(i>>2)+2], v[(i>>2)+3]);
+	}
+	if (gmu->hfi && gmu->hfi->virt) {
+		u32 *v = gmu->hfi->virt;
+		for (i = 0; i < 0x5000; i += 16)
+			pr_info("A6XX_DUMP %s HFI+%04x %08x %08x %08x %08x\n",
+				tag, i, v[i>>2], v[(i>>2)+1], v[(i>>2)+2], v[(i>>2)+3]);
+	}
+	if (gmu->log && gmu->log->virt) {
+		u32 *v = gmu->log->virt;
+		for (i = 0; i < 0x1000; i += 16)
+			pr_info("A6XX_DUMP %s LOG+%03x %08x %08x %08x %08x\n",
+				tag, i, v[i>>2], v[(i>>2)+1], v[(i>>2)+2], v[(i>>2)+3]);
+	}
+	pr_info("A6XX_DUMP %s done\n", tag);
+}
