+/*
+ * TEMPORARY bring-up tracing -- REMOVE ONCE seq_mmio IS UNDERSTOOD.
+ *
+ * Prints the three GMU MMIO pointers and, where the resource is known, the
+ * backing resource extents. Called at probe time, before the RPMh init, and
+ * before the first pdcseq_write().
+ */
+
+/*
+ * TEMPORARY GMU post-mortem -- REMOVE ONCE A6xx BRING-UP IS DONE.
+ * Runs in SMMU-IRQ context just before the fault panic. Only gmu_read()
+ * (plain MMIO) + pr_info + host-RAM reads: no locks, no allocations.
+ * Ordered registers-first so early lines survive even a wedged TCM read.
+ * Everything is bounded for last_kmsg.
+ */
+void a6xx_gmu_snapshot_on_smmu_fault(const char *smmu_name,
+		unsigned long iova,
+		int cbndx, u32 sid, u32 fsr, u32 fsynr0, u32 fsynr1,
+		u64 ttbr0, u64 ttbr1, u32 sctlr)
+{
+	struct a6xx_gmu *gmu = a6xx_snapshot_gmu;
+	int i;
+	u32 w0, w1, w2, w3;
+
+	if (!gmu || !gmu->mmio)
+		return;
+
+	pr_info("A6XX_SNAPSHOT: FAULT smmu=%s iova=0x%lx cb=%d sid=0x%x fsr=0x%x fsynr0=0x%x fsynr1=0x%x\n",
+		smmu_name, iova, cbndx, sid, fsr, fsynr0, fsynr1);
+	pr_info("A6XX_SNAPSHOT: SMMU ttbr0=0x%llx ttbr1=0x%llx sctlr=0x%x\n",
+		ttbr0, ttbr1, sctlr);
+	pr_info("A6XX_SNAPSHOT: HOST QTBL=0x%x INFO=0x%x SFR=0x%x BOOT=0x%x CM3CFG=0x%x G7=0x%x INITRES=0x%x HFISTAT=0x%x\n",
+		gmu_read(gmu, REG_A6XX_GMU_HFI_QTBL_ADDR),
+		gmu_read(gmu, REG_A6XX_GMU_HFI_QTBL_INFO),
+		gmu_read(gmu, REG_A6XX_GMU_HFI_SFR_ADDR),
+		gmu_read(gmu, REG_A6XX_GMU_CM3_BOOT_CONFIG),
+		gmu_read(gmu, REG_A6XX_GMU_CM3_CFG),
+		gmu_read(gmu, REG_A6XX_GMU_GENERAL_7),
+		gmu_read(gmu, REG_A6XX_GMU_CM3_FW_INIT_RESULT),
+		gmu_read(gmu, REG_A6XX_GMU_HFI_CTRL_STATUS));
+	if (gmu->hfi && gmu->hfi->virt)
+		pr_info("A6XX_SNAPSHOT: HFIQ %08x %08x %08x %08x\n",
+			((u32 *)gmu->hfi->virt)[0], ((u32 *)gmu->hfi->virt)[1],
+			((u32 *)gmu->hfi->virt)[2], ((u32 *)gmu->hfi->virt)[3]);
+	for (i = 0; i < 0x80; i += 16) {
+		w0 = gmu_read(gmu, REG_A6XX_GMU_CM3_ITCM_START + (i >> 2));
+		w1 = gmu_read(gmu, REG_A6XX_GMU_CM3_ITCM_START + (i >> 2) + 1);
+		w2 = gmu_read(gmu, REG_A6XX_GMU_CM3_ITCM_START + (i >> 2) + 2);
+		w3 = gmu_read(gmu, REG_A6XX_GMU_CM3_ITCM_START + (i >> 2) + 3);
+		pr_info("A6XX_SNAPSHOT: ITCM+%02x %08x %08x %08x %08x\n",
+			i, w0, w1, w2, w3);
+	}
+	for (i = 0; i < 0x40; i += 16) {
+		w0 = gmu_read(gmu, REG_A6XX_GMU_CM3_DTCM_START + (i >> 2));
+		w1 = gmu_read(gmu, REG_A6XX_GMU_CM3_DTCM_START + (i >> 2) + 1);
+		w2 = gmu_read(gmu, REG_A6XX_GMU_CM3_DTCM_START + (i >> 2) + 2);
+		w3 = gmu_read(gmu, REG_A6XX_GMU_CM3_DTCM_START + (i >> 2) + 3);
+		pr_info("A6XX_SNAPSHOT: DTCM+%02x %08x %08x %08x %08x\n",
+			i, w0, w1, w2, w3);
+	}
+	for (i = 0; i < 0x40; i += 16) {
+		w0 = gmu_read(gmu, REG_A6XX_GMU_CM3_DTCM_START +
+			((0x3f80 + i) >> 2));
+		w1 = gmu_read(gmu, REG_A6XX_GMU_CM3_DTCM_START +
+			((0x3f80 + i) >> 2) + 1);
+		w2 = gmu_read(gmu, REG_A6XX_GMU_CM3_DTCM_START +
+			((0x3f80 + i) >> 2) + 2);
+		w3 = gmu_read(gmu, REG_A6XX_GMU_CM3_DTCM_START +
+			((0x3f80 + i) >> 2) + 3);
+		pr_info("A6XX_SNAPSHOT: DTCM+3f%02x %08x %08x %08x %08x\n",
+			i, w0, w1, w2, w3);
+	}
+	if (gmu->sentinel && gmu->sentinel->virt)
+		pr_info("A6XX_SNAPSHOT: SENTINEL %08x %08x %08x %08x %08x %08x %08x %08x FW_BUSY=0x%x NMI=0x%x elapsed=%ums\n",
+			((u32 *)gmu->sentinel->virt)[0], ((u32 *)gmu->sentinel->virt)[1],
+			((u32 *)gmu->sentinel->virt)[2], ((u32 *)gmu->sentinel->virt)[3],
+			((u32 *)gmu->sentinel->virt)[4], ((u32 *)gmu->sentinel->virt)[5],
+			((u32 *)gmu->sentinel->virt)[6], ((u32 *)gmu->sentinel->virt)[7],
+			gmu_read(gmu, REG_A6XX_GMU_CM3_FW_BUSY),
+			gmu_read(gmu, REG_A6XX_GMU_NMI_CONTROL_STATUS),
+			jiffies_to_msecs(jiffies - a6xx_start_jiffies));
+	pr_info("A6XX_SNAPSHOT: done\n");
+}
