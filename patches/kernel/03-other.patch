+	/*
+	 * IMAGE 237 -- RB_NC_MODE_CNTL amsbc bit for A640 + UBWC 3.0.
+	 *
+	 * CAF (vendor adreno_a6xx.c:898-921): with DT qcom,ubwc-mode = <3>
+	 * (UBWC 3.0, which our sm8150-gpu.dtsi:125 sets), mode = 0 and
+	 * amsbc = 1, where the comment says amsbc is "Only valid for A640
+	 * and A680". With min-access-length 32 (mal = 0, :123) and
+	 * highest-bank-bit 15 (bit = (15-13)&3 = 2, :121), CAF writes:
+	 *
+	 *   RB_NC_MODE_CNTL   = (1<<4)|(0<<3)|(2<<1)|0 = 0x14
+	 *   TPL1_NC_MODE_CNTL = (0<<3)|(2<<1)|0        = 0x04
+	 *   SP_NC_MODE_CNTL   = (0<<3)|(2<<1)|0        = 0x04
