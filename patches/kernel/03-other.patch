+	rc = subsys_powerup(&d->subsys_desc);
+
+	d->fw_loaded = (rc == 0);
+	pr_info("pil_tz: fw_load %s for %s: rc=%d\n",
+			rc == 0 ? "SUCCEEDED" : "FAILED", dev_name(dev), rc);
+	return count;
