+/*
+ * TEMPORARY image 166 -- PROMOTE with the IRQ-handler change above.
+ * Force the GMU off (upstream force_off shape, minus bus_halt which
+ * needs the absent interconnect driver) then cold re-bootstrap via
+ * the proven resume path (which retries the firmware lottery itself).
+ * Runs in process context under the DRM mutex, like a submit would.
+ * If resume fails, the machine stays alive (suppress philosophy) and
+ * the log shows exactly where.
+ */
+static void recover166_fn(struct work_struct *work)
+{
+	struct a6xx_gpu *ag = recover166_ag;
+	struct msm_gpu *gpu;
+	int ret;
+
+	if (!ag)
+		return;
+	gpu = &ag->base.base;
+
+	pr_info("RECOVER166: begin (force off + cold resume)\n");
+	mutex_lock(&gpu->dev->struct_mutex);
+	recover166_fast = true;
+
+	gmu_write(&ag->gmu, REG_A6XX_GMU_GMU_PWR_COL_KEEPALIVE, 0);
+	a6xx_hfi_stop(&ag->gmu);
+	a6xx_gmu_irq_disable(&ag->gmu);
+	a6xx_sptprac_disable(&ag->gmu);
+	gmu_write(&ag->gmu, REG_A6XX_GMU_AO_AHB_FENCE_CTRL, 0);
+	wmb();
+	gmu_write(&ag->gmu, REG_A6XX_GMU_CM3_SYSRESET, 1);
+	pr_info("RECOVER166: GMU halted, resuming\n");
+	a6xx_rpmh_stop(&ag->gmu);
+
+	ret = a6xx_gmu_resume(ag);
+
+	recover166_fast = false;
+	mutex_unlock(&gpu->dev->struct_mutex);
+	pr_info("RECOVER166: end ret=%d\n", ret);
+}
