+/*
+ * HFI version dispatch. Ported from upstream v5.8.
+ *
+ * gmu->legacy is set for A618/A630, which speak HFI v1 and use the flat ITCM
+ * firmware image. A640/A650 (legacy == false) speak HFI v2 and use the block
+ * firmware format. Mixing the two fails in confusing ways, so the selection
+ * follows the same flag that selects the firmware format.
+ */
+int a6xx_hfi_start(struct a6xx_gmu *gmu, int boot_state)
+{
+	int ret;
+
+	if (gmu->legacy)
+		return a6xx_hfi_start_v1(gmu, boot_state);
+
+	/*
+	 * TEMPORARY experiment image 106 -- REMOVE OR PROMOTE ON RESULT.
+	 * Vendor-compatible v2 order: version, perf, bw, ECP feature,
+	 * core_fw_start, start. Stop at the FIRST failing message.
+	 */
+	pr_info("=== FW_VERSION ===\n");
+	pr_info("HFI: verify_fw_version enter\n");
+	ret = a6xx_hfi_get_fw_version(gmu, NULL);
+	pr_info("HFI: verify_fw_version ret=%d\n", ret);
+	if (ret)
+		return ret;
+
+	/*
+	 * TEMPORARY experiment image 117 -- REMOVE OR PROMOTE ON RESULT.
+	 * Full canonical sequence restored (no skips): v2 PERF_TABLE send
+	 * for A640 (upstream v5.8 order). DCVS OOB is gated separately in
+	 * set_oob, not here.
+	 */
+	pr_info("=== PERF_TABLE ===\n");
+	pr_info("HFI: send_perftbl enter\n");
+	ret = a6xx_hfi_send_perf_table(gmu);
+	pr_info("HFI: send_perftbl ret=%d\n", ret);
+	if (ret)
+		return ret;
+
+	pr_info("=== BW_TABLE ===\n");
+	pr_info("HFI: send_bwtbl enter\n");
+	{
+		struct a6xx_hfi_queue *q0 = &gmu->queues[0];
+		struct a6xx_hfi_queue *q1 = &gmu->queues[1];
+		pr_info("=== BW_TABLE SEND BEGIN ===\n");
+		pr_info("HFI BW: q0 rd=%u wr=%u q1 rd=%u wr=%u INTR_INFO=0x%x\n",
+			q0->header->read_index, q0->header->write_index,
+			q1->header->read_index, q1->header->write_index,
+			gmu_read(gmu, REG_A6XX_GMU_GMU2HOST_INTR_INFO));
+		a6xx_hfi_bw_sent = true;
+	}
+	/* Canonical A640 BW table from Image 110 (untouched object). */
+	/* TEMPORARY image 145 -- REMOVE AFTER RESULT. Gated BW skip: tests
+	 * whether ECP answers with real ARC votes but no BW state, and
+	 * whether survival changes when firmware never receives the table. */
+	if (skip_bw) {
+		pr_info("BW145: SKIPPED (a6xx.skip_bw=1), continuing as if ACKed\n");
+		ret = 0;
+	} else {
+		ret = a6xx_hfi_send_bw_table(gmu);
+	}
+	pr_info("HFI: send_bwtbl ret=%d\n", ret);
+	if (ret)
+		return ret;
+
+	pr_info("=== ECP ===\n");
+	pr_info("HFI: feature_ctrl ECP enter\n");
+	{
+		struct a6xx_hfi_queue *q0 = &gmu->queues[0];
+		struct a6xx_hfi_queue *q1 = &gmu->queues[1];
+		pr_info("=== ECP SEND ===\n");
+		pr_info("HFI-ECP q0 rd=%u wr=%u q1 rd=%u wr=%u INTR_INFO=0x%x\n",
+			q0->header->read_index, q0->header->write_index,
+			q1->header->read_index, q1->header->write_index,
+			gmu_read(gmu, REG_A6XX_GMU_GMU2HOST_INTR_INFO));
+	}
+	ret = a6xx_hfi_send_feature_ctrl(gmu, HFI_FEATURE_ECP, 0, 0);
+	pr_info("HFI: feature_ctrl ECP ret=%d\n", ret);
+	if (ret)
+		return ret;
+	pr_info("=== GMU BOOTSTRAP END ===\n");
+	pr_info("HFI: core_fw_start enter\n");
+	ret = a6xx_hfi_send_core_fw_start(gmu);
+	pr_info("HFI: core_fw_start ret=%d\n", ret);
+	if (ret)
+		return ret;
+
+	pr_info("HFI: init_perf_vote(start) enter\n");
+	ret = a6xx_hfi_send_start(gmu);
+	pr_info("HFI: init_perf_vote(start) ret=%d\n", ret);
+	if (ret)
+		return ret;
+
+	return 0;
+}
