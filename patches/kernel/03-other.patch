+struct msm_gpu *a6xx_gpu_init(struct drm_device *dev)
+{
+	struct msm_drm_private *priv = dev->dev_private;
+	struct platform_device *pdev = priv->gpu_pdev;
+	struct device_node *node;
+	struct a6xx_gpu *a6xx_gpu;
+	struct adreno_gpu *adreno_gpu;
+	struct msm_gpu *gpu;
+	int ret;
+
+	a6xx_gpu = kzalloc(sizeof(*a6xx_gpu), GFP_KERNEL);
+	if (!a6xx_gpu)
+		return ERR_PTR(-ENOMEM);
+
+	adreno_gpu = &a6xx_gpu->base;
+	gpu = &adreno_gpu->base;
+
+	adreno_gpu->registers = a6xx_registers;
+	adreno_gpu->reg_offsets = a6xx_register_offsets;
+
+	/*
+	 * Build the GPU address space FIRST, before adreno_gpu_init().
+	 *
+	 * Ordering requirement: msm_gpu_init() (called by adreno_gpu_init())
+	 * attaches the MMU, and msm_iommu_attach() does pm_runtime_get_sync(),
+	 * which can trigger runtime-resume of the GPU platform device and hence
+	 * a6xx_pm_resume() -> a6xx_gmu_resume(). That path dereferences the MMU
+	 * (mmu->dev), so the MMU must already exist and be populated by then.
+	 *
+	 * msm_gpu_init() would otherwise allocate its own address space with a
+	 * bare iommu_domain_alloc(), which on this platform has no SMMU behind
+	 * it (the GPU node has no "iommus" property; the context banks do).
+	 * msm_gpu_init() therefore leaves gpu->aspace alone when it is already
+	 * set - see msm_gpu.c.
+	 *
+	 * The A640 GPU core runs from gfx3d_user (CB 0, SID 0x401). The GMU's
+	 * own buffers are handled separately, in a6xx_gmu_memory_probe(), on
+	 * gmu_kernel (CB 5).
+	 */
+	if (!gpu->aspace) {
+		struct msm_gem_address_space *aspace;
+
+		aspace = msm_gpu_aspace_new("gfx3d_user", "gfx3d");
+		if (IS_ERR(aspace)) {
+			DRM_DEV_ERROR(&pdev->dev,
+				"failed to create GPU address space on gfx3d_user: %ld\n",
+				PTR_ERR(aspace));
+			/* nothing else is initialised yet, so free directly */
+			kfree(a6xx_gpu);
+			return ERR_CAST(aspace);
+		}
+
+		gpu->aspace = aspace;
+
+		mmu_dbg(&pdev->dev, "GPU address space ready on gfx3d_user\n");
+	}
+
+	ret = adreno_gpu_init(dev, pdev, adreno_gpu, &funcs, 1);
+	if (ret) {
+		a6xx_destroy(&(a6xx_gpu->base.base));
+		return ERR_PTR(ret);
+	}
+
+	/* Check if there is a GMU phandle and set it up */
+	node = of_parse_phandle(pdev->dev.of_node, "gmu", 0);
+
+	/* FIXME: How do we gracefully handle this? */
+	BUG_ON(!node);
+
+	ret = a6xx_gmu_probe(a6xx_gpu, node);
+	if (ret) {
+		a6xx_destroy(&(a6xx_gpu->base.base));
+		return ERR_PTR(ret);
+	}
+	pr_info("A6XX_TRACE: a6xx_gpu_init probe returned, registering fault handler\n");
+
+	if (gpu->aspace)
+		msm_mmu_set_fault_handler(gpu->aspace->mmu, gpu,
+				a6xx_fault_handler);
+
+	return gpu;
+}
