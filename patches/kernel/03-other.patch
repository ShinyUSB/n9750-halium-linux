+static int a6xx_pm_resume(struct msm_gpu *gpu)
+{
+	struct adreno_gpu *adreno_gpu = to_adreno_gpu(gpu);
+	struct a6xx_gpu *a6xx_gpu = to_a6xx_gpu(adreno_gpu);
+	int ret;
+
+	pr_info("A6XX_TRACE: enter a6xx_pm_resume\n");
+
+	ret = a6xx_gmu_resume(a6xx_gpu);
+
+	gpu->needs_hw_init = true;
+
+	pr_info("A6XX_TRACE: a6xx_pm_resume returned (ret=%d)\n", ret);
+
+	/* TEMPORARY diagnostic stop -- REMOVE AFTER RESULT. */
+	{
+		extern int a6xx_gmu_boot_error;
+		a6xx_gmu_boot_error = ret;
+	}
+
+	return ret;
+}
+
+static int a6xx_pm_suspend(struct msm_gpu *gpu)
+{
+	struct adreno_gpu *adreno_gpu = to_adreno_gpu(gpu);
+	struct a6xx_gpu *a6xx_gpu = to_a6xx_gpu(adreno_gpu);
+
+	/*
+	 * TEMPORARY image 210 -- allow a genuine re-init after suspend.
+	 *
+	 * msm_gpu_hw_init() refuses to re-run while hw_init_done is set, which
+	 * is what stops a second bring-up from reprogramming a live GPU (the
+	 * image 209 freezes). A real suspend/resume must still be able to
+	 * re-initialise, so clear the latch here. No printk: this is the
+	 * suspend path, and images 179-181 established that a printk here can
+	 * wedge the caller inside console_unlock.
+	 */
+	gpu->hw_init_done = false;
+
+	/*
+	 * Make sure the GMU is idle before continuing (because some transitions
+	 * may use VBIF
+	 *
+	 * Image 182: the enter/wait_for_idle prints are gone unconditionally
+	 * (not just behind a6xx_instr). Images 179-181 proved the FIRST of
+	 * these two printks wedges the caller inside console_unlock
+	 * (CPU3, RCU stalls 6302->63017 jiffies): the writer never reaches
+	 * wait_for_idle at all. A printk that can cost the machine's
+	 * responsiveness has no place on the suspend path.
+	 */
+	a6xx_gmu_wait_for_idle(a6xx_gpu);
+	if (a6xx_instr)
+		pr_info("SSTEP171: wait_for_idle done\n");
+
+	/*
+	 * IMAGE 245 -- do NOT halt VBIF on a GBIF part.
+	 *
+	 * This was the pm_runtime livelock: runtime_status pinned at
+	 * "suspending", active_time climbing ~1000 ms/s, suspended_time frozen,
+	 * RCU stalls every ~63 s in pm_runtime_work, task state R. No panic, so no
+	 * pstore. It looked like general instability for months.
+	 *
+	 * RETRACTED: spin_until() is NOT the kernel's unbounded macro here. It is
+	 * locally redefined at adreno_gpu.h:178 and bounded to 1000 ms
+	 * (ADRENO_IDLE_TIMEOUT), so this poll cannot livelock. The original
+	 * diagnosis in ROOT-CAUSE-GLREADPIXELS-LIVELOCK.md was wrong; see
+	 * RETRACTION-VBIF-LIVELOCK.md.
+	 *
+	 * The GBIF guard below is still correct on its own merits -- upstream
+	 * gates this sequence on !a6xx_has_gbif() (a6xx_gpu.c:2179) and a640 IS
+	 * a GBIF part, so upstream never touches VBIF_XIN_HALT_CTRL0 here at
+	 * all. It was declined as cosmetic-only, so the sequence is restored
+	 * verbatim and this note is all that remains of it.
+	 */
+	gpu_write(gpu, REG_A6XX_VBIF_XIN_HALT_CTRL0, 0xf);
+	spin_until((gpu_read(gpu, REG_A6XX_VBIF_XIN_HALT_CTRL1) & 0xf) == 0xf);
+	gpu_write(gpu, REG_A6XX_VBIF_XIN_HALT_CTRL0, 0);
+	if (a6xx_instr)
+		pr_info("SSTEP171: vbif halt done\n");
+
+	return a6xx_gmu_stop(a6xx_gpu);
+}
+
+/*
+ * TEMPORARY image 184 -- PROMOTE (Mesa unblock). MSM_PARAM_TIMESTAMP is
+ * the FIRST ioctl Mesa issues when it creates a context, so anything
+ * that wedges here blocks all of userspace before a surface exists.
+ *
+ * Two hazards, both proven live (MESA-RENDER-ATTEMPT-1.md):
+ *
+ *  1. adreno_get_param() wraps this in pm_runtime_get_sync/put_autosuspend.
+ *     We leave the GPU powered after bring-up (slumber off since 182), so
+ *     the extra ref is pure risk: python3 sat in D inside rpm_resume for
+ *     minutes holding it. The read needs a live GPU, not a power
+ *     transition.
+ *
+ *  2. GMU_OOB_GPU_SET is a live handshake with the GMU firmware. When the
+ *     firmware is quiet the set never ACKs and this function never
+ *     returns -- an uninterruptible wedge from an ioctl, the worst
+ *     possible failure mode. A timestamp is diagnostics; it must never be
+ *     able to hang a process.
+ *
+ * So: check the OOB result, read either way, and only clear when we own
+ * it. A quiet firmware yields a stale-but-harmless timestamp, exactly
+ * what the -110 paths already teach us to accept everywhere else.
+ */
+static int a6xx_get_timestamp(struct msm_gpu *gpu, uint64_t *value)
+{
+	struct adreno_gpu *adreno_gpu = to_adreno_gpu(gpu);
+	struct a6xx_gpu *a6xx_gpu = to_a6xx_gpu(adreno_gpu);
+	int oob_ret;
+
+	/* Only meaningful if the GMU is actually managing our power state. */
+	oob_ret = a6xx_gmu_set_oob(&a6xx_gpu->gmu, GMU_OOB_GPU_SET);
+	if (oob_ret)
+		pr_warn_ratelimited("a6xx: timestamp: GPU_SET OOB ret=%d, reading anyway\n",
+			oob_ret);
+
+	*value = gpu_read64(gpu, REG_A6XX_RBBM_PERFCTR_CP_0_LO,
+		REG_A6XX_RBBM_PERFCTR_CP_0_HI);
+
+	if (!oob_ret)
+		a6xx_gmu_clear_oob(&a6xx_gpu->gmu, GMU_OOB_GPU_SET);
+	return 0;
+}
