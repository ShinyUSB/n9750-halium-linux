+/* Check to see if the GX rail is still powered */
+static bool a6xx_gmu_gx_is_on(struct a6xx_gmu *gmu)
+{
+	u32 val = gmu_read(gmu, REG_A6XX_GMU_SPTPRAC_PWR_CLK_STATUS);
+
+	/*
+	 * IMAGE 226: a reading of 0x0 is NOT proof of life.
+	 *
+	 * captures/221-full.txt shows SPTPRAC==0x0 at every GVIT157 sample
+	 * while clk_summary on that very boot proves the GX clocks were
+	 * unenabled. So the all-clear value is ambiguous on this part --
+	 * it is what the register reads when nobody is driving the FSM.
+	 * Treat it as UNKNOWN and only trust the GX_HM bits when the
+	 * SPTPRAC power FSM itself reports a settled state.
+	 *
+	 * Ground truth for "is GX up" is the clock tree
+	 * (gpu_cc_gx_gmu_clk enable count), not this register.
+	 */
+	if (!(val & (A6XX_GMU_SPTPRAC_PWR_CLK_STATUS_SPTPRAC_GDSC_POWER_ON |
+		     A6XX_GMU_SPTPRAC_PWR_CLK_STATUS_SPTPRAC_GDSC_POWER_OFF)))
+		return false;
+
+	return !(val &
+		(A6XX_GMU_SPTPRAC_PWR_CLK_STATUS_GX_HM_GDSC_POWER_OFF |
+		A6XX_GMU_SPTPRAC_PWR_CLK_STATUS_GX_HM_CLK_OFF));
+}
