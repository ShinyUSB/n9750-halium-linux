+		gpu_write(gpu, REG_A6XX_RBBM_INTERFACE_HANG_INT_CNTL,
+			0x40cfffff);	/* the WORKING device's value */
+	else
+		gpu_write(gpu, REG_A6XX_RBBM_INTERFACE_HANG_INT_CNTL,
