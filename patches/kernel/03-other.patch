+
+/* TEMPORARY image 138 -- REMOVE AFTER RESULT. Attach identity + provider
+ * snapshot. Read-only; proves duplicate-attach origin and dependency
+ * readiness at each attach. */
+static int att138_n;
+
+/* TEMPORARY image 138 -- clocks-gate for prov138 HW reads. GMU CSR /
+ * GDSC / clock-controller reads with clocks off can NoC-fault (TZ
+ * reset, no Linux record). Set on successful enable, cleared on disable.
+ */
+
+static void prov138(struct a6xx_gmu *gmu, const char *tag)
+{
+	struct device *dev = gmu->dev;
+	struct device *parent = dev ? dev->parent : NULL;
+	int i;
+	pr_info("PROV138-%s: dev=%s parent=%s pm_en=%d pm_active=%d usage=%d rpmh_init=%s\n",
+		tag,
+		dev ? dev_name(dev) : "?",
+		parent ? dev_name(parent) : "?",
+		dev ? pm_runtime_enabled(dev) : -1,
+		dev ? pm_runtime_active(dev) : -1,
+		dev ? atomic_read(&dev->power.usage_count) : -1,
+		"n/a-at-probe(rpmh_init runs at trigger)");
+	pr_info("PROV138-%s: cx_reg=%d gx_reg=%d domain=%s cb=%s RPMH_CTRL=0x%x%s\n",
+		tag,
+		gmu_clks_live && gmu->cx ? regulator_is_enabled(gmu->cx) : -1,
+		gmu_clks_live && gmu->gx ? regulator_is_enabled(gmu->gx) : -1,
+		gmu->domain ? "set" : "NULL",
+		gmu->cb_dev ? dev_name(gmu->cb_dev) : "NULL",
+		gmu->mmio && gmu_clks_live ?
+			gmu_read(gmu, REG_A6XX_GMU_RPMH_CTRL) : 0,
+		gmu_clks_live ? "" : " (HW reads skipped, clocks off)");
+	for (i = 0; i < gmu->nr_clocks; i++)
+		pr_info("PROV138-%s: clk[%d]=%s rate=%lu\n", tag, i,
+			gmu->clocks[i].id ? gmu->clocks[i].id : "?",
+			(gmu_clks_live && gmu->clocks[i].clk) ?
+				clk_get_rate(gmu->clocks[i].clk) : 0);
+	pr_info("PROV138-%s: note no-gxpd no-devfreq-target no-qmp links-skipped\n",
+		tag);
+}
