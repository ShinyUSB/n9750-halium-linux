+/* TEMPORARY experiment image 132 -- PROMOTE IF GX TURNS ON. Gated A640
+ * HFI GX_BW_PERF_VOTE probe. Default off (behavior unchanged + logging).
+ * Enable with a6xx.gmu_hfi_probe=1 (MODULE_PARAM_PREFIX is "a6xx.").
+ * Runs after message-level hfi_start success, before set_freq/hw_init.
+ * Uses only existing send/wait/dispatch; no transport/parser change. */
+bool gx_vote_done;
+static bool gmu_hfi_probe;
+bool experimental_nonlegacy;
+bool skip_bw;
+bool hold_boot;
+bool skip_gpuset;
+
+/* TEMPORARY image 156 -- PROMOTE IFF SURVIVAL EXTENDS. Periodic HFI
+ * keepalive: re-sends the proven GX vote on a timer so firmware that
+ * needs ongoing host contact (vs one-shot boot votes) stays alive.
+ * Gated, default off. No other behavior change. */
+static void keepalive156_fn(struct work_struct *work);
+static DECLARE_DELAYED_WORK(keepalive156_work, keepalive156_fn);
+static unsigned long keepalive156_interval_ms = 3000;
+
+/*
+ * TEMPORARY image 157 -- PROMOTE IFF IT CATCHES THE KILLER. GMU-only
+ * vitals: SPTPRAC/RPMH/votes/OOB/IRQ counts every 30s (first +5s).
+ * GMU CSR reads only (never faulted in our history); NO GPU-side reads
+ * (GX-collapse NOC hazard). Armed at every resume end in nonlegacy mode.
+ */
+static void gvitals157_fn(struct work_struct *work);
+static DECLARE_DELAYED_WORK(gvitals157_work, gvitals157_fn);
+static struct a6xx_gmu *gvitals157_gmu;
+
+static void gvitals157_fn(struct work_struct *work)
+{
+	struct a6xx_gmu *gmu = gvitals157_gmu;
+
+	/*
+	 * TEMPORARY image 223 -- poller self-diagnosis.
+	 *
+	 * Image 222 armed this poller and it never printed again, which is
+	 * why GMULIVE/HFI_VERSION went unread. Print BEFORE the NULL check so
+	 * we can distinguish "the work is not running at all" from "the work
+	 * ran but gmu was NULL", and always re-arm so one miss cannot silence
+	 * it permanently. Cheap enough to leave in: one line per 30s.
+	 */
+	pr_info("GVITTICK: fired, gmu=%px\n", (void *)gmu);
+
+	if (!gmu) {
+		schedule_delayed_work(&gvitals157_work,
+			msecs_to_jiffies(30000));
+		return;
+	}
+	/*
+	 * TEMPORARY image 222 -- GMU LIVENESS.
+	 *
+	 * Root cause: the GX (graphics) clock domain is OFF
+	 * (gpu_cc_gx_gmu_clk en=0, gcc_gpu_gpll0_clk_src en=0), so the RB/SP
+	 * never run and nothing is ever written. GXVOTE reads 0 even though
+	 * VOTE151 wrote gx=0x9, and the OOB that should raise the GX rail
+	 * times out ("POST_START: oob GPU_SET ack-wait TIMEOUT").
+	 *
+	 * a640_gmu.bin is byte-identical to stock (sha256 3ff0c027...d2), so
+	 * the firmware IMAGE is not the problem. Open question: is the GMU
+	 * firmware EXECUTING at all?
+	 *
+	 * HFI_VERSION_INFO (0x5181) is the GMU's own version handshake reply.
+	 * A live GMU answers with a real version; a dead GMU returns 0 or
+	 * 0xffffffff. If it reads 0/0xffffffff the firmware is not running and
+	 * nothing host-side can fix it.
+	 */
+	pr_info("GMULIVE: HFI_VER=0x%x OOB_G2H_INFO=0x%x OOB_G2H_MASK=0x%x OOB_H2G_RAW=0x%x OOB_H2G_SET=0x%x GX_VOTE=0x%x MX_VOTE=0x%x SPTPRAC_PWR=0x%x\n",
+		gmu_read(gmu, REG_A6XX_GMU_HFI_VERSION_INFO),
+		gmu_read(gmu, REG_A6XX_GMU_GMU2HOST_INTR_INFO),
+		gmu_read(gmu, REG_A6XX_GMU_GMU2HOST_INTR_MASK),
+		gmu_read(gmu, REG_A6XX_GMU_HOST2GMU_INTR_RAW_INFO),
+		gmu_read(gmu, REG_A6XX_GMU_HOST2GMU_INTR_SET),
+		gmu_read(gmu, REG_A6XX_GMU_GX_VOTE_IDX),
+		gmu_read(gmu, REG_A6XX_GMU_MX_VOTE_IDX),
+		gmu_read(gmu, REG_A6XX_GMU_SPTPRAC_PWR_CLK_STATUS));
+
+	pr_info("GVIT157: SPTPRAC=0x%x RPMHPWR=0x%x GXVOTE=0x%x MXVOTE=0x%x OOB_H2G=0x%x OOB_G2H=0x%x hfi_irq=%lu gmu_irq=%lu\n",
+		gmu_read(gmu, REG_A6XX_GMU_SPTPRAC_PWR_CLK_STATUS),
+		gmu_read(gmu, REG_A6XX_GPU_GMU_CX_GMU_RPMH_POWER_STATE),
+		gmu_read(gmu, REG_A6XX_GMU_GX_VOTE_IDX),
+		gmu_read(gmu, REG_A6XX_GMU_MX_VOTE_IDX),
+		gmu_read(gmu, REG_A6XX_GMU_HOST2GMU_INTR_RAW_INFO),
+		gmu_read(gmu, REG_A6XX_GMU_GMU2HOST_INTR_INFO),
+		bw124_hfi_irqs, bw124_gmu_irqs);
+
+	/*
+	 * IMAGE 225 -- RPMh/TCS vitals. NEVER DUMPED IN 224 IMAGES.
+	 *
+	 * Every previous document cited "RPMH_CTRL_GFX_VOTE_ENABLE is set" as
+	 * evidence that the GMU votes GX up. Setting the vote *interface* is
+	 * not evidence that a vote was ever *issued*. These are the registers
+	 * that actually witness a vote transaction:
+	 *
+	 *   TCS0..3_DRV0_STATUS  bit0 = transaction in flight
+	 *   RSCC_SEQ_BUSY_DRV0   RSC sequencer busy
+	 *   RSC_STATUS0_DRV0     RSC machine state, incl. bit24 (SDE gating)
+	 *   GX_GDSCR             the GX GDSC soft-reset/retention register --
+	 *                       the host-visible shadow of the rail state that
+	 *                       SPTPRAC_PWR_CLK_STATUS reports as GX_HM_* bits
+	 *   RPMH_CTRL            confirm GFX_VOTE_ENABLE survived
+	 *
+	 * If after the GX vote TCS bits are still 0 and RSC_STATUS0 stays put,
+	 * the firmware never issued a vote and the break is below the GMU.
+	 * If they move, the vote went out and the break is AOP-side.
+	 */
+	pr_info("RPV225: TCS0=0x%x TCS1=0x%x TCS2=0x%x TCS3=0x%x SEQ_BUSY=0x%x RSC0=0x%x GX_GDSCR=0x%x RPMH_CTRL=0x%x\n",
+		gmu_read(gmu, REG_A6XX_RSCC_TCS0_DRV0_STATUS),
+		gmu_read(gmu, REG_A6XX_RSCC_TCS1_DRV0_STATUS),
+		gmu_read(gmu, REG_A6XX_RSCC_TCS2_DRV0_STATUS),
+		gmu_read(gmu, REG_A6XX_RSCC_TCS3_DRV0_STATUS),
+		gmu_read(gmu, REG_A6XX_RSCC_SEQ_BUSY_DRV0),
+		gmu_read(gmu, REG_A6XX_GPU_RSCC_RSC_STATUS0_DRV0),
+		gmu_read(gmu, REG_A6XX_GPU_CC_GX_GDSCR),
+		gmu_read(gmu, REG_A6XX_GMU_RPMH_CTRL));
+
+	schedule_delayed_work(&gvitals157_work, msecs_to_jiffies(30000));
+}
+
+static void keepalive156_fn(struct work_struct *work)
+{
+	extern struct a6xx_gmu *keepalive156_gmu;
+	struct a6xx_gmu *gmu = keepalive156_gmu;
+	int ret;
+
+	if (!gmu)
+		return;
+	pr_info("KEEPALIVE156: re-vote enter\n");
+	/*
+	 * TEMPORARY image 158 -- PROMOTE IFF SURVIVAL EXTENDS. Vote LOW
+	 * (index 1, 257MHz) instead of max: if deaths are power/heat from
+	 * sustained 675MHz clocks, downclocking right after boot should
+	 * extend survival. Contact-keeping is unchanged (still periodic).
+	 */
+	ret = a6xx_hfi_send_gx_vote(gmu, 1, 1, 0);
+	pr_info("KEEPALIVE156: re-vote ret=%d\n", ret);
+	bc132("KEEPALIVE", ret);
+	schedule_delayed_work(&keepalive156_work,
+		msecs_to_jiffies(keepalive156_interval_ms));
+}
+/* IMAGE 231: KGSL gates this on ADRENO_QUIRK_LIMIT_UCHE_GBIF_RW, a DT quirk whose value
+ * we do not know. Default off rather than invent a condition. */
+bool uche_gbif_rw;
+bool a6xx_selftest;
+int secure_probe;
+/* IMAGE 273: force the SECVID_TRUST_CNTL write independently of the
+ * HFI path (a6xx.experimental_nonlegacy), which otherwise skips it.
+ */
+int secvid;
+/* IMAGE 277: do what stock KGSL and mainline a5xx do -- leave secure mode
+ * by asking the CP to write RBBM_SECVID_TRUST_CNTL, not by writing it from
+ * the host.  See adreno.c:1870 (KGSL) and a5xx_gpu.c:578 (mainline).
+ */
+int cp_secure_off;
+/* IMAGE 279: write CAF's zeros into the UCHE's address filters
+ * (WRITE_RANGE_MAX / TRAP_BASE / WRITE_THRU_BASE) instead of upstream's
+ * values.  The CP's writes work; the shader domain's do not, and these
+ * registers are the UCHE's own write-address limits.
+ */
+int uche_filter_clear;
+/* IMAGE 280: use the a640 value of PC_DBG_ECO_CNTL (0x00200200) instead of
+ * the generic one (0x00180000) -- upstream commit 564499f5ddbb.
+ */
+int pc_eco_a640;
+/* IMAGE 285: use CAF's CP_PROTECT table verbatim. */
+int cp_protect_caf;
+/* IMAGE 286: match the WORKING device's init-time register values. */
+int reg_match = 1;
+/* IMAGE 282: program the UCHE's GMEM window with CAF's formula. */
+int gmem_window = -1;
+
+static void gx132_snap(struct a6xx_gmu *gmu, const char *tag)
+{
+	pr_info("GX132-%s: SPTPRAC=0x%x RPMHPWR=0x%x GXVOTE=0x%x MXVOTE=0x%x GXGDSCR=0x%x RB_BASE=0x%llx RB_CNTL=0x%x RPTR=0x%x WPTR=0x%x\n",
+		tag,
+		gmu_read(gmu, REG_A6XX_GMU_SPTPRAC_PWR_CLK_STATUS),
+		gmu_read(gmu, REG_A6XX_GPU_GMU_CX_GMU_RPMH_POWER_STATE),
+		gmu_read(gmu, REG_A6XX_GMU_GX_VOTE_IDX),
+		gmu_read(gmu, REG_A6XX_GMU_MX_VOTE_IDX),
+		gmu_read(gmu, REG_A6XX_GPU_CC_GX_GDSCR),
+		(unsigned long long)gpu_read64(&container_of(gmu, struct a6xx_gpu, gmu)->base.base, REG_A6XX_CP_RB_BASE, REG_A6XX_CP_RB_BASE_HI),
+		gpu_read(&container_of(gmu, struct a6xx_gpu, gmu)->base.base, REG_A6XX_CP_RB_CNTL),
+		gpu_read(&container_of(gmu, struct a6xx_gpu, gmu)->base.base, REG_A6XX_CP_RB_RPTR),
+		gpu_read(&container_of(gmu, struct a6xx_gpu, gmu)->base.base, REG_A6XX_CP_RB_WPTR));
+}
+
+static int a6xx_gmu_hfi_vote_probe(struct a6xx_gmu *gmu)
+{
+	int idx, ret;
+
+	if (gmu->nr_gpu_freqs <= 0) {
+		pr_info("GX132-PROBE-SKIP: nr_gpu_freqs=%d, no index to vote\n",
+			gmu->nr_gpu_freqs);
+		return 0;
+	}
+	idx = gmu->nr_gpu_freqs - 1;
+
+	gx132_snap(gmu, "PRE");
+	pr_info("GX132-VOTE: send ack_type=1 freq=%d(idx) bw=0\n", idx);
+	ret = a6xx_hfi_send_gx_vote(gmu, 1, (u32)idx, 0);
+	pr_info("GX132-VOTE: hfi_ret=%d\n", ret);
+	gx132_snap(gmu, "POST");
+	udelay(100);
+	gx132_snap(gmu, "PLUS100US");
+	usleep_range(1000, 1100);
+	gx132_snap(gmu, "PLUS1MS");
+	usleep_range(10000, 10200);
+	gx132_snap(gmu, "PLUS10MS");
+	if (!ret) {
+		gx_vote_done = true;
+		if (keepalive156) {
+			keepalive156_gmu = gmu;
+			schedule_delayed_work(&keepalive156_work,
+				msecs_to_jiffies(keepalive156_interval_ms));
+			pr_info("KEEPALIVE156: armed (10s period)\n");
+		}
+	}
+	return ret;
+}
+int a6xx_gmu_resume(struct a6xx_gpu *a6xx_gpu)
+{
+	struct a6xx_gmu *gmu = &a6xx_gpu->gmu;
+	int status, ret;
+
+	if (WARN(!gmu->mmio, "The GMU is not set up yet\n"))
+		return 0;
+
+	/*
+	 * IMAGE 230: ACD notification to AOP, FIRST -- matching KGSL's
+	 * gmu_start() ordering exactly (kgsl_gmu.c:1644), which does this
+	 * before gmu_enable_gdsc(), gmu_enable_clks() and the RPMh/GX vote.
+	 * It must precede everything: the host is telling the Always-On
+	 * Processor that the GPU's clock distribution is live before any
+	 * power or clock resource is touched.
+	 */
+	if (a6xx_gmu_send_acd_state(gmu, true))
+		pr_info("ACD230: AOP ACD-enable notification FAILED (channel unavailable or link down)\n");
+
+	/* Turn on the resources */
+	pr_info("GMU_PM: gmu->dev=%s gxpd=NULL (no gxpd in this tree; upstream takes a second runtime-PM ref)\n",
+		dev_name(gmu->dev));
+	bc132("RESUME_ENTRY", 0);
+	pr_info("GMU_PM: gmu_dev_runtime_enabled=%d\n",
+		pm_runtime_enabled(gmu->dev));
+	pm_runtime_get_sync(gmu->dev);
+	pr_info("GMU_PM: pm_runtime_get_sync(gmu->dev) done\n");
+	A6XX_TRACE("pm_runtime_get_sync done");
+
+	/*
+	 * Minimal equivalent of vendor KGSL gmu_enable_gdsc(), which runs
+	 * before gmu_enable_clks() in every gmu_start() state (INIT/SUSPEND/
+	 * SLUMBER/RESET). regulator_enable() is refcounted, so calling it on
+	 * an already-enabled rail only bumps the count -- safe either way.
+	 */
+	A6XX_TRACE("before CX GDSC enable (cx=%px already=%d)",
+		gmu->cx, gmu->cx ? regulator_is_enabled(gmu->cx) : -1);
+	if (gmu->cx) {
+		ret = regulator_enable(gmu->cx);
+		A6XX_TRACE("after CX GDSC enable (ret=%d already=%d)", ret,
+			regulator_is_enabled(gmu->cx));
+		if (ret)
+			goto out;
+	} else {
+		A6XX_TRACE("CX GDSC enable skipped (no regulator)");
+	}
+
+	/*
+	 * IMAGE 274c -- the one regulator operation KGSL does that this driver
+	 * has never done.
+	 *
+	 * Everything else in the KGSL power sequence has already been ported and
+	 * exercised (image 273's dmesg, in order):
+	 *
+	 *   ACD230: '{class: gpu, res: acd, value: 1}' ret=0   (KGSL step 1)
+	 *   GXVOTE225: idx=6/7 legacy=0 -> SPTPRAC=0xc0 GX_GDSCR=0x222001
+	 *   GXGDSC226: regulator_enable(vdd/gpu_gx_gdsc) ret=0 already=1
+	 *   GXCLK229: clk_prepare_enable(gpu_cc_gx_gmu_clk) ret=0 rate=200000000
+	 *   + the DDR/CNOC bus vote: msm_bus_scale_client_update_request(bw_pcl, 4)
+	 *     immediately before FW_START (a6xx_gmu.c:2139-2141)
+	 *
+	 * So the CX GDSC is ENABLED, the GX GDSC is enabled, both clocks are on,
+	 * the AOP has been told, the interconnect is voted -- and the GPU still
+	 * writes nothing.
+	 *
+	 * What is missing is the CX GDSC's MODE.  KGSL sets it:
+	 *
+	 *   kgsl_gmu.c:1599  regulator_set_mode(gmu->cx_gdsc, REGULATOR_MODE_IDLE);
+	 *   kgsl_gmu.c:1604  regulator_set_mode(gmu->cx_gdsc, REGULATOR_MODE_NORMAL);
+	 *
+	 * and, because the DT sets qcom,gpu-quirk-cx-gdsc, KGSL then answers
+	 * "is the CX domain on" from the regulator's own state rather than from
+	 * the register (adreno_a6xx_gmu.c:842-846).  This driver parses no
+	 * gpu-quirk property at all and never calls regulator_set_mode().
+	 *
+	 * The mode is what tells the PMIC how hard the GPU domain may be driven;
+	 * on this part the CX GDSC left in its default/IDLE mode is a plausible
+	 * reason for the GX side to stay quiescent even with every gate and
+	 * clock nominally open.
+	 *
+	 * MEASUREMENT, not a fix.  It prints the regulator's own view before and
+	 * after, plus the GX GDSC and SPTPRAC registers, so one boot gives an
+	 * A/B.  The CX_GDSCR register (0x2441B) is deliberately not read: it
+	 * lives in the GPU_CC window, not the GMU's, and this tree has no accessor
+	 * for it (and the project has already established that CPU-side GPU
+	 * registers on this part are context-banked and unreliable -- image 263).
+	 */
+	if (cxgdm) {
+		bool quirk = false;
+		struct msm_drm_private *priv = NULL;
+		struct device_node *gpu_node = NULL;
+		unsigned int mode = cxgdm;
+
+		/*
+		 * IMAGE 275 FIX: the quirk property lives on the GPU node
+		 * (qcom,kgsl-3d0), NOT on the GMU node (qcom,gpu-gmu):
+		 *
+		 *   sm8150-gpu.dtsi:116   qcom,gpu-quirk-cx-gdsc;   <- GPU node
+		 *   sm8150-gpu.dtsi:175   regulator-names = "vddcx", "vdd";
+		 *   sm8150-gpu.dtsi:403   regulator-names = "vddcx", "vdd";  <- GMU node
+		 *
+		 * Image 274 read it from gmu->dev->of_node (the GMU node)
+		 * and got 0.  KGSL reads it from the adreno device node.
+		 */
+		if (a6xx_gpu->base.base.dev && a6xx_gpu->base.base.dev->dev_private)
+			priv = a6xx_gpu->base.base.dev->dev_private;
+		if (priv && priv->gpu_pdev)
+			gpu_node = priv->gpu_pdev->dev.of_node;
+		if (gpu_node)
+			quirk = of_property_read_bool(gpu_node,
+					"qcom,gpu-quirk-cx-gdsc");
+
+		pr_info("CXMODE274: cx=%px gpu_node=%px quirk(cx-gdsc)=%d mode=%u\n",
+			(void *)gmu->cx, (void *)gpu_node, quirk, mode);
+
+		if (gmu->cx) {
+			pr_info("CXMODE274: before: enabled=%d mode=%d\n",
+				regulator_is_enabled(gmu->cx),
+				regulator_get_mode(gmu->cx));
+			ret = regulator_set_mode(gmu->cx, mode);
+			pr_info("CXMODE274: regulator_set_mode(vddcx, %u) = %d\n",
+				mode, ret);
+			pr_info("CXMODE274: after: enabled=%d mode=%d\n",
+				regulator_is_enabled(gmu->cx),
+				regulator_get_mode(gmu->cx));
+		} else {
+			pr_info("CXMODE274: no vddcx regulator, nothing to do\n");
+		}
+
+		/* give the PMIC a real window before sampling */
+		msleep(20);
+
+		pr_info("CXMODE274: +20ms SPTPRAC=0x%x GX_GDSCR=0x%x TCS0=0x%x RSC0=0x%x RPMHPWR=0x%x gx_is_on=%d\n",
+			gmu_read(gmu, REG_A6XX_GMU_SPTPRAC_PWR_CLK_STATUS),
+			gmu_read(gmu, REG_A6XX_GPU_CC_GX_GDSCR),
+			gmu_read(gmu, REG_A6XX_RSCC_TCS0_DRV0_STATUS),
+			gmu_read(gmu, REG_A6XX_GPU_RSCC_RSC_STATUS0_DRV0),
+			gmu_read(gmu, REG_A6XX_GPU_GMU_CX_GMU_RPMH_POWER_STATE),
+			a6xx_gmu_gx_is_on(gmu));
+	}
+
+	/* Use a known rate to bring up the GMU */
+	clk_set_rate(gmu->core_clk, 200000000);
+	A6XX_TRACE("clk_set_rate done");
+	a6xx_gmu_scratch_check(gmu, "pre-clocks");
+	A6XX_TRACE("before clk_bulk_prepare_enable");
+	pr_info("GMU_PM: clk_bulk_prepare_enable(nr=%d) enter\n",
+		gmu->nr_clocks);
+	ret = a6xx_gmu_clk_bulk_prepare_enable_traced(gmu->nr_clocks,
+			gmu->clocks);
+	A6XX_TRACE("clocks enabled (ret=%d)", ret);
+	if (!ret)
+		gmu_clks_live = true;
+	a6xx_gmu_scratch_check(gmu, "post-clocks");
+	if (ret)
+		goto out;
+
+	A6XX_TRACE("before GMU IRQ enable");
+	a6xx_gmu_irq_enable(gmu);
+	A6XX_TRACE("GMU IRQ enabled");
+
+	/* Check to see if we are doing a cold or warm boot */
+	status = gmu_read(gmu, REG_A6XX_GMU_GENERAL_7) == 1 ?
+		GMU_WARM_BOOT : GMU_COLD_BOOT;
+
+	/*
+	 * IMAGE 225 -- RESTORED from upstream v5.8 a6xx_gmu_resume().
+	 *
+	 * "Warm boot path does not work on newer GPUs. Presumably this is
+	 * because icache/dcache regions must be restored."
+	 *
+	 * Our port dropped this override, so it trusted GENERAL_7 alone. But
+	 * our own cold-boot fw_start sets GENERAL_7=1, so every resume after
+	 * the first selected WARM and skipped the firmware reload. That is a
+	 * second, independent way GX never comes up on a retried resume.
+	 */
+	if (!gmu->legacy)
+		status = GMU_COLD_BOOT;
+
+	A6XX_TRACE("boot status read (%s)",
+		status == GMU_WARM_BOOT ? "warm" : "cold");
+
+	/*
+	 * Minimal equivalent of vendor KGSL gmu_start(): DDR bandwidth vote
+	 * immediately before FW_START. KGSL votes
+	 * msm_bus_scale_client_update_request(gmu->pcl,
+	 * pwr->pwrlevels[default].bus_freq) with the comment "Vote for 300MHz
+	 * DDR for GMU to init"; on sm8150 grp3d that is index 4 (bus=300).
+	 * Observation only beyond the vote itself.
+	 */
+	A6XX_TRACE("before DDR vote (pcl=%u)", gmu->bw_pcl);
+	if (gmu->bw_pcl) {
+		ret = msm_bus_scale_client_update_request(gmu->bw_pcl, 4);
+		A6XX_TRACE("after DDR vote (ret=%d)", ret);
+		if (ret)
+			goto out;
+	} else {
+		A6XX_TRACE("DDR vote skipped (no bus client)");
+	}
+
+	/*
+	 * TEMPORARY SMMU/map diagnostics -- REMOVE ONCE FAULT IS UNDERSTOOD.
+	 *
+	 * The ARM SMMU reports faults by internal cbndx (cb=1 = second CB
+	 * allocated on kgsl-smmu, NOT hardware CB 5), so log our address
+	 * spaces by device + domain + aperture + fwspec SIDs, plus every GMU
+	 * buffer IOVA, before the GMU touches DMA.
+	 */
+	{
+		struct a6xx_gpu *ag = container_of(gmu, struct a6xx_gpu, gmu);
+		struct adreno_gpu *ad = &ag->base;
+		struct drm_device *drm = ad->base.dev;
+		struct msm_drm_private *priv = drm ? drm->dev_private : NULL;
+		struct msm_gpu *gpu = priv ? priv->gpu : NULL;
+		struct iommu_fwspec *fs;
+		int i;
+
+		A6XX_TRACE("SMMU gmu domain=%px dev=%s aperture=%llx-%llx",
+			gmu->domain, gmu->cb_dev ? dev_name(gmu->cb_dev) : "?",
+			gmu->domain ? gmu->domain->geometry.aperture_start : 0,
+			gmu->domain ? gmu->domain->geometry.aperture_end : 0);
+		if (gmu->cb_dev && gmu->cb_dev->iommu_fwspec) {
+			fs = gmu->cb_dev->iommu_fwspec;
+			for (i = 0; i < fs->num_ids; i++)
+				A6XX_TRACE("SMMU gmu fwspec SID[%d]=0x%x",
+					i, fs->ids[i]);
+		}
+		if (gpu && gpu->aspace)
+			A6XX_TRACE("SMMU gpu aspace=%px dev=%s",
+				gpu->aspace,
+				priv->gpu_pdev ? dev_name(&priv->gpu_pdev->dev) : "?");
+		if (priv && priv->gpu_pdev &&
+		    priv->gpu_pdev->dev.iommu_fwspec) {
+			fs = priv->gpu_pdev->dev.iommu_fwspec;
+			for (i = 0; i < fs->num_ids; i++)
+				A6XX_TRACE("SMMU gpu fwspec SID[%d]=0x%x",
+					i, fs->ids[i]);
+		}
+	}
+#define A6XX_BO_LOG(tag, bo) do { \
+		if (bo) \
+			A6XX_TRACE("SMMU map " tag " iova=0x%llx size=0x%zx %s", \
+				(unsigned long long)(bo)->iova, (bo)->size, \
+				IS_ERR(bo) ? "ERR" : "ok"); \
+		else \
+			A6XX_TRACE("SMMU map " tag " NULL"); \
+	} while (0)
+	A6XX_BO_LOG("itcmhole", gmu->itcm_hole);
+	A6XX_BO_LOG("hfi", gmu->hfi);
+	A6XX_BO_LOG("icache", gmu->icache);
+	A6XX_BO_LOG("dcache", gmu->dcache);
+	A6XX_BO_LOG("debug", gmu->debug);
+	A6XX_BO_LOG("dummy", gmu->dummy);
+	A6XX_BO_LOG("sentinel", gmu->sentinel);
+	A6XX_BO_LOG("log", gmu->log);
+#undef A6XX_BO_LOG
+
+	/*
+	 * TEMPORARY image 142 -- PROMOTE IF STABLE. Bounded retry beats the
+	 * firmware lottery (BADDFACE/NACK/silence): attempt 0 is the exact old
+	 * path; attempts 1-2 run the proven a6xx_gmu_reset() teardown+reboot
+	 * (fw RESET + hfi COLD_BOOT inside). Success path byte-identical.
+	 */
+	ret = -ETIMEDOUT;
+	{
+		int attempt;
+		for (attempt = 0; attempt < (recover166_fast ? 1 : 3); attempt++) {
+			if (attempt == 0) {
+				pr_info("A6XX_SNAPSHOT: FW_START state=%d\n", status);
+				pr_info("POST_START: fw_start begin\n");
+				A6XX_TRACE("before firmware start");
+				ret = a6xx_gmu_fw_start(gmu, status);
+				pr_info("POST_START: fw_start end ret=%d\n", ret);
+				A6XX_TRACE("fw_start returned (ret=%d)", ret);
+				if (ret)
+					goto next_attempt;
+
+				a6xx_gmu_bootstrap_active = true;
+				pr_info("=== GMU BOOTSTRAP BEGIN ===\n");
+				ret = a6xx_hfi_start(gmu, status);
+				a6xx_gmu_bootstrap_active = false;
+				pr_info("=== GMU BOOTSTRAP END ===\n");
+				A6XX_TRACE("hfi_start returned (ret=%d)", ret);
+			} else {
+				pr_info("RETRY142: attempt %d/2 after ret=%d\n",
+					attempt, ret);
+				bc132("RETRY", ret);
+				ret = a6xx_gmu_reset(a6xx_gpu);
+				pr_info("RETRY142: reset returned ret=%d\n", ret);
+			}
+			if (ret)
+				goto next_attempt;
+
+			/*
+			 * TEMPORARY image 132 gated probe + image 137 nonlegacy
+			 * mode.
+			 *
+			 * TEMPORARY image 194 -- PROMOTE IF THE RING APPEARS.
+			 *
+			 * This probe is an INSTRUMENT, not a bring-up
+			 * requirement. It used to be able to fail the bring-up,
+			 * and that is what stopped the GPU ever working.
+			 *
+			 * Observed on image 193:
+			 *
+			 *   fw_start end ret=0                 <- attempt 0 OK
+			 *   ... hfi_vote_probe fails ...
+			 *   GMU firmware initialization timed out
+			 *   after GMU start (ret=-110)         <- attempt 1
+			 *   BC132: ev=RESUME_RETURN ret=-110
+			 *   A6XX_DIAG: hw_init suppressed after GMU boot error -110
+			 *
+			 * A perfectly healthy GMU was booted (GOOD BABEFACE,
+			 * HFISTAT=0x1), a diagnostic vote probe failed, and the
+			 * loop then re-ran fw_start on the already-running GMU.
+			 * That retry timed out, the -110 latched
+			 * a6xx_gmu_boot_error in a6xx_pm_resume, and
+			 * msm_gpu_hw_init() skips hw_init while that is set -- so
+			 * the ring was never programmed (rb_iova=0x0, RB_BASE=0x0,
+			 * no RINGHW[] lines, "CP is NOT CLOCKING") even though
+			 * GL_RENDERER read FD640 and every GEM_SUBMIT returned 0.
+			 *
+			 * That is the entire reason wptr_dw stayed 0.
+			 *
+			 * Fix: log a probe failure and keep the successful fw_start
+			 * result instead of discarding it and retrying. bring-up is
+			 * already complete at this point; a failed read-only vote
+			 * probe must not undo it.
+			 */
+			if (gmu_hfi_probe || experimental_nonlegacy) {
+				int probe_ret = a6xx_gmu_hfi_vote_probe(gmu);
+
+				if (probe_ret && !ret) {
+					pr_info("A6XX_DIAG: hfi_vote_probe failed (%d) "
+						"-- keeping successful fw_start, "
+						"NOT retrying (image 194)\n",
+						probe_ret);
+				}
+			}
+
+			break;
+next_attempt:;
+		}
+	}
+	if (ret)
+		goto out;
+
+	/*
+	 * TEMPORARY image 140 -- PROMOTE IF STICKY. Nonlegacy mode keeps the
+	 * DCVS register writes (proven load-bearing: 133/136/138 sticky runs
+	 * all executed them; 137-att5 skipped them -> void). The OOB ack
+	 * timeout inside set_freq is harmless (all sticky runs had it).
+	 */
+	if (experimental_nonlegacy)
+		pr_info("NONLEGACY140: running legacy DCVS set_freq for its register writes (OOB result ignored as before)\n");
+	/* Set the GPU to the highest power frequency */
+	a6xx_gmu_set_freq(gmu, gmu->nr_gpu_freqs - 1);
+	A6XX_TRACE("set_freq done");
+
+	/*
+	 * IMAGE 225: immediate readback around the GX vote. This is the first
+	 * point in the whole project where we can see whether the vote had any
+	 * effect. Compare SPTPRAC / GX_GDSCR before (a6xx_gmu_resume entry) with
+	 * the values here, and GXSTATE ~1ms after via the poller.
+	 */
+	pr_info("GXVOTE225: idx=%d/%d legacy=%d -> SPTPRAC=0x%x GX_GDSCR=0x%x TCS0=0x%x RSC0=0x%x RPMHPWR=0x%x\n",
+		gmu->nr_gpu_freqs - 1, gmu->nr_gpu_freqs, gmu->legacy,
+		gmu_read(gmu, REG_A6XX_GMU_SPTPRAC_PWR_CLK_STATUS),
+		gmu_read(gmu, REG_A6XX_GPU_CC_GX_GDSCR),
+		gmu_read(gmu, REG_A6XX_RSCC_TCS0_DRV0_STATUS),
+		gmu_read(gmu, REG_A6XX_GPU_RSCC_RSC_STATUS0_DRV0),
+		gmu_read(gmu, REG_A6XX_GPU_GMU_CX_GMU_RPMH_POWER_STATE));
+
+	/*
+	 * IMAGE 226 -- THE DECISIVE EXPERIMENT. gpu_cc_gx_gmu_clk is still
+	 * en=0 after a correct, acked GX vote. Last remaining blocker.
+	 *
+	 * gpu_gx_gdsc is a REAL power domain, not a placeholder:
+	 *   sm8150-gdsc.dtsi:228  qcom,gdsc@0x2c9100c, sw-reset, domain-addr
+	 *   sm8150.dtsi:4121      status="ok", parent-supply=<&pm8150l_s2_level>
+	 * i.e. a genuine PMIC rail behind a GDSC CSR. We hold the handle
+	 * (devm_regulator_get(gmu->dev,"vdd")) and have NEVER enabled it --
+	 * resume enables CX only. IMAGE-83-84-RESULTS.md proposed exactly this
+	 * a hundred images ago; KGSL-DRM-POWER-COMPARE.md later closed it on
+	 * the claim that GX comes up via GMU/RPMh alone. That claim is now
+	 * testable, because the GMU/RPMh path has actually been exercised and
+	 * the gate is still shut.
+	 *
+	 * Placed AFTER the GXVOTE225 print so that print captures the clean
+	 * pre-enable state and this block captures the post-enable state: one
+	 * boot gives an A/B. Modelled on upstream's gmu_gxpd_get(), whose own
+	 * comment says the A6x/A7x host vote "won't actually do anything but
+	 * ... make sure that the refcounting is correct".
+	 *
+	 * Interpretation:
+	 *   GXGDSCR / SPTPRAC move  -> the rail IS host-reachable; the break is
+	 *                              strictly in the GMU->AOP path.
+	 *   nothing moves           -> the host cannot reach it at all, and the
+	 *                              AOP/QMP ACD notification is the fix.
+	 */
+	if (gmu->gx && !IS_ERR(gmu->gx) && enable_gx_gdsc) {
+		int gxret = regulator_enable(gmu->gx);
+
+		pr_info("GXGDSC226: regulator_enable(vdd/gpu_gx_gdsc) ret=%d already=%d\n",
+			gxret, regulator_is_enabled(gmu->gx));
+		gmu->gx_gdsc_enabled = !gxret;
+
+		/* give the rail/sequencer a real window before sampling */
+		msleep(5);
+
+		pr_info("GXGDSC226: +5ms SPTPRAC=0x%x GX_GDSCR=0x%x TCS0=0x%x RSC0=0x%x RPMHPWR=0x%x gx_is_on=%d\n",
+			gmu_read(gmu, REG_A6XX_GMU_SPTPRAC_PWR_CLK_STATUS),
+			gmu_read(gmu, REG_A6XX_GPU_CC_GX_GDSCR),
+			gmu_read(gmu, REG_A6XX_RSCC_TCS0_DRV0_STATUS),
+			gmu_read(gmu, REG_A6XX_GPU_RSCC_RSC_STATUS0_DRV0),
+			gmu_read(gmu, REG_A6XX_GPU_GMU_CX_GMU_RPMH_POWER_STATE),
+			a6xx_gmu_gx_is_on(gmu));
+	} else {
+		pr_info("GXGDSC226: skipped (handle %px, module param off)\n",
+			(void *)gmu->gx);
+	}
+
+	/*
+	 * IMAGE 229: enable the GX clock through the CLK FRAMEWORK.
+	 *
+	 * Images 227/228/229-previous each tried to poke the gate register
+	 * directly and all three failed for different reasons (of_iomap
+	 * garbage, -EBUSY, devm_ioremap garbage), twice Oopsing
+	 * a6xx_gmu_resume. Worse, the premise was wrong: I took the offset
+	 * 0x162 / mask 0x0F from debugcc-sm8150.c, which is a *measurement*
+	 * register. The real gate is in drivers/clk/qcom/gpucc-sm8150.c:
+	 *
+	 *   static struct clk_branch gpu_cc_gx_gmu_clk = {
+	 *           .enable_reg = 0x1064, .enable_mask = BIT(0), ...
+	 *
+	 * So: add GPU_CC_GX_GMU_CLK to the GMU node (done in
+	 * sm8150-gpu.dtsi) and let the clk driver enable it properly --
+	 * correct register, correct parent chain (gpu_cc_gx_gmu_clk_src),
+	 * correct refcounting. No raw MMIO, no resource conflicts.
+	 *
+	 * This is still a DIAGNOSTIC: if the fence now completes, the
+	 * firmware simply never opens this gate and the fix is the AOP/QMP
+	 * ACD notification. If the fence still hangs, the break is deeper
+	 * than power and the entire power story was a red herring.
+	 */
+	if (force_gx_clk) {
+		struct clk *gx;
+
+		gx = devm_clk_get(gmu->dev, "gx_gmu_clk");
+		if (IS_ERR(gx)) {
+			pr_info("GXCLK229: devm_clk_get(gx_gmu_clk) failed %ld\n",
+				PTR_ERR(gx));
+		} else {
+			int cret = clk_prepare_enable(gx);
+
+			pr_info("GXCLK229: clk_prepare_enable(gpu_cc_gx_gmu_clk) ret=%d rate=%lu\n",
+				cret, clk_get_rate(gx));
+
+			/* give the domain a real window before sampling */
+			msleep(20);
+
+			pr_info("GXCLK229: +20ms SPTPRAC=0x%x GX_GDSCR=0x%x TCS0=0x%x RSC0=0x%x RPMHPWR=0x%x gx_is_on=%d\n",
+				gmu_read(gmu, REG_A6XX_GMU_SPTPRAC_PWR_CLK_STATUS),
+				gmu_read(gmu, REG_A6XX_GPU_CC_GX_GDSCR),
+				gmu_read(gmu, REG_A6XX_RSCC_TCS0_DRV0_STATUS),
+				gmu_read(gmu, REG_A6XX_GPU_RSCC_RSC_STATUS0_DRV0),
+				gmu_read(gmu, REG_A6XX_GPU_GMU_CX_GMU_RPMH_POWER_STATE),
+				a6xx_gmu_gx_is_on(gmu));
+		}
+	}
+
+	/*
+	 * IMAGE 226: dump both sides of the OOB channel and clear a stale
+	 * host request. REG_A6XX_GMU_HOST2GMU_INTR_CLR (0x5195) is written
+	 * NOWHERE in this tree, so bit 16 -- set since image 1 and never
+	 * consumed -- has been un-retractable for the life of the project.
+	 */
+	{
+		u32 h2g = gmu_read(gmu, REG_A6XX_GMU_HOST2GMU_INTR_RAW_INFO);
+
+		pr_info("OOBDIAG226: H2G_RAW=0x%08x G2H_INFO=0x%08x G2H_SET=0x%08x G2H_MASK=0x%08x AO_STATUS=0x%08x\n",
+			h2g,
+			gmu_read(gmu, REG_A6XX_GMU_GMU2HOST_INTR_INFO),
+			gmu_read(gmu, REG_A6XX_GMU_GMU2HOST_INTR_SET),
+			gmu_read(gmu, REG_A6XX_GMU_GMU2HOST_INTR_MASK),
+			gmu_read(gmu, REG_A6XX_GMU_AO_HOST_INTERRUPT_STATUS));
+
+		if (h2g) {
+			gmu_write(gmu, REG_A6XX_GMU_HOST2GMU_INTR_CLR, h2g);
+			pr_info("OOBDIAG226: wrote HOST2GMU_INTR_CLR=0x%08x -> H2G_RAW=0x%08x G2H_INFO=0x%08x\n",
+				h2g,
+				gmu_read(gmu, REG_A6XX_GMU_HOST2GMU_INTR_RAW_INFO),
+				gmu_read(gmu, REG_A6XX_GMU_GMU2HOST_INTR_INFO));
+		}
+	}
+
+out:
+	/* Make sure to turn off the boot OOB request on error */
+	if (ret)
+		a6xx_gmu_clear_oob(gmu, GMU_OOB_BOOT_SLUMBER);
+
+	A6XX_TRACE("a6xx_gmu_resume RETURNING ret=%d", ret);
+
+	/*
+	 * IMAGE 226 -- FIX MY OWN BUG. The poller was gated on
+	 * `experimental_nonlegacy`, but the live cmdline sets
+	 * `al_nonlegacy=1`, which is a DIFFERENT parameter name. So the
+	 * poller never armed on the hardware and every RPMh/TCS diagnostic
+	 * living in it (RPV225) silently produced zero lines for the whole
+	 * image-225 run -- including the registers I added specifically to
+	 * interpret image 225's own result.
+	 *
+	 * Arm it unconditionally. The poller is observation-only.
+	 */
+	gvitals157_gmu = gmu;
+	schedule_delayed_work(&gvitals157_work, msecs_to_jiffies(5000));
+	pr_info("GVIT226: poller armed (first +5s, then 30s)\n");
+	bc132("RESUME_RETURN", ret);
+	return ret;
+}
