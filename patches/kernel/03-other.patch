+/*
+ * Map one GMU register region, tolerating either the upstream or the Samsung
+ * CAF reg-name.
+ *
+ * Upstream v4.19/v5.8 expect:
+ *      "gmu", "gmu_pdc", "gmu_pdc_seq"
+ * while this vendor device tree names the same three regions:
+ *      "kgsl_gmu_reg", "kgsl_gmu_pdc_cfg", "kgsl_gmu_pdc_seq"
+ *
+ * The vendor name is tried first and the upstream name is kept as a fallback,
+ * so no device-tree change is required and the tree works either way. All
+ * three DT resources are left untouched.
+ */
+static void __iomem *a6xx_gmu_get_mmio_any(struct platform_device *pdev,
+		const char *vendor_name, const char *upstream_name)
+{
+	void __iomem *ret;
+
+	ret = a6xx_gmu_get_mmio(pdev, vendor_name);
+	if (!IS_ERR(ret))
+		return ret;
+
+	return a6xx_gmu_get_mmio(pdev, upstream_name);
+}
+
+
+static int a6xx_gmu_get_irq(struct a6xx_gmu *gmu, struct platform_device *pdev,
+		int irq, const char *name, irq_handler_t handler)
+{
+	int ret;
+
+	ret = devm_request_irq(&pdev->dev, irq, handler, IRQF_TRIGGER_HIGH,
+		name, gmu);
+	if (ret) {
+		dev_err(&pdev->dev, "Unable to get interrupt %s\n", name);
+		return ret;
+	}
+
+	disable_irq(irq);
+
+	return irq;
+}
+
+/*
+ * Acquire one GMU interrupt, tolerating either the upstream or the Samsung
+ * CAF interrupt-name.
+ *
+ * Upstream v4.19/v5.8 expect:
+ *      "hfi", "gmu"
+ * while this vendor device tree names the same two interrupts:
+ *      "kgsl_hfi_irq", "kgsl_gmu_irq"
+ *
+ * Same vendor-first / upstream-fallback policy as a6xx_gmu_get_mmio_any().
+ * platform_get_irq_byname() returns a negative errno when the name is not
+ * present, so an absent vendor name falls through to the upstream name.
+ */
+static int a6xx_gmu_get_irq_any(struct a6xx_gmu *gmu,
+		struct platform_device *pdev, const char *vendor_name,
+		const char *upstream_name, irq_handler_t handler)
+{
+	int irq;
+
+	irq = platform_get_irq_byname(pdev, vendor_name);
+	if (irq < 0)
+		irq = platform_get_irq_byname(pdev, upstream_name);
+
+	if (irq < 0) {
+		dev_err(&pdev->dev, "Unable to find the %s/%s interrupt\n",
+			vendor_name, upstream_name);
+		return irq;
+	}
+
+	return a6xx_gmu_get_irq(gmu, pdev, irq, vendor_name, handler);
+}
+
+void a6xx_gmu_remove(struct a6xx_gpu *a6xx_gpu)
+{
+	struct a6xx_gmu *gmu = &a6xx_gpu->gmu;
+
+	if (!IS_ERR_OR_NULL(gmu->mmio)) {
+		pm_runtime_disable(gmu->dev);
+		a6xx_gmu_stop(a6xx_gpu);
+
+		a6xx_gmu_irq_disable(gmu);
+		a6xx_gmu_memory_free(gmu, gmu->hfi);
+
+		/* A640 i/d cache buffers, and the legacy debug region */
+		a6xx_gmu_memory_free(gmu, gmu->icache);
+		a6xx_gmu_memory_free(gmu, gmu->dcache);
+		a6xx_gmu_memory_free(gmu, gmu->itcm_hole);
+		a6xx_gmu_memory_free(gmu, gmu->dummy);
+		a6xx_gmu_memory_free(gmu, gmu->sentinel);
+		a6xx_gmu_memory_free(gmu, gmu->log);
+		a6xx_gmu_memory_free(gmu, gmu->debug);
+	}
+
+	/*
+	 * Release the context-bank domain obtained by msm_gpu_cb_domain_get().
+	 * Done unconditionally: the domain may have been obtained even if mmio
+	 * mapping later failed.
+	 */
+	msm_gpu_cb_domain_put(gmu->domain, gmu->cb_dev);
+	gmu->domain = NULL;
+	gmu->cb_dev = NULL;
+}
