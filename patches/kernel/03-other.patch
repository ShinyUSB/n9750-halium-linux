+	 * CAVEAT: upstream msm programs the same degenerate window as us and
+	 * works on a640 elsewhere, so this is a candidate, not a finding.  It
+	 * is cheap to test, so it is tested.
+	 *
+	 * a6xx.gmem_window=<KB> programs CAF's window for that size;
+	 * -1 (default) keeps the current behaviour.
+	 */
+	if (gmem_window >= 0) {
+		u32 size = gmem_window * 1024;
+		u32 base = (size + 0xFFFFF) & ~0xFFFFF;	/* ALIGN(size, 1M) */
+
+		gpu_write64(gpu, REG_A6XX_UCHE_GMEM_RANGE_MIN_LO,
+			REG_A6XX_UCHE_GMEM_RANGE_MIN_HI, base);
+		gpu_write64(gpu, REG_A6XX_UCHE_GMEM_RANGE_MAX_LO,
+			REG_A6XX_UCHE_GMEM_RANGE_MAX_HI, base + size - 1);
+		pr_info("GMEM282: window [0x%x, 0x%x] (CAF formula, %d KB)\n",
