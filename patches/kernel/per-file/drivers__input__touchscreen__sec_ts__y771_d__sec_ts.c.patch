+/*
+ * TEMPORARY bring-up silencing -- REMOVE ONCE A6xx BRING-UP IS DONE.
+ *
+ * The touch IRQ fires roughly every 9 ms and each pass through
+ * sec_ts_read_event() emits several input_info() lines, i.e. on the order of
+ * 100+ lines/second. That floods the kernel ring buffer so thoroughly that the
+ * A6xx GMU bring-up markers are rotated out within ~70 seconds, which makes the
+ * GPU bring-up unobservable over /dev/kmsg.
+ *
+ * Only the high-rate input_info() call sites inside sec_ts_read_event() are
+ * switched to SEC_TS_QUIET_INFO(); input_err() (real errors) is deliberately
+ * left alone. Off by default; set sec_ts_verbose=1 on the kernel command line to
+ * restore the old logging.
+ */
+static bool sec_ts_verbose;
+module_param(sec_ts_verbose, bool, 0644);
+MODULE_PARM_DESC(sec_ts_verbose,
+	"Re-enable high-rate sec_ts input_info logging (off by default)");
+
+#define SEC_TS_QUIET_INFO(mode, dev, fmt, ...)				\
+	do {									\
+		if (sec_ts_verbose)					\
+			input_info(mode, dev, fmt, ##__VA_ARGS__);	\
+	} while (0)
 extern struct tsp_dump_callbacks dump_callbacks;
 static struct delayed_work *p_ghost_check;
 
