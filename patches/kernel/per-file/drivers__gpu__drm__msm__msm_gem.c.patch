+	/*
+	 * IMAGE 252 -- do not purge while a vmap is outstanding.
+	 *
+	 * This is a real, reproducible dangling-pointer bug, and it was
+	 * corrupting every buffer-content measurement in this project.
+	 *
+	 * The sequence:
+	 *
+	 *  1. msm_gem_get_vaddr() caches msm_obj->vaddr and increments
+	 *     vmap_count.
+	 *  2. The shrinker reaches us now. msm_gem_vunmap_locked() checks
+	 *
+	 *	(is_vunmapable() = vmap_count == 0 && vaddr)
+	 *
+	 *     so with vmap_count > 0 it RETURNS EARLY -- and its only
+	 *     "vaddr = NULL" is on the success path, so the cached pointer
+	 *     SURVIVES.
+	 *  3. We then call put_pages(), which frees msm_obj->pages and NULLs
+	 *     it -- but still never clears msm_obj->vaddr.
+	 *  4. The next msm_gem_get_vaddr() sees vaddr != NULL and hands back
+	 *     that pointer to the FREED pages, without re-mapping. The object
+	 *     meanwhile gets fresh pages at new physical addresses.
+	 *
+	 * Measured directly, every submitted BO:
+	 *
+	 *  virt_to_phys=0x97f46000  sgt_phys=0x3cb3f9000  != MISMATCH
+	 *
+	 * i.e. the diagnostic was reading a freed allocation, in a completely
+	 * different physical range from the memory the GPU was given. That is
+	 * where every "the buffer is all zeros" result in this project came
+	 * from -- including the (withdrawn) empty-shader-ISA finding.
+	 *
+	 * Note our own instrumentation is what opens the window: the BOS[] dump
+	 * takes a vaddr around every submit, so it is what drives vmap_count up
+	 * at exactly the moment the shrinker can fire.
+	 *
+	 * The fix is to refuse to purge while the mapping is in use. Simply
+	 * NULLing vaddr instead would be WRONG: whoever is inside
+	 * msm_gem_get_vaddr() right now is about to dereference that pointer,
+	 * and zeroing it would hand them a use-after-free. Leaving it set
+	 * while freeing the pages underneath is equally bad. The only safe
+	 * answer is to not free anything until the mapping is released.
+	 *
+	 * The object stays purgeable and the shrinker will simply take another
+	 * pass later, when vmap_count is back to zero.
+	 */
+	if (msm_obj->vmap_count) {
+		mutex_lock_nested(&msm_obj->lock, subclass);
+		pr_info("GEM252: deferring purge of %s (vmap_count=%u, vaddr=%px)\n",
+			obj->name ? obj->name : "?", msm_obj->vmap_count,
+			msm_obj->vaddr);
+		mutex_unlock(&msm_obj->lock);
+		return;
+	}
