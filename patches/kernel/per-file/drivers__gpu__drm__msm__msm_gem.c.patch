+/*
+ * IMAGE 249 -- map user GPU buffers writecombine.
+ *
+ * The GPU on this platform is NOT coherent with the CPU cache. The tree says so
+ * itself, twice:
+ *
+ *   msm_gem.c: "Make sure to flush the CPU cache for newly allocated memory so
+ *               we don't get ourselves into trouble with a dirty cache"
+ *   msm_gem.c: "For non-cached buffers, ensure the new pages are clean because
+ *               display controller, GPU, etc. are not coherent"
+ *
+ * and it acts on that -- but ONLY for objects flagged MSM_BO_WC/MSM_BO_UNCACHED,
+ * with explicit sync_for_device()/sync_for_cpu(). Those flags cover the
+ * ringbuffer, scanout FBOs, the cursor and imported dmabufs. They are NOT
+ * reachable from userspace (the DRM alloc ioctl exposes no equivalent), so every
+ * GL buffer Mesa allocates falls into the cached branch below.
+ *
+ * Consequence, and it is the whole rendering failure:
+ *
+ *   userspace writes the shader ISA / buffer data through a CACHEABLE mapping
+ *     -> it stays as dirty cache lines
+ *     -> it is never written back to DRAM
+ *     -> the GPU DMAs from DRAM and reads ZEROS
+ *
+ * A zero ISA is a no-op, not a fault. Hence: CP domain perfect, ring drains,
+ * fences signal, CP_INTERRUPT_STATUS always 0, no GMU error, no hang-detect
+ * trigger -- and nothing rendered, ever. It also explains the case an empty-ISA
+ * theory could not: glClear produces nothing either, because the render
+ * target's contents are equally invisible to the GPU.
+ *
+ * Proof it is coherency and not lost data: writing a pattern via
+ * glMapBufferRange and reading it back from the SAME pointer returns the
+ * pattern, while glGetBufferSubData and the kernel's own BOS[] dump (which
+ * reads via pgprot_writecombine, a non-shareable mapping) both return zeros.
+ *
+ * The fix is to stop handing userspace a cacheable mapping for GPU memory. WC
+ * writes go straight through to memory, which is exactly why the ringbuffer
+ * (already MSM_BO_WC) has always worked.
+ *
+ * IMAGE 251 -- DEFAULT BACK TO OFF.
+ *
+ * This was measured and it changes nothing: with bo_mmap_wc both Y and N the
+ * kernel's view of a BO disagrees with userspace's in the same way, so the
+ * writecombine mapping is not the cause of anything observed. It costs
+ * performance and it was adopted on the strength of a measurement that later
+ * turned out to be reading the wrong memory. Left in place, default OFF, so it
+ * can still be A/B'd if a future experiment makes it relevant.
+ *
+ * IMAGE 258 -- RETRACTION. The sentence above is no longer trustworthy. The
+ * "kernel's view disagrees with userspace's" observation came from the
+ * pattern test, which has since been shown to be a NULL TEST: the buffers it
+ * wrote were never submitted, so the kernel never had a chance to observe
+ * them. See CORRECTION-PATTERN-TEST-WAS-A-NULL-TEST.md. Separately, image 258
+ * showed this whole line of inquiry was reading submit->bos[b].flags instead
+ * of bo->flags, so no cache-mode conclusion was ever actually under test.
+ * Default stays 0, but "no effect has been measured" should be read as
+ * "never properly measured".
+ */
+static bool bo_mmap_wc;
+module_param(bo_mmap_wc, bool, 0644);
+MODULE_PARM_DESC(bo_mmap_wc, "Map userspace GPU buffer mappings writecombine instead of cacheable. Default 0");
+
+/*
+ * IMAGE 258 -- force every BO to be mapped cacheable.
+ *
+ * freedreno picks the cachiness in msm_bo.c new_handle():
+ *
+ *	if (flags & FD_BO_CACHED_COHERENT)
+ *		req.flags |= MSM_BO_CACHED_COHERENT;
+ *	else
+ *		req.flags |= MSM_BO_WC;
+ *
+ * and marks exactly three things FD_BO_NOMAP -- the shader ISA
+ * (ir3_gallium.c), pvtmem (fd6_program.c), tess factors (fd6_program.c).
+ * So every GPU-only buffer is writecombine, while command streams are cached
+ * coherent and do have data. That is the one structural asymmetry left
+ * standing, and it is currently UNTESTED: the BOS dump used to print
+ * submit->bos[b].flags (internal submit bookkeeping, decoded 0x6003), not
+ * bo->flags, so no correlation between cache mode and content could ever be
+ * observed. Image 258 prints bo->flags properly; this parameter is the
+ * follow-up, so that if the correlation confirms, the next boot needs no
+ * rebuild.
+ *
+ * Set 1 to rewrite MSM_BO_WC / MSM_BO_UNCACHED to MSM_BO_CACHED at allocation
+ * time, which changes BOTH the userspace VMA (msm_gem_mmap_obj) and the
+ * kernel's own view (msm_gem_get_vaddr) in one go. Default 0, so the
+ * diagnostic boot is untouched.
+ */
+static bool bo_force_cached;
+module_param(bo_force_cached, bool, 0644);
+MODULE_PARM_DESC(bo_force_cached, "Force MSM_BO_CACHED on all BOs regardless of what userspace asked for. Diagnostic A/B for the shader-ISA upload anomaly. Default 0");
+
