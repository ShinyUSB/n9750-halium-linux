 static inline bool msm_gpu_active(struct msm_gpu *gpu)
 {
+	/* a6xx reports the active ring rather than a fence counter */
+	if (gpu->funcs->active_ring)
+		return !!gpu->funcs->active_ring(gpu);
+
 	return gpu->fctx->last_fence > gpu->funcs->last_fence(gpu);
 }
 
