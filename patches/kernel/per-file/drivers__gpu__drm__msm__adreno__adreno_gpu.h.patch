+/*
+ * Legacy CAF name for the same rptr/fence pair that upstream v4.19 reaches
+ * through the ringbuffer as struct msm_rbmemptrs. Both views must refer to
+ * ONE type, otherwise ring->memptrs and adreno_gpu->memptrs become
+ * incompatible pointer types when the two are wired together.
+ */
+#define adreno_rbmemptrs msm_rbmemptrs
+
+/*
+ * IMAGE 266 -- CP-view capture space, carved out of the EXISTING memptrs BO.
+ *
+ * Why not a fresh msm_gem_kernel_new():
+ *   - image 264 allocated one lazily inside a6xx_submit() and deadlocked the
+ *     machine (lock-order inversion against struct_mutex).
+ *   - image 265 allocated one at init from inside hw_init and ALSO deadlocked:
+ *     the a6xx-load thread ended up in D state inside msm_gem_new_impl.
+ *     Upstream avoids this because it calls a6xx_ucode_load() from
+ *     msm_gpu_init(), BEFORE hw_init, with fewer locks held. This CAF tree
+ *     calls a6xx_ucode_init() from inside hw_init, where the GEM lock
+ *     conflicts. So moving the call earlier is not enough -- the allocation
+ *     site itself is wrong for this tree.
+ *
+ * The memptrs object is allocated in adreno_gpu_init(), the ordinary DRM init
+ * path, and that demonstrably works (memptrs_iova reads 0x700000000). So we
+ * simply make that one allocation a little larger and use the tail for the
+ * CP_REG_TO_MEM capture. No new allocation is introduced anywhere, and no
+ * lock-ordering question arises in the GPU bring-up path.
+ *
+ * The capture lives AFTER sizeof(struct msm_rbmemptrs) (rptr + fence = 8 B),
+ * so the two live fields are untouched.
+ */
+#define ADRENO_IBCAP_OFF   sizeof(struct msm_rbmemptrs)
+#define ADRENO_IBCAP_LEN   256
+
+/* Upstream v4.19 uses a single fixed ring size for all targets. */
+#define MSM_GPU_RINGBUFFER_SZ SZ_32K
+
+/* Moved here from adreno_gpu.c (where it was static) because the a6xx
+ * sources ported from upstream v4.19 call it directly.
+ */
+static inline uint32_t get_wptr(struct msm_ringbuffer *ring)
+{
+	return (ring->cur - ring->start) % (MSM_GPU_RINGBUFFER_SZ >> 2);
+}
 
