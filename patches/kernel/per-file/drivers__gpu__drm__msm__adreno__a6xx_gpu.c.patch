+static void gxstate_snap(struct msm_gpu *gpu, const char *tag)
+{
+	struct adreno_gpu *adreno_gpu = to_adreno_gpu(gpu);
+	struct a6xx_gpu *a6xx_gpu = to_a6xx_gpu(adreno_gpu);
+	struct a6xx_gmu *gmu = &a6xx_gpu->gmu;
+	u32 sptp = gmu_read(gmu, REG_A6XX_GMU_SPTPRAC_PWR_CLK_STATUS);
+	u32 off = A6XX_GMU_SPTPRAC_PWR_CLK_STATUS_GX_HM_GDSC_POWER_OFF;
+	u32 clkoff = A6XX_GMU_SPTPRAC_PWR_CLK_STATUS_GX_HM_CLK_OFF;
+
+	pr_info("GXSTATE[%s]: SPTPRAC=0x%x GDSC_OFF=%u CLK_OFF=%u RPMHPWR=0x%x GXVOTE=0x%x MXVOTE=0x%x GXGDSCR=0x%x\n",
+		tag, sptp, !!(sptp & off), !!(sptp & clkoff),
+		gmu_read(gmu, REG_A6XX_GPU_GMU_CX_GMU_RPMH_POWER_STATE),
+		gmu_read(gmu, REG_A6XX_GMU_GX_VOTE_IDX),
+		gmu_read(gmu, REG_A6XX_GMU_MX_VOTE_IDX),
+		gmu_read(gmu, REG_A6XX_GPU_CC_GX_GDSCR));
+	pr_info("GXSTATE[%s]: verdict GX_%s\n", tag,
+		((sptp & (off | clkoff)) == 0) ? "ON" : "OFF");
+}
