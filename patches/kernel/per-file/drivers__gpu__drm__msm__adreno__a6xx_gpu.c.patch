+/*
+ * TEMPORARY image 161 -- PROMOTE IFF IT CATCHES THE KILLER. In-kernel
+ * death-watch: host/userspace reaction (even 0.2s polling) keeps missing
+ * a killer that strikes within ~1s of [25]. A delayed_work armed at
+ * hw_init success dumps state at +200ms (regs only), +2s (regs +
+ * all-CPU backtraces + full task dump), +30s (regs). All to printk so
+ * sec_debug last_kmsg carries it. Self-diagnosing: a wedged GX read
+ * shows as the last printed line.
+ */
+/*
+ * TEMPORARY image 165 -- PROMOTE IFF IT SHOWS THE WEDGE. Timer-free
+ * witness: classic timers (pet_timer, delayed_work) stop firing within
+ * ~250ms of [25] while hrtimers/scheduling continue, and every
+ * timer-based dump (GVIT, SHOT1+) misses. A kthread that busy-waits on
+ * sched_clock (no timers, no sleeps) dumps regs at +1s and regs +
+ * show_state at +5s. Whatever wedges the timers cannot stop an already
+ * running thread; the +5s show_state reveals the pet kthread's exact
+ * wait point (timer wait vs IPI ping vs MMIO).
+ */
+static struct task_struct *sw165_task;
+static struct a6xx_gpu *sw165_ag;
+static void __iomem *sw165_wdt_base;
+static void dw161_regs(struct a6xx_gpu *ag, const char *tag);
+
+static void sw165_ipi_fn(void *info)
+{
+	*(u64 *)info = sched_clock();
+}
+
+struct sw165_ipi_done {
+	struct completion c;
+	u64 t;
+};
+
+static void sw165_ipi_fn2(void *info)
+{
+	struct sw165_ipi_done *d = info;
+	d->t = sched_clock();
+	complete(&d->c);
+}
+
+static int sw165_fn(void *data)
+{
+	u64 t0 = sched_clock();
+	u64 t1 = t0 + 1000000000ULL;
+	u64 t2 = t0 + 5000000000ULL;
+	u64 t3 = t0 + 12000000000ULL;
+	u64 t4 = t0 + 15000000000ULL;
+	u64 next_snap = t0 + 500000000ULL;
+	struct a6xx_gpu *ag = sw165_ag;
+	struct msm_gpu *gpu = ag ? &ag->base.base : NULL;
+	struct a6xx_gmu *gmu = ag ? &ag->gmu : NULL;
+	bool mmio_done = false, ipi_done = false, unvote_done = false;
+
+	while ((s64)(sched_clock() - t1) < 0) {
+		cpu_relax();
+		cond_resched();
+	}
+	if (ag)
+		dw161_regs(ag, "SPIN1");
+	else
+		pr_info("DW161-SPIN1: no ag (jiffies=%llu sched=%llu online=%u)\n",
+			(unsigned long long)get_jiffies_64(),
+			(unsigned long long)sched_clock(),
+			num_online_cpus());
+	/*
+	 * TEMPORARY image 169 -- PROMOTE with the spinwatch. Timer-free
+	 * storm timeline: every 500ms of spin time, snapshot all three
+	 * GPU IRQ counters + jiffies + online count. If an IRQ storm
+	 * starts post-+1s and wedges CPUs (starving timers, the pet
+	 * path, and eventually this thread), the last snapshot names
+	 * the line and the time. Surviving to +5s still dumps show_state.
+	 */
+	while ((s64)(sched_clock() - t2) < 0) {
+		u64 now = sched_clock();
+		if ((s64)(now - next_snap) >= 0) {
+			next_snap = now + 500000000ULL;
+			if (ag)
+				pr_info("DW161-SNAP: t+%llums jiffies=%llu gpu=%u hfi=%u gmu=%u online=%u\n",
+					(unsigned long long)(now - t0) / 1000000ULL,
+					(unsigned long long)get_jiffies_64(),
+					gpu->irq >= 0 ? kstat_irqs((unsigned int)gpu->irq) : 0,
+					gmu->hfi_irq >= 0 ? kstat_irqs((unsigned int)gmu->hfi_irq) : 0,
+					gmu->gmu_irq >= 0 ? kstat_irqs((unsigned int)gmu->gmu_irq) : 0,
+					num_online_cpus());
+			else
+				pr_info("DW161-SNAP: t+%llums no ag\n",
+					(unsigned long long)(now - t0) / 1000000ULL);
+			/*
+			 * TEMPORARY image 180 -- PROMOTE IFF SURVIVAL
+			 * EXTENDS. Post-success vote removal: return power
+			 * control to the bootloader state (proven stable on
+			 * pristine boots) by dropping our GX/MX ARC votes,
+			 * all RPMH vote enables, and the HFI vote. If OUR
+			 * votes/rails destabilize the system (firmware
+			 * acting on them over seconds), this removes the
+			 * playground; SHOTs after this point may wedge on
+			 * collapsed GX (harmless datum, other CPUs live).
+			 */
+			if (!unvote_done && ag &&
+			    (s64)(now - t0 - 10000000000ULL) >= 0) {
+				int uvret;
+				unvote_done = true;
+				gmu_write(gmu, REG_A6XX_GMU_GX_VOTE_IDX, 0);
+				gmu_write(gmu, REG_A6XX_GMU_MX_VOTE_IDX, 0);
+				gmu_rmw(gmu, REG_A6XX_GMU_RPMH_CTRL,
+					A6XX_GMU_RPMH_CTRL_RPMH_INTERFACE_ENABLE |
+					A6XX_GMU_RPMH_CTRL_LLC_VOTE_ENABLE |
+					A6XX_GMU_RPMH_CTRL_DDR_VOTE_ENABLE |
+					A6XX_GMU_RPMH_CTRL_MX_VOTE_ENABLE |
+					A6XX_GMU_RPMH_CTRL_CX_VOTE_ENABLE |
+					A6XX_GMU_RPMH_CTRL_GFX_VOTE_ENABLE, 0);
+				uvret = a6xx_hfi_send_gx_vote(gmu, 1, 0, 0);
+				pr_info("UNVOTE180: ARC+enables cleared hfi_ret=%d RPMHPWR=0x%x\n",
+					uvret,
+					gmu_read(gmu,
+						REG_A6XX_GPU_GMU_CX_GMU_RPMH_POWER_STATE));
+			}
+		}
+		/*
+		 * TEMPORARY image 171 -- PROMOTE with the wedge finder.
+		 * Probe the two remaining pet-path links from this
+		 * timer-free thread: WDT MMIO readability (+2s) and
+		 * self-IPI round trip (+3s). A wedge inside either probe
+		 * names the killer by its absence (everything else proves
+		 * liveness around it).
+		 */
+		if (!mmio_done && (s64)(now - t0 - 2000000000ULL) >= 0) {
+			mmio_done = true;
+			if (sw165_wdt_base) {
+				u64 mb = sched_clock();
+				u32 v1 = readl(sw165_wdt_base + 0x0C);
+				u32 v2 = readl(sw165_wdt_base + 0x0C);
+				u64 ma = sched_clock();
+				pr_info("DW161-WDTMMIO: v1=0x%x v2=0x%x dt_ns=%llu\n",
+					v1, v2, (unsigned long long)(ma - mb));
+			} else {
+				pr_info("DW161-WDTMMIO: no mapping\n");
+			}
+			/*
+			 * TEMPORARY image 176 -- PROMOTE with the variance
+			 * verdict. 1000 rapid back-to-back reads: a healthy
+			 * 32kHz counter barely moves (1-2 distinct values);
+			 * a faulting bus shows garbage spread. Detects the
+			 * instability class that would spin pet_watchdog's
+			 * read loop forever (now capped, forced pet).
+			 */
+			if (sw165_wdt_base) {
+				u32 first, v, mn = 0xFFFFFFFF, mx = 0;
+				int k, uniq = 0;
+				u32 last = 0;
+				first = readl(sw165_wdt_base + 0x0C);
+				mn = mx = last = first;
+				for (k = 0; k < 1000; k++) {
+					v = readl(sw165_wdt_base + 0x0C);
+					if (v < mn)
+						mn = v;
+					if (v > mx)
+						mx = v;
+					if (v != last) {
+						uniq++;
+						last = v;
+					}
+				}
+				pr_info("DW161-WDTVAR: n=1000 min=0x%x max=0x%x transitions=%d\n",
+					mn, mx, uniq);
+			}
+		}
+		if (!ipi_done && (s64)(now - t0 - 3000000000ULL) >= 0) {
+			u64 tib, tia, tstamp = 0;
+			int iret, cpu;
+			ipi_done = true;
+			tib = sched_clock();
+			iret = smp_call_function_single(smp_processor_id(),
+				sw165_ipi_fn, &tstamp, 1);
+			tia = sched_clock();
+			pr_info("DW161-IPI: ret=%d dt_ns=%llu tstamp=%llu\n",
+				iret, (unsigned long long)(tia - tib),
+				(unsigned long long)tstamp);
+			/*
+			 * TEMPORARY image 172 -- PROMOTE with the ping
+			 * verdict. The watchdog pets by IPI-pinging every
+			 * online CPU with wait=1; a CPU that never acks
+			 * wedges the pet forever. Ping every OTHER online
+			 * CPU the same way and time each: a wedge here
+			 * names the dead CPU (last line standing).
+			 *
+			 * TEMPORARY image 173 -- PROMOTE with the deaf map.
+			 * wait=1 wedges the witness too; go async with a
+			 * 1s completion timeout so the loop always finishes
+			 * and names EVERY deaf CPU, then continues.
+			 */
+			for_each_online_cpu(cpu) {
+				u64 cb, ca;
+				struct sw165_ipi_done d;
+				long wret;
+				if (cpu == smp_processor_id())
+					continue;
+				init_completion(&d.c);
+				d.t = 0;
+				cb = sched_clock();
+				smp_call_function_single(cpu,
+					sw165_ipi_fn2, &d, 0);
+				wret = wait_for_completion_timeout(&d.c,
+					msecs_to_jiffies(1000));
+				ca = sched_clock();
+				pr_info("DW161-IPIX: cpu=%d %s dt_ns=%llu\n",
+					cpu, wret ? "ACK" : "TIMEOUT",
+					(unsigned long long)(ca - cb));
+			}
+			pr_info("DW161-IPIX: all-cpu ping done\n");
+		}
+		cpu_relax();
+		cond_resched();
+	}
+	pr_info("DW161-SPIN5: show_state begin (jiffies=%llu sched=%llu online=%u)\n",
+		(unsigned long long)get_jiffies_64(),
+		(unsigned long long)sched_clock(),
+		num_online_cpus());
+	show_state();
+	pr_info("DW161-SPIN5: show_state end\n");
+	/*
+	 * TEMPORARY image 174 -- PROMOTE with the blind-window eliminator.
+	 * The +5s-to-+13s window (pet due, then bark) was never witnessed;
+	 * extend the timer-free spin to +15s with a compact +12s snapshot
+	 * (regs + clocks + online). If the machine dies first, the last
+	 * SNAP already bounded it; if it lives, +12s shows the pre-bark
+	 * state with zero timer dependence.
+	 */
+	while ((s64)(sched_clock() - t3) < 0) {
+		cpu_relax();
+		cond_resched();
+	}
+	if (sw165_ag)
+		dw161_regs(sw165_ag, "SPIN12");
+	pr_info("DW161-SPIN12: jiffies=%llu sched=%llu online=%u\n",
+		(unsigned long long)get_jiffies_64(),
+		(unsigned long long)sched_clock(),
+		num_online_cpus());
+	while ((s64)(sched_clock() - t4) < 0) {
+		cpu_relax();
+		cond_resched();
+	}
+	pr_info("DW161-SPIN15: end jiffies=%llu sched=%llu online=%u\n",
+		(unsigned long long)get_jiffies_64(),
+		(unsigned long long)sched_clock(),
+		num_online_cpus());
+	return 0;
+}
+
+static void sw165_arm(struct a6xx_gpu *ag)
+{
+	if (sw165_task)
+		return;
+	sw165_ag = ag;
+	sw165_wdt_base = ioremap(0x17c10000, 0x1000);
+	pr_info("DW161-SPIN: wdt_map=%px\n", sw165_wdt_base);
+	sw165_task = kthread_run(sw165_fn, NULL, "sw165");
+	if (IS_ERR(sw165_task)) {
+		pr_info("DW161-SPIN: kthread_run failed\n");
+		sw165_task = NULL;
+	} else {
+		pr_info("DW161-SPIN: armed (+1s/+5s, timer-free)\n");
+	}
+}
+
+static void dw161_fn(struct work_struct *work);
+static DECLARE_DELAYED_WORK(dw161_work, dw161_fn);
+static struct a6xx_gpu *dw161_ag;
+static int dw161_shot;
+
+static void dw161_regs(struct a6xx_gpu *ag, const char *tag)
+{
+	struct msm_gpu *gpu = &ag->base.base;
+	struct a6xx_gmu *gmu = &ag->gmu;
+
+	pr_info("DW161-%s: SPTPRAC=0x%x RPMHPWR=0x%x GXVOTE=0x%x MXVOTE=0x%x OOB_H2G=0x%x OOB_G2H=0x%x\n",
+		tag,
+		gmu_read(gmu, REG_A6XX_GMU_SPTPRAC_PWR_CLK_STATUS),
+		gmu_read(gmu, REG_A6XX_GPU_GMU_CX_GMU_RPMH_POWER_STATE),
+		gmu_read(gmu, REG_A6XX_GMU_GX_VOTE_IDX),
+		gmu_read(gmu, REG_A6XX_GMU_MX_VOTE_IDX),
+		gmu_read(gmu, REG_A6XX_GMU_HOST2GMU_INTR_RAW_INFO),
+		gmu_read(gmu, REG_A6XX_GMU_GMU2HOST_INTR_INFO));
+	pr_info("DW161-%s: RBBM_STATUS=0x%x RPTR=0x%x WPTR=0x%x fence=%u\n",
+		tag,
+		gpu_read(gpu, REG_A6XX_RBBM_STATUS),
+		gpu_read(gpu, REG_A6XX_CP_RB_RPTR),
+		gpu_read(gpu, REG_A6XX_CP_RB_WPTR),
+		gpu->fctx ? gpu->fctx->completed_fence : 0);
+	pr_info("DW161-%s: gpu_irq=%d irqcount=%u hfi_irq=%d hficount=%u gmu_irq=%d gmucount=%u\n",
+		tag, gpu->irq,
+		gpu->irq >= 0 ? kstat_irqs((unsigned int)gpu->irq) : 0,
+		gmu->hfi_irq,
+		gmu->hfi_irq >= 0 ? kstat_irqs((unsigned int)gmu->hfi_irq) : 0,
+		gmu->gmu_irq,
+		gmu->gmu_irq >= 0 ? kstat_irqs((unsigned int)gmu->gmu_irq) : 0);
+	/* Clock triple + online count: discriminates tick-freeze (jiffies
+	 * stalls vs sched_clock/ktime) from a wedged pet path. */
+	pr_info("DW161-%s: jiffies=%llu sched_clock=%llu ktime=%lld online=%u\n",
+		tag, (unsigned long long)get_jiffies_64(),
+		(unsigned long long)sched_clock(),
+		(long long)ktime_get_ns(), num_online_cpus());
+}
+
+static void dw161_fn(struct work_struct *work)
+{
+	struct a6xx_gpu *ag = dw161_ag;
+	int shot = dw161_shot++;
+
+	if (!ag)
+		return;
+	if (shot == 0) {
+		dw161_regs(ag, "SHOT0");
+		schedule_delayed_work(&dw161_work,
+			msecs_to_jiffies(200));
+	} else if (shot == 1) {
+		dw161_regs(ag, "SHOT1");
+		schedule_delayed_work(&dw161_work,
+			msecs_to_jiffies(750));
+	} else if (shot == 2) {
+		dw161_regs(ag, "SHOT2");
+		schedule_delayed_work(&dw161_work,
+			msecs_to_jiffies(4000));
+	} else if (shot == 3) {
+		dw161_regs(ag, "SHOT3");
+		pr_info("DW161-SHOT3: cpubt=%d begin\n",
+			trigger_all_cpu_backtrace());
+		pr_info("DW161-SHOT3: cpubt done, show_state begin\n");
+		show_state();
+		pr_info("DW161-SHOT3: show_state end\n");
+		schedule_delayed_work(&dw161_work,
+			msecs_to_jiffies(25000));
+	} else {
+		dw161_regs(ag, "SHOT4");
+		pr_info("DW161: watch complete\n");
+	}
+}
+
+static inline bool _a6xx_check_idle(struct msm_gpu *gpu)
+{
+	struct adreno_gpu *adreno_gpu = to_adreno_gpu(gpu);
+	struct a6xx_gpu *a6xx_gpu = to_a6xx_gpu(adreno_gpu);
+
+	/* Check that the GMU is idle */
+	if (!a6xx_gmu_isidle(&a6xx_gpu->gmu))
+		return false;
+
+	/* Check tha the CX master is idle */
+	if (gpu_read(gpu, REG_A6XX_RBBM_STATUS) &
+			~A6XX_RBBM_STATUS_CP_AHB_BUSY_CX_MASTER)
+		return false;
+
+	return !(gpu_read(gpu, REG_A6XX_RBBM_INT_0_STATUS) &
+		A6XX_RBBM_INT_0_MASK_RBBM_HANG_DETECT);
+}
+
+bool a6xx_idle(struct msm_gpu *gpu, struct msm_ringbuffer *ring)
+{
+	/* wait for CP to drain ringbuffer: */
+	if (!adreno_idle(gpu, ring))
+		return false;
+
+	if (spin_until(_a6xx_check_idle(gpu))) {
+		DRM_ERROR("%s: %ps: timeout waiting for GPU to idle: status %8.8X irq %8.8X rptr/wptr %d/%d\n",
+			gpu->name, __builtin_return_address(0),
+			gpu_read(gpu, REG_A6XX_RBBM_STATUS),
+			gpu_read(gpu, REG_A6XX_RBBM_INT_0_STATUS),
+			gpu_read(gpu, REG_A6XX_CP_RB_RPTR),
+			gpu_read(gpu, REG_A6XX_CP_RB_WPTR));
+		return false;
+	}
+
+	return true;
+}
+
+static void a6xx_flush(struct msm_gpu *gpu, struct msm_ringbuffer *ring)
+{
+	uint32_t wptr;
+	unsigned long flags;
+
+	spin_lock_irqsave(&ring->lock, flags);
+
+	/* Copy the shadow to the actual register */
+	ring->cur = ring->next;
+
+	/* Make sure to wrap wptr if we need to */
+	wptr = get_wptr(ring);
+
+	spin_unlock_irqrestore(&ring->lock, flags);
+
+	/* Make sure everything is posted before making a decision */
+	mb();
+
+	gpu_write(gpu, REG_A6XX_CP_RB_WPTR, wptr);
+}
+
+static bool ibdump;
+module_param(ibdump, bool, 0644);
+
+MODULE_PARM_DESC(ibdump, "dump indirect buffer contents on every submit (debug)");
+
+/*
+ * IMAGE 261 -- TIME-RESOLVED POST-FLUSH SAMPLER.
+ *
+ * WHY THIS EXISTS
+ * ---------------
+ * Every verdict this project has reached about "did the GPU run" so far has
+ * come from a SINGLE sample taken after the work had already finished:
+ *
+ *   - a6xx_submit() does msleep(50) after a6xx_flush() and only then reads
+ *     CP_SQE_STAT.  A constant sqe_pc there is what a HEALTHY IDLE SQE looks
+ *     like, not evidence of a wedged one (this retracted a whole root-cause
+ *     document).
+ *   - CP_SCRATCH_REG(2), the fence and CP_RB_RPTR are all point-in-time reads
+ *     taken at the same moment, so they cannot show ORDER.  We know the scratch
+ *     register eventually holds the seqno and the ring eventually drains, but
+ *     not whether the timestamp ever fired, nor what the state was in between.
+ *
+ * The one sound signal we have is the interrupt decode:
+ *
+ *   RBBM_INT_0_STATUS = 0, cache_flush_ts = 0, and NO fault of any kind
+ *   (no ahb error, no hang detect, no opcode/ucode/hw_fault/prot/vsd/illegal).
+ *
+ * i.e. the submission neither completes nor faults.  To localise WHERE it
+ * stops we need time resolution, which is exactly what this adds.
+ *
+ * WHAT IT SAMPLES, AND WHY EACH ONE
+ *   pc/pkt   CP_SQE_STAT index 0/1 -- the SQE program counter and the packet
+ *            it is currently on.  A PC that ADVANCES proves the SQE is
+ *            running; a PC pinned at one value across a burst proves it is
+ *            stuck THERE, which is the discriminator we lack.
+ *   rptr/wptr  ROQ prefetch progress.
+ *   scratch  CP_SCRATCH_REG(2) -- lands at the END of the driver's preamble,
+ *            so the sample at which it flips tells us how far the CP got.
+ *   int0     RBBM_INT_0_STATUS.  Bit 20 (0x00100000) is CP_CACHE_FLUSH_TS,
+ *            the "the fence write landed" success bit.
+ *   cpint    CP_INTERRUPT_STATUS -- the fault flavours.
+ *   fence    ring->memptrs->fence -- the CPU-visible timestamp.
+ *
+ * The burst stops early once RPTR==WPTR and CACHE_FLUSH_TS has fired, so a
+ * healthy submit costs only a couple of samples.
+ *
+ * Controlled by `ibtrace` (samples per submit, 0 = off) so it is strictly
+ * on-demand: with it at 0 this code does nothing and the submit path is
+ * unchanged.  Writes no state; read-only apart from the documented
+ * CP_SQE_STAT_ADDR index selector.
+ */
+static unsigned int ibtrace;
+module_param(ibtrace, uint, 0644);
+
+MODULE_PARM_DESC(ibtrace, "post-flush SQE walk iteration budget, 0=off (debug)");
+
+/* IMAGE 264 -- defined below; used by the walk tracer to dump the capture. */
+static void a6xx_ibcap_report(struct msm_gpu *gpu, unsigned int seqno);
+
+/*
+ * IMAGE 265 -- hard ceiling on the walk tracer.
+ *
+ * The burst runs inside a6xx_submit() with struct_mutex held, and each
+ * iteration is ~4 MMIO reads. Left unbounded, a submission whose fence never
+ * lands would spin here for an arbitrary time and block the entire GPU
+ * scheduling path. ibtrace is the operator's budget; this is the driver's
+ * veto. A healthy submission needs ~70 iterations, so 4096 is ~50x headroom
+ * while still bounding the worst case to a few milliseconds.
+ */
+#define IBTRACE_MAX 4096
+
+static void a6xx_trace_burst(struct msm_gpu *gpu, struct msm_ringbuffer *ring,
+			     unsigned int seqno)
+{
+	u32 last_pc = ~0u, last_pkt = ~0u;
+	unsigned int i, nlogged = 0, stale = 0, budget;
+	u32 busy0, busy1, gras_tl0, gras_tl1;
+	u64 aon0, aon1;
+
+	if (!ibtrace)
+		return;
+
+	budget = min(ibtrace, (unsigned int)IBTRACE_MAX);
+
+	/*
+	 * Baselines for the DELTAs. Point values prove nothing on their own --
+	 * a register that reads 0x80000000 may be a real latched value or just
+	 * an idle one. What matters is whether it MOVED while the submission
+	 * ran, so take a baseline here and diff it in the summary line.
+	 */
+	busy0     = gpu_read(gpu, REG_A6XX_RBBM_PERFCTR_GPU_BUSY_MASKED);
+	gras_tl0  = gpu_read(gpu, REG_A6XX_GRAS_2D_DST_TL);
+	aon0      = gpu_read64(gpu, REG_A6XX_CP_ALWAYS_ON_COUNTER_LO,
+				REG_A6XX_CP_ALWAYS_ON_COUNTER_HI);
+
+	/*
+	 * IMAGE 261b -- CHANGE-DRIVEN WALK TRACE.
+	 *
+	 * The previous version logged every sample at ~100 us. That was fast
+	 * enough to prove the submission retires, but far too slow to see HOW
+	 * the SQE walks the command graph: a whole submission completes in
+	 * under ~100 us, so a 100 us sampler only ever catches the first
+	 * sample and then the idle state.
+	 *
+	 * Everything we have measured so far is ring-level: the ring's own
+	 * CP_SCRATCH/CACHE_FLUSH_TS land, and pkt=0x70bf8003 is the ring's
+	 * CP_INDIRECT_BUFFER packet. The render commands live one and two
+	 * levels further down (envelope -> leaf), and we have NEVER observed
+	 * the SQE in either of those. The fence landing proves the ring
+	 * completed; it does not prove the nested buffers were walked.
+	 *
+	 * So: poll only pc/pkt (4 MMIO) as fast as the interconnect allows,
+	 * and pay for the full register set ONLY when one of them changes.
+	 * That maximises the rate at which we can observe the walk while
+	 * keeping the log short enough to read.
+	 */
+	for (i = 0; i < budget; i++) {
+		u32 pc, pkt;
+
+		/*
+		 * Indexed register protocol: ADDR is a WRITE-ONLY selector.
+		 * Write the index, then read DATA to pop the corresponding word.
+		 * Order matters -- successive reads pop associated state.  Index 0
+		 * is the SQE firmware PC, index 1 the current packet header.
+		 */
+		gpu_write(gpu, REG_A6XX_CP_SQE_STAT_ADDR, 0);
+		pc = gpu_read(gpu, REG_A6XX_CP_SQE_STAT_DATA);
+		gpu_write(gpu, REG_A6XX_CP_SQE_STAT_ADDR, 1);
+		pkt = gpu_read(gpu, REG_A6XX_CP_SQE_STAT_DATA);
+
+		if (pc != last_pc || pkt != last_pkt) {
+			u32 rptr, wptr, scratch, int0, cpint, fence;
+			u32 busy, gras_tl, gras_br, rb_mode;
+			u64 rbmempx;
+
+			rptr    = gpu_read(gpu, REG_A6XX_CP_RB_RPTR);
+			wptr    = gpu_read(gpu, REG_A6XX_CP_RB_WPTR);
+			scratch = gpu_read(gpu, REG_A6XX_CP_SCRATCH_REG(2));
+			int0    = gpu_read(gpu, REG_A6XX_RBBM_INT_0_STATUS);
+			cpint   = gpu_read(gpu, REG_A6XX_CP_INTERRUPT_STATUS);
+			fence   = ring->memptrs ? ring->memptrs->fence : 0xffffffff;
+			/* CP_RB_RPTR_ADDR is 64-bit in this tree: _LO / _HI. */
+			rbmempx = gpu_read64(gpu, REG_A6XX_CP_RB_RPTR_ADDR_LO,
+						REG_A6XX_CP_RB_RPTR_ADDR_HI);
+
+			/*
+			 * IMAGE 262 -- RENDER BACKEND STATE at the instant the
+			 * SQE is holding a CP_DRAW.  The draws are proven to
+			 * execute (walk step pc=0xd00 pkt=0x70388003), yet
+			 * nothing is ever written, so the question is whether
+			 * the RB is ARMED at all.
+			 *
+			 *   gpubusy  RBBM_PERFCTR_GPU_BUSY_MASKED -- aggregate
+			 *            GPU busy cycles.  If this does not move
+			 *            across a submission containing a draw,
+			 *            no engine did any work, and that is
+			 *            decisive regardless of point values.
+			 *   gras_tl/br  GRAS_2D_DST_TL/BR -- the 2D bounds the
+			 *            render backend uses.  A6xx CULLS a draw
+			 *            when no primitive is visible in the
+			 *            current tile, so wrong/zero bounds here
+			 *            would silently discard every primitive
+			 *            with no fault at all.
+			 *   rb_mode  RB_ADDR_MODE_CNTL -- 64-bit addressing
+			 *            for the RB; a zero here would mis-address
+			 *            every render target store.
+			 */
+			busy    = gpu_read(gpu,
+					REG_A6XX_RBBM_PERFCTR_GPU_BUSY_MASKED);
+			gras_tl = gpu_read(gpu, REG_A6XX_GRAS_2D_DST_TL);
+			gras_br = gpu_read(gpu, REG_A6XX_GRAS_2D_DST_BR);
+			rb_mode = gpu_read(gpu, REG_A6XX_RB_ADDR_MODE_CNTL);
+
+			pr_info("TRC[seq=%u i=%03u] pc=0x%08x pkt=0x%08x rptr=0x%05x wptr=0x%05x scratch=0x%08x int0=0x%08x cpint=0x%08x fence=%u rptraddr=0x%llx flush_ts=%d gpubusy=0x%08x gras_tl=0x%08x gras_br=0x%08x rb_mode=0x%08x\n",
+				seqno, nlogged, pc, pkt, rptr, wptr, scratch,
+				int0, cpint, fence,
+				(unsigned long long)rbmempx,
+				!!(int0 & 0x00100000),
+				busy, gras_tl, gras_br, rb_mode);
+
+			last_pc = pc;
+			last_pkt = pkt;
+			nlogged++;
+			stale = 0;
+		} else {
+			stale++;
+		}
+
+		/*
+		 * Retire early once the submission is clearly done AND the SQE
+		 * has stopped moving -- i.e. it has gone idle. Without this we
+		 * would spin the full ibtrace budget every submit.
+		 */
+		if (stale > 64 && ring->memptrs &&
+		    ring->memptrs->fence >= seqno)
+			break;
+
+		udelay(1);
+	}
+
+	busy1    = gpu_read(gpu, REG_A6XX_RBBM_PERFCTR_GPU_BUSY_MASKED);
+	gras_tl1 = gpu_read(gpu, REG_A6XX_GRAS_2D_DST_TL);
+	aon1     = gpu_read64(gpu, REG_A6XX_CP_ALWAYS_ON_COUNTER_LO,
+			       REG_A6XX_CP_ALWAYS_ON_COUNTER_HI);
+
+	/*
+	 * gpubusy_delta == 0 across a submission that contains CP_DRAW is the
+	 * single most decisive number this instrument produces: it means no
+	 * GPU engine did any work at all, regardless of what any individual
+	 * register happens to read.
+	 */
+	pr_info("TRC[seq=%u] walk_end iterations=%u transitions=%u gpubusy_delta=%u alwayson_delta=%llu gras_tl_changed=%d\n",
+		seqno, i, nlogged, busy1 - busy0,
+		(unsigned long long)(aon1 - aon0),
+		(gras_tl1 != gras_tl0));
+
+	/*
+	 * IMAGE 264 -- if the CP-view capture was armed, report it now.  This
+	 * runs after the fence has landed, so the captured values are the
+	 * post-render state.
+	 */
+	a6xx_ibcap_report(gpu, seqno);
+}
+
+/*
+ * IMAGE 264 -- RENDER-BACKEND REGISTER CAPTURE VIA CP_REG_TO_MEM.
+ *
+ * WHY CPU MMIO CANNOT ANSWER THIS
+ * -------------------------------
+ * Image 263 read GRAS_2D_DST_TL/BR, RB_ADDR_MODE_CNTL and
+ * RBBM_PERFCTR_GPU_BUSY_MASKED straight over the CPU bus and got unusable
+ * results:
+ *
+ *   - GRAS_2D_DST_TL read 0x00000000, yet the submitted command stream
+ *     demonstrably contains a write to it (header 0x48840502 = reg 0x8405).
+ *   - PERFCTR_GPU_BUSY_MASKED read a CONSTANT 0x002f7fff and never moved,
+ *     while CP_ALWAYS_ON_COUNTER advanced 6724 in the same window. A counter
+ *     stuck at a fixed value is evidence the counter is not counting, NOT
+ *     evidence that the engine is idle.
+ *
+ * The cause of the first one is structural: a6xx register clusters are
+ * CONTEXT-BANKED. From the freedreno documentation, "registers generally have
+ * two copies ('contexts') in their cluster", so a CPU read can land on a
+ * different context than the one the CP wrote. Reading the render backend over
+ * the CPU bus therefore cannot work here, and must not be used to conclude
+ * anything.
+ *
+ * THE FIX
+ * -------
+ * Ask the CP to capture the registers itself, with CP_REG_TO_MEM, and read
+ * the results from memory. This is the same mechanism upstream uses for its
+ * statistics counters (get_stats_counter() in a6xx_submit()), and it reads
+ * the register in the CP's OWN context -- the view that actually matters.
+ *
+ * The packets are emitted AFTER the indirect buffer, so they capture the state
+ * left behind by the render, not the state before it.
+ *
+ * Encoding taken from this tree, not from memory:
+ *   CP_REG_TO_MEM = 62                    (adreno_pm4.xml.h)
+ *   CP_REG_TO_MEM_0_REG  bits 0-15        (mask 0x0000ffff)
+ *   CP_REG_TO_MEM_0_CNT  bits 19-28       (mask 0x3ff80000)
+ *   CP_REG_TO_MEM_0_64B  bit 30
+ *
+ * Note REG is only 16 bits wide, so every register listed below must fit --
+ * they do (largest is 0x8e07).
+ */
+static bool ibcap;
+module_param(ibcap, bool, 0644);
+
+MODULE_PARM_DESC(ibcap, "capture render-backend registers via CP_REG_TO_MEM (debug)");
+
+static const struct {
+	u32 reg;
+	const char *name;
+} ibcap_regs[] = {
+	{ REG_A6XX_GRAS_2D_DST_TL,			"GRAS_2D_DST_TL" },
+	{ REG_A6XX_GRAS_2D_DST_BR,			"GRAS_2D_DST_BR" },
+	{ REG_A6XX_RB_ADDR_MODE_CNTL,			"RB_ADDR_MODE_CNTL" },
+	{ REG_A6XX_RB_CCU_CNTL,				"RB_CCU_CNTL" },
+	{ REG_A6XX_RBBM_PERFCTR_GPU_BUSY_MASKED,	"PERFCTR_GPU_BUSY" },
+	{ REG_A6XX_RBBM_STATUS,				"RBBM_STATUS" },
+	{ REG_A6XX_RBBM_INT_0_STATUS,			"INT_0_STATUS" },
+	{ REG_A6XX_CP_RB_CNTL,				"CP_RB_CNTL" },
+	{ REG_A6XX_SP_FS_CTRL_REG0,			"SP_FS_CTRL_REG0" },
+};
+
+static uint64_t ibcap_iova;
+static unsigned int ibcap_len;
+
+/*
+ * IMAGE 266 -- THE CAPTURE USES THE EXISTING MEMPTRS BUFFER. NO ALLOCATION.
+ *
+ * Three attempts, and the failure modes are worth keeping together:
+ *
+ *   264  allocated a BO lazily inside a6xx_submit(). Deadlock: the call took
+ *        the GEM locks while struct_mutex and the GPU lock were held. The
+ *        kernel thread stayed stuck holding struct_mutex, so every reader of
+ *        a6xx_gpu_cpstate blocked forever -- which LOOKED like a frozen phone
+ *        but was not one; ssh and dmesg kept working throughout.
+ *   265  allocated at init from inside hw_init. Also a deadlock: the
+ *        a6xx-load thread sat in D state inside msm_gem_new_impl. Upstream
+ *        escapes this by calling a6xx_ucode_load() from msm_gpu_init(),
+ *        before hw_init; this CAF tree calls a6xx_ucode_init() from inside
+ *        hw_init, where the GEM lock conflicts.
+ *   266  allocate nothing at all. The capture lives in the TAIL of the memptrs
+ *        buffer, which is allocated in adreno_gpu_init() -- the ordinary DRM
+ *        init path that already works. See ADRENO_IBCAP_OFF/_LEN in
+ *        adreno_gpu.h.
+ *
+ * ibcap_iova is therefore derived from memptrs_iova at emit time. There is no
+ * allocation on any GPU path, so the deadlock class is structurally gone.
+ */
+static void a6xx_ibcap_emit(struct msm_gpu *gpu, struct msm_ringbuffer *ring)
+{
+	struct adreno_gpu *adreno_gpu = to_adreno_gpu(gpu);
+	unsigned int i;
+	u64 base, off = 0;
+
+	if (!ibcap || !adreno_gpu->memptrs_iova)
+		return;
+
+	base = adreno_gpu->memptrs_iova + ADRENO_IBCAP_OFF;
+	ibcap_iova = base;
+
+	for (i = 0; i < ARRAY_SIZE(ibcap_regs); i++) {
+		if (off + 8 > ADRENO_IBCAP_LEN)
+			break;
+		OUT_PKT7(ring, CP_REG_TO_MEM, 3);
+		OUT_RING(ring, CP_REG_TO_MEM_0_REG(ibcap_regs[i].reg) |
+			      CP_REG_TO_MEM_0_CNT(2) | CP_REG_TO_MEM_0_64B);
+		OUT_RING(ring, lower_32_bits(base + off));
+		OUT_RING(ring, upper_32_bits(base + off));
+		off += 8;		/* CNT(2) => 2 dwords */
+	}
+
+	ibcap_len = off;
+}
+
+static void a6xx_ibcap_report(struct msm_gpu *gpu, unsigned int seqno)
+{
+	struct adreno_gpu *adreno_gpu = to_adreno_gpu(gpu);
+	u32 *p;
+	unsigned int i;
+
+	if (!ibcap || !ibcap_len || !adreno_gpu->memptrs)
+		return;
+
+	p = msm_gem_get_vaddr(adreno_gpu->memptrs_bo);
+	if (IS_ERR(p)) {
+		msm_gem_put_vaddr(adreno_gpu->memptrs_bo);
+		return;
+	}
+
+	pr_info("IBCAP[seq=%u] === CP-view register capture, %u regs ===\n",
+		seqno, ARRAY_SIZE(ibcap_regs));
+	for (i = 0; i < ARRAY_SIZE(ibcap_regs); i++)
+		pr_info("IBCAP[seq=%u] %-20s = 0x%08x  0x%08x\n",
+			seqno, ibcap_regs[i].name,
+			p[ADRENO_IBCAP_OFF / 4 + i * 2],
+			p[ADRENO_IBCAP_OFF / 4 + i * 2 + 1]);
+
+	msm_gem_put_vaddr(adreno_gpu->memptrs_bo);
+}
+
+/*
+ * IMAGE 243 -- a640 bring-up parity with CAF and mainline.
+ *
+ * NOTE the default of a640_gbif_halt is FALSE on purpose. At the corrected
+ * address (0x3c45) writing GBIF_HALT=0 / RBBM_GBIF_HALT=0 wedges the AXI bus
+ * and freezes the machine on the first GPU trigger -- confirmed by runtime
+ * A/B on image 243-v2: a640_gbif_halt=1 froze the system, a640_gbif_halt=0
+ * brought the GPU up cleanly on the same image. Images 231/232 saw the same
+ * thing but their define was 0xf114 (4x-inflated, unmapped), so the write was
+ * a no-op and the "GBIF does not answer" conclusion was reached for the wrong
+ * reason. Both references do clear it, so this is CAF/mainline divergence we
+ * cannot adopt on this hardware.
+ */
+static bool a640_roq2 = true;
+module_param(a640_roq2, bool, 0644);
+MODULE_PARM_DESC(a640_roq2, "a640: CP_ROQ_THRESHOLDS_2=0x02000140 (CAF+mainline a640 value); tree was using the a630 value 0x010000c0");
+
+static bool a640_gbif_halt;
+module_param(a640_gbif_halt, bool, 0644);
+MODULE_PARM_DESC(a640_gbif_halt, "a640: clear GBIF_HALT/RBBM_GBIF_HALT at hw_init. DEFAULT OFF - at the corrected address this write wedges the AXI bus and freezes the machine on GPU trigger (A/B verified on image 243-v2)");
+
+static bool a640_gmu_cgc = true;
+module_param(a640_gmu_cgc, bool, 0644);
+MODULE_PARM_DESC(a640_gmu_cgc, "a640: write GMU AO_CGC_MODE/DELAY/HYST + CX_GMU_WFI_CONFIG in a6xx_set_hwcg (CAF __get_gmu_ao_cgc_* / __get_gmu_wfi_config; mainline a6xx_set_hwcg). Had no writer before");
+
+static bool a640_qsb = true;
+module_param(a640_qsb, bool, 0644);
+MODULE_PARM_DESC(a640_qsb, "a640: also program GBIF_QSB_SIDE0..3=0x00071620. DEFAULT ON per CAF a640_gbif[] (adreno_a6xx.c:48-54) - image 243 turned this off on mainline's a610-only scoping, which was the wrong reference");
+
+static bool a640_rbbm_nc = true;
+module_param(a640_rbbm_nc, bool, 0644);
+MODULE_PARM_DESC(a640_rbbm_nc, "a640: write RBBM_NC_MODE_CNTL=1 (macrotile mode; mainline from DT ubwc-mode=3 + highest-bank-bit=15)");
+
+/* IMAGE 281: use CAF's 49-entry a640 hwcg table instead of the project's 46-entry one. */
+static bool hwcg_caf = true;
+module_param(hwcg_caf, bool, 0444);
+MODULE_PARM_DESC(hwcg_caf, "1=use CAF's a640 hwcg table verbatim (49 entries, image 281), 0=the previous 46-entry table");
+
+static bool a640_hwcg_a640 = true;
+module_param(a640_hwcg_a640, bool, 0644);
+MODULE_PARM_DESC(a640_hwcg_a640, "a640: use CAF's per-chip a640_hwcg table (46 entries, incl. the TEX_FCHE clock gate) instead of the a630 table (105 entries). Set 0 to fall back to the old table at runtime");
+
+;
+
+/*
+ * IMAGE 241 -- runtime-triggered LLCC SCID programming (default off).
+ *
+ * The image-240 inline version hung bring-up writing a wrong address, so the
+ * write now happens only when explicitly requested AFTER bring-up: a bad
+ * address can wedge the triggering shell at worst, never the GPU. (The
+ * device survived the 240 hang with ssh/ping alive, so this is proven safe
+ * to attempt.)
+ *
+ * Steps are printed individually so a hang identifies the exact call:
+ *   1. llcc_slice_getd (CPU DT lookup; bounded)
+ *   2. llcc_slice_activate (bounded poll, ~0 jiffies at HZ>=100... returns
+ *      -ETIMEDOUT quickly if the slice never signals)
+ *   3. gpu_write(REG_A6XX_GBIF_SCACHE_CNTL1 = 0x3c02, replicated SCID).
+ *      WRITE ONLY, no readback (image 231: GBIF reads wedge).
+ *
+ * Correct address provenance: canonical Mesa/CAF dword index 0x3c02
+ * (mesa a6xx.xml, CAF a6xx_reg.h:849). Our header previously had no such
+ * define; image 240 used 0xF008 (= 0x3c02 * 4, byte 0x3C020, unmapped).
+ */
+static struct msm_gpu *rbobs_gpu_stash;
+
+static int llcc_scid_set(const char *val, const struct kernel_param *kp)
+{
+	struct llcc_slice_desc *slice;
+	int scid, i, ret;
+	u32 scid_val = 0;
+	struct msm_gpu *gpu = rbobs_gpu_stash;
+
+	ret = param_set_bool(val, kp);
+	if (ret)
+		return ret;
+
+	if (!gpu) {
+		pr_info("LLCCSCID: no GPU stashed yet (bring-up has not run)\n");
+		return 0;
+	}
+
+	pr_info("LLCCSCID: step 1 getd\n");
+	slice = llcc_slice_getd(&gpu->pdev->dev, "gpu");
+	if (IS_ERR(slice)) {
+		pr_info("LLCCSCID: getd failed %ld\n", PTR_ERR(slice));
+		return 0;
+	}
+
+	pr_info("LLCCSCID: step 2 activate\n");
+	ret = llcc_slice_activate(slice);
+	pr_info("LLCCSCID: activate ret=%d\n", ret);
+	if (ret)
+		return 0;
+
+	pr_info("LLCCSCID: step 3 write\n");
+	scid = llcc_get_slice_id(slice);
+	for (i = 0; i < 5; i++)
+		scid_val |= ((u32)(scid & 0x1f) << (i * 5));
+	gpu_write(gpu, REG_A6XX_GBIF_SCACHE_CNTL1, scid_val);
+	pr_info("LLCCSCID: scid=%d cntl1=0x%08x written (no readback)\n",
+		scid, scid_val);
+	return 0;
+}
+
+static bool llcc_scid;
+static const struct kernel_param_ops param_ops_llcc_scid = {
+	.set = llcc_scid_set,
+	.get = param_get_bool,
+};
+module_param_cb(llcc_scid, &param_ops_llcc_scid, &llcc_scid, 0644);
+MODULE_PARM_DESC(llcc_scid, "program LLCC SCID on demand (debug, default off)");
+
+/*
+ * IMAGE 239 -- backend observer v2 (replaces the image 238 delayed sampler).
+ *
+ * Why v1 failed: it sampled RBBM_STATUS 5x starting 10 ms after the kick.
+ * A 64x64 clear executes in microseconds, so all five samples showed the
+ * all-idle 0x1. Combined with zero pixels that is two indistinguishable
+ * states: "executed and wrote nothing" vs "never executed". The sampler
+ * could only ever catch idle, so it proved nothing.
+ *
+ * v2 polls STATUS in a tight loop starting immediately after the kick and
+ * stops when the GPU echoes the fence (or after a bounded iteration cap),
+ * keeping a STICKY bitmask of every bit seen. The fence echo is the GPU's
+ * own completion signal, so the window exactly covers execution:
+ *
+ *   RB ever set     -> backend received the work (addressing/format fork;
+ *                      LLCC/SCID is next)
+ *   RB never, CP/SP -> backend never engaged (dispatch fork; CP_ME_INIT /
+ *                      GMU AO CGC are next)
+ *   nothing ever    -> the submit never reached the GPU
+ *
+ * Blocking the ioctl path is safe here: the loop is bounded by the cap
+ * regardless of the fence, the fence is known to retire (no hang since
+ * image 234), and a6xx_submit runs in process context. cpu_relax() between
+ * MMIO reads. memptrs->fence is already CPU-polled elsewhere in-tree
+ * (hangcheck_handler via last_fence()), so no new coherency assumption.
+ */
+static void rbobs_poll(struct msm_gpu *gpu, struct msm_ringbuffer *ring,
+		unsigned int seqno)
+{
+	u32 seen = 0;
+	int i;
+
+	for (i = 0; i < 20000; i++) {
+		u32 st = gpu_read(gpu, REG_A6XX_RBBM_STATUS);
+
+		seen |= st;
+		if (ring->memptrs && ring->memptrs->fence >= seqno)
+			break;
+		cpu_relax();
+	}
+
+	pr_info("RBOBS2[seq=%u] iters=%d fence=%u STATUS_seen=0x%08x RB=%d SP=%d HLSQ=%d VPC=%d UCHE=%d CCU=%d CP=%d PC_DCALL=%d\n",
+		seqno, i,
+		ring->memptrs ? ring->memptrs->fence : 0xffffffff, seen,
+		!!(seen & A6XX_RBBM_STATUS_RB_BUSY),
+		!!(seen & A6XX_RBBM_STATUS_SP_BUSY),
+		!!(seen & A6XX_RBBM_STATUS_HLSQ_BUSY),
+		!!(seen & A6XX_RBBM_STATUS_VPC_BUSY),
+		!!(seen & A6XX_RBBM_STATUS_UCHE_BUSY),
+		!!(seen & A6XX_RBBM_STATUS_CCU_BUSY),
+		!!(seen & A6XX_RBBM_STATUS_CP_BUSY),
+		!!(seen & A6XX_RBBM_STATUS_PC_DCALL_BUSY));
+}
+
+/* IMAGE 250: tag written by the kernel into each submitted BO so userspace can
+ * tell whether the kernel's own mapping aliases the one userspace writes. */
+#define A6XX_BOS_ALIAS_TAG 0x5C5C5C5Cu
+
+/*
+ * IMAGE 272 -- POINTER MAP.
+ *
+ * IMAGE 271 established that the image-260 DANGLING IOVA scan is broken in
+ * two ways, and the resolver proved the first of them:
+ *
+ *   1. it used EXACT IOVA equality instead of containment, so every interior
+ *      pointer into a submitted buffer was reported as "dangling".  Measured:
+ *      0x700027000 -> offset 0x1000 inside the submitted 20480-byte BO;
+ *      0x700021010 -> offset 0x10 inside the submitted 4096-byte BO.
+ *      None of them was an unmapped address.
+ *   2. it only reported addresses that were NOT in the submitted set, so it
+ *      was completely silent about the pointers that DO resolve -- and that
+ *      is where the answer is.
+ *
+ * This function therefore maps EVERY pointer: for an aperture-range 64-bit
+ * value it finds the BO that contains it and prints the BO's identity --
+ * above all its mmoff, which is the DRM fake offset of the BO's mmap and
+ * therefore directly comparable with the file offset the userspace
+ * vmascan8.py reports for a /dev/dri mapping.  That is the join between the
+ * kernel's view and the userspace's view of the same buffer.
+ *
+ * The three answers this can give, and what each means:
+ *
+ *   -> BO mmoff=0x102179000   the pointer lands in the shader ISA buffer
+ *                             (userspace shows the magic constant inside it)
+ *   -> NO BO OWNS THIS IOVA  the program is not carried by the submission
+ *   -> BO mmoff=0x102189000   the pointer lands in the all-zero buffer
+ *
+ * Measurement only.  Touches no submit path, no register, no allocation.
+ */
+#define A6XX_PTRMAP_MAX 512
+
+/*
+ * Find the BO whose VMA contains the IOVA, in one list of BO objects.
+ * Returns true and fills the outputs on a hit.
+ */
+static bool a6xx_find_bo_for_iova(struct list_head *list, uint64_t iova,
+		struct msm_gem_object **out_obj, uint64_t *out_base,
+		uint64_t *out_size)
+{
+	struct msm_gem_object *msm_obj;
+	struct msm_gem_vma *vma;
+
+	list_for_each_entry(msm_obj, list, mm_list) {
+		list_for_each_entry(vma, &msm_obj->vmas, list) {
+			uint64_t vsize = (uint64_t)vma->node.size << PAGE_SHIFT;
+
+			/*
+			 * A vma with no size in the drm_mm is one created
+			 * without an allocation (e.g. the physaddr path);
+			 * fall back to the object's size so the range check
+			 * still means something.
+			 */
+			if (!vsize)
+				vsize = msm_obj->base.size;
+
+			if (iova >= vma->iova && iova < vma->iova + vsize) {
+				*out_obj = msm_obj;
+				*out_base = vma->iova;
+				*out_size = vsize;
+				return true;
+			}
+		}
+	}
+	return false;
+}
+
+static void a6xx_map_pointer(struct msm_gpu *gpu, uint64_t iova,
+		unsigned int seqno, unsigned int bo_idx, unsigned int dword,
+		unsigned int *count)
+{
+	struct msm_drm_private *priv = gpu->dev->dev_private;
+	struct msm_gem_object *msm_obj = NULL;
+	uint64_t base = 0, size = 0;
+	uint64_t best_iova = 0, best_size = 0;
+	struct msm_gem_object *bobj;
+	struct msm_gem_vma *vma;
+	bool found;
+
+	(*count)++;
+
+	/*
+	 * Enumerate every BO the DRM knows about, and find the one whose VMA
+	 * covers the IOVA.
+	 *
+	 * TWO lists, both linked through msm_gem_object::mm_list:
+	 *   gpu->active_list    -- BOs currently resident on the GPU
+	 *   priv->inactive_list -- BOs not currently on the GPU
+	 * (msm_gem_move_to_active() / msm_gem_move_to_inactive(), msm_gem.c)
+	 *
+	 * DO NOT use aspace->active_list here.  On this tree:
+	 *   - msm_gem_address_space_create() -- the constructor the GPU
+	 *     address space actually uses (msm_gpu_aspace_new() calls it) --
+	 *     does NOT INIT_LIST_HEAD(&aspace->active_list), and
+	 *   - msm_iommu_aspace_ops has no .add_to_active, so
+	 *     msm_gem_add_obj_to_aspace_active_list() is a no-op.
+	 * The list is therefore {NULL,NULL} and walking it oopses the kernel
+	 * at container_of(NULL, msm_gem_object, iova_list).  That is exactly
+	 * what image 271 did, and it cost an oops.  The missing
+	 * INIT_LIST_HEAD is a latent tree bug; it is recorded, not fixed
+	 * here, so that this image changes one thing only.
+	 *
+	 * Locking: the BO lists are protected by dev->struct_mutex, which the
+	 * submit path already holds (msm_gem_move_to_inactive() asserts it).
+	 * aspace->list_lock is likewise never mutex_init'd on this path, so it
+	 * must not be taken.
+	 */
+	found = a6xx_find_bo_for_iova(&gpu->active_list, iova, &msm_obj,
+			&base, &size);
+	if (!found)
+		found = a6xx_find_bo_for_iova(&priv->inactive_list, iova,
+				&msm_obj, &base, &size);
+
+	if (found) {
+		pr_info("PTRMAP[seq=%u] bo[%u] dword %u -> iova 0x%llx -> BO mmoff=0x%llx base=0x%llx size=0x%llx objsz=%zu boflags=0x%x name='%s' off=0x%llx\n",
+			seqno, bo_idx, dword,
+			(unsigned long long)iova,
+			(unsigned long long)msm_gem_mmap_offset(&msm_obj->base),
+			(unsigned long long)base,
+			(unsigned long long)size,
+			msm_obj->base.size,
+			msm_obj->flags,
+			msm_obj->name,
+			(unsigned long long)(iova - base));
+		return;
+	}
+
+	/* No owner: report the nearest lower VMA, which is often the
+	 * buffer the pointer was *meant* to be relative to. */
+	list_for_each_entry(bobj, &gpu->active_list, mm_list) {
+		list_for_each_entry(vma, &bobj->vmas, list) {
+			uint64_t vsize = (uint64_t)vma->node.size << PAGE_SHIFT;
+
+			if (!vsize)
+				vsize = bobj->base.size;
+			if (vma->iova <= iova && vma->iova >= best_iova) {
+				best_iova = vma->iova;
+				best_size = vsize;
+			}
+		}
+	}
+
+	pr_info("PTRMAP[seq=%u] bo[%u] dword %u -> iova 0x%llx -> NO BO OWNS THIS IOVA (nearest lower vma iova=0x%llx size=0x%llx)\n",
+		seqno, bo_idx, dword,
+		(unsigned long long)iova,
+		(unsigned long long)best_iova,
+		(unsigned long long)best_size);
+}
+
+static void a6xx_submit(struct msm_gpu *gpu, struct msm_gem_submit *submit,
+	struct msm_file_private *ctx)
+{
+	struct msm_drm_private *priv = gpu->dev->dev_private;
+	/* a6xx in v4.19 submits exclusively on ring 0 */
+	struct msm_ringbuffer *ring = gpu->rb[0];
+	unsigned int i;
+
+	/*
+	 * TEMPORARY image 220 -- MEASUREMENT ONLY.
+	 *
+	 * Images 217/218/219 chased the render commands through cmd[] and got
+	 * nowhere, for a reason worth recording precisely:
+	 *
+	 *  - 217 dumped the RING only. The commands live in an indirect
+	 *    buffer the ring merely points at.
+	 *  - 218 dumped cmd[] and found exactly ONE buffer per submit
+	 *    (346/332/223 dwords). But that stream itself contains nested
+	 *    CP_INDIRECT_BUFFER references to iova 0x2c000 (77 dwords),
+	 *    0x2d000 (18) and 0x2d050 (19).
+	 *  - 219 added a dump for MSM_SUBMIT_CMD_IB_TARGET_BUF and captured
+	 *    NOTHING, because nr_cmds == 1: there are no IB_TARGET_BUF cmd
+	 *    entries at all.
+	 *
+	 * The reason is that a nested IB target is not a cmd entry. It is a
+	 * RELOC: fd_ringbuffer_emit_reloc_ring_full() records the target in
+	 * submit->bos[] and patches the address into the IB packet. So the
+	 * real clear/render commands live in submit->bos[], which nothing has
+	 * ever dumped.
+	 *
+	 * So: walk bos[] directly. Each entry has {flags, obj, iova}; the
+	 * nested IB targets are identifiable by having a GPU-visible iova.
+	 * Dump contents only for small objects (<= BSKIP dwords) so we do not
+	 * flood the log with the render target or staging buffers.
+	 */
+	if (ibdump) {
+		unsigned int b;
+		unsigned int gather_nr;
+		uint64_t gather_iova[64];	/* IMAGE 260 */
+
+		/*
+		 * IMAGE 260 -- DANGLING IOVA SCAN.
+		 *
+		 * Established (images 258-259 + vmascan2.py): the VS, the binning
+		 * VS and the FS ISA buffers are all compiled, uploaded and
+		 * verifiably resident in the Mesa process -- a magic constant baked
+		 * into each shader is found in shared /dev/dri mappings as real
+		 * a6xx ISA -- and NONE of them appears in this submission's bos[].
+		 *
+		 * freedreno only puts a BO in bos[] via fd_submit_append_bo(),
+		 * which is reached solely from the OUT_RELOC path:
+		 *
+		 *   freedreno_ringbuffer_sp_reloc.h:107
+		 *       for (i = 0; i < nr_reloc_bos; i++)
+		 *               fd_submit_append_bo(fd_submit, ...);
+		 *   msm_ringbuffer_sp.c:141
+		 *       req.nr_bos = fd_submit->nr_bos;
+		 *
+		 * So a missing BO means OUT_RELOC was never called for it, i.e.
+		 * the shader state was never emitted.
+		 *
+		 * The decisive question this answers: does the command stream
+		 * nevertheless CONTAIN an address for the shader? If the stream
+		 * carries an IOVA that no submitted BO provides, the GPU is being
+		 * pointed at memory the submission never maps -- a dangling
+		 * reference, and a complete explanation for a shader domain that
+		 * retires cleanly while executing nothing.
+		 *
+		 * Gather the submitted IOVA set first (cheap, no vmap), then flag
+		 * any aperture-range value in any dumped buffer that is not in it.
+		 * Layout-independent, unlike decoding CP_LOAD_STATE6 -- guessed
+		 * wrong twice already.
+		 */
+		gather_nr = 0;
+		for (b = 0; b < submit->nr_bos && gather_nr < ARRAY_SIZE(gather_iova);
+		     b++)
+			gather_iova[gather_nr++] = submit->bos[b].iova;
+		pr_info("BOS[seq=%u] iova-set gathered: %u of %u bos\n",
+			submit->seqno, gather_nr, submit->nr_bos);
+
+		pr_info("BOS[seq=%u] nr_bos=%u nr_cmds=%u\n",
+			submit->seqno, submit->nr_bos, submit->nr_cmds);
+
+		for (b = 0; b < submit->nr_bos; b++) {
+			struct msm_gem_object *bo = submit->bos[b].obj;
+			void *vaddr;
+			unsigned int ndw;
+
+			/*
+			 * IMAGE 258 -- PRINT THE RIGHT FLAGS.
+			 *
+			 * This used to print submit->bos[b].flags, which is
+			 * internal CAF submit bookkeeping (BO_VALID | BO_LOCKED
+			 * | BO_PINNED | MSM_SUBMIT_BO_WRITE) decoded from the
+			 * legacy msm_submit_rel interface -- NOT the BO's cache
+			 * mode. Observed values like 0x6003 look like a cachiness
+			 * but are not one, which is how every earlier attempt to
+			 * correlate cache mode with buffer content was reading the
+			 * wrong field and concluding "flipping WC changed
+			 * nothing".
+			 *
+			 * bo->flags is the real thing: MSM_BO_CACHE_MASK covers
+			 * 0xf0000, with MSM_BO_CACHED 0x10000, MSM_BO_WC
+			 * 0x20000, MSM_BO_UNCACHED 0x40000. This tree predates
+			 * struct drm_msm_gem_bo, which does not exist anywhere in
+			 * it, so msm_obj->flags is the only cache-mode source.
+			 *
+			 * Also print the name, which freedreno supplies at BO
+			 * creation ("fs:...", "vs:...", "pvtmem_per_fiber",
+			 * "cmdstream", "gmem:..."), so buffer identity no longer
+			 * has to be inferred from size.
+			 *
+			 * IMAGE 259 -- ALSO PRINT THE MMAP OFFSET.
+			 *
+			 * vmascan.py proved the shader ISA *is* materialised in the
+			 * Mesa process: a magic constant baked into the fragment
+			 * shader is found in a 4096-byte shared mapping on /dev/dri/
+			 * at DRM fake offset 0x10217e000, as genuine a6xx ISA whose
+			 * instruction count matches Mesa's own
+			 * "5 instr ... 32 dwords". So the upload lands. What we
+			 * cannot yet do is tell whether the buffer userspace filled
+			 * is the buffer the kernel submits: this line printed only
+			 * the IOVA, never the mmap offset, so the two views could not
+			 * be reconciled at all.
+			 *
+			 * With mmoff printed, match the ISA mapping's offset against
+			 * the submitted buffers:
+			 *   - offset present in bos[] -> identity confirmed, and the
+			 *     kernel reading zeros there would contradict the proven
+			 *     128-byte round-trip, i.e. page detachment.
+			 *   - offset absent -> the shader BO is never submitted, and
+			 *     the draw references a buffer the submission does not
+			 *     carry. One specific defect, and it also explains why the
+			 *     "empty ISA" has been permanent.
+			 */
+			if (!bo) {
+				pr_info("BOS[seq=%u] bo[%u] iova=0x%llx sflags=0x%x bo=NULL\n",
+					submit->seqno, b,
+					(unsigned long long)submit->bos[b].iova,
+					submit->bos[b].flags);
+				continue;
+			}
+
+			pr_info("BOS[seq=%u] bo[%u] iova=0x%llx mmoff=0x%llx sflags=0x%x boflags=0x%x sz=%zu name='%s' bo=%px\n",
+				submit->seqno, b,
+				(unsigned long long)submit->bos[b].iova,
+				(unsigned long long)msm_gem_mmap_offset(&bo->base),
+				submit->bos[b].flags, bo->flags, bo->base.size,
+				bo->name, (void *)bo);
+
+			ndw = bo->base.size / 4;
+
+			/* only the small command-stream buffers */
+			/*
+			 * TEMPORARY image 221 -- RAISED DUMP CAP.
+			 *
+			 * Image 220's cap of 1024 dwords (= 4096 bytes = 0x1000)
+			 * turned out to be exactly the size of a UBWC metadata
+			 * plane. For a 64x64 UBWC RGBA8 render target the layout
+			 * is 0x4000 colour + 0x1000 metadata, and the colour
+			 * plane begins at offset 0x1000 -- i.e. precisely where
+			 * the old cap stopped. We had been dumping the metadata
+			 * plane and not one byte of colour data, so the
+			 * "render target is all zeros" conclusion was measuring
+			 * the wrong region entirely.
+			 *
+			 * 8192 dwords = 32 KiB comfortably covers a 0x5000-byte
+			 * UBWC buffer including both planes, and a linear 0x4000.
+			 */
+			if (ndw == 0 || ndw > 8192)
+				continue;
+
+			vaddr = msm_gem_get_vaddr(&bo->base);
+			if (IS_ERR(vaddr)) {
+				pr_info("BOS[seq=%u] bo[%u] vmap failed err=%ld\n",
+					submit->seqno, b, PTR_ERR(vaddr));
+				continue;
+			}
+
+			pr_info("BOS[seq=%u] bo[%u] ndwords=%u\n",
+				submit->seqno, b, ndw);
+
+			/*
+			 * IMAGE 272 -- POINTER MAP.
+			 *
+			 * The image-260 DANGLING scan is replaced, not extended.
+			 * Image 271's resolver proved it was reporting interior
+			 * pointers into submitted buffers as unmapped (it used exact
+			 * IOVA equality rather than containment), and it only ever
+			 * reported the addresses that did NOT resolve -- saying
+			 * nothing about the ones that do, which is where the answer
+			 * is.
+			 *
+			 * So: map every pointer.  For each 64-bit value in the
+			 * aperture range, print which buffer it lands in, by
+			 * containment, with the offset within that buffer.  The
+			 * mmoff printed is the DRM fake offset of the owning BO's
+			 * mmap, which is exactly the file offset the userspace
+			 * vmascan8.py reports -- so the kernel's and the userspace's
+			 * views of the same buffer can finally be compared.
+			 *
+			 * Alignment: scanned at EVERY dword boundary, not just even
+			 * ones, because a pointer need not be even-aligned.  The
+			 * aperture range makes false positives essentially
+			 * impossible: the high half of any pointer in this aperture
+			 * is exactly 0x00000007, so only dwords equal to 7 can
+			 * produce a hit.
+			 */
+			{
+				uint32_t *sc = vaddr;
+				unsigned int j, nptr = 0;
+
+				for (j = 1; j < ndw; j++) {
+					uint64_t v = ((uint64_t)sc[j] << 32) | sc[j - 1];
+
+					if (v < 0x700000000ULL || v > 0x800000000ULL)
+						continue;
+					a6xx_map_pointer(gpu, v, submit->seqno, b, j - 1,
+						&nptr);
+					if (nptr >= A6XX_PTRMAP_MAX)
+						break;
+				}
+				if (nptr)
+					pr_info("BOS[seq=%u] bo[%u] PTRMAP: %u pointer(s) mapped\n",
+						submit->seqno, b, nptr);
+			}
+
+			{
+				uint32_t *p = vaddr;
+				unsigned int j;
+
+				for (j = 0; j < ndw; j++)
+					pr_info("BOS[seq=%u] bo[%u] [%03u] = 0x%08x\n",
+						submit->seqno, b, j, p[j]);
+			}
+
+			/*
+			 * IMAGE 250 -- ALIASING PROBE.
+			 *
+			 * Every "this buffer is all zeros" result in this project
+			 * came from msm_gem_get_vaddr(), which vmaps the object with
+			 * pgprot_writecombine. But two INDEPENDENT userspace
+			 * glMapBufferRange() calls on the same buffer (two views of
+			 * the same BO) agree with each other and DISAGREE with this
+			 * reader -- a pattern written through one userspace mapping is
+			 * visible through the other, yet reads as zero here.
+			 *
+			 * Settling it from userspace is unreliable (freedreno
+			 * invalidates and re-uploads buffers after use; a
+			 * PIPE_MAP_READ may be a GPU blit to staging rather than a
+			 * CPU read; GL_MAP_PERSISTENT may simply fail). So do it
+			 * here, in the kernel, where none of those apply.
+			 *
+			 * IMAGE 251 -- compare PHYSICAL addresses:
+			 *
+			 *   vpage = virt_to_phys(vaddr)          -- what this reader
+			 *            sees, and therefore what it is reporting on
+			 *   spage = sg_phys(sgt->sgl, 0)         -- what the GPU is
+			 *            actually given
+			 *
+			 *   equal     -> the mapping aliases, and the zeros are a
+			 *                region/offset problem instead
+			 *   different -> this reader is a different memory, and every
+			 *                kernel-side content read is invalid
+			 *
+			 * Note DRM's own rule for a non-coherent GPU: "backing pages
+			 * for an object are flushed to memory and marked write
+			 * combined so as to be coherent with the GPU" -- which is why
+			 * the WC mapping exists, and why an address mismatch is the
+			 * only remaining explanation.
+			 */
+			{
+				uint32_t *p = vaddr;
+				unsigned int j;
+				unsigned long vpage;
+				unsigned long spage = 0;
+				bool have_sgt = false;
+
+				/*
+				 * IMAGE 254 -- the 0x5C5C5C5C tag write is GONE.
+				 *
+				 * Images 250-253 wrote a tag into the first 16 dwords of
+				 * every submitted BO to prove the kernel's mapping
+				 * aliases userspace's. It did prove that (6/6 identical
+				 * content via the in-kernel SGT mapping in image 253), but
+				 * it also overwrote real buffer data, and every
+				 * measurement taken while it was live was corrupted --
+				 * BOs came back with exactly 16 nonzero dwords, which was
+				 * the tag, not the buffer. A diagnostic that modifies what
+				 * it measures is worse than none.
+				 *
+				 * The BOSXCHK cross-check below proves the same thing
+				 * without writing anything, so the tag is no longer needed.
+				 */
+
+				vpage = virt_to_phys(vaddr);
+				if (bo->sgt && bo->sgt->sgl) {
+					spage = (unsigned long)sg_phys(bo->sgt->sgl);
+					have_sgt = true;
+				}
+				/*
+				 * IMAGE 254 -- vpage is NOT trustworthy.
+				 *
+				 * vmap() returns a vmalloc-range address and
+				 * virt_to_phys() is invalid there on arm64, so this
+				 * number is meaningless and must not be compared with
+				 * sgt_phys. Image 253 proved that conclusively: the
+				 * content cross-check below shows the two mappings hold
+				 * IDENTICAL data for every BO, while this comparison
+				 * reported 6/6 MISMATCH. The probe was wrong, not the
+				 * driver.
+				 *
+				 * Printed for the record only, no verdict.
+				 */
+				pr_info("BOSPHYS[seq=%u] bo[%u] obj=%px size=%zu sgt_nents=%u flags=0x%x madv=%u vaddr=%px (vpage 0x%lx UNRELIABLE, sgt_phys 0x%lx)\n",
+					submit->seqno, b, (void *)&bo->base,
+					bo->base.size,
+					bo->sgt ? bo->sgt->nents : 0,
+					bo->flags, bo->madv, vaddr, vpage, spage);
+
+				/*
+				 * IMAGE 253/254 -- CONTENT cross-check, now READ-ONLY.
+				 *
+				 * Builds a second mapping directly from bo->sgt->sgl --
+				 * the very pages the GPU is handed -- and compares its
+				 * contents against the msm_gem_get_vaddr() view. This is
+				 * the only trustworthy aliasing check we have: image 253
+				 * showed 6/6 IDENTICAL CONTENT, which means the BOS[]
+				 * dump has been reading real buffer memory all along.
+				 *
+				 * Crucially this WRITES NOTHING. Image 253 also had a tag
+				 * write (0x5C5C5C5C into the first 16 dwords of every
+				 * submitted BO) which was needed to prove aliasing via
+				 * userspace. That tag corrupted every subsequent content
+				 * measurement -- BOs came back showing exactly 16 nonzero
+				 * dwords, which was the tag, not data. Now that the
+				 * cross-check is in-kernel and needs no tag, the write is
+				 * gone and the dump reports the buffer as it really is.
+				 */
+
+				/*
+				 * IMAGE 253/254 -- CONTENT cross-check, READ-ONLY.
+				 *
+				 * Builds a second mapping directly from bo->sgt->sgl --
+				 * the very pages the GPU is handed -- and compares its
+				 * contents against the msm_gem_get_vaddr() view. This is
+				 * the only trustworthy aliasing check we have: image 253
+				 * showed 6/6 IDENTICAL CONTENT, which means the BOS[]
+				 * dump has been reading real buffer memory all along.
+				 *
+				 * WRITES NOTHING. Image 253 also tagged the first 16
+				 * dwords of every submitted BO with 0x5C5C5C5C to prove
+				 * aliasing via userspace; that tag corrupted every
+				 * later measurement (BOs came back with exactly 16
+				 * nonzero dwords -- the tag, not data). With the check
+				 * in-kernel the write is unnecessary, so it is gone.
+				 */
+				if (have_sgt) {
+					struct page **sp;
+					struct scatterlist *sg = bo->sgt->sgl;
+					unsigned int nents = bo->sgt->nents;
+					unsigned int nwalk = 0;
+
+					if (!nents)
+						goto xchk_done;
+
+					sp = kmalloc_array(nents, sizeof(*sp),
+						GFP_KERNEL);
+					if (!sp)
+						goto xchk_done;
+
+					/* this 4.14 tree has no sg_get_pages(), so
+					 * walk the scatterlist by hand */
+					while (sg && nwalk < nents) {
+						sp[nwalk++] = sg_page(sg);
+						if (sg_is_last(sg))
+							break;
+						sg = sg_next(sg);
+					}
+
+					if (nwalk) {
+						void *v2 = vmap(sp, nwalk,
+							VM_MAP,
+							pgprot_writecombine(PAGE_KERNEL));
+						if (v2) {
+							uint32_t *q = v2;
+							bool same = true;
+
+							for (j = 0; j < 16 && j < ndw; j++)
+								if (q[j] != p[j])
+									same = false;
+
+							pr_info("BOSXCHK[seq=%u] bo[%u] sgt-map=%px sgt-first: %08x %08x %08x %08x | vaddr-map first: %08x %08x %08x %08x => %s\n",
+								submit->seqno, b, v2,
+								q[0], q[1], q[2], q[3],
+								p[0], p[1], p[2], p[3],
+								same ? "IDENTICAL CONTENT"
+								     : "*** DIFFERENT MEMORY ***");
+							vunmap(v2);
+						} else {
+							pr_info("BOSXCHK[seq=%u] bo[%u] sgt vmap failed\n",
+								submit->seqno, b);
+						}
+					}
+					kvfree(sp);
+				}
+xchk_done:
+				;
+			}
+
+			msm_gem_put_vaddr(&bo->base);
+		}
+	}
+
+	/*
+	 * TEMPORARY image 218 -- MEASUREMENT CONTROL.
+	 *
+	 * Image 217 gated every diagnostic on `submit->seqno <= 3`, which was
+	 * correct when the only thing we ran was the first submit. It is now
+	 * actively harmful: after three submits the dump goes silent forever,
+	 * so a later run produces NO output at all and we cannot tell "nothing
+	 * was submitted" from "we stopped printing". That is exactly how image
+	 * 217's 319-dword IB got mistaken for the glClear stream -- it was
+	 * captured from the first run, and every subsequent run was invisible.
+	 *
+	 * A runtime parameter is the right control: default off (zero cost),
+	 * enable only around the run being measured, and disable before any
+	 * reboot so the log cannot flood.
+	 */
+
+	/* Invalidate CCU depth and color */
+	OUT_PKT7(ring, CP_EVENT_WRITE, 1);
+	OUT_RING(ring, PC_CCU_INVALIDATE_DEPTH);
+
+	OUT_PKT7(ring, CP_EVENT_WRITE, 1);
+	OUT_RING(ring, PC_CCU_INVALIDATE_COLOR);
+
+	/*
+	 * IMAGE 270 -- page table prologue (upstream's a6xx_set_pagetable()).
+	 *
+	 * Upstream emits this on every context change and this tree emits it
+	 * nowhere, despite having identified the omission itself in the image-209
+	 * diagnostic comment at a6xx_gpu.c:1598-1601 ("upstream's a6xx_submit()
+	 * emits a prologue we emit nowhere: ... CP_SMMU_TABLE_UPDATE with
+	 * TTBR0+ASID").  The corpus later retired the hypothesis on the premise
+	 * that the packet is "v5.10+ only"; the PM4 spec says otherwise
+	 * (CP_SMMU_TABLE_UPDATE = 0x53, variants="A5XX-") and the vendor KGSL
+	 * driver emits it on this silicon class at adreno_iommu.c:590 with the
+	 * comment "CP switches the pagetable and flushes the Caches".
+	 *
+	 * TTBR0 is the base the shader/interconnect domain translates through.
+	 * Without it, shader-domain stores (RB render stores and SP compute
+	 * stores alike) have no valid translation -- which is exactly the
+	 * observed signature: Mesa's state is live and workload-tracking in the
+	 * registers, no fault is ever raised, the CP still writes DDR
+	 * (memptrs->fence increments), and nothing from any shader reaches
+	 * memory.
+	 *
+	 * Deliberately minimal, unlike upstream: only the packet itself.  The
+	 * CP_MEM_WRITE of TTBR0 to the memstore is upstream's "for debugging /
+	 * preemption" and is skipped because our memptrs layout has no PT_INFO
+	 * slot.  CP_SET_PROTECTED_MODE is likewise skipped -- our tree never
+	 * enables protected mode, so there is nothing to turn off.
+	 *
+	 * This is command-stream generation, not a hardware register write: the
+	 * same OUT_PKT7 mechanism Mesa already uses successfully, and it is
+	 * emitted before the existing cmd loop, leaving that loop untouched.
+	 * If the SMMU cannot supply a page table yet the submit proceeds without
+	 * it -- a missing prologue must never fail a submit.
+	 */
+	{
+		struct msm_mmu *mmu = (gpu->aspace) ? gpu->aspace->mmu : NULL;
+		uint64_t ttbr = 0;
+		int asid = 0;
+
+		if (mmu && mmu->funcs &&
+		    mmu->funcs->get_pagetable_params &&
+		    !mmu->funcs->get_pagetable_params(mmu, &ttbr, &asid)) {
+			/*
+			 * ttbr comes back with the ASID already at bit 48, and the
+			 * packet wants TTBR0_LO = bits[31:0], TTBR0_HI =
+			 * bits[63:32] -- so the two halves are simply the two
+			 * halves.  No shift constant needed, which matters because
+			 * TTBRn_ASID_SHIFT lives in a private IOMMU header.
+			 */
+			OUT_PKT7(ring, CP_SMMU_TABLE_UPDATE, 4);
+			OUT_RING(ring, lower_32_bits(ttbr));
+			OUT_RING(ring, upper_32_bits(ttbr));
+			OUT_RING(ring, 0);	/* CONTEXTIDR */
+			OUT_RING(ring, 0);	/* CONTEXTBANK */
+			pr_info("PTU270[seq=%u] ttbr0=0x%llx asid=%d\n",
+				submit->seqno, (unsigned long long)ttbr, asid);
+		} else {
+			pr_info("PTU270[seq=%u] no pagetable params, prologue skipped\n",
+				submit->seqno);
+		}
+	}
+
+	/* Submit the commands */
+	for (i = 0; i < submit->nr_cmds; i++) {
+		switch (submit->cmd[i].type) {
+		case MSM_SUBMIT_CMD_IB_TARGET_BUF:
+			/*
+			 * TEMPORARY image 219 -- MEASUREMENT ONLY.
+			 *
+			 * Image 218 dumped only CMD_BUF, and only one IB per
+			 * submit came back. But the captured stream contains
+			 * THREE nested CP_INDIRECT_BUFFER references:
+			 *
+			 *   dword 199: iova 0x2c000, 77 dwords
+			 *   dword 304: iova 0x2d000, 18 dwords
+			 *   dword 316: iova 0x2d050, 19 dwords
+			 *
+			 * Those buffers are submitted as IB_TARGET_BUF. Per
+			 * include/uapi/drm/msm_drm.h: "IB_TARGET_BUF - this cmd
+			 * buffer is an IB target. Reloc's are processed
+			 * normally, but the kernel does not setup an IB to this
+			 * buffer in the first-level ringbuffer". So they are
+			 * deliberately NOT emitted as ring references -- and
+			 * image 218's dump skipped them for the very same
+			 * reason, which is why they were invisible.
+			 *
+			 * These are where the actual render commands live: the
+			 * clear (tile_setup) and the draw/prologue buffers are
+			 * all IB targets. So the one buffer we did dump was
+			 * only ever the envelope. This is the same class of
+			 * blind spot as image 218 fixed one level up.
+			 */
+			if (ibdump &&
+			    submit->cmd[i].idx < submit->nr_bos) {
+				struct msm_gem_object *tbo =
+					submit->bos[submit->cmd[i].idx].obj;
+				void *tvaddr;
+
+				pr_info("IBTGT[seq=%u] cmd[%u] iova=0x%llx size=%u bo=%px\n",
+					submit->seqno, i,
+					(unsigned long long)submit->cmd[i].iova,
+					submit->cmd[i].size, (void *)tbo);
+
+				if (!tbo)
+					break;
+
+				tvaddr = msm_gem_get_vaddr(&tbo->base);
+				if (IS_ERR(tvaddr)) {
+					pr_info("IBTGT[seq=%u] cmd[%u] vmap failed err=%ld\n",
+						submit->seqno, i,
+						PTR_ERR(tvaddr));
+					break;
+				}
+
+				{
+					uint32_t *tp = tvaddr;
+					unsigned int tndw =
+						submit->cmd[i].size;
+					unsigned int j;
+
+					if (tndw > tbo->base.size / 4)
+						tndw = tbo->base.size / 4;
+
+					pr_info("IBTGT[seq=%u] cmd[%u] ndwords=%u\n",
+						submit->seqno, i, tndw);
+
+					for (j = 0; j < tndw; j++)
+						pr_info("IBTGT[seq=%u] cmd[%u] [%03u] = 0x%08x\n",
+							submit->seqno, i, j,
+							tp[j]);
+				}
+
+				msm_gem_put_vaddr(&tbo->base);
+			}
+			break;
+		case MSM_SUBMIT_CMD_CTX_RESTORE_BUF:
+			if (priv->lastctx == ctx)
+				break;
+		case MSM_SUBMIT_CMD_BUF:
+			/*
+			 * TEMPORARY image 217 -- MEASUREMENT ONLY.
+			 *
+			 * Every dump we have taken so far (RINGCPU) only shows
+			 * what a6xx_submit() itself writes into the ring. Mesa's
+			 * actual render commands are NOT in the ring: they live
+			 * in this indirect buffer, which the ring references by
+			 * address only. So we have been looking at the envelope
+			 * and never at the letter.
+			 *
+			 * type-7 opcode 0x3f is CP_INDIRECT_BUFFER (not some
+			 * bookkeeping packet), so the [hdr, addr_lo, addr_hi,
+			 * dwords] quad we kept seeing IS a real IB reference.
+			 *
+			 * cmd[i].idx indexes submit->bos[], which holds the GEM
+			 * object backing this cmdstream, so we can map it and
+			 * read the real commands. This is the first measurement
+			 * that can show whether Mesa emitted a clear at all,
+			 * which clear path it took (GMEM RB_BLIT with
+			 * CLEAR_MASK vs bypass CP_BLIT vs nothing), and whether
+			 * the stream is well-formed.
+			 */
+			if (ibdump &&
+			    submit->cmd[i].idx < submit->nr_bos) {
+				struct msm_gem_object *bo =
+					submit->bos[submit->cmd[i].idx].obj;
+				void *vaddr;
+
+				pr_info("IBDUMP[seq=%u] cmd[%u] type=%u size=%u iova=0x%llx bo=%px\n",
+					submit->seqno, i, submit->cmd[i].type,
+					submit->cmd[i].size,
+					(unsigned long long)submit->cmd[i].iova,
+					(void *)bo);
+
+				if (!bo)
+					goto ibdump_done;
+
+				vaddr = msm_gem_get_vaddr(&bo->base);
+				if (IS_ERR(vaddr)) {
+					pr_info("IBDUMP[seq=%u] cmd[%u] vmap failed err=%ld\n",
+						submit->seqno, i,
+						PTR_ERR(vaddr));
+					goto ibdump_done;
+				}
+
+				pr_info("IBDUMP[seq=%u] cmd[%u] vaddr=%px bo_size=%u\n",
+					submit->seqno, i, vaddr, bo->base.size);
+
+				{
+					uint32_t *p = vaddr;
+					unsigned int ndw =
+						submit->cmd[i].size;
+					unsigned int j;
+
+					/* size is in dwords */
+					if (ndw > bo->base.size / 4)
+						ndw = bo->base.size / 4;
+
+					pr_info("IBDUMP[seq=%u] cmd[%u] ndwords=%u\n",
+						submit->seqno, i, ndw);
+
+					for (j = 0; j < ndw; j++)
+						pr_info("IBDUMP[seq=%u] cmd[%u] [%03u] = 0x%08x\n",
+							submit->seqno, i, j, p[j]);
+				}
+
+				msm_gem_put_vaddr(&bo->base);
+			}
+ibdump_done:
+			OUT_PKT7(ring, CP_INDIRECT_BUFFER_PFE, 3);
+			OUT_RING(ring, lower_32_bits(submit->cmd[i].iova));
+			OUT_RING(ring, upper_32_bits(submit->cmd[i].iova));
+			OUT_RING(ring, submit->cmd[i].size);
+			break;
+		}
+	}
+
+	/*
+	 * IMAGE 264 -- capture the render backend's registers AFTER the command
+	 * stream has run, using the CP's own context.  Must sit here, between
+	 * the indirect buffer and CP_SCRATCH(2), so the values are post-render.
+	 */
+	a6xx_ibcap_emit(gpu, ring);
+
+	/* Write the fence to the scratch register */
+	OUT_PKT4(ring, REG_A6XX_CP_SCRATCH_REG(2), 1);
+	OUT_RING(ring, submit->seqno);
+
+	/*
+	 * Execute a CACHE_FLUSH_TS event. This will ensure that the
+	 * timestamp is written to the memory and then triggers the interrupt
+	 */
+	OUT_PKT7(ring, CP_EVENT_WRITE, 4);
+	OUT_RING(ring, CACHE_FLUSH_TS | (1 << 31));
+	OUT_RING(ring, lower_32_bits(rbmemptr(ring, fence)));
+	OUT_RING(ring, upper_32_bits(rbmemptr(ring, fence)));
+	OUT_RING(ring, submit->seqno);
+
+	/*
+	 * TEMPORARY image 209 -- MEASUREMENT ONLY. Changes no behaviour.
+	 *
+	 * Dumps the CPU-side view of what we just wrote, immediately after
+	 * the stream is built and before a6xx_flush() kicks the ring. This is
+	 * the one measurement that discriminates between the two families of
+	 * remaining explanation for "GPU consumes the ring but nothing
+	 * executes" (RPTR chases WPTR, CP_SCRATCH_REG2 = 0, fence stuck 0/1):
+	 *
+	 *   1. If the dwords below are the real packets, the CPU side of the
+	 *      ring is correct and the fault is GPU-side (page table / SMMU
+	 *      translation -- upstream's a6xx_submit() emits a prologue we
+	 *      emit nowhere: CP_SET_PROTECTED_MODE=0, PERFCTR_SRAM_INIT_CMD,
+	 *      and CP_SMMU_TABLE_UPDATE with TTBR0+ASID).
+	 *   2. If they are garbage, zeros or stale, the CPU is not really
+	 *      writing the ring memory the GPU reads, and coherency is live
+	 *      after all.
+	 *
+	 * ring->cur is the offset the GPU is being pointed at; the stream was
+	 * written from ring->start up to ring->next. Only dwords below cur can
+	 * have been written this submit.
+	 *
+	 * TEMPORARY image 213 -- FIX to the image 209/211/212 version of this
+	 * dump. It printed j from cur-16 to cur, i.e. dwords BELOW the commit
+	 * point, which is the PREVIOUS submit's content. On image 212 that
+	 * meant we captured the CP_ME_INIT packet left behind by
+	 * a6xx_cp_init() during bring-up instead of the stream we had just
+	 * written. The window that actually matters is cur .. next, because
+	 * ring->cur is not advanced until a6xx_flush() below.
+	 */
+	if (ibdump) {
+		unsigned int cur = ring->cur - ring->start;
+		unsigned int next = ring->next - ring->start;
+		unsigned int j;
+
+		pr_info("RINGCPU[seq=%u] start=%px cur=%u next=%u size=%u iova=0x%llx ndwords=%u\n",
+			submit->seqno, (void *)ring->start, cur, next,
+			ring->size, (unsigned long long)gpu->rb_iova,
+			next - cur);
+		pr_info("RINGCPU[seq=%u] memptrs=%px memptrs_iova=0x%llx fence=%u rptr=%u\n",
+			submit->seqno, (void *)ring->memptrs,
+			(unsigned long long)ring->memptrs_iova,
+			ring->memptrs ? ring->memptrs->fence : 0xffffffff,
+			ring->memptrs ? ring->memptrs->rptr : 0xffffffff);
+		for (j = cur; j < next && j < ring->size / 4; j++)
+			pr_info("RINGCPU[seq=%u] [%03u] = 0x%08x\n",
+				submit->seqno, j, ring->start[j]);
+	}
+
+	a6xx_flush(gpu, ring);
+
+	/*
+	 * IMAGE 261 -- sample the ring WHILE the submission is in flight, not
+	 * 50 ms after it has finished.  See a6xx_trace_burst() for why every
+	 * other verdict this project drew was a single post-hoc point sample.
+	 */
+	a6xx_trace_burst(gpu, ring, submit->seqno);
+
+	rbobs_poll(gpu, ring, submit->seqno);
+
+	/*
+	 * TEMPORARY image 212 -- MEASUREMENT ONLY. Decode the interrupt the
+	 * submit produced.
+	 *
+	 * This is the single most informative register pair we can read. Until
+	 * now we have only counted IRQs ("one per submit") without knowing
+	 * WHICH bit fired, and that count has been ambiguous between success
+	 * and failure the whole time.
+	 *
+	 *   RBBM_INT_0 bit 20 (0x00100000) = CP_CACHE_FLUSH_TS  -> SUCCESS,
+	 *                                                          the fence
+	 *                                                          write landed
+	 *   RBBM_INT_0 bit 23 (0x00800000) = RBBM_HANG_DETECT   -> a hang report
+	 *   RBBM_INT_0 bit  1 (0x00000002) = CP_AHB_ERROR      -> the CP tried
+	 *                                                          an address it
+	 *                                                          could not
+	 *                                                          translate
+	 *
+	 * CP_INTERRUPT_STATUS then says which flavour of CP fault:
+	 *   0x01 CP_OPCODE_ERROR   0x02 CP_UCODE_ERROR
+	 *   0x04 CP_HW_FAULT_ERROR 0x10 REGISTER_PROTECTION_ERROR
+	 *   0x20 CP_AHB_ERROR      0x40 VSD_PARITY_ERROR
+	 *   0x80 CP_ILLEGAL_INSTR_ERROR
+	 *
+	 * Motivation: memptrs_iova is 0 (confirmed three boots), so
+	 * rbmemptr(ring, fence) == 0x4 -- an address that is not a mapped GPU
+	 * VA. If the theory is right we should see an AHB error rather than
+	 * CACHE_FLUSH_TS, and CP_SCRATCH_REG(2) staying 0 is consistent: the
+	 * CP halts on the first faulting write, which is the CACHE_FLUSH_TS
+	 * itself in a v4.19 stream (there is no pagetable packet before it).
+	 *
+	 * A short delay lets the CP actually retire the stream before we read.
+	 */
+	if (ibdump) {
+		msleep(50);
+		pr_info("CPINT[seq=%u] RBBM_INT_0_STATUS=0x%08x INT_0_MASK=0x%08x CP_INTERRUPT_STATUS=0x%08x CP_SQE_STAT_DATA=0x%08x\n",
+			submit->seqno,
+			gpu_read(gpu, REG_A6XX_RBBM_INT_0_STATUS),
+			gpu_read(gpu, REG_A6XX_RBBM_INT_0_MASK),
+			gpu_read(gpu, REG_A6XX_CP_INTERRUPT_STATUS),
+			gpu_read(gpu, REG_A6XX_CP_SQE_STAT_DATA));
+		pr_info("CPINT[seq=%u] decodes: cache_flush_ts=%d hang_detect=%d ahb_err_rb=%d | opcode=%d ucode=%d hw_fault=%d prot=%d ahb_err_cp=%d vsd=%d illegal=%d\n",
+			submit->seqno,
+			!!(gpu_read(gpu, REG_A6XX_RBBM_INT_0_STATUS) & A6XX_RBBM_INT_0_MASK_CP_CACHE_FLUSH_TS),
+			!!(gpu_read(gpu, REG_A6XX_RBBM_INT_0_STATUS) & A6XX_RBBM_INT_0_MASK_RBBM_HANG_DETECT),
+			!!(gpu_read(gpu, REG_A6XX_RBBM_INT_0_STATUS) & A6XX_RBBM_INT_0_MASK_CP_AHB_ERROR),
+			!!(gpu_read(gpu, REG_A6XX_CP_INTERRUPT_STATUS) & A6XX_CP_INT_CP_OPCODE_ERROR),
+			!!(gpu_read(gpu, REG_A6XX_CP_INTERRUPT_STATUS) & A6XX_CP_INT_CP_UCODE_ERROR),
+			!!(gpu_read(gpu, REG_A6XX_CP_INTERRUPT_STATUS) & A6XX_CP_INT_CP_HW_FAULT_ERROR),
+			!!(gpu_read(gpu, REG_A6XX_CP_INTERRUPT_STATUS) & A6XX_CP_INT_CP_REGISTER_PROTECTION_ERROR),
+			!!(gpu_read(gpu, REG_A6XX_CP_INTERRUPT_STATUS) & A6XX_CP_INT_CP_AHB_ERROR),
+			!!(gpu_read(gpu, REG_A6XX_CP_INTERRUPT_STATUS) & A6XX_CP_INT_CP_VSD_PARITY_ERROR),
+			!!(gpu_read(gpu, REG_A6XX_CP_INTERRUPT_STATUS) & A6XX_CP_INT_CP_ILLEGAL_INSTR_ERROR));
+		pr_info("CPINT[seq=%u] scratch2=0x%08x fence=%u rptr=%u RB_RB_WPTR=0x%x RB_RB_RPTR=0x%x\n",
