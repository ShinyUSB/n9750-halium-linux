+			gpu_read(gpu, REG_A6XX_CP_SCRATCH_REG(2)),
+			ring->memptrs ? ring->memptrs->fence : 0xffffffff,
+			ring->memptrs ? ring->memptrs->rptr : 0xffffffff,
+			gpu_read(gpu, REG_A6XX_CP_RB_WPTR),
+			gpu_read(gpu, REG_A6XX_CP_RB_RPTR));
+		/*
+		 * TEMPORARY image 213 -- where is the SQE actually stopped?
+		 *
+		 * Image 212 established that the CP retires NOTHING (all interrupt
+		 * status zero, scratch2=0, fence=0) while still advancing RPTR
+		 * and mirroring it into memptrs->rptr. Even the CP_ME_INIT that
+		 * a6xx_cp_init() wrote during bring-up is still sitting
+		 * unretired in the ring. So the question is not "why did the
+		 * submit fail" but "why has the SQE never started".
+		 *
+		 * CP_SQE_STAT_ADDR says which SQE state the sequencer is in and
+		 * CP_SQE_STAT_DATA carries the payload for that state. Together
+		 * with RBBM_STATUS they tell us whether the SQE is idle, busy,
+		 * waiting on a timestamp, or wedged on an error.
+		 */
+		if (ibdump) {
+		/*
+		 * TEMPORARY image 221 -- DIAGNOSTIC.
+		 *
+		 * Established so far (all proven this session):
+		 *   - Mesa's nested indirect buffer IS fetched and executed:
+		 *     CP_EVENT_WRITE(timestamp) values land in control memory,
+		 *     incrementing once per submit.
+		 *   - The 2D blit command stream is complete and correct,
+		 *     including RB_DBG_ECO_CNTL=0x04100000 (the A640
+		 *     BLIT_OP_SCALE workaround) bracketing CP_BLIT.
+		 *   - Yet NO data write ever lands. Both the 2D blitter and the
+		 *     shader-based util_blitter render pass fail identically,
+		 *     with UBWC on and off, sysmem and gmem.
+		 *
+		 * Everything we have ever proven about "the GPU runs" is
+		 * CP-domain: CP_SCRATCH_REG(2), the ring fence, CP_EVENT_WRITE.
+		 * Blits and render passes are executed by RB/SP/UCHE. We have
+		 * never once shown those blocks are clocked.
+		 *
+		 * So: read back every clock/power gate we can see and check for
+		 * a block that is off while CP is on. RBBM_CLOCK_CNTL=0x8aa8aa02
+		 * is the only one ever logged, and it is an aggregate mask --
+		 * it says nothing about the CLOCK_CNTL2 per-block registers for
+		 * RB, SP, UCHE or TP, the GMU
+		 * SPTPRAC clock control, or per-block slave counters.
+		 */
+		{
+			static const struct { u32 reg; const char *name; } clk[] = {
+				{ REG_A6XX_RBBM_CLOCK_CNTL,		"CLOCK_CNTL" },
+				{ REG_A6XX_RBBM_CLOCK_CNTL2_RB0,	"CLOCK_CNTL2_RB0" },
+				{ REG_A6XX_RBBM_CLOCK_CNTL2_RB1,	"CLOCK_CNTL2_RB1" },
+				{ REG_A6XX_RBBM_CLOCK_CNTL2_RB2,	"CLOCK_CNTL2_RB2" },
+				{ REG_A6XX_RBBM_CLOCK_CNTL2_RB3,	"CLOCK_CNTL2_RB3" },
+				{ REG_A6XX_RBBM_CLOCK_CNTL2_SP0,	"CLOCK_CNTL2_SP0" },
+				{ REG_A6XX_RBBM_CLOCK_CNTL2_SP1,	"CLOCK_CNTL2_SP1" },
+				{ REG_A6XX_RBBM_CLOCK_CNTL2_SP2,	"CLOCK_CNTL2_SP2" },
+				{ REG_A6XX_RBBM_CLOCK_CNTL2_SP3,	"CLOCK_CNTL2_SP3" },
+				{ REG_A6XX_RBBM_CLOCK_CNTL2_UCHE,	"CLOCK_CNTL2_UCHE" },
+				{ REG_A6XX_RBBM_CLOCK_CNTL2_TP0,	"CLOCK_CNTL2_TP0" },
+				{ REG_A6XX_RBBM_CLOCK_CNTL2_RAC,	"CLOCK_CNTL2_RAC" },
+				{ REG_A6XX_RBBM_CLOCK_CNTL_SP0,	"CLOCK_CNTL_SP0" },
+				{ REG_A6XX_RBBM_CLOCK_CNTL_SP1,	"CLOCK_CNTL_SP1" },
+			};
+			struct a6xx_gmu *gmu = &to_a6xx_gpu(to_adreno_gpu(gpu))->gmu;
+			unsigned int c;
+
+			for (c = 0; c < ARRAY_SIZE(clk); c++)
+				pr_info("CLKCHK[seq=%u] %-16s 0x%08x\n",
+					submit->seqno, clk[c].name,
+					gpu_read(gpu, clk[c].reg));
+
+			pr_info("CLKCHK[seq=%u] %-16s 0x%08x\n", submit->seqno,
+				"GMU_SPTPRAC_CLKCTL",
+				gmu_read(gmu, REG_A6XX_GPU_GMU_GX_SPTPRAC_CLOCK_CONTROL));
+			pr_info("CLKCHK[seq=%u] %-16s 0x%08x\n", submit->seqno,
+				"GMU_SPTPRAC_PWRCTL",
+				gmu_read(gmu, REG_A6XX_GMU_GX_SPTPRAC_POWER_CONTROL));
+			pr_info("CLKCHK[seq=%u] %-16s 0x%08x\n", submit->seqno,
+				"RBBM_STATUS",
+				gpu_read(gpu, REG_A6XX_RBBM_STATUS));
+			pr_info("CLKCHK[seq=%u] %-16s 0x%08x\n", submit->seqno,
+				"CP_RB_CNTL",
+				gpu_read(gpu, REG_A6XX_CP_RB_CNTL));
+			pr_info("CLKCHK[seq=%u] %-16s 0x%08x\n", submit->seqno,
+				"RB_CCU_CNTL",
+				gpu_read(gpu, REG_A6XX_RB_CCU_CNTL));
+		}
+	}
+
+		pr_info("CPINT[seq=%u] SQE_STAT_ADDR=0x%08x SQE_STAT_DATA=0x%08x RBBM_STATUS=0x%08x SQE_CNTL=0x%x SQE_BASE=0x%llx\n",
+			submit->seqno,
+			gpu_read(gpu, REG_A6XX_CP_SQE_STAT_ADDR),
+			gpu_read(gpu, REG_A6XX_CP_SQE_STAT_DATA),
+			gpu_read(gpu, REG_A6XX_RBBM_STATUS),
+			gpu_read(gpu, REG_A6XX_CP_SQE_CNTL),
+			(unsigned long long)gpu_read64(gpu,
+				REG_A6XX_CP_SQE_INSTR_BASE_LO,
+				REG_A6XX_CP_SQE_INSTR_BASE_HI));
+		/*
+		 * TEMPORARY image 214 -- read the SQE's indexed debug registers
+		 * PROPERLY, and read back the bring-up values that research says
+		 * are the remaining candidates.
+		 *
+		 * CP_SQE_STAT_ADDR/CP_SQE_STAT_DATA are NOT a status/state pair.
+		 * ADDR is a WRITE-ONLY SELECTOR: you write an index, then read
+		 * DATA to pop the corresponding debug word. Successive reads pop
+		 * out associated state, so order matters. Index 0 is the SQE
+		 * firmware PC -- the single most informative value available.
+		 * Index 1 is the current packet header.
+		 *
+		 *   (Mesa crashdec.c dump_cp_sqe_stat: stat[0] = "PC",
+		 *    a6xx_gpu_state.h a6xx_indexed_reglist[] "CP_SQE_STAT" count
+		 *    0x33; KGSL adreno_a6xx_snapshot.c does the same.)
+		 *
+		 * Our earlier "SQE_STAT_ADDR=0x1" reading was meaningless -- it
+		 * was just the last index written, which is exactly the 1 that
+		 * KGSL writes to fetch the offending opcode.
+		 *
+		 * Research also established:
+		 *   - RBBM_STATUS bit 0 is CP_AHB_BUSY_CX_MASTER, the ONE bit
+		 *     upstream's idle check masks out, so 0x1 means IDLE.
+		 *   - CP_RB_RPTR is advanced by the ROQ DMA prefetcher, which is
+		 *     a different clock domain from the SQE. RPTR==WPTR with an
+		 *     idle SQE is what a STOPPED SQE looks like, not a finished
+		 *     one. So we have never seen anything retire.
+		 *   - bring-up order and CP_RB_CNTL=0x20c match v4.19 exactly.
+		 */
+		{
+			uint32_t sqe_pc, sqe_pkt, clk_cntl, hang_cntl;
+
+			/* Indexed register protocol: write index, then pop DATA. */
+			gpu_write(gpu, REG_A6XX_CP_SQE_STAT_ADDR, 0);
+			sqe_pc = gpu_read(gpu, REG_A6XX_CP_SQE_STAT_DATA);
+
+			gpu_write(gpu, REG_A6XX_CP_SQE_STAT_ADDR, 1);
+			sqe_pkt = gpu_read(gpu, REG_A6XX_CP_SQE_STAT_DATA);
+
+			clk_cntl = gpu_read(gpu, REG_A6XX_RBBM_CLOCK_CNTL);
+			hang_cntl = gpu_read(gpu,
+				REG_A6XX_RBBM_INTERFACE_HANG_INT_CNTL);
+
+			pr_info("SQE214: sqe_pc=0x%08x sqe_cur_pkt=0x%08x\n",
+				sqe_pc, sqe_pkt);
+			pr_info("SQE214: RBBM_CLOCK_CNTL=0x%08x (want 0x8aa8aa82 on a640) HANG_INT_CNTL=0x%08x (want 0x401fffff)\n",
+				clk_cntl, hang_cntl);
+			pr_info("SQE214: RBBM_STATUS=0x%08x (cp_busy=%d ahb_cp=%d ahb_cx=%d) INT_0_MASK=0x%08x CP_PROTECT_CNTL=0x%08x RB_CNTL=0x%08x\n",
+				gpu_read(gpu, REG_A6XX_RBBM_STATUS),
+				!!(gpu_read(gpu, REG_A6XX_RBBM_STATUS) & A6XX_RBBM_STATUS_CP_BUSY),
+				!!(gpu_read(gpu, REG_A6XX_RBBM_STATUS) & A6XX_RBBM_STATUS_CP_AHB_BUSY_CP_MASTER),
+				!!(gpu_read(gpu, REG_A6XX_RBBM_STATUS) & A6XX_RBBM_STATUS_CP_AHB_BUSY_CX_MASTER),
+				gpu_read(gpu, REG_A6XX_RBBM_INT_0_MASK),
+				gpu_read(gpu, REG_A6XX_CP_PROTECT_CNTL),
+				gpu_read(gpu, REG_A6XX_CP_RB_CNTL));
+		}
+	}
+}
