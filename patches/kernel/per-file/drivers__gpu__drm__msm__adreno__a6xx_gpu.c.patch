+static int a6xx_pm_suspend(struct msm_gpu *gpu)
+{
+	struct adreno_gpu *adreno_gpu = to_adreno_gpu(gpu);
+	struct a6xx_gpu *a6xx_gpu = to_a6xx_gpu(adreno_gpu);
+
+	/*
+	 * TEMPORARY image 210 -- allow a genuine re-init after suspend.
+	 *
+	 * msm_gpu_hw_init() refuses to re-run while hw_init_done is set, which
+	 * is what stops a second bring-up from reprogramming a live GPU (the
+	 * image 209 freezes). A real suspend/resume must still be able to
+	 * re-initialise, so clear the latch here. No printk: this is the
+	 * suspend path, and images 179-181 established that a printk here can
+	 * wedge the caller inside console_unlock.
+	 */
+	gpu->hw_init_done = false;
+
+	/*
+	 * Make sure the GMU is idle before continuing (because some transitions
+	 * may use VBIF
+	 *
+	 * Image 182: the enter/wait_for_idle prints are gone unconditionally
+	 * (not just behind a6xx_instr). Images 179-181 proved the FIRST of
+	 * these two printks wedges the caller inside console_unlock
+	 * (CPU3, RCU stalls 6302->63017 jiffies): the writer never reaches
+	 * wait_for_idle at all. A printk that can cost the machine's
+	 * responsiveness has no place on the suspend path.
+	 */
+	a6xx_gmu_wait_for_idle(a6xx_gpu);
+	if (a6xx_instr)
+		pr_info("SSTEP171: wait_for_idle done\n");
+
+	/*
+	 * IMAGE 245 -- do NOT halt VBIF on a GBIF part.
+	 *
+	 * This was the pm_runtime livelock: runtime_status pinned at
+	 * "suspending", active_time climbing ~1000 ms/s, suspended_time frozen,
+	 * RCU stalls every ~63 s in pm_runtime_work, task state R. No panic, so no
+	 * pstore. It looked like general instability for months.
+	 *
+	 * RETRACTED: spin_until() is NOT the kernel's unbounded macro here. It is
+	 * locally redefined at adreno_gpu.h:178 and bounded to 1000 ms
+	 * (ADRENO_IDLE_TIMEOUT), so this poll cannot livelock. The original
+	 * diagnosis in ROOT-CAUSE-GLREADPIXELS-LIVELOCK.md was wrong; see
+	 * RETRACTION-VBIF-LIVELOCK.md.
+	 *
+	 * The GBIF guard below is still correct on its own merits -- upstream
+	 * gates this sequence on !a6xx_has_gbif() (a6xx_gpu.c:2179) and a640 IS
+	 * a GBIF part, so upstream never touches VBIF_XIN_HALT_CTRL0 here at
+	 * all. It was declined as cosmetic-only, so the sequence is restored
+	 * verbatim and this note is all that remains of it.
+	 */
+	gpu_write(gpu, REG_A6XX_VBIF_XIN_HALT_CTRL0, 0xf);
+	spin_until((gpu_read(gpu, REG_A6XX_VBIF_XIN_HALT_CTRL1) & 0xf) == 0xf);
+	gpu_write(gpu, REG_A6XX_VBIF_XIN_HALT_CTRL0, 0);
+	if (a6xx_instr)
+		pr_info("SSTEP171: vbif halt done\n");
+
+	return a6xx_gmu_stop(a6xx_gpu);
+}
+
+/*
+ * TEMPORARY image 184 -- PROMOTE (Mesa unblock). MSM_PARAM_TIMESTAMP is
+ * the FIRST ioctl Mesa issues when it creates a context, so anything
+ * that wedges here blocks all of userspace before a surface exists.
+ *
+ * Two hazards, both proven live (MESA-RENDER-ATTEMPT-1.md):
+ *
+ *  1. adreno_get_param() wraps this in pm_runtime_get_sync/put_autosuspend.
+ *     We leave the GPU powered after bring-up (slumber off since 182), so
+ *     the extra ref is pure risk: python3 sat in D inside rpm_resume for
+ *     minutes holding it. The read needs a live GPU, not a power
+ *     transition.
+ *
+ *  2. GMU_OOB_GPU_SET is a live handshake with the GMU firmware. When the
+ *     firmware is quiet the set never ACKs and this function never
+ *     returns -- an uninterruptible wedge from an ioctl, the worst
+ *     possible failure mode. A timestamp is diagnostics; it must never be
+ *     able to hang a process.
+ *
+ * So: check the OOB result, read either way, and only clear when we own
+ * it. A quiet firmware yields a stale-but-harmless timestamp, exactly
+ * what the -110 paths already teach us to accept everywhere else.
+ */
+static int a6xx_get_timestamp(struct msm_gpu *gpu, uint64_t *value)
+{
+	struct adreno_gpu *adreno_gpu = to_adreno_gpu(gpu);
+	struct a6xx_gpu *a6xx_gpu = to_a6xx_gpu(adreno_gpu);
+	int oob_ret;
+
+	/* Only meaningful if the GMU is actually managing our power state. */
+	oob_ret = a6xx_gmu_set_oob(&a6xx_gpu->gmu, GMU_OOB_GPU_SET);
+	if (oob_ret)
+		pr_warn_ratelimited("a6xx: timestamp: GPU_SET OOB ret=%d, reading anyway\n",
+			oob_ret);
+
+	*value = gpu_read64(gpu, REG_A6XX_RBBM_PERFCTR_CP_0_LO,
+		REG_A6XX_RBBM_PERFCTR_CP_0_HI);
+
+	if (!oob_ret)
+		a6xx_gmu_clear_oob(&a6xx_gpu->gmu, GMU_OOB_GPU_SET);
+	return 0;
+}
+
+#if defined(CONFIG_DEBUG_FS) || defined(CONFIG_DEV_COREDUMP)
+static void a6xx_show(struct msm_gpu *gpu, struct msm_gpu_state *state,
+		struct drm_printer *p)
+{
+	struct msm_ringbuffer *ring = gpu->rb[0];
+	struct adreno_gpu *ag = to_adreno_gpu(gpu);
+
+	/*
+	 * Upstream's adreno_show() takes (msm_gpu_state *, drm_printer *).
+	 * This tree's adreno_show() is the older CAF form taking a seq_file,
+	 * so the full register dump is not reproduced here; the ring and
+	 * firmware state that matters for bring-up is reported instead.
+	 */
+	drm_printf(p, "rb wptr: %d\n", get_wptr(ring));
+	if (ring->memptrs)
+		drm_printf(p, "rb rpdr: %d\n", ring->memptrs->rptr);
+	if (ring->memptrs)
+		drm_printf(p, "rb fence: %u\n", ring->memptrs->fence);
+
+	drm_printf(p, "sqe: %d bytes\n",
+		ag->fw[ADRENO_FW_SQE] ? ag->fw[ADRENO_FW_SQE]->size : 0);
+	drm_printf(p, "gmu: %d bytes\n",
+		ag->fw[ADRENO_FW_GMU] ? ag->fw[ADRENO_FW_GMU]->size : 0);
+}
+#endif
+
+static struct msm_ringbuffer *a6xx_active_ring(struct msm_gpu *gpu)
+{
+	struct adreno_gpu *adreno_gpu = to_adreno_gpu(gpu);
+	struct a6xx_gpu *a6xx_gpu = to_a6xx_gpu(adreno_gpu);
+
+	return a6xx_gpu->cur_ring;
+}
+
+/*
+ * TEMPORARY image 203 -- the missing last_fence.
+ *
+ * Three call sites in msm_gpu.c unconditionally dereference
+ * gpu->funcs->last_fence():
+ *
+ *   msm_gpu.c:294  recover_worker():  fence = gpu->funcs->last_fence(gpu)
+ *   msm_gpu.c:348  hangcheck_handler():fence = gpu->funcs->last_fence(gpu)
+ *   msm_gpu.c:521  retire_worker():   fence = gpu->funcs->last_fence(gpu)
+ *
+ * and our a6xx funcs table never provided it (msm_gpu.h:78 documents the
+ * design as "a6xx provides active_ring instead of last_fence"). So the first
+ * time any of those three paths runs, the kernel jumps through a NULL function
+ * pointer. The oops is unmistakable:
+ *
+ *   Workqueue: msm_drm retire_worker
+ *   pc : jopp_springboard_blr_x8+0x4
+ *   lr : retire_worker+0x30
+ *   virtual address fffffffffffffffc  (= NULL - 4, the prefetch slot)
+ *
+ * retire_worker is queued from msm_gpu_retire(), which runs on every submit
+ * completion path -- so the first real GL submit or retire is what kills the
+ * machine. That is why bring-up (which never submits) is 5-for-5 clean while
+ * the first GL work dies with no kernel record: the oops IS the record, and
+ * the resets before this log simply never had pstore/last_kmsg read back.
+ *
+ * The implementation reads the fence from the active ring's shadow, exactly as
+ * upstream v419 does everywhere it needs a fence value (never via
+ * funcs->last_fence in the retire path):
+ *
+ *   donor/v419/msm_gpu.c:526  fence = ring->memptrs->fence
+ *   donor/v419/msm_gpu.c:696  update_fences(gpu, ring, ring->memptrs->fence)
+ *
+ * NULL-safe: if there is no current ring yet, report 0 (nothing retired).
+ */
+static uint32_t a6xx_last_fence(struct msm_gpu *gpu)
+{
+	struct msm_ringbuffer *ring = a6xx_active_ring(gpu);
+
+	if (!ring || !ring->memptrs)
+		return 0;
+
+	return ring->memptrs->fence;
+}
+
+static void a6xx_destroy(struct msm_gpu *gpu)
+{
+	struct adreno_gpu *adreno_gpu = to_adreno_gpu(gpu);
+	struct a6xx_gpu *a6xx_gpu = to_a6xx_gpu(adreno_gpu);
+
+	if (a6xx_gpu->sqe_bo) {
+		if (a6xx_gpu->sqe_iova)
+			msm_gem_put_iova(a6xx_gpu->sqe_bo, gpu->aspace);
+		drm_gem_object_unreference_unlocked(a6xx_gpu->sqe_bo);
+	}
+
+	a6xx_gmu_remove(a6xx_gpu);
+
+	adreno_gpu_cleanup(adreno_gpu);
+	kfree(a6xx_gpu);
+}
+
+static const struct adreno_gpu_funcs funcs = {
+	.base = {
+		.get_param = adreno_get_param,
+		.hw_init = a6xx_hw_init,
+		.pm_suspend = a6xx_pm_suspend,
+		.pm_resume = a6xx_pm_resume,
+		.recover = a6xx_recover,
+		.submit = a6xx_submit,
+		.flush_ring = a6xx_flush,
+		.active_ring = a6xx_active_ring,
+		.last_fence = a6xx_last_fence,
+		.irq = a6xx_irq,
+		.destroy = a6xx_destroy,
+#if defined(CONFIG_DEBUG_FS) || defined(CONFIG_DEV_COREDUMP)
+		.show_state = a6xx_show,
+#endif
+	},
+	.get_timestamp = a6xx_get_timestamp,
+};
+
+struct msm_gpu *a6xx_gpu_init(struct drm_device *dev)
+{
+	struct msm_drm_private *priv = dev->dev_private;
+	struct platform_device *pdev = priv->gpu_pdev;
+	struct device_node *node;
+	struct a6xx_gpu *a6xx_gpu;
+	struct adreno_gpu *adreno_gpu;
+	struct msm_gpu *gpu;
+	int ret;
+
+	a6xx_gpu = kzalloc(sizeof(*a6xx_gpu), GFP_KERNEL);
+	if (!a6xx_gpu)
+		return ERR_PTR(-ENOMEM);
+
+	adreno_gpu = &a6xx_gpu->base;
+	gpu = &adreno_gpu->base;
+
+	adreno_gpu->registers = a6xx_registers;
+	adreno_gpu->reg_offsets = a6xx_register_offsets;
+
+	/*
+	 * Build the GPU address space FIRST, before adreno_gpu_init().
+	 *
+	 * Ordering requirement: msm_gpu_init() (called by adreno_gpu_init())
+	 * attaches the MMU, and msm_iommu_attach() does pm_runtime_get_sync(),
+	 * which can trigger runtime-resume of the GPU platform device and hence
+	 * a6xx_pm_resume() -> a6xx_gmu_resume(). That path dereferences the MMU
+	 * (mmu->dev), so the MMU must already exist and be populated by then.
+	 *
+	 * msm_gpu_init() would otherwise allocate its own address space with a
+	 * bare iommu_domain_alloc(), which on this platform has no SMMU behind
+	 * it (the GPU node has no "iommus" property; the context banks do).
+	 * msm_gpu_init() therefore leaves gpu->aspace alone when it is already
+	 * set - see msm_gpu.c.
+	 *
+	 * The A640 GPU core runs from gfx3d_user (CB 0, SID 0x401). The GMU's
+	 * own buffers are handled separately, in a6xx_gmu_memory_probe(), on
+	 * gmu_kernel (CB 5).
+	 */
+	if (!gpu->aspace) {
+		struct msm_gem_address_space *aspace;
+
+		aspace = msm_gpu_aspace_new("gfx3d_user", "gfx3d");
+		if (IS_ERR(aspace)) {
+			DRM_DEV_ERROR(&pdev->dev,
+				"failed to create GPU address space on gfx3d_user: %ld\n",
+				PTR_ERR(aspace));
+			/* nothing else is initialised yet, so free directly */
+			kfree(a6xx_gpu);
+			return ERR_CAST(aspace);
+		}
+
+		gpu->aspace = aspace;
+
+		mmu_dbg(&pdev->dev, "GPU address space ready on gfx3d_user\n");
+	}
+
+	ret = adreno_gpu_init(dev, pdev, adreno_gpu, &funcs, 1);
+	if (ret) {
+		a6xx_destroy(&(a6xx_gpu->base.base));
+		return ERR_PTR(ret);
+	}
+
+	/* Check if there is a GMU phandle and set it up */
+	node = of_parse_phandle(pdev->dev.of_node, "gmu", 0);
+
+	/* FIXME: How do we gracefully handle this? */
+	BUG_ON(!node);
+
+	ret = a6xx_gmu_probe(a6xx_gpu, node);
+	if (ret) {
+		a6xx_destroy(&(a6xx_gpu->base.base));
+		return ERR_PTR(ret);
+	}
+	pr_info("A6XX_TRACE: a6xx_gpu_init probe returned, registering fault handler\n");
+
+	if (gpu->aspace)
+		msm_mmu_set_fault_handler(gpu->aspace->mmu, gpu,
+				a6xx_fault_handler);
+
+	return gpu;
+}
