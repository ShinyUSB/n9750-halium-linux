+{
+	struct adreno_gpu *adreno_gpu = to_adreno_gpu(gpu);
+	struct a6xx_gpu *a6xx_gpu = to_a6xx_gpu(adreno_gpu);
+	struct a6xx_gmu *gmu = &a6xx_gpu->gmu;
+	unsigned int i;
+	u32 val;
+	u32 rbbm_clock_on;
+
+	val = gpu_read(gpu, REG_A6XX_RBBM_CLOCK_CNTL);
+
+	/*
+	 * IMAGE 235 -- A640 needs its own RBBM_CLOCK_CNTL value.
+	 *
+	 * This was hard-coded to 0x8aa8aa02, which CAF gives ONLY to a630.
+	 * Every other chip in CAF's selector, including a640, gets
+	 * 0x8aa8aa82:
+	 *
+	 *   vendor adreno_a6xx.c:592-601
+	 *     __get_rbbm_clock_cntl_on():
+	 *       if (adreno_is_a630)              return 0x8AA8AA02;
+	 *       else if (a612 || a610)           return 0xAAA8AA82;
+	 *       else                             return 0x8AA8AA82;   <- a640
+	 *
+	 * The single differing bit is bit 7. On a640 we were leaving one
+	 * clock gate off that CAF turns on.
+	 *
+	 * This matters because it is the ONE hypothesis that matches the
+	 * symptom split exactly: the CP runs (its bits are right in both
+	 * values) while the RB/ROP path never writes (its gate is wrong).
+	 *
+	 * NOTE: the SQE214 diagnostic above and the "already correct" test
+	 * here both keyed on the old a630 constant, so they reported success
+	 * on a value CAF says belongs to a different chip. Both are updated.
+	 *
+	 * This tree has no adreno_is_a630() helper (only adreno_is_a640() at
+	 * adreno_gpu.h:241), so the selector is written in terms of a640, which
+	 * is the only part we run on. CAF returns 0x8AA8AA82 for everything
+	 * except a630, so this matches.
+	 */
+	rbbm_clock_on = adreno_is_a640(adreno_gpu) ? 0x8aa8aa82 : 0x8aa8aa02;
+
+	/* IMAGE 243 -- GMU always-on clock gate (CAF __get_gmu_ao_cgc_*, __get_gmu_wfi_config;
+	 * mainline a6xx_set_hwcg). a640 takes the `else` branch of each selector.
+	 * This was the corpus's own open item "GMU AO CGC: defines present, no writer". */
+	if (a640_gmu_cgc) {
+		gmu_write(gmu, REG_A6XX_GPU_GMU_AO_GMU_CGC_MODE_CNTL, state ? 0x00020202 : 0);
+		gmu_write(gmu, REG_A6XX_GPU_GMU_AO_GMU_CGC_DELAY_CNTL, state ? 0x00010111 : 0);
+		gmu_write(gmu, REG_A6XX_GPU_GMU_AO_GMU_CGC_HYST_CNTL, state ? 0x00005555 : 0);
+		gmu_write(gmu, REG_A6XX_GMU_CX_GMU_WFI_CONFIG,
+			state ? (adreno_is_a640(adreno_gpu) ? 0x00000002 : 0) : 0);
+		pr_info("GMUCGC243: MODE=0x%x DELAY=0x%x HYST=0x%x WFI=0x%x state=%d\n",
+			gmu_read(gmu, REG_A6XX_GPU_GMU_AO_GMU_CGC_MODE_CNTL),
+			gmu_read(gmu, REG_A6XX_GPU_GMU_AO_GMU_CGC_DELAY_CNTL),
+			gmu_read(gmu, REG_A6XX_GPU_GMU_AO_GMU_CGC_HYST_CNTL),
+			gmu_read(gmu, REG_A6XX_GMU_CX_GMU_WFI_CONFIG), state);
+	}
+
+	/* Don't re-program the registers if they are already correct */
+	if ((!state && !val) || (state && (val == rbbm_clock_on)))
+		return;
+
+	/* Disable SP clock before programming HWCG registers */
+	gmu_rmw(gmu, REG_A6XX_GPU_GMU_GX_SPTPRAC_CLOCK_CONTROL, 1, 0);
+
+	if (adreno_is_a640(adreno_gpu) && a640_hwcg_a640) {
+
+		const struct a640_hwcg_reg *tbl;
+		int n;
+
+		if (hwcg_caf) {
+			tbl = a640_hwcg_caf;
+			n = ARRAY_SIZE(a640_hwcg_caf);
+		} else {
+			tbl = a640_hwcg_old;
+			n = ARRAY_SIZE(a640_hwcg_old);
+		}
+
+		for (i = 0; i < n; i++) {
+			gpu_write(gpu, tbl[i].offset,
+				state ? tbl[i].value : 0);
+		}
+		pr_info("HWCG244: a640 table, %zu entries, state=%d "
+			"CNTL_TEX_FCHE=0x%x\n", n, state,
+			gpu_read(gpu, REG_A6XX_RBBM_CLOCK_CNTL_TEX_FCHE));
+
+		/*
+		 * IMAGE 245 -- VERIFY, do not assume.
+		 *
+		 * Read back every entry and compare against the value CAF says
+		 * a640 wants. A gpu_read() of an address the part does not
+		 * implement returns 0xdeadbead (Adreno's unmapped-register
+		 * signature), so a deadbead here means the ADDRESS in our
+		 * a6xx.xml.h is wrong for this part and the setting was written
+		 * into the void -- i.e. that clock gate was never programmed at
+		 * all. A plain value mismatch means the write did not stick.
+		 *
+		 * This is the only way to tell "we programmed the RB/CCU clocks"
+		 * (what we have been asserting) from "we wrote to a register that
+		 * does not exist on a640" (which looks identical from userspace).
+		 */
+		if (state) {
+			int bad = 0;
+
+			for (i = 0; i < n; i++) {
+				u32 want = tbl[i].value;
+				u32 got = gpu_read(gpu, tbl[i].offset);
+
+				if (got == want)
+					continue;
+				bad++;
+				pr_info("HWCGVFY: MISMATCH off=0x%04x want=0x%08x got=0x%08x%s\n",
+					tbl[i].offset, want, got,
+					(got == 0xdeadbead || got == 0xffffffff) ?
+					"  <== UNMAPPED, ADDRESS WRONG FOR a640" : "");
+			}
+			pr_info("HWCGVFY: %d/%zu entries did not read back as CAF specifies\n",
+				bad, n);
+		}
+	} else {
+		for (i = 0; i < ARRAY_SIZE(a6xx_hwcg); i++)
+			gpu_write(gpu, a6xx_hwcg[i].offset,
+				state ? a6xx_hwcg[i].value : 0);
+		pr_info("HWCG244: legacy a630 table, %zu entries, state=%d\n",
+			ARRAY_SIZE(a6xx_hwcg), state);
+	}
+
+	/* Enable SP clock */
+	gmu_rmw(gmu, REG_A6XX_GPU_GMU_GX_SPTPRAC_CLOCK_CONTROL, 0, 1);
+
+	gpu_write(gpu, REG_A6XX_RBBM_CLOCK_CNTL, state ? rbbm_clock_on : 0);
+}
