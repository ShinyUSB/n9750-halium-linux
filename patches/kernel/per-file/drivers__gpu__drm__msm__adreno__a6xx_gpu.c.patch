+static void a6xx_fault_detect_irq(struct msm_gpu *gpu)
+{
+	struct adreno_gpu *adreno_gpu = to_adreno_gpu(gpu);
+	struct a6xx_gpu *a6xx_gpu = to_a6xx_gpu(adreno_gpu);
+	struct drm_device *dev = gpu->dev;
+	struct msm_drm_private *priv = dev->dev_private;
+	struct msm_ringbuffer *ring = gpu->funcs->active_ring(gpu);
+
+	/*
+	 * Force the GPU to stay on until after we finish
+	 * collecting information
+	 */
+	gmu_write(&a6xx_gpu->gmu, REG_A6XX_GMU_GMU_PWR_COL_KEEPALIVE, 1);
+
+	/*
+	 * IMAGE 231: we have been blind at exactly the wrong moment.
+	 *
+	 * RBBM_STATUS alone cannot tell an SMMU stall from a shader-pipe
+	 * launch failure from a CP fault -- three very different bugs with
+	 * three different fixes. Upstream master reads STATUS3 FIRST and
+	 * bails on SMMU_STALLED_ON_FAULT (donor/master:1831-1832); our handler
+	 * never read STATUS3 at all, so that case has always been misread as a
+	 * generic hang.
+	 *
+	 * Dump the discriminating registers alongside the status.
+	 */
+	{
+		u32 status3 = gpu_read(gpu, REG_A6XX_RBBM_STATUS3);
+		u32 int0 = gpu_read(gpu, REG_A6XX_RBBM_INT_0_STATUS);
+		u32 cpi = gpu_read(gpu, REG_A6XX_CP_INTERRUPT_STATUS);
+		u32 cphw = gpu_read(gpu, REG_A6XX_CP_HW_FAULT);
+
+		DRM_DEV_ERROR(&gpu->pdev->dev,
+			"  DIAG231 status3=0x%08x%s int0=0x%08x cp_int=0x%08x cp_hw_fault=0x%08x\n",
+			status3,
+			(status3 & A6XX_RBBM_STATUS3_SMMU_STALLED_ON_FAULT) ?
+				" *** SMMU_STALLED_ON_FAULT ***" : "",
+			int0, cpi, cphw);
+	}
+
+	DRM_DEV_ERROR(&gpu->pdev->dev,
+		"gpu fault ring %d fence %x status %8.8X rb %4.4x/%4.4x ib1 %16.16llX/%4.4x ib2 %16.16llX/%4.4x\n",
+		ring ? ring->id : -1, ring ? ring->seqno : 0,
+		gpu_read(gpu, REG_A6XX_RBBM_STATUS),
+		gpu_read(gpu, REG_A6XX_CP_RB_RPTR),
+		gpu_read(gpu, REG_A6XX_CP_RB_WPTR),
+		gpu_read64(gpu, REG_A6XX_CP_IB1_BASE, REG_A6XX_CP_IB1_BASE_HI),
+		gpu_read(gpu, REG_A6XX_CP_IB1_REM_SIZE),
+		gpu_read64(gpu, REG_A6XX_CP_IB2_BASE, REG_A6XX_CP_IB2_BASE_HI),
+		gpu_read(gpu, REG_A6XX_CP_IB2_REM_SIZE));
+
+	/* Turn off the hangcheck timer to keep it from bothering us */
+	del_timer(&gpu->hangcheck_timer);
+
+	queue_work(priv->wq, &gpu->recover_work);
+}
+
+static irqreturn_t a6xx_irq(struct msm_gpu *gpu)
+{
+	u32 status = gpu_read(gpu, REG_A6XX_RBBM_INT_0_STATUS);
+
+	gpu_write(gpu, REG_A6XX_RBBM_INT_CLEAR_CMD, status);
+
+	if (status & A6XX_RBBM_INT_0_MASK_RBBM_HANG_DETECT)
+		a6xx_fault_detect_irq(gpu);
+
+	if (status & A6XX_RBBM_INT_0_MASK_CP_AHB_ERROR)
+		dev_err_ratelimited(&gpu->pdev->dev, "CP | AHB bus error\n");
+
+	if (status & A6XX_RBBM_INT_0_MASK_CP_HW_ERROR)
+		a6xx_cp_hw_err_irq(gpu);
+
+	if (status & A6XX_RBBM_INT_0_MASK_RBBM_ATB_ASYNCFIFO_OVERFLOW)
+		dev_err_ratelimited(&gpu->pdev->dev, "RBBM | ATB ASYNC overflow\n");
+
+	if (status & A6XX_RBBM_INT_0_MASK_RBBM_ATB_BUS_OVERFLOW)
+		dev_err_ratelimited(&gpu->pdev->dev, "RBBM | ATB bus overflow\n");
+
+	if (status & A6XX_RBBM_INT_0_MASK_UCHE_OOB_ACCESS)
+		dev_err_ratelimited(&gpu->pdev->dev, "UCHE | Out of bounds access\n");
+
+	if (status & A6XX_RBBM_INT_0_MASK_CP_CACHE_FLUSH_TS)
+		msm_gpu_retire(gpu);
+
+	return IRQ_HANDLED;
+}
+
+/*
+ * TEMPORARY image 185 -- DIAGNOSTIC ONLY, safe to keep until answered.
+ *
+ * Dump the CP ring + interrupt state on demand. This exists because the
+ * first-pixels run (MESA-RENDER-ATTEMPT-2.md) produced a fully working
+ * EGL/GLES context on FD640 -- glClear and glFlush both return error 0 --
+ * yet glFinish and glReadPixels block forever. /proc/interrupts shows the
+ * GPU core IRQ (Linux 487, "A640") at ZERO while the HFI IRQ counted 7, so
+ * a6xx_irq() never runs and msm_gpu_retire() never releases the fence.
+ *
+ * Two very different bugs hide behind that, and they are not distinguishable
+ * from userspace: no /proc/gpu, no /dev/mem, debugfs dri/0/gpu is empty.
+ *
+ *   (A) The CP is not running the render ring at all.
+ *   (B) The CP runs it but never raises the completion interrupt.
+ *
+ * This answers it directly. The bring-up already proves the ring is
+ * programmed correctly (RINGHW[01] CP_RB_BASE=iova:0x1000 hw=0x1000, and
+ * rp_iova is 0x1000, so the HW ring IS the real render ring, not a scratch
+ * one), and RPTR demonstrably advances across the selftest -- so the
+ * "scratch ring" theory is already dead. What is unknown is the state of
+ * that ring *after* Mesa has submitted to it and is blocked in glFinish.
+ *
+ * Read-only. No register is written.
+ */
+/*
+ * TEMPORARY image 196 -- READABLE cpstate for userspace polling.
+ *
+ * Once the GPU actually executes (image 195), submitting GL work hard-resets
+ * the system with NO kernel record: no panic, no oops, no SMMU fault, no
+ * watchdog. dmesg just stops mid-stream and /proc/last_kmsg cannot help,
+ * because a hard reset writes no pstore record.
+ *
+ * The existing dump therefore fails exactly when needed -- its output goes to
+ * the ring buffer, which the reset discards. And there is no pure-userspace
+ * route: /dev/mem does not exist on this system, and msm's debugfs register
+ * interface is non-functional in this CAF tree (the `gpu` file is empty and
+ * writes are rejected).
+ *
+ * So the probe must RETURN values rather than print them. A userspace poller
+ * can then sample at high rate and fsync each sample itself, so the last
+ * samples before the reset survive on disk. The kernel hands values over
+ * early; userspace decides when they are durable.
+ *
+ * Caller holds gpu->dev->struct_mutex.
+ */
+int a6xx_cp_state_read(struct msm_gpu *gpu, char *page, size_t size)
+{
+	struct adreno_gpu *adreno = to_adreno_gpu(gpu);
+	struct a6xx_gpu *a6xx = to_a6xx_gpu(adreno);
+	struct a6xx_gmu *gmu = &a6xx->gmu;
+	size_t n = 0;
+
+	/* Values we most want at the instant the machine dies. */
+	n += scnprintf(page + n, size - n, "RBBM_STATUS 0x%08x\n",
+			gpu_read(gpu, REG_A6XX_RBBM_STATUS));
+	n += scnprintf(page + n, size - n, "RBBM_STATUS3 0x%08x\n",
+			gpu_read(gpu, REG_A6XX_RBBM_STATUS3));
+	n += scnprintf(page + n, size - n, "CP_RB_CNTL 0x%08x\n",
+			gpu_read(gpu, REG_A6XX_CP_RB_CNTL));
+	n += scnprintf(page + n, size - n, "CP_RB_WPTR 0x%08x\n",
+			gpu_read(gpu, REG_A6XX_CP_RB_WPTR));
+	n += scnprintf(page + n, size - n, "CP_RB_RPTR 0x%08x\n",
+			gpu_read(gpu, REG_A6XX_CP_RB_RPTR));
+	n += scnprintf(page + n, size - n, "CP_SQE_CNTL 0x%08x\n",
+			gpu_read(gpu, REG_A6XX_CP_SQE_CNTL));
+	n += scnprintf(page + n, size - n, "CP_INTERRUPT_STATUS 0x%08x\n",
+			gpu_read(gpu, REG_A6XX_CP_INTERRUPT_STATUS));
+	n += scnprintf(page + n, size - n, "SPTPRAC_PWR_CLK_STATUS 0x%08x\n",
+			gmu_read(gmu, REG_A6XX_GMU_SPTPRAC_PWR_CLK_STATUS));
+	n += scnprintf(page + n, size - n, "RPMH_POWER_STATE 0x%08x\n",
+			gmu_read(gmu, REG_A6XX_GPU_GMU_CX_GMU_RPMH_POWER_STATE));
+	n += scnprintf(page + n, size - n, "GMU2HOST_INTR_INFO 0x%08x\n",
+			gmu_read(gmu, REG_A6XX_GMU_GMU2HOST_INTR_INFO));
+	n += scnprintf(page + n, size - n, "sw_rb_iova 0x%llx\n",
+			(unsigned long long)gpu->rb_iova);
+
+	/*
+	 * CP clock test, mirroring the CPF logic used by the auto-rest dump.
+	 * If this counter is not advancing the CP is not fetching, which is
+	 * the single most useful thing to know at the moment of death.
+	 */
+	{
+		u64 t0, t1;
+
+		t0 = gpu_read64(gpu, REG_A6XX_RBBM_PERFCTR_CP_0_LO,
+				REG_A6XX_RBBM_PERFCTR_CP_0_HI);
+		udelay(1000);
+		t1 = gpu_read64(gpu, REG_A6XX_RBBM_PERFCTR_CP_0_LO,
+				REG_A6XX_RBBM_PERFCTR_CP_0_HI);
+		n += scnprintf(page + n, size - n,
+				"CP_TIMESTAMP 0x%016llx delta %llu clocking %d\n",
+				(unsigned long long)t1,
+				(unsigned long long)(t1 - t0),
+				(t1 != t0));
+	}
+
+	return n;
+}
+
+/*
+ * IMAGE 283 -- read a list of GPU register offsets and print their values.
+ *
+ * WHY: the ground truth.  The WORKING device (Android/KGSL) has been
+ * captured: 2342 register entries, decoded against a6xx_reg.h, and saved as
+ * artifacts/gpu-bringup/ground-truth/android-gpu-regs.txt.  To compare, the
+ * same registers have to be read on THIS device.
+ *
+ * /dev/mem is no help: this kernel's devmem_is_allowed() refuses exclusive
+ * device regions, and the GPU's MMIO is claimed exclusively by the driver.
+ * But the driver has the ioremap, so it can read the registers itself.
+ *
+ * The offset list is read from /userdata/gpuwork/reg_offsets.txt (one hex
+ * offset per line), so the same list can be changed without a rebuild.
+ * Offsets are word indices, the same convention as the XML header and as
+ * CAF's a6xx_reg.h, and the same convention the Android snapshot uses.
+ */
+static void a6xx_cp_state_regs(struct msm_gpu *gpu)
+{
+	struct file *f;
+	char *buf, *line, *p;
+	loff_t pos = 0;
+	ssize_t n;
+	unsigned long count = 0;
+
+	f = filp_open("/userdata/gpuwork/reg_offsets.txt", O_RDONLY, 0);
+	if (IS_ERR(f)) {
+		pr_info("REGS: cannot open the offset list: %ld\n", PTR_ERR(f));
+		return;
+	}
+
+	buf = kzalloc(256 * 1024, GFP_KERNEL);
+	if (!buf) {
+		filp_close(f, NULL);
+		return;
+	}
+
+	n = kernel_read(f, buf, 256 * 1024 - 1, &pos);
+	filp_close(f, NULL);
+	if (n <= 0) {
+		pr_info("REGS: offset list is empty (%zd)\n", n);
+		kfree(buf);
+		return;
+	}
+	buf[n] = '\0';
+
+	p = buf;
+	while ((line = strsep(&p, "\n")) != NULL) {
+		unsigned long off;
+
+		if (!*line)
+			continue;
+		off = simple_strtoul(line, NULL, 0);
+		if (off >= 0x10000)	/* outside the a6xx register window */
+			continue;
+		pr_info("REGS %05lx %08x\n", off, gpu_read(gpu, (u32)off));
+		count++;
+	}
+	pr_info("REGS: %lu registers read\n", count);
+	kfree(buf);
+}
+
+int a6xx_cp_state_dump(struct msm_gpu *gpu, const char *tag)
+{
+	struct adreno_gpu *adreno_gpu = to_adreno_gpu(gpu);
+	struct a6xx_gpu *a6xx_gpu = to_a6xx_gpu(adreno_gpu);
+	struct msm_ringbuffer *rb = gpu->rb[0];
+	u64 t0, t1;
+
+	if (!strcmp(tag, "REGS"))
+		a6xx_cp_state_regs(gpu);
+
+	pr_info("CPDUMP[%s] ---- a6xx CP state ----\n", tag);
+
+	pr_info("CPDUMP[%s] sw : rb_iova=0x%llx rb_size=%d wptr_dw=%u next_dw=%u\n",
+		tag,
+		(unsigned long long)gpu->rb_iova,
+		rb ? rb->size : -1,
+		rb ? (unsigned)(rb->cur - rb->start) : 0,
+		rb ? (unsigned)(rb->next - rb->start) : 0);
+
+	pr_info("CPDUMP[%s] hw : RB_BASE=0x%llx RB_CNTL=0x%x RB_RPTR_ADDR=0x%llx\n",
+		tag,
+		(unsigned long long)gpu_read64(gpu,
+			REG_A6XX_CP_RB_BASE, REG_A6XX_CP_RB_BASE_HI),
+		gpu_read(gpu, REG_A6XX_CP_RB_CNTL),
+		(unsigned long long)gpu_read64(gpu,
+			REG_A6XX_CP_RB_RPTR_ADDR_LO, REG_A6XX_CP_RB_RPTR_ADDR_HI));
+
+	pr_info("CPDUMP[%s] hw : RB_RPTR=0x%x RB_WPTR=0x%x SQE_CNTL=0x%x SQE_BASE=0x%llx (sw 0x%llx)\n",
+		tag,
+		gpu_read(gpu, REG_A6XX_CP_RB_RPTR),
+		gpu_read(gpu, REG_A6XX_CP_RB_WPTR),
+		gpu_read(gpu, REG_A6XX_CP_SQE_CNTL),
+		(unsigned long long)gpu_read64(gpu,
+			REG_A6XX_CP_SQE_INSTR_BASE_LO,
+			REG_A6XX_CP_SQE_INSTR_BASE_HI),
+		(unsigned long long)a6xx_gpu->sqe_iova);
+
+	pr_info("CPDUMP[%s] irq: INT_0_STATUS=0x%x INT_0_MASK=0x%x CP_INTERRUPT_STATUS=0x%x\n",
+		tag,
+		gpu_read(gpu, REG_A6XX_RBBM_INT_0_STATUS),
+		gpu_read(gpu, REG_A6XX_RBBM_INT_0_MASK),
+		gpu_read(gpu, REG_A6XX_CP_INTERRUPT_STATUS));
+
+	pr_info("CPDUMP[%s] st : RBBM_STATUS=0x%x RBBM_STATUS3=0x%x linux_irq=%u irqs=%lu\n",
+		tag,
+		gpu_read(gpu, REG_A6XX_RBBM_STATUS),
+		gpu_read(gpu, REG_A6XX_RBBM_STATUS3),
+		gpu->irq,
+		gpu->irq >= 0 ? kstat_irqs((unsigned int)gpu->irq) : 0UL);
+
+	/*
+	 * The decisive bit. PERFCTR_CP_0 is clocked by the command processor
+	 * itself, so if it advances over a short interval the CP is genuinely
+	 * running right now -- independently of whether the interrupt ever
+	 * fires. That is exactly the (A)/(B) discriminator, and it works even
+	 * though the IRQ path is the thing that is broken.
+	 */
+	t0 = gpu_read64(gpu, REG_A6XX_RBBM_PERFCTR_CP_0_LO,
+		REG_A6XX_RBBM_PERFCTR_CP_0_HI);
+	msleep(50);
+	t1 = gpu_read64(gpu, REG_A6XX_RBBM_PERFCTR_CP_0_LO,
+		REG_A6XX_RBBM_PERFCTR_CP_0_HI);
+	pr_info("CPDUMP[%s] CPF: t0=0x%llx t1=0x%llx delta=%llu => CP is %s\n",
+		tag, t0, t1, (unsigned long long)(t1 - t0),
+		(t1 != t0) ? "CLOCKING (running, problem is the IRQ)"
+			   : "NOT CLOCKING (stalled, problem is the ring)");
+
+	pr_info("CPDUMP[%s] ---- end ----\n", tag);
+	return 0;
+}
