+static int a6xx_cp_init(struct msm_gpu *gpu)
+{
+	struct msm_ringbuffer *ring = gpu->rb[0];
+
+	OUT_PKT7(ring, CP_ME_INIT, 8);
+
+	OUT_RING(ring, 0x0000002f);
+
+	/* Enable multiple hardware contexts */
+	OUT_RING(ring, 0x00000003);
+
+	/* Enable error detection */
+	OUT_RING(ring, 0x20000000);
+
+	/* Don't enable header dump */
+	OUT_RING(ring, 0x00000000);
+	OUT_RING(ring, 0x00000000);
+
+	/* No workarounds enabled */
+	OUT_RING(ring, 0x00000000);
+
+	/* Pad rest of the cmds with 0's */
+	OUT_RING(ring, 0x00000000);
+	OUT_RING(ring, 0x00000000);
+
+	/* TEMPORARY image 129 diagnostics -- REMOVE AFTER RESULT. */
+	pr_info("CP_PRE_FLUSH: ring_iova=0x%llx sw_wptr_dw=%u RB_BASE=0x%llx RB_CNTL=0x%x RPTR=0x%x WPTR=0x%x SQE=0x%x\n",
+		(unsigned long long)gpu->rb_iova,
+		(unsigned)(ring->cur - ring->start),
+		(unsigned long long)gpu_read64(gpu,
+			REG_A6XX_CP_RB_BASE, REG_A6XX_CP_RB_BASE_HI),
+		gpu_read(gpu, REG_A6XX_CP_RB_CNTL),
+		gpu_read(gpu, REG_A6XX_CP_RB_RPTR),
+		gpu_read(gpu, REG_A6XX_CP_RB_WPTR),
+		gpu_read(gpu, REG_A6XX_CP_SQE_CNTL));
+	a6xx_flush(gpu, ring);
+	pr_info("CP_POST_FLUSH: RPTR=0x%x WPTR=0x%x STATUS=0x%x INT0=0x%x\n",
+		gpu_read(gpu, REG_A6XX_CP_RB_RPTR),
+		gpu_read(gpu, REG_A6XX_CP_RB_WPTR),
+		gpu_read(gpu, REG_A6XX_RBBM_STATUS),
+		gpu_read(gpu, REG_A6XX_RBBM_INT_0_STATUS));
+	if (!a6xx_idle(gpu, ring)) {
+		/* TEMPORARY image 128 failure snapshot -- REMOVE AFTER RESULT. */
+		pr_info("CPIDLE-FAIL: RBBM_STATUS=0x%x INT0=0x%x CP_RB_RPTR=0x%x CP_RB_WPTR=0x%x\n",
+			gpu_read(gpu, REG_A6XX_RBBM_STATUS),
+			gpu_read(gpu, REG_A6XX_RBBM_INT_0_STATUS),
+			gpu_read(gpu, REG_A6XX_CP_RB_RPTR),
+			gpu_read(gpu, REG_A6XX_CP_RB_WPTR));
+		pr_info("CPIDLE-FAIL: ring0[0..15] =%08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x\n",
+			ring->start[0], ring->start[1], ring->start[2],
+			ring->start[3], ring->start[4], ring->start[5],
+			ring->start[6], ring->start[7], ring->start[8],
+			ring->start[9], ring->start[10], ring->start[11],
+			ring->start[12], ring->start[13], ring->start[14],
+			ring->start[15]);
+		return -EINVAL;
+	}
+	return 0;
+}
