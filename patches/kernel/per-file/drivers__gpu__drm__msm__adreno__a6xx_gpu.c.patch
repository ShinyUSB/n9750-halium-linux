+/*
+ * IMAGE 244 -- a640 clock-gating table, transcribed verbatim from
+ *   qualcomm-linux/kgsl gfx-kernel.le.0.0 adreno-gpulist.h a640_hwcg_regs[]
+ * (CAF's own per-chip table for this GPU).
+ *
+ * The table previously used here is CAF's *a630* one: 105 entries with
+ * SP0-3 / RB0-3 / CCU0-3 / TP1-3, three of each of which an a640 does not
+ * have.  This one is 44 entries, SP0 / RB0 / CCU0 / TP0 only, plus the
+ * texture fetch engine (TEX_FCHE) that a630 lacks.
+ *
+ * That gap is the point: TEX_FCHE is the block that moves colour data, and
+ * its clock gate was never programmed.  CP executes, RB/UCHE/CCU report busy
+ * and retire, nothing faults, and no bytes reach DDR -- consistent with a
+ * pipeline whose fetch stage is not clocked.
+ *
+ * A6XX_RBBM_CLOCK_CNTL is deliberately omitted: a6xx_set_hwcg() writes it
+ * separately, using the CAF-selected rbbm_clock_on value.
+ */
+/*
+ * IMAGE 281 -- CAF's a640 hwcg table, copied VERBATIM (49 entries).
+ *
+ * MEASURED (image 276, healthy CP, one boot): the CP executes userspace
+ * command streams and DOES write a userspace buffer (CP_MEM_WRITE
+ * 0x11111111 landed), while every shader-domain write fails.  So the defect
+ * is in the 3D domain, not in the memory path.
+ *
+ * A mechanical diff of CAF's a640_hwcg_regs[] against this table found four
+ * differences that the project had never noticed (it compared readbacks by
+ * offset, not by register name):
+ *
+ *   A6XX_RBBM_CLOCK_HYST_TEX_FCHE  CAF=0x00000777  ours=0x00000000
+ *   A6XX_RBBM_ISDB_CNT              CAF=0x00000182  MISSING here
+ *   A6XX_RBBM_RAC_THRESHOLD_CNT     CAF=0x00000000  MISSING here
+ *   A6XX_RBBM_SP_HYST_CNT           CAF=0x00000000  MISSING here
+ *
+ * TEX_FCHE is the texture-fetch engine -- the block that moves data between
+ * the GPU and memory -- and this table had its CNTL and DELAY but zeroed its
+ * HYST, where CAF programs 0x777.  The project's own note on this table says
+ * the TEX_FCHE clock gate "was never programmed" and that a pipeline whose
+ * fetch stage is not clocked produces exactly the observed symptom.
+ *
+ * The table is now CAF's table, entry for entry, in CAF's order.
+ */
+struct a640_hwcg_reg {
+	u32 offset;
+	u32 value;
+};
