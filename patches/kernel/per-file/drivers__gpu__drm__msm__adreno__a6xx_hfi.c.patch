+/*
+ * TEMPORARY image-107 diagnostics -- REMOVE AFTER RESULT. One-shot snapshots
+ * of the FW_VERSION transaction state. Work items fire once and only log;
+ * they never touch queues, registers (other than reads), or timeouts.
+ */
+static struct delayed_work hfi_snap_1ms_work;
+static struct delayed_work hfi_snap_100ms_work;
+static struct a6xx_gmu *hfi_snap_gmu;
+
+static void hfi_snap_show(struct a6xx_gmu *gmu, const char *when)
+{
+	struct a6xx_hfi_queue *q0 = &gmu->queues[0];
+	struct a6xx_hfi_queue *q1 = &gmu->queues[1];
+
+	pr_info("HFI-SNAP %s q0 rd=%u wr=%u q1 rd=%u wr=%u INTR_INFO=0x%x RAW=0x%x INFO0=0x%x INFO1=0x%x\n",
+		when, q0->header->read_index, q0->header->write_index,
+		q1->header->read_index, q1->header->write_index,
+		gmu_read(gmu, REG_A6XX_GMU_GMU2HOST_INTR_INFO),
+		gmu_read(gmu, REG_A6XX_GMU_HOST2GMU_INTR_RAW_INFO),
+		gmu_read(gmu, REG_A6XX_GMU_HOST2GMU_INTR_INFO_0),
+		gmu_read(gmu, REG_A6XX_GMU_HOST2GMU_INTR_INFO_1));
+}
+
+static void hfi_snap_1ms_fn(struct work_struct *work)
+{
+	hfi_snap_show(hfi_snap_gmu, "C+1ms");
+}
+
+static void hfi_snap_100ms_fn(struct work_struct *work)
+{
+	hfi_snap_show(hfi_snap_gmu, "D+100ms");
+}
