+static int a6xx_hfi_queue_read(struct a6xx_gmu *gmu,
+		struct a6xx_hfi_queue *queue, u32 *data,
+		u32 dwords)
+{
+	struct a6xx_hfi_queue_header *header = queue->header;
+	u32 i, hdr, index = header->read_index;
+	int k;
+	/*
+	 * TEMPORARY image-108 diagnostics -- REMOVE AFTER RESULT. Snapshot the
+	 * response-queue state and ring contents BEFORE the BUG_ON below.
+	 * Read-only: no index advance, no queue writes, no size clamping.
+	 */
+	pr_info("HFI-RD hdr: status=%u iova=0x%x type=0x%x size=0x%x msg=%u drop=%u rxwm=%u txwm=%u rxrq=%u txrq=%u rd=%u wr=%u\n",
+		header->status, header->iova, header->type, header->size,
+		header->msg_size, header->dropped, header->rx_watermark,
+		header->tx_watermark, header->rx_request, header->tx_request,
+		header->read_index, header->write_index);
+	pr_info("HFI-RD ring[0..31]:");
+	for (k = 0; k < 32; k++)
+		pr_cont(" %08x", queue->data[k]);
+	pr_cont("\n");
+	{
+		u32 h0 = queue->data[index];
+		u32 span = (header->write_index - header->read_index +
+			header->size) % header->size;
+		pr_info("HFI-RD at rd=%u: hdr=0x%08x id=%u type=%u size=%u seq=%u next3=%08x %08x %08x span=%u dwords=%u\n",
+			index, h0, h0 & 0xff, (h0 >> 16) & 0xf,
+			(h0 >> 8) & 0xff, (h0 >> 20) & 0xfff,
+			queue->data[(index + 1) % header->size],
+			queue->data[(index + 2) % header->size],
+			queue->data[(index + 3) % header->size],
+			span, dwords);
+	}
+
+	if (header->read_index == header->write_index) {
+		header->rx_request = 1;
+		return 0;
+	}
+
+	hdr = queue->data[index];
+
+	pr_info("HFI_RX index=%u hdr=0x%08x id=%u type=%u size=%u seq=%u\n",
+		index, hdr, HFI_HEADER_ID(hdr), HFI_HEADER_TYPE(hdr),
+		HFI_HEADER_SIZE(hdr), HFI_HEADER_SEQNUM(hdr));
+
+	/*
+	 * TEMPORARY image-112 diagnostics -- REMOVE AFTER RESULT. Sole caller
+	 * is the response-queue tasklet (queue 1). Read-only dump of the exact
+	 * packet at read_index BEFORE the BUG_ON below; no advance, no clamp.
+	 */
+	{
+		u32 avail = (header->write_index - header->read_index +
+			header->size) % header->size;
+		u32 decl = HFI_HEADER_SIZE(hdr);
+		u32 n = decl < 32 ? decl : 32;
+		u32 k;
+		pr_info("=== HFI PRE-BUG PACKET ===\n");
+		pr_info("HFI-PRE queue=1(response) index=%u queue_size=%u\n",
+			index, header->size);
+		pr_info("HFI-PRE hdr=0x%08x id=%u type=%u size=%u seq=%u\n",
+			hdr, HFI_HEADER_ID(hdr), HFI_HEADER_TYPE(hdr),
+			decl, HFI_HEADER_SEQNUM(hdr));
+		pr_info("HFI-PRE q1 rd=%u wr=%u available=%u declared=%u dwords=%u\n",
+			header->read_index, header->write_index,
+			avail, decl, dwords);
+		pr_info("HFI-PRE ring@%u:", index);
+		for (k = 0; k < n; k++)
+			pr_cont(" %08x",
+				queue->data[(index + k) % header->size]);
+		pr_cont("\n");
+	}
+
+	/*
+	 * TEMPORARY image 125 -- vendor HFI-v2 parity. An oversized packet
+	 * is logged and returned as -EMSGSIZE, never BUGs. The queue index
+	 * is not advanced and the packet is not reinterpreted.
+	 */
+	if (HFI_HEADER_SIZE(hdr) > dwords) {
+		pr_info("HFI_RX OVERSIZE index=%u hdr=0x%08x size=%u max=%u\n",
+			index, hdr, HFI_HEADER_SIZE(hdr), dwords);
+		dev_err(gmu->dev,
+			"HFI response size %u exceeds reader capacity %u\n",
+			HFI_HEADER_SIZE(hdr), dwords);
+		return -EMSGSIZE;
+	}
+
+	for (i = 0; i < HFI_HEADER_SIZE(hdr); i++) {
+		data[i] = queue->data[index];
+		index = (index + 1) % header->size;
+	}
+
+	/*
+	 * TEMPORARY image 125 -- vendor HFI-v2 parity: 4-dword alignment
+	 * after each packet (this tree has no gmu->ver.hfi; !legacy is the
+	 * established HFI-v2 discriminator). Not applied to HFI v1.
+	 */
+	if (!gmu->legacy) {
+		u32 raw_end = index;
+		u32 aligned = ALIGN(raw_end, SZ_4) % header->size;
+		pr_info("HFI_RX advance old=%u raw_end=%u aligned=%u\n",
+			header->read_index, raw_end, aligned);
+		index = aligned;
+	}
+
+	header->read_index = index;
+	return HFI_HEADER_SIZE(hdr);
+}
+
+static int a6xx_hfi_queue_write(struct a6xx_gmu *gmu,
+	struct a6xx_hfi_queue *queue, u32 *data, u32 dwords)
+{
+	struct a6xx_hfi_queue_header *header = queue->header;
+	u32 i, space, index = header->write_index;
+
+	spin_lock(&queue->lock);
+
+	space = CIRC_SPACE(header->write_index, header->read_index,
+		header->size);
+	if (space < dwords) {
+		header->dropped++;
+		spin_unlock(&queue->lock);
+		return -ENOSPC;
+	}
+
+	for (i = 0; i < dwords; i++) {
+		queue->data[index] = data[i];
+		index = (index + 1) % header->size;
+	}
+
+	/*
+	 * TEMPORARY image 200 -- PROMOTE IF THE FLICKER STOPS.
+	 *
+	 * Barrier #1: payload -> write_index. MISSING until now.
+	 *
+	 * CAF KGSL has THREE ordered barriers on the transmit path; this port
+	 * had one (image 195 added the index->doorbell one). The first is:
+	 *
+	 *   hfi_update_write_idx:
+	 *       write payload into queue[...]
+	 *       wmb();                       <-- payload -> index
+	 *       *write_idx = index;
+	 *   hfi_update_write_idx again:
+	 *       wmb();                       <-- index -> doorbell
+	 *   a6xx_hfi_cmdq_write:
+	 *       wmb();
+	 *       HOST2GMU_INTR_SET = 0x1;
+	 *
+	 * CAF's comment at kgsl_hfi.c:175 states the invariant precisely:
+	 * "make sure packet AND WRITE INDEX are written before an interrupt
+	 * is raised" -- i.e. two orderings, not one.
+	 *
+	 * Without it the payload stores and the index publish are not ordered
+	 * against each other. The GMU can observe write_index advance (the
+	 * queue looks non-empty) while still reading stale payload, or miss
+	 * the payload entirely. Either way it never gets to a valid request,
+	 * which is exactly the observed "HFI-ACK 6 times once, timeout
+	 * otherwise".
+	 */
+	wmb();
+
+	header->write_index = index;
+	spin_unlock(&queue->lock);
+
+	/*
+	 * TEMPORARY image 195 -- PROMOTE IF THE HFI REPLY ARRIVES.
+	 *
+	 * Write barrier, ported from CAF KGSL kgsl_hfi.c:170-182, which this
+	 * port had DROPPED. CAF's own comment states the invariant:
+	 *
+	 *   hdr->write_index = write;
+	 *   ...
+	 *   "Memory barrier to make sure packet and write index are written
+	 *    before an interrupt is raised"
+	 *   wmb();
+	 *   adreno_write_gmureg(... GMU_HOST2GMU_INTR_SET, 0x1);
+	 *
+	 * Without it the queue stores and the write_index publish can still be
+	 * sitting in the CPU's write-combine buffer when the doorbell MMIO
+	 * write lands. The GMU is kicked, reads the queue, and sees the OLD
+	 * (zero) contents -- so read_index == write_index, nothing to do, and
+	 * it goes back to sleep. That matches the observed signature exactly:
+	 *
+	 *   HFI-T ... q0 rd=0 wr=2 ... hfi_irqs=0(+0) gmu_irqs=0(+0)
+	 *          INTR_INFO=0x0 H2G_RAW=0x0
+	 *   HFI-E q1resp: 00000000 (empty)
+	 *
+	 * -- a doorbell that was delivered and consumed (H2G_RAW back to 0)
+	 * but a command the GMU never actually saw. Our own log line
+	 * "doorbell=0x01" is a hardcoded printf literal, not a register
+	 * readback, so it was never evidence that the kick worked.
+	 */
+	wmb();
+
+	gmu_write(gmu, REG_A6XX_GMU_HOST2GMU_INTR_SET, 0x01);
+	return 0;
+}
+
+struct a6xx_hfi_response {
+	u32 id;
+	u32 seqnum;
+	struct list_head node;
+	struct completion complete;
+
+	u32 error;
+	u32 payload[16];
+};
+
+/*
+ * Incoming HFI ack messages can come in out of order so we need to store all
+ * the pending messages on a list until they are handled.
+ */
+extern unsigned long bw124_gmu_irqs;
+extern unsigned long bw124_hfi_irqs;
+bool a6xx_hfi_bw_sent;
+static unsigned long hfi_send_irq_base;
+static unsigned long hfi_send_gmu_irq_base;
+
+extern bool skip_bw;
+
+static spinlock_t hfi_ack_lock = __SPIN_LOCK_UNLOCKED(message_lock);
+static LIST_HEAD(hfi_ack_list);
+
+static void a6xx_hfi_handle_ack(struct a6xx_gmu *gmu,
+		struct a6xx_hfi_msg_response *msg)
+{
+	struct a6xx_hfi_response *resp;
+	u32 id, seqnum;
+
+	/* msg->ret_header contains the header of the message being acked */
+	id = HFI_HEADER_ID(msg->ret_header);
+	seqnum = HFI_HEADER_SEQNUM(msg->ret_header);
+
+	spin_lock(&hfi_ack_lock);
+	list_for_each_entry(resp, &hfi_ack_list, node) {
+		/*
+		 * TEMPORARY image 157 -- PROMOTE IF VOTE COMPLETES. Vendor
+		 * matches ACKs by SEQNUM ONLY (receive_ack_cmd); our extra
+		 * id check drops legitimate answers whose ret_id differs
+		 * (observed: vote answered with ret_id=239). Sequential
+		 * sends make seqnum unique in practice.
+		 */
+		if (resp->seqnum == seqnum) {
+			if (resp->id != id)
+				pr_info("HFI-ACK idmismatch: waiter id=%u got ret_id=%u seq=%u error=%u (accepted by seq)\n",
+					resp->id, id, seqnum, msg->error);
+			resp->error = msg->error;
+			memcpy(resp->payload, msg->payload,
+				sizeof(resp->payload));
+
+			complete(&resp->complete);
+			spin_unlock(&hfi_ack_lock);
+			return;
+		}
+	}
+	spin_unlock(&hfi_ack_lock);
+
+	dev_err(gmu->dev, "Nobody was waiting for HFI message %d\n", seqnum);
+}
+
+static void a6xx_hfi_handle_error(struct a6xx_gmu *gmu,
+		struct a6xx_hfi_msg_response *msg)
+{
+	struct a6xx_hfi_msg_error *error = (struct a6xx_hfi_msg_error *) msg;
+
+	dev_err(gmu->dev, "GMU firmware error %d\n", error->code);
+}
+
+void a6xx_hfi_task(unsigned long data)
+{
+	struct a6xx_gmu *gmu = (struct a6xx_gmu *) data;
+	struct a6xx_hfi_queue *queue = &gmu->queues[HFI_RESPONSE_QUEUE];
+	struct a6xx_hfi_msg_response resp;
+
+	for (;;) {
+		u32 id;
+		int ret;
+		pr_info("HFI-ITER q1 rd=%u wr=%u\n",
+			queue->header->read_index, queue->header->write_index);
+		ret = a6xx_hfi_queue_read(gmu, queue, (u32 *) &resp,
+			sizeof(resp) >> 2);
+
+		/* Returns the number of bytes copied or negative on error */
+		if (ret <= 0) {
+			if (ret < 0)
+				dev_err(gmu->dev,
+					"Unable to read the HFI message queue\n");
+			break;
+		}
+
+		id = HFI_HEADER_ID(resp.header);
+
+		/* TEMPORARY image-111 diagnostics -- REMOVE AFTER RESULT. */
+		{
+			struct a6xx_hfi_queue *rq = &gmu->queues[HFI_RESPONSE_QUEUE];
+			u32 *rw = (u32 *) &resp;
+			int k, n = HFI_HEADER_SIZE(resp.header);
+			if (n > 19)
+				n = 19;
+			pr_info("HFI RX: header=0x%08x id=%u type=%u size=%u seq=%u\n",
+				resp.header, id,
+				HFI_HEADER_TYPE(resp.header),
+				HFI_HEADER_SIZE(resp.header),
+				HFI_HEADER_SEQNUM(resp.header));
+			pr_info("HFI RX: q1 rd=%u wr=%u words:",
+				rq->header->read_index, rq->header->write_index);
+			for (k = 0; k < n; k++)
+				pr_cont(" %08x", rw[k]);
+			pr_cont("\n");
+			if (HFI_HEADER_TYPE(resp.header) == HFI_MSG_ACK)
+				pr_info("HFI RX: ack ret_id=%u ret_type=%u ret_size=%u ret_seq=%u error=%u\n",
+					HFI_HEADER_ID(resp.ret_header),
+					HFI_HEADER_TYPE(resp.ret_header),
+					HFI_HEADER_SIZE(resp.ret_header),
+					HFI_HEADER_SEQNUM(resp.ret_header),
+					resp.error);
+			if (id == HFI_F2H_MSG_ERROR)
+				pr_info("HFI RX: ERROR code=%u payload=%08x %08x\n",
+					resp.error, resp.payload[0], resp.payload[1]);
+			if (a6xx_hfi_bw_sent) {
+				a6xx_hfi_bw_sent = false;
+				pr_info("=== HFI RX AFTER BW ===\n");
+			}
+		}
+
+		/*
+		 * TEMPORARY experiment image 109 -- REMOVE OR PROMOTE ON RESULT.
+		 * HFI v2 ACKs carry type == HFI_MSG_ACK with the acked command's
+		 * id/seqnum in ret_header; dispatching on id == 126 misses them.
+		 */
+		if (HFI_HEADER_TYPE(resp.header) == HFI_MSG_ACK) {
+			pr_info("HFI-ACK id=%u seq=%u error=%u\n", id,
+				HFI_HEADER_SEQNUM(resp.header), resp.error);
+			a6xx_hfi_handle_ack(gmu, &resp);
+		} else if (id == HFI_F2H_MSG_ERROR)
+			a6xx_hfi_handle_error(gmu, &resp);
+	}
+}
+
+static int a6xx_hfi_send_msg(struct a6xx_gmu *gmu, int id,
+		void *data, u32 size, u32 *payload, u32 payload_size)
+{
+	struct a6xx_hfi_queue *queue = &gmu->queues[HFI_COMMAND_QUEUE];
+	struct a6xx_hfi_response resp = { 0 };
+	int ret, dwords = size >> 2;
+	u32 seqnum;
+
+	seqnum = atomic_inc_return(&queue->seqnum) % 0xfff;
+
+	/* First dword of the message is the message header - fill it in */
+	*((u32 *) data) = (seqnum << 20) | (HFI_MSG_CMD << 16) |
+		(dwords << 8) | id;
+
+	init_completion(&resp.complete);
+	resp.id = id;
+	resp.seqnum = seqnum;
+
+	spin_lock_bh(&hfi_ack_lock);
+	list_add_tail(&resp.node, &hfi_ack_list);
+	spin_unlock_bh(&hfi_ack_lock);
+
+	if (id == HFI_H2F_MSG_FW_VERSION) {
+		struct a6xx_hfi_queue *q0 = &gmu->queues[0];
+		int k;
+		pr_info("HFI-A fw_version pre-write q0 rd=%u wr=%u msg=",
+			q0->header->read_index, q0->header->write_index);
+		for (k = 0; k < 8 && k < (int)dwords; k++)
+			pr_cont(" %08x", ((u32 *)data)[k]);
+		pr_cont("\n");
+	}
+	ret = a6xx_hfi_queue_write(gmu, queue, data, dwords);
+	hfi_send_irq_base = bw124_hfi_irqs;
+	hfi_send_gmu_irq_base = bw124_gmu_irqs;
+	if (id == HFI_H2F_MSG_FW_VERSION && !ret) {
+		struct a6xx_hfi_queue *q0 = &gmu->queues[0];
+		int k;
+		pr_info("HFI-B fw_version post-write q0 rd=%u wr=%u doorbell=0x01 data=",
+			q0->header->read_index, q0->header->write_index);
+		for (k = 0; k < 8 && k < (int)dwords; k++)
+			pr_cont(" %08x", q0->data[k]);
+		pr_cont("\n");
+		hfi_snap_gmu = gmu;
+		INIT_DELAYED_WORK(&hfi_snap_1ms_work, hfi_snap_1ms_fn);
+		INIT_DELAYED_WORK(&hfi_snap_100ms_work, hfi_snap_100ms_fn);
+		schedule_delayed_work(&hfi_snap_1ms_work, msecs_to_jiffies(1));
+		schedule_delayed_work(&hfi_snap_100ms_work, msecs_to_jiffies(100));
+	}
+	if (ret) {
+		dev_err(gmu->dev, "Unable to send message %s id %d\n",
+			a6xx_hfi_msg_id[id], seqnum);
+		goto out;
+	}
+
+	/*
+	 * TEMPORARY image 201 -- PROMOTE IF HFI STOPS TIMING OUT.
+	 *
+	 * Poll GMU2HOST_INTR_INFO for the MSGQ bit instead of waiting on IRQ
+	 * completion, matching CAF KGSL (adreno_a6xx_hfi.c,
+	 * a6xx_hfi_send_cmd_wait_inline polls INTR_INFO for BIT0 with a 1000ms
+	 * timeout; upstream msm does the same).
+	 *
+	 * We used to wait here on wait_for_completion_timeout(&resp.complete),
+	 * signalled via hardIRQ -> tasklet -> complete(). That chain has three
+	 * links that can each silently drop the wakeup: the GIC delivery, the
+	 * tasklet scheduling, and the completion itself. CAF deliberately
+	 * excludes MSGQ from its IRQ mask (HFI_IRQ_MASK has no BIT0) and polls
+	 * instead -- so an interrupt-driven wait on this path is itself a
+	 * porting bug regardless of outcome.
+	 *
+	 * This keeps the completion short-circuit (if the IRQ path did fire,
+	 * take the answer immediately) and otherwise polls INTR_INFO directly,
+	 * draining through the same a6xx_hfi_task() the tasklet runs. The
+	 * tasklet is disabled around the direct drain so a concurrently
+	 * scheduled instance cannot race it on the response queue.
+	 *
+	 * Decision rule for the result: if this still times out with
+	 * INTR_INFO == 0x0, the firmware genuinely never posts, and the problem
+	 * is inside the firmware's view of memory -- not barriers, not waits.
+	 */
+	{
+		unsigned long deadline =
+			jiffies + msecs_to_jiffies(5000);
+
+		ret = 0;
+		for (;;) {
+			if (completion_done(&resp.complete)) {
+				ret = 1;
+				break;
+			}
+			if (gmu_read(gmu, REG_A6XX_GMU_GMU2HOST_INTR_INFO) &
+				A6XX_GMU_GMU2HOST_INTR_INFO_MSGQ) {
+				tasklet_disable(&gmu->hfi_tasklet);
+				a6xx_hfi_task((unsigned long) gmu);
+				tasklet_enable(&gmu->hfi_tasklet);
+				continue;
+			}
+			if (time_after(jiffies, deadline))
+				break;
+			usleep_range(100, 200);
+		}
+		pr_info("HFI-POLL id=%d seq=%u completed=%d INTR_INFO=0x%x\n",
+			id, seqnum, !!ret,
+			gmu_read(gmu, REG_A6XX_GMU_GMU2HOST_INTR_INFO));
+	}
+	if (!ret) {
+		struct a6xx_hfi_queue *tq0 = &gmu->queues[0];
+		struct a6xx_hfi_queue *tq1 = &gmu->queues[1];
+		dev_err(gmu->dev,
+			"Message %s id %d timed out waiting for response\n",
+			a6xx_hfi_msg_id[id], seqnum);
+		/* TEMPORARY image 151 timeout forensics -- every message. */
+		pr_info("HFI-T id=%d seq=%u q0 rd=%u wr=%u q1 rd=%u wr=%u hfi_irqs=%lu(+%lu) gmu_irqs=%lu(+%lu) INTR_INFO=0x%x MASK=0x%x H2G_RAW=0x%x\n",
+			id, seqnum,
+			tq0->header->read_index, tq0->header->write_index,
+			tq1->header->read_index, tq1->header->write_index,
+			bw124_hfi_irqs, bw124_hfi_irqs - hfi_send_irq_base,
+			bw124_gmu_irqs, bw124_gmu_irqs - hfi_send_gmu_irq_base,
+			gmu_read(gmu, REG_A6XX_GMU_GMU2HOST_INTR_INFO),
+			gmu_read(gmu, REG_A6XX_GMU_GMU2HOST_INTR_MASK),
+			gmu_read(gmu, REG_A6XX_GMU_HOST2GMU_INTR_RAW_INFO));
+		if (id == HFI_H2F_MSG_FW_VERSION) {
+			struct a6xx_hfi_queue *q0 = &gmu->queues[0];
+			struct a6xx_hfi_queue *q1 = &gmu->queues[1];
+			int k;
+			pr_info("HFI-E fw_version timeout q0 rd=%u wr=%u q1 rd=%u wr=%u INTR_INFO=0x%x\n",
+				q0->header->read_index, q0->header->write_index,
+				q1->header->read_index, q1->header->write_index,
+				gmu_read(gmu, REG_A6XX_GMU_GMU2HOST_INTR_INFO));
+			pr_info("HFI-E q0cmd:");
+			for (k = 0; k < 8; k++)
+				pr_cont(" %08x", q0->data[k]);
+			pr_cont("\nHFI-E q1resp:");
+			for (k = 0; k < 16; k++)
+				pr_cont(" %08x", q1->data[k]);
+			pr_cont("\n");
+		}
+		ret = -ETIMEDOUT;
+	} else
+		ret = 0;
+
+out:
+	spin_lock_bh(&hfi_ack_lock);
+	list_del(&resp.node);
+	spin_unlock_bh(&hfi_ack_lock);
+
+	if (ret)
+		return ret;
+
+	if (resp.error) {
+		dev_err(gmu->dev, "Message %s id %d returned error %d\n",
+			a6xx_hfi_msg_id[id], seqnum, resp.error);
+		return -EINVAL;
+	}
+
+	if (payload && payload_size) {
+		int copy = min_t(u32, payload_size, sizeof(resp.payload));
+
+		memcpy(payload, resp.payload, copy);
+	}
+
+	return 0;
+}
