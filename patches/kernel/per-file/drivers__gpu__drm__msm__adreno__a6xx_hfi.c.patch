+/*
+ * HFI version dispatch. Ported from upstream v5.8.
+ *
+ * gmu->legacy is set for A618/A630, which speak HFI v1 and use the flat ITCM
+ * firmware image. A640/A650 (legacy == false) speak HFI v2 and use the block
+ * firmware format. Mixing the two fails in confusing ways, so the selection
+ * follows the same flag that selects the firmware format.
+ */
+int a6xx_hfi_start(struct a6xx_gmu *gmu, int boot_state)
+{
+	int ret;
+
+	if (gmu->legacy)
+		return a6xx_hfi_start_v1(gmu, boot_state);
+
+	/*
+	 * TEMPORARY experiment image 106 -- REMOVE OR PROMOTE ON RESULT.
+	 * Vendor-compatible v2 order: version, perf, bw, ECP feature,
+	 * core_fw_start, start. Stop at the FIRST failing message.
+	 */
+	pr_info("=== FW_VERSION ===\n");
+	pr_info("HFI: verify_fw_version enter\n");
+	ret = a6xx_hfi_get_fw_version(gmu, NULL);
+	pr_info("HFI: verify_fw_version ret=%d\n", ret);
+	if (ret)
+		return ret;
+
+	/*
+	 * TEMPORARY experiment image 117 -- REMOVE OR PROMOTE ON RESULT.
+	 * Full canonical sequence restored (no skips): v2 PERF_TABLE send
+	 * for A640 (upstream v5.8 order). DCVS OOB is gated separately in
+	 * set_oob, not here.
+	 */
+	pr_info("=== PERF_TABLE ===\n");
+	pr_info("HFI: send_perftbl enter\n");
+	ret = a6xx_hfi_send_perf_table(gmu);
+	pr_info("HFI: send_perftbl ret=%d\n", ret);
+	if (ret)
+		return ret;
+
+	pr_info("=== BW_TABLE ===\n");
+	pr_info("HFI: send_bwtbl enter\n");
+	{
+		struct a6xx_hfi_queue *q0 = &gmu->queues[0];
+		struct a6xx_hfi_queue *q1 = &gmu->queues[1];
+		pr_info("=== BW_TABLE SEND BEGIN ===\n");
+		pr_info("HFI BW: q0 rd=%u wr=%u q1 rd=%u wr=%u INTR_INFO=0x%x\n",
+			q0->header->read_index, q0->header->write_index,
+			q1->header->read_index, q1->header->write_index,
+			gmu_read(gmu, REG_A6XX_GMU_GMU2HOST_INTR_INFO));
+		a6xx_hfi_bw_sent = true;
+	}
+	/* Canonical A640 BW table from Image 110 (untouched object). */
+	/* TEMPORARY image 145 -- REMOVE AFTER RESULT. Gated BW skip: tests
+	 * whether ECP answers with real ARC votes but no BW state, and
+	 * whether survival changes when firmware never receives the table. */
+	if (skip_bw) {
+		pr_info("BW145: SKIPPED (a6xx.skip_bw=1), continuing as if ACKed\n");
+		ret = 0;
+	} else {
+		ret = a6xx_hfi_send_bw_table(gmu);
+	}
+	pr_info("HFI: send_bwtbl ret=%d\n", ret);
+	if (ret)
+		return ret;
+
+	pr_info("=== ECP ===\n");
+	pr_info("HFI: feature_ctrl ECP enter\n");
+	{
+		struct a6xx_hfi_queue *q0 = &gmu->queues[0];
+		struct a6xx_hfi_queue *q1 = &gmu->queues[1];
+		pr_info("=== ECP SEND ===\n");
+		pr_info("HFI-ECP q0 rd=%u wr=%u q1 rd=%u wr=%u INTR_INFO=0x%x\n",
+			q0->header->read_index, q0->header->write_index,
+			q1->header->read_index, q1->header->write_index,
+			gmu_read(gmu, REG_A6XX_GMU_GMU2HOST_INTR_INFO));
+	}
+	ret = a6xx_hfi_send_feature_ctrl(gmu, HFI_FEATURE_ECP, 0, 0);
+	pr_info("HFI: feature_ctrl ECP ret=%d\n", ret);
+	if (ret)
+		return ret;
+	pr_info("=== GMU BOOTSTRAP END ===\n");
+	pr_info("HFI: core_fw_start enter\n");
+	ret = a6xx_hfi_send_core_fw_start(gmu);
+	pr_info("HFI: core_fw_start ret=%d\n", ret);
+	if (ret)
+		return ret;
+
+	pr_info("HFI: init_perf_vote(start) enter\n");
+	ret = a6xx_hfi_send_start(gmu);
+	pr_info("HFI: init_perf_vote(start) ret=%d\n", ret);
+	if (ret)
+		return ret;
+
+	return 0;
+}
+
+void a6xx_hfi_stop(struct a6xx_gmu *gmu)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(gmu->queues); i++) {
+		struct a6xx_hfi_queue *queue = &gmu->queues[i];
+
+		if (!queue->header)
+			continue;
+
+		if (queue->header->read_index != queue->header->write_index)
+			dev_err(gmu->dev, "HFI queue %d is not empty\n", i);
+
+		queue->header->read_index = 0;
+		queue->header->write_index = 0;
+	}
+}
+
+static void a6xx_hfi_queue_init(struct a6xx_hfi_queue *queue,
+		struct a6xx_hfi_queue_header *header, void *virt, u64 iova,
+		u32 id, u32 prio, u32 status)
+{
+	spin_lock_init(&queue->lock);
+	queue->header = header;
+	queue->data = virt;
+	atomic_set(&queue->seqnum, 0);
+
+	/* Set up the shared memory header */
+	header->iova = iova;
+	header->type = prio << 8 | id;
+	header->status = status;
+	header->size = SZ_4K >> 2;
+	header->msg_size = 0;
+	header->dropped = 0;
+	header->rx_watermark = 1;
+	header->tx_watermark = 1;
+	header->rx_request = 1;
+	header->tx_request = 0;
+	header->read_index = 0;
+	header->write_index = 0;
+}
+
+void a6xx_hfi_init(struct a6xx_gmu *gmu)
+{
+	struct a6xx_gmu_bo *hfi = gmu->hfi;
+	struct a6xx_hfi_queue_table_header *table = hfi->virt;
+	struct a6xx_hfi_queue_header *headers = hfi->virt + sizeof(*table);
+	u64 offset;
+	int table_size;
+
+	/*
+	 * The table size is the size of the table header plus all of the queue
+	 * headers
+	 */
+	table_size = sizeof(*table);
+	table_size += (ARRAY_SIZE(gmu->queues) *
+		sizeof(struct a6xx_hfi_queue_header));
+
+	table->version = 0;
+	/*
+	 * TEMPORARY experiment -- REMOVE OR PROMOTE ON RESULT. Vendor KGSL
+	 * documents size in dwords (its 4-queue table reports 0x36 = 216 bytes
+	 * >> 2); the sibling fields below already use >> 2. For our 2-queue
+	 * table: 120 bytes >> 2 = 30 = 0x1E. Queues/layout untouched.
+	 */
+	table->size = table_size >> 2;
+	/* First queue header is located immediately after the table header */
+	table->qhdr0_offset = sizeof(*table) >> 2;
+	table->qhdr_size = sizeof(struct a6xx_hfi_queue_header) >> 2;
+	table->num_queues = ARRAY_SIZE(gmu->queues);
+	table->active_queues = ARRAY_SIZE(gmu->queues);
+
+	/*
+	 * TEMPORARY experiment image 101 -- REMOVE OR PROMOTE ON RESULT.
+	 * Exact vendor KGSL 4-queue topology (CMD/MSG/DBG enabled, DSP defined
+	 * but disabled). Data pages at base+0x1000..+0x4000.
+	 */
+	/* Command queue */
+	offset = SZ_4K;
+	a6xx_hfi_queue_init(&gmu->queues[0], &headers[0], hfi->virt + offset,
+		hfi->iova + offset, 0, 10, 1);
+
+	/* GMU response queue */
+	offset += SZ_4K;
+	a6xx_hfi_queue_init(&gmu->queues[1], &headers[1], hfi->virt + offset,
+		hfi->iova + offset, 1, 10, 1);
+
+	/* Debug queue */
+	offset += SZ_4K;
+	a6xx_hfi_queue_init(&gmu->queues[2], &headers[2], hfi->virt + offset,
+		hfi->iova + offset, 2, 40, 1);
+
+	/* Dispatch queue (defined but disabled, per vendor) */
+	offset += SZ_4K;
+	a6xx_hfi_queue_init(&gmu->queues[3], &headers[3], hfi->virt + offset,
+		hfi->iova + offset, 3, 20, 0);
+}
