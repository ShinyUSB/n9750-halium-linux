+/*
+ * IMAGE 225 -- PROMOTE: this is the function that was missing.
+ *
+ * Set the GPU frequency on HFI v2 (A640/A650) firmware.
+ *
+ * Transcribed from upstream v5.8 a6xx_hfi.c:a6xx_hfi_set_freq() and upstream
+ * master (same body, extra bw_index). This is the ONLY instruction in the
+ * whole driver that tells v2 firmware which GX corner to vote for, and
+ * therefore the only one that can cause the GMU to raise the GX rail and
+ * clock gpu_cc_gx_gmu_clk.
+ *
+ * Our port had no equivalent: a6xx_gmu_set_freq() ran the HFI v1 DCVS
+ * register + DCVS-OOB sequence unconditionally. On v2 firmware the DCVS OOB
+ * request bit is not watched, so the request was never consumed and the
+ * firmware was never asked for a GX corner -- it correctly held GX collapsed.
+ * That matches every observation: GMU alive and ACKing HFI, CX domain running,
+ * GX_VOTE_IDX consumed and cleared, and gpu_cc_gx_gmu_clk permanently en=0.
+ */
+int a6xx_hfi_set_freq(struct a6xx_gmu *gmu, int index)
+{
+	struct a6xx_hfi_msg_gx_bw_perf_vote msg = { 0 };
+
+	msg.ack_type = 1;	/* blocking */
+	msg.freq = index;
+	msg.bw = 0;		/* TODO: bus scaling */
+
+	return a6xx_hfi_send_gx_vote(gmu, msg.ack_type, msg.freq, msg.bw);
+}
