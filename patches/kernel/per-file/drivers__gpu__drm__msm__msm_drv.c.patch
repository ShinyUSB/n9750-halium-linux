+/*
+ * IMAGE 297: D2Q guard -- keep xserver from replacing its own framebuffer
+ * with the fbcon/fbdev one.
+ *
+ * xserver 21.1.7 (modesetting) re-applies its cached "desired" state on every
+ * damage event, and the fb id it uses is the framebuffer that was on the CRTC
+ * when X started -- the fbcon/fbdev framebuffer.  Nothing draws into that
+ * buffer (fbcon=map:2), so the panel goes black although X's own framebuffer
+ * is perfectly fine.  Refuse a *userspace* commit that puts the fbdev fb onto
+ * a plane whose current fb is a different (client) fb.  Kernel-context commits
+ * (boot splash handoff, fbcon restore) are not affected.
+ */
+static int d2q_guard_fbdev_fb(struct drm_device *dev,
+			      struct drm_atomic_state *state)
+{
+	struct msm_drm_private *priv = dev->dev_private;
+	struct drm_plane *plane;
+	struct drm_plane_state *new_ps, *old_ps;
+	int i;
+
+	if (!priv || !priv->fbdev || !priv->fbdev->fb)
+		return 0;
+	if (!current->mm)	/* kernel context: never interfere */
+		return 0;
+
+	for_each_new_plane_in_state(state, plane, new_ps, i) {
+		old_ps = plane->state;
+		if (!new_ps->crtc || new_ps->fb != priv->fbdev->fb)
+			continue;
+		if (!old_ps || !old_ps->fb || old_ps->fb == priv->fbdev->fb)
+			continue;
+
+		/*
+		 * IMAGE 298: substitute instead of rejecting.  Rejecting the
+		 * whole commit threw away the very commit that programs the
+		 * hardware and left the DPU black (flicker: lit/dark/lit).
+		 * Keeping the commit but pinning the client fb keeps both the
+		 * DRM state and the hardware consistent.
+		 */
+		pr_info("D2QGUARD: substituting fb %u for fbcon fb %u on '%s' (crtc%d, comm=%s/%d)\n",
+			old_ps->fb->base.id, priv->fbdev->fb->base.id, plane->name,
+			old_ps->crtc ? (int)old_ps->crtc->index : -1,
+			current->comm, current->pid);
+		drm_atomic_set_fb_for_plane(new_ps, old_ps->fb);
+	}
+
+	return 0;
+}
