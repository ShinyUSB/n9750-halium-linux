+/*
+ * TEMPORARY image 196 -- a READABLE cpstate.
+ *
+ * Why this exists
+ * ---------------
+ * Now that the GPU really executes (image 195), submitting GL work hard-resets
+ * the system with NO kernel record at all: no panic, no oops, no SMMU fault, no
+ * watchdog bite. dmesg simply stops mid-stream, and /proc/last_kmsg cannot help
+ * because a hard reset writes no pstore record. The existing probe therefore
+ * fails at exactly the moment it is needed: its output goes to the ring buffer,
+ * which the reset discards.
+ *
+ * /dev/mem does not exist on this system and msm's debugfs register interface is
+ * non-functional in this CAF tree (the `gpu` file is empty and writes are
+ * rejected), so there is NO pure-userspace way to read these registers today.
+ * Hence this: make the probe RETURN its values instead of printing them.
+ *
+ * Why userspace must own the write
+ * --------------------------------
+ * If the kernel merely logged the dump, a hard reset would still lose it. The
+ * point of this read path is that a userspace poller can sample it at high rate
+ * and fsync each sample to disk itself, so the last samples taken before the
+ * reset survive on the phone. The kernel hands the values over early; userspace
+ * decides when they are durable.
+ *
+ * Read format: one "key value" pair per line, so it is trivially greppable and
+ * trivially parsed.
+ */
+extern int a6xx_cp_state_read(struct msm_gpu *gpu, char *page, size_t size);
+
+static ssize_t a6xx_gpu_cpstate_show(struct device *dev,
+		struct device_attribute *attr, char *page)
+{
+	struct platform_device *pdev = to_platform_device(dev);
+	struct drm_device *ddev;
+	struct msm_drm_private *priv;
+	struct msm_gpu *gpu;
+	int n;
+
+	(void)attr;
+
+	if (mutex_lock_interruptible(&init_lock))
+		return -ERESTARTSYS;
+
+	/* Exactly the lookup the store handler uses. */
+	ddev = platform_get_drvdata(pdev);
+	priv = ddev ? ddev->dev_private : NULL;
+	if (!priv || !priv->gpu) {
+		mutex_unlock(&init_lock);
+		return scnprintf(page, PAGE_SIZE, "nogpu\n");
+	}
+	gpu = priv->gpu;
+
+	/*
+	 * Serialised against the store path, which probes under struct_mutex.
+	 * The reads themselves live in a6xx_gpu.c because that file has the
+	 * adreno/a6xx register definitions; msm_drv.c cannot see them.
+	 *
+	 * Deliberately NO msm_gpu_retire() here. Reading these registers must
+	 * not wake the GPU or change power state -- the whole point is to
+	 * observe a dying machine without perturbing it.
