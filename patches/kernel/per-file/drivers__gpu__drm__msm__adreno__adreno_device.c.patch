+	/*
+	 * A640 (Adreno 640 v2, Snapdragon 855+/SM8150).
+	 *
+	 * This entry is NOT present in any upstream tree up to and including
+	 * v5.8, nor in CAF msm-4.19; it is authored here for this port.
+	 *
+	 * Chip ID note (milestone E): the vendor DT declares
+	 *   qcom,chipid = <0x06040000>   -> rev 6.4.0.0
+	 * while newer upstream catalogues list 0x06040001 -> rev 6.4.0.1.
+	 * Rather than change the vendor DT value, the patch-id component is
+	 * wildcarded with ANY_ID so that BOTH revisions resolve to this entry.
+	 * The value read back from the hardware register is logged at probe
+	 * time and recorded in the bring-up log before any judgement is made.
+	 */
+	{
+		.rev   = ADRENO_REV(6, 4, 0, ANY_ID),
+		.revn  = 640,
+		.name  = "A640",
+		.fw = {
+			[ADRENO_FW_SQE] = "a630_sqe.fw",
+			[ADRENO_FW_GMU] = "a640_gmu.bin",
+		},
+		.gmem  = SZ_1M,
+		.init  = a6xx_gpu_init,
+		.zapfw = "a640_zap.mdt",
+		/*
+		 * Take the GPU out of GDSC bounce between frames the same way
+		 * the A630 entry does, to avoid GDSC instability.
+		 */
+		.inactive_period = 250,
+		.quirks = ADRENO_QUIRK_TWO_PASS_USE_WFI |
+			ADRENO_QUIRK_FAULT_DETECT_MASK,
+	},
 };
 
