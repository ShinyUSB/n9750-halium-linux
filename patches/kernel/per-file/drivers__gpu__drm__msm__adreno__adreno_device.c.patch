 	if (gpu) {
 		int ret;
+		struct adreno_gpu *adreno_gpu = to_adreno_gpu(gpu);
+
+		/*
+		 * a6xx: load the SQE/GMU firmware blobs before hw init.
+		 * Upstream v4.19 does this in adreno_load_gpu() before
+		 * msm_gpu_hw_init(); the legacy CAF path loaded pm4/pfp
+		 * inside adreno_hw_init() instead, so we keep both.
+		 */
+		ret = adreno_load_fw(adreno_gpu);
+		if (ret) {
+			dev_err(dev->dev, "failed to load firmware: %d\n", ret);
+
+			/*
+			 * msm_gpu_init() claimed the GPU IRQ with
+			 * devm_request_irq(), which is only released when the GPU
+			 * platform device is released -- destroy() does not do
+			 * that. Leave it held and every later load_gpu() retry
+			 * gets -EBUSY from devm_request_irq(), which then turns
+			 * into "failed to load adreno gpu" for good.
+			 *
+			 * pdev is priv->gpu_pdev here, the same device the IRQ was
+			 * claimed on, so devm_free_irq() pairs with it correctly.
+			 */
+			if (gpu->irq >= 0)
+				devm_free_irq(&pdev->dev, gpu->irq, gpu);
+
+			gpu->funcs->destroy(gpu);
+			return NULL;
+		}
+
+		/*
+		 * a6xx addresses the ring fence/rptr memptrs through the
+		 * ring (rbmemptr(ring, ...)), while the legacy CAF code
+		 * addresses them through adreno_gpu. Point the ring at the
+		 * same allocation so both forms resolve to one object.
+		 */
+		if (gpu->rb[0]) {
+			gpu->rb[0]->memptrs       = adreno_gpu->memptrs;
