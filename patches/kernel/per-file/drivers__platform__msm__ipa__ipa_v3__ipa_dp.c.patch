+int d2q_rx_trace = 1;
+static void d2q_hexdump(const char *tag, const void *buf, int len)
+{
+	int i;
+	char line[3 * 16 + 1];
+	const u8 *p = buf;
+
+	if (!d2q_rx_trace)
+		return;
+	if (len > 64)
+		len = 64;
+	for (i = 0; i < len; i++) {
+		snprintf(line + (i % 16) * 3, 4, "%02x ", p[i]);
+		if (i % 16 == 15 || i == len - 1) {
+			line[(i % 16) * 3 + 3] = 0;
+			pr_err("D2QRX %s: %s\n", tag, line);
+		}
+	}
+}
+#define D2QRX(...) do { if (d2q_rx_trace) pr_err("D2QRX " __VA_ARGS__); } while (0)
