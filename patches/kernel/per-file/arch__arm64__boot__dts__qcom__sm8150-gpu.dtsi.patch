--- a/arch/arm64/boot/dts/qcom/sm8150-gpu.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm8150-gpu.dtsi
@@ -63,6 +63,25 @@
 		};
 	};
 
+	/*
+	 * TEMPORARY experiment image 121 -- REMOVE OR PROMOTE ON RESULT.
+	 * Dedicated GMU OPP table (canonical SM8150/A640 shape): a single
+	 * 200 MHz level. dev_pm_opp_of_add_table() needs only opp-hz to
+	 * succeed; opp-microvolt carries the RPMh level per in-tree
+	 * convention (sdmshrike gmu table, gpu_opp_table above), and
+	 * opp-level mirrors it per the SM8150/A640 reference. Both are
+	 * inert for probe success; get_arc_level() reads qcom,level.
+	 */
+	gmu_opp_table: gmu-opp-table {
+		compatible = "operating-points-v2";
+
+		opp-200000000 {
+			opp-hz = /bits/ 64 <200000000>;
+			opp-microvolt = <RPMH_REGULATOR_LEVEL_MIN_SVS>;
+			opp-level = <RPMH_REGULATOR_LEVEL_MIN_SVS>;
+		};
+	};
+
 	msm_gpu: qcom,kgsl-3d0@2C00000 {
 		label = "kgsl-3d0";
 		compatible = "qcom,kgsl-3d0", "qcom,kgsl-3d";
@@ -77,6 +96,20 @@
 
 		qcom,chipid = <0x06040000>;
 
+		/*
+		 * EXPERIMENTAL A6xx DRM: a6xx_gpu_init() does
+		 *   of_parse_phandle(pdev->dev.of_node, "gmu", 0)
+		 * and BUG_ON()s if it is absent. The upstream property name is
+		 * plain "gmu", NOT "qcom,gmu". The GMU node itself already
+		 * exists below with reg 0x2c6a000 and IRQs 304/305, so only the
+		 * phandle is required here.
+		 *
+		 * The vendor qcom,chipid value 0x06040000 is deliberately left
+		 * untouched: adreno_device.c wildcarded the A640 patch-id with
+		 * ANY_ID so both 0x06040000 and upstream's 0x06040001 match.
+		 */
+		gmu = <&gmu>;
+
 		qcom,initial-pwrlevel = <5>;
 
 		qcom,gpu-quirk-secvid-set-once;
@@ -375,10 +408,26 @@
 				<&clock_gpucc GPU_CC_CXO_CLK>,
 				<&clock_gcc GCC_DDRSS_GPU_AXI_CLK>,
 				<&clock_gcc GCC_GPU_MEMNOC_GFX_CLK>,
-				<&clock_gpucc GPU_CC_AHB_CLK>;
+				<&clock_gpucc GPU_CC_AHB_CLK>,
+				/*
+				 * IMAGE 229: the GX graphics-domain clock.
+				 * It is NOT enabled by KGSL or upstream msm --
+				 * the GMU firmware is supposed to open it --
+				 * but it is the one gate still shut after a
+				 * correct, acknowledged GX vote. Requesting it
+				 * lets the clk driver (which knows the real
+				 * gate is GPU_CC+0x1064 BIT(0), NOT the
+				 * 0x162/0x0F measurement register quoted by
+				 * debugcc-sm8150.c) drive it properly.
+				 */
+				<&clock_gpucc GPU_CC_GX_GMU_CLK>;
 
 		clock-names = "gmu_clk", "cxo_clk", "axi_clk",
-				"memnoc_clk", "gpu_cc_ahb";
+				"memnoc_clk", "gpu_cc_ahb",
+				"gx_gmu_clk";
+
+		/* TEMPORARY experiment image 121: GMU OPP table (see above). */
+		operating-points-v2 = <&gmu_opp_table>;
 
 		/* AOP mailbox for sending ACD enable and disable messages */
 		mboxes = <&qmp_aop 0>;
