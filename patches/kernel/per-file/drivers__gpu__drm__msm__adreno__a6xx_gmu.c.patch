+/*
+ * TEMPORARY bring-up tracing -- REMOVE ONCE GMU RESUME IS STABLE.
+ *
+ * Local, A6xx-only stand-in for clk_bulk_prepare_enable() so each clock can be
+ * identified individually. It deliberately does NOT replace or wrap the
+ * generic helper: this kernel's clk_bulk_prepare_enable() is two passes
+ * (clk_bulk_prepare() then clk_bulk_enable()), so both are traced here in the
+ * same order, with no change to clock or power behaviour.
+ */
+static int a6xx_gmu_clk_bulk_prepare_enable_traced(int num,
+		struct clk_bulk_data *clks)
+{
+	int ret, i;
+
+	A6XX_TRACE("--- resolved GMU clock list: count=%d ---", num);
+	for (i = 0; i < num; i++)
+		A6XX_TRACE("clock[%d] '%s' clk=%p", i,
+			clks[i].id ? clks[i].id : "(null-id)",
+			(void *)clks[i].clk);
+
+	A6XX_TRACE("--- pass 1: clk_prepare ---");
+	for (i = 0; i < num; i++) {
+		A6XX_TRACE("clock[%d] '%s' prepare enter", i,
+			clks[i].id ? clks[i].id : "(null-id)");
+		ret = clk_prepare(clks[i].clk);
+		A6XX_TRACE("clock[%d] '%s' prepare returned ret=%d", i,
+			clks[i].id ? clks[i].id : "(null-id)", ret);
+		if (ret)
+			return ret;
+	}
+
+	A6XX_TRACE("--- pass 2: clk_enable ---");
+	for (i = 0; i < num; i++) {
+		A6XX_TRACE("clock[%d] '%s' enable enter", i,
+			clks[i].id ? clks[i].id : "(null-id)");
+		ret = clk_enable(clks[i].clk);
+		A6XX_TRACE("clock[%d] '%s' enable returned ret=%d", i,
+			clks[i].id ? clks[i].id : "(null-id)", ret);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
