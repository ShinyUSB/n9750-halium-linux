+static void prov138(struct a6xx_gmu *gmu, const char *tag)
+{
+	struct device *dev = gmu->dev;
+	struct device *parent = dev ? dev->parent : NULL;
+	int i;
+	pr_info("PROV138-%s: dev=%s parent=%s pm_en=%d pm_active=%d usage=%d rpmh_init=%s\n",
+		tag,
+		dev ? dev_name(dev) : "?",
+		parent ? dev_name(parent) : "?",
+		dev ? pm_runtime_enabled(dev) : -1,
+		dev ? pm_runtime_active(dev) : -1,
+		dev ? atomic_read(&dev->power.usage_count) : -1,
+		"n/a-at-probe(rpmh_init runs at trigger)");
+	pr_info("PROV138-%s: cx_reg=%d gx_reg=%d domain=%s cb=%s RPMH_CTRL=0x%x%s\n",
+		tag,
+		gmu_clks_live && gmu->cx ? regulator_is_enabled(gmu->cx) : -1,
+		gmu_clks_live && gmu->gx ? regulator_is_enabled(gmu->gx) : -1,
+		gmu->domain ? "set" : "NULL",
+		gmu->cb_dev ? dev_name(gmu->cb_dev) : "NULL",
+		gmu->mmio && gmu_clks_live ?
+			gmu_read(gmu, REG_A6XX_GMU_RPMH_CTRL) : 0,
+		gmu_clks_live ? "" : " (HW reads skipped, clocks off)");
+	for (i = 0; i < gmu->nr_clocks; i++)
+		pr_info("PROV138-%s: clk[%d]=%s rate=%lu\n", tag, i,
+			gmu->clocks[i].id ? gmu->clocks[i].id : "?",
+			(gmu_clks_live && gmu->clocks[i].clk) ?
+				clk_get_rate(gmu->clocks[i].clk) : 0);
+	pr_info("PROV138-%s: note no-gxpd no-devfreq-target no-qmp links-skipped\n",
+		tag);
+}
+static int a6xx_gmu_probe_real(struct a6xx_gpu *a6xx_gpu,
+		struct device_node *node);
+
+/*
+ * TEMPORARY bring-up tracing -- REMOVE ONCE seq_mmio IS UNDERSTOOD.
+ *
+ * Prints the three GMU MMIO pointers and, where the resource is known, the
+ * backing resource extents. Called at probe time, before the RPMh init, and
+ * before the first pdcseq_write().
+ */
+
+/*
+ * TEMPORARY GMU post-mortem -- REMOVE ONCE A6xx BRING-UP IS DONE.
+ * Runs in SMMU-IRQ context just before the fault panic. Only gmu_read()
+ * (plain MMIO) + pr_info + host-RAM reads: no locks, no allocations.
+ * Ordered registers-first so early lines survive even a wedged TCM read.
+ * Everything is bounded for last_kmsg.
+ */
+void a6xx_gmu_snapshot_on_smmu_fault(const char *smmu_name,
+		unsigned long iova,
+		int cbndx, u32 sid, u32 fsr, u32 fsynr0, u32 fsynr1,
+		u64 ttbr0, u64 ttbr1, u32 sctlr)
+{
+	struct a6xx_gmu *gmu = a6xx_snapshot_gmu;
+	int i;
+	u32 w0, w1, w2, w3;
+
+	if (!gmu || !gmu->mmio)
+		return;
+
+	pr_info("A6XX_SNAPSHOT: FAULT smmu=%s iova=0x%lx cb=%d sid=0x%x fsr=0x%x fsynr0=0x%x fsynr1=0x%x\n",
+		smmu_name, iova, cbndx, sid, fsr, fsynr0, fsynr1);
+	pr_info("A6XX_SNAPSHOT: SMMU ttbr0=0x%llx ttbr1=0x%llx sctlr=0x%x\n",
+		ttbr0, ttbr1, sctlr);
+	pr_info("A6XX_SNAPSHOT: HOST QTBL=0x%x INFO=0x%x SFR=0x%x BOOT=0x%x CM3CFG=0x%x G7=0x%x INITRES=0x%x HFISTAT=0x%x\n",
+		gmu_read(gmu, REG_A6XX_GMU_HFI_QTBL_ADDR),
+		gmu_read(gmu, REG_A6XX_GMU_HFI_QTBL_INFO),
+		gmu_read(gmu, REG_A6XX_GMU_HFI_SFR_ADDR),
+		gmu_read(gmu, REG_A6XX_GMU_CM3_BOOT_CONFIG),
+		gmu_read(gmu, REG_A6XX_GMU_CM3_CFG),
+		gmu_read(gmu, REG_A6XX_GMU_GENERAL_7),
+		gmu_read(gmu, REG_A6XX_GMU_CM3_FW_INIT_RESULT),
+		gmu_read(gmu, REG_A6XX_GMU_HFI_CTRL_STATUS));
+	if (gmu->hfi && gmu->hfi->virt)
+		pr_info("A6XX_SNAPSHOT: HFIQ %08x %08x %08x %08x\n",
+			((u32 *)gmu->hfi->virt)[0], ((u32 *)gmu->hfi->virt)[1],
+			((u32 *)gmu->hfi->virt)[2], ((u32 *)gmu->hfi->virt)[3]);
+	for (i = 0; i < 0x80; i += 16) {
+		w0 = gmu_read(gmu, REG_A6XX_GMU_CM3_ITCM_START + (i >> 2));
+		w1 = gmu_read(gmu, REG_A6XX_GMU_CM3_ITCM_START + (i >> 2) + 1);
+		w2 = gmu_read(gmu, REG_A6XX_GMU_CM3_ITCM_START + (i >> 2) + 2);
+		w3 = gmu_read(gmu, REG_A6XX_GMU_CM3_ITCM_START + (i >> 2) + 3);
+		pr_info("A6XX_SNAPSHOT: ITCM+%02x %08x %08x %08x %08x\n",
+			i, w0, w1, w2, w3);
+	}
+	for (i = 0; i < 0x40; i += 16) {
+		w0 = gmu_read(gmu, REG_A6XX_GMU_CM3_DTCM_START + (i >> 2));
+		w1 = gmu_read(gmu, REG_A6XX_GMU_CM3_DTCM_START + (i >> 2) + 1);
+		w2 = gmu_read(gmu, REG_A6XX_GMU_CM3_DTCM_START + (i >> 2) + 2);
+		w3 = gmu_read(gmu, REG_A6XX_GMU_CM3_DTCM_START + (i >> 2) + 3);
+		pr_info("A6XX_SNAPSHOT: DTCM+%02x %08x %08x %08x %08x\n",
+			i, w0, w1, w2, w3);
+	}
+	for (i = 0; i < 0x40; i += 16) {
+		w0 = gmu_read(gmu, REG_A6XX_GMU_CM3_DTCM_START +
+			((0x3f80 + i) >> 2));
+		w1 = gmu_read(gmu, REG_A6XX_GMU_CM3_DTCM_START +
+			((0x3f80 + i) >> 2) + 1);
+		w2 = gmu_read(gmu, REG_A6XX_GMU_CM3_DTCM_START +
+			((0x3f80 + i) >> 2) + 2);
+		w3 = gmu_read(gmu, REG_A6XX_GMU_CM3_DTCM_START +
+			((0x3f80 + i) >> 2) + 3);
+		pr_info("A6XX_SNAPSHOT: DTCM+3f%02x %08x %08x %08x %08x\n",
+			i, w0, w1, w2, w3);
+	}
+	if (gmu->sentinel && gmu->sentinel->virt)
+		pr_info("A6XX_SNAPSHOT: SENTINEL %08x %08x %08x %08x %08x %08x %08x %08x FW_BUSY=0x%x NMI=0x%x elapsed=%ums\n",
+			((u32 *)gmu->sentinel->virt)[0], ((u32 *)gmu->sentinel->virt)[1],
+			((u32 *)gmu->sentinel->virt)[2], ((u32 *)gmu->sentinel->virt)[3],
+			((u32 *)gmu->sentinel->virt)[4], ((u32 *)gmu->sentinel->virt)[5],
+			((u32 *)gmu->sentinel->virt)[6], ((u32 *)gmu->sentinel->virt)[7],
+			gmu_read(gmu, REG_A6XX_GMU_CM3_FW_BUSY),
+			gmu_read(gmu, REG_A6XX_GMU_NMI_CONTROL_STATUS),
+			jiffies_to_msecs(jiffies - a6xx_start_jiffies));
+	pr_info("A6XX_SNAPSHOT: done\n");
+}
+
+int a6xx_gmu_probe(struct a6xx_gpu *a6xx_gpu, struct device_node *node)
+{
+	/*
+	 * Synchronous, as upstream orders it: the GMU must be set up before
+	 * any GPU hw init, because a6xx_gmu_resume() dereferences gmu->mmio
+	 * and oopses if the probe has not run. The deferral that used to live
+	 * here produced exactly that NULL deref once the filesystem was fixed.
+	 *
+	 * gpu_init_delay_ms now only gates the GPU core attach in msm_drv.c,
+	 * which keeps the kernel bring-up observable over the network.
+	 */
+	return a6xx_gmu_probe_real(a6xx_gpu, node);
+}
+
+static int a6xx_gmu_probe_real(struct a6xx_gpu *a6xx_gpu,
+		struct device_node *node)
+{
+	struct a6xx_gmu *gmu = &a6xx_gpu->gmu;
+	struct adreno_gpu *adreno_gpu = &a6xx_gpu->base;
+	struct platform_device *pdev = of_find_device_by_node(node);
+	int ret;
+
+	if (!pdev)
+		return -ENODEV;
+
+	att138_n++;
+	pr_info("ATT138: n=%d pdev=%s/%px node=%s parent=%s mmio=%s domain=%s caller=%ps\n",
+		att138_n, dev_name(&pdev->dev), &pdev->dev,
+		node->full_name,
+		pdev->dev.parent ? dev_name(pdev->dev.parent) : "?",
+		gmu->mmio ? "set" : "NULL",
+		gmu->domain ? "set" : "NULL",
+		__builtin_return_address(0));
+	prov138(gmu, "probe-entry");
+
+	gmu->dev = &pdev->dev;
+
+	of_dma_configure(gmu->dev, node);
+
+	/* Fow now, don't do anything fancy until we get our feet under us */
+	gmu->idle_level = GMU_IDLE_STATE_ACTIVE;
+
+	pm_runtime_enable(gmu->dev);
+	gmu->gx = devm_regulator_get(gmu->dev, "vdd");
+	/*
+	 * Minimal equivalent of vendor KGSL gmu_enable_gdsc(): own the CX
+	 * GDSC from the same GMU node ("vddcx" in regulator-names,
+	 * vddcx-supply = <&gpu_cx_gdsc>). No DT change; the binding exists.
+	 * Left NULL on error so a missing binding cannot break the probe;
+	 * the resume skips a NULL/ERR regulator.
+	 */
+	gmu->cx = devm_regulator_get(gmu->dev, "vddcx");
+	if (IS_ERR(gmu->cx)) {
+		dev_info(gmu->dev, "a6xx: no vddcx regulator: %ld (continuing)\n",
+			PTR_ERR(gmu->cx));
+		gmu->cx = NULL;
+	}
+
+	/*
+	 * Minimal equivalent of vendor KGSL gmu_gpu_bw_probe(): register a
+	 * bus-scale client on the GPU device's grp3d table. KGSL votes index
+	 * bus_freq (300MHz DDR = index 4 on sm8150) via
+	 * msm_bus_scale_client_update_request(gmu->pcl, ...) immediately
+	 * before FW_START. 0 stays 0 if the table/client is unavailable.
+	 */
+	{
+		struct drm_device *drm = adreno_gpu->base.dev;
+		struct msm_drm_private *priv = drm ? drm->dev_private : NULL;
+		struct platform_device *gpdev =
+			priv ? priv->gpu_pdev : NULL;
+		struct msm_bus_scale_pdata *bw_table = NULL;
+
+		if (gpdev)
+			bw_table = msm_bus_cl_get_pdata(gpdev);
+		if (bw_table) {
+			gmu->bw_pcl =
+				msm_bus_scale_register_client(bw_table);
+			dev_info(gmu->dev,
+				"a6xx: bus client registered: pcl=%u cases=%d\n",
+				gmu->bw_pcl,
+				bw_table->num_usecases);
+		} else {
+			dev_info(gmu->dev,
+				"a6xx: no grp3d bus table (continuing)\n");
+		}
+	}
+
+	/* Get the list of clocks */
+	ret = a6xx_gmu_clocks_probe(gmu);
+	if (ret)
+		return ret;
+
+	/*
+	 * IMAGE 230: open the AOP mailbox channel used to notify AOP of the
+	 * GPU's ACD state. Transcribed from vendor KGSL
+	 * drivers/gpu/msm/kgsl_gmu.c:1305-1333 on this board's tree.
+	 *
+	 * The GMU DT node already carries the phandle (sm8150-gpu.dtsi):
+	 *	mboxes = <&qmp_aop 0>;
+	 *	mbox-names = "aop";
+	 * so mbox_request_channel() can resolve it. Failure is non-fatal:
+	 * report it and carry on, exactly as KGSL logs and continues.
+	 */
+	if (send_acd) {
+		gmu->aop_client = kzalloc(sizeof(*gmu->aop_client),
+					  GFP_KERNEL);
+		if (gmu->aop_client) {
+			gmu->aop_client->dev = gmu->dev;
+			gmu->aop_client->tx_block = true;
+			gmu->aop_client->tx_tout = 1000;
+			gmu->aop_client->knows_txdone = false;
+
+			gmu->aop_chan = mbox_request_channel(gmu->aop_client, 0);
+			if (IS_ERR(gmu->aop_chan)) {
+				pr_info("ACD230: mbox_request_channel failed %ld\n",
+					PTR_ERR(gmu->aop_chan));
+				gmu->aop_chan = NULL;
+				kfree(gmu->aop_client);
+				gmu->aop_client = NULL;
+			} else {
+				pr_info("ACD230: AOP mailbox channel acquired\n");
+			}
+		}
+	}
+
+	/* Set up the IOMMU context bank (gmu->dev stays on the GMU pdev) */
+	pr_info("GMU_DEV: before=%p/%s/%s\n", gmu->dev, dev_name(gmu->dev),
+		gmu->dev->of_node ? gmu->dev->of_node->full_name : "?");
+	ret = a6xx_gmu_memory_probe(&adreno_gpu->base.pdev->dev, gmu);
+	if (ret)
+		return ret;
+	pr_info("GMU_DEV: after=%p/%s/%s cb=%s\n", gmu->dev, dev_name(gmu->dev),
+		gmu->dev->of_node ? gmu->dev->of_node->full_name : "?",
+		gmu->cb_dev ? dev_name(gmu->cb_dev) : "?");
+	a6xx_trace("after memory_probe");
+
+	/*
+	 * TEMPORARY A/B experiment -- REVERT AFTER RESULT.
+	 * Upstream v5.8 allocates a dummy page at fixed 0x60000000
+	 * (a6xx_gmu.c:1432) and HFI dynamically at >= 0x60001000
+	 * (range_start = 0x60000000 + PAGE_SIZE); our HFI sits at
+	 * 0x60000000. Mirror the v5.8 layout exactly for one boot.
+	 * Nothing else changes: same helpers, same flags, same teardown
+	 * (memory_free already handles dummy).
+	 */
+	gmu->dummy = a6xx_gmu_memory_alloc_fixed(gmu, SZ_4K, 0x60000000,
+			IOMMU_READ | IOMMU_WRITE | IOMMU_PRIV);
+	if (IS_ERR(gmu->dummy))
+		goto err;
+	gmu->uncached_iova_base = 0x60300000;
+	A6XX_TRACE("dummy mapped at 0x60000000, dynamic base now 0x60300000 (KGSL layout: HFI 0x60100000, LOG 0x60200000)");
+
+	/*
+	 * Allocate memory for the HFI queues.
+	 *
+	 * IMAGE 276: place the table at the FIXED address the A640 GMU
+	 * firmware expects, instead of letting the dynamic allocator choose.
+	 *
+	 * ANDROID-KGSL-PSP-REFERENCE.md records the working KGSL layout:
+	 *
+	 *   0x60000000  dummy page          (4K)
+	 *   0x60100000  HFI table           (20K = 0x5000)  <- KGSL
+	 *   0x60200000  LOG buffer          (4K)            <- KGSL
+	 *
+	 * This tree had:
+	 *
+	 *   0x60000000  dummy page          (4K)   same
+	 *   0x60001000  HFI table           (0x5000)  <- dynamic, NOT where KGSL puts it
+	 *   0x60006000  LOG buffer          (4K)    <- NOT where KGSL puts it
+	 *
+	 * so 0x60200000 was UNMAPPED in our layout, while the GMU firmware
+	 * has that address compiled in (it is the GMU's own non-cached window,
+	 * 0x60000000-0x80000000, and the firmware's LOG and HFI offsets are
+	 * fixed).  A firmware write to an address the GMU domain does not
+	 * map is an unmapped access at EL2 -- which is exactly the
+	 * TZBSP_ERR_FATAL_NOC_ERROR / EL2 data abort that accounts for
+	 * 167 of the project's 213 archived captures.
+	 *
+	 * The dummy page stays at 0x60000000 (matching both upstream v5.8 and
+	 * KGSL), and the dynamic allocator's base stays 0x60001000 so it
+	 * cannot hand out the now-reserved 0x60100000/0x60200000.
+	 */
+	gmu->hfi = a6xx_gmu_memory_alloc_fixed(gmu, 0x5000, 0x60100000,
+			IOMMU_READ | IOMMU_WRITE | IOMMU_PRIV);
+	if (IS_ERR(gmu->hfi))
+		goto err;
+	a6xx_trace("after hfi alloc (fixed 0x60100000, KGSL layout)");
+
+	/*
+	 * A640 vs A618/A630 GMU bring-up. Ported from upstream v5.8.
+	 *
+	 * A640 gets dedicated i/d cache buffers at the fixed IOVAs its
+	 * firmware block list addresses, and runs HFI v2. Everything else is
+	 * "legacy": a single debug buffer and HFI v1.
+	 */
+	if (adreno_is_a640(adreno_gpu)) {
+		/*
+		 * TEMPORARY image 192 -- PROMOTE ONLY ON RESULT.
+		 *
+		 * Fill the GMU ITCM hole at IOVA 0x00000-0x04000.
+		 *
+		 * Evidence: immediately after fw_start returns GOOD (0xBABEFACE
+		 * is the CA success code -- our own poll waits for it), the GMU
+		 * issues SMMU reads to IOVA 0x280/0x800/0x820 and every one
+		 * fails:
+		 *
+		 *   Unhandled context fault: iova=0x820, cb=1,
+		 *     fsr=0x40000402 [TF R SS]
+		 *   soft iova-to-phys=0x0
+		 *   SOFTWARE TABLE WALK FAILED! ... unmapped address
+		 *
+		 * Our lowest GMU mapping is icache at 0x4000, so all three
+		 * addresses sit in a hole with no mapping at all. 1.5s later
+		 * the GMU watchdog expires and the recovery resume times out,
+		 * which drops the GPU (ENXIO -> llvmpipe).
+		 *
+		 * CAF lists this range too -- kgsl_gmu.c gmu_vma[] has
+		 *   [GMU_ITCM] = { .start = 0x00000, .size = SZ_16K }
+		 * -- but CAF deliberately does NOT map it: alloc_and_map()
+		 * returns 0 early for GMU_ITCM/GMU_DTCM ("No actually memory
+		 * allocated"). So CAF must reach ITCM over the private CM3
+		 * aperture rather than the SMMU, and on this tree it evidently
+		 * does not. That is the gap being closed here.
+		 *
+		 * IOMMU_PRIV matches icache/dcache. Sized 16K to end exactly at
+		 * the icache base, so it cannot overlap any existing mapping.
+		 */
+		a6xx_trace("before itcm_hole alloc_fixed");
+		gmu->itcm_hole = a6xx_gmu_memory_alloc_fixed(gmu,
+			SZ_16K, 0x00000,
+			IOMMU_READ | IOMMU_WRITE | IOMMU_PRIV);
+		if (IS_ERR(gmu->itcm_hole))
+			goto err;
+		memset(gmu->itcm_hole->virt, 0, SZ_16K);
+		a6xx_trace("after itcm_hole alloc_fixed");
+
+		a6xx_trace("before icache alloc_fixed");
+		gmu->icache = a6xx_gmu_memory_alloc_fixed(gmu,
+			SZ_256K - SZ_16K, 0x04000,
+			IOMMU_READ | IOMMU_WRITE | IOMMU_PRIV);
+		if (IS_ERR(gmu->icache))
+			goto err;
+		a6xx_trace("after icache alloc_fixed");
+
+		a6xx_trace("before dcache alloc_fixed");
+		gmu->dcache = a6xx_gmu_memory_alloc_fixed(gmu,
+			SZ_256K - SZ_16K, 0x44000,
+			IOMMU_READ | IOMMU_WRITE | IOMMU_PRIV);
+		if (IS_ERR(gmu->dcache))
+			goto err;
+		a6xx_trace("after dcache alloc_fixed");
+	} else {
+		/* HFI v1, has sptprac */
+		gmu->legacy = true;
+
+		/* Allocate memory for the GMU debug region */
+		gmu->debug = a6xx_gmu_memory_alloc(gmu, SZ_16K);
+		if (IS_ERR(gmu->debug))
+			goto err;
+		a6xx_trace("after debug alloc");
+	}
+
+	/*
+	 * TEMPORARY experiment image 102 -- REMOVE OR PROMOTE ON RESULT.
+	 * 4 KiB GMU log at fixed 0x60006000 (right after the 0x5000 HFI),
+	 * normal READ|WRITE (upstream v5.8: plain WC dynamic buffer, NOT
+	 * priv). Zero-filled: uninitialized log memory must not confuse the
+	 * firmware's log-size/address decode.
+	 *
+	 * IMAGE 276: move it to KGSL's address.  The GMU's non-cached window
+	 * is 0x60000000-0x80000000 and the firmware has the LOG at a FIXED
+	 * offset in it (0x60200000 per ANDROID-KGSL-PSP-REFERENCE.md).  With
+	 * the HFI table now at 0x60100000 and the log at 0x60006000, the
+	 * firmware's own LOG address (0x60200000) was not mapped at all --
+	 * a firmware write there is an unmapped access at EL2.
+	 */
+	gmu->log = a6xx_gmu_memory_alloc_fixed(gmu, SZ_4K, 0x60200000,
+			IOMMU_READ | IOMMU_WRITE);
+	if (IS_ERR(gmu->log))
+		goto err;
+	memset(gmu->log->virt, 0, SZ_4K);
+	A6XX_TRACE("LOG mapped 0x60006000/0x1000 zeroed");
+
+	/*
+	 * TEMPORARY A/B experiment -- REVERT AFTER RESULT.
+	 * Probe-time layout verification: dummy must be 0x60000000/0x1000,
+	 * HFI >= 0x60001000, icache 0x4000, dcache 0x44000.
+	 */
+	A6XX_TRACE("LAYOUT dummy=0x%llx/0x%zx hfi=0x%llx/0x%zx",
+		(unsigned long long)gmu->dummy->iova, gmu->dummy->size,
+		(unsigned long long)gmu->hfi->iova, gmu->hfi->size);
+	if (adreno_is_a640(adreno_gpu))
+		A6XX_TRACE("LAYOUT icache=0x%llx/0x%zx dcache=0x%llx/0x%zx",
+			(unsigned long long)gmu->icache->iova, gmu->icache->size,
+			(unsigned long long)gmu->dcache->iova, gmu->dcache->size);
+	else
+		A6XX_TRACE("LAYOUT debug=0x%llx/0x%zx",
+			(unsigned long long)gmu->debug->iova, gmu->debug->size);
+
+	/*
+	 * TEMPORARY sentinel diagnostic -- REMOVE AFTER RESULT. One 4 KiB
+	 * scratch page at 0xDEADB000, READ|WRITE (deliberately NOT priv: if
+	 * the accessor is privileged this will permission-fault instead,
+	 * which is itself an answer). Filled with 0xA5A5A5A5 before start.
+	 * Verifies unmapped-ness by construction: the 0xDEADBEE0 fault proves
+	 * nothing is mapped there today.
+	 */
+	gmu->sentinel = a6xx_gmu_memory_alloc_fixed(gmu, SZ_4K, 0xDEADB000,
+			IOMMU_READ | IOMMU_WRITE);
+	if (IS_ERR(gmu->sentinel))
+		goto err;
+	memset(gmu->sentinel->virt, 0xA5, SZ_4K);
+	A6XX_TRACE("SENTINEL mapped 0xDEADB000/0x1000 filled A5");
+	A6XX_TRACE("LAYOUT sentinel=0x%llx/0x%zx",
+		(unsigned long long)gmu->sentinel->iova, gmu->sentinel->size);
+	A6XX_TRACE("LAYOUT log=0x%llx/0x%zx",
+		(unsigned long long)gmu->log->iova, gmu->log->size);
+	a6xx_gmu_scratch_check(gmu, "probe-memsetup");
+
+	/* Map the GMU registers (vendor reg-name, upstream as fallback) */
+	a6xx_trace("before mmio map");
+	gmu->mmio = a6xx_gmu_get_mmio_any(pdev, "kgsl_gmu_reg", "gmu");
+	a6xx_trace("after mmio map");
+
+	/* Map the GPU power domain controller registers */
+	gmu->pdc_mmio = a6xx_gmu_get_mmio_any(pdev,
+		"kgsl_gmu_pdc_cfg", "gmu_pdc");
+	a6xx_trace("after pdc_mmio map");
+
+	/*
+	 * Map the PDC sequence registers. These are a separate DT resource on
+	 * this platform and upstream v5.8 fetches them separately; the RPMh
+	 * sequence programming writes target this region.
+	 */
+	gmu->seq_mmio = a6xx_gmu_get_mmio_any(pdev,
+		"kgsl_gmu_pdc_seq", "gmu_pdc_seq");
+	a6xx_trace("after seq_mmio map");
+
+	if (IS_ERR(gmu->mmio) || IS_ERR(gmu->pdc_mmio) ||
+	    IS_ERR(gmu->seq_mmio))
+		goto err;
+
+	a6xx_gmu_dump_mmio(pdev, gmu, "MMIO_MAP");
+
+	/* Get the HFI and GMU interrupts */
+	a6xx_trace("before irq requests");
+	gmu->hfi_irq = a6xx_gmu_get_irq_any(gmu, pdev,
+		"kgsl_hfi_irq", "hfi", a6xx_hfi_irq);
+	a6xx_trace("after hfi irq");
+	gmu->gmu_irq = a6xx_gmu_get_irq_any(gmu, pdev,
+		"kgsl_gmu_irq", "gmu", a6xx_gmu_irq);
+	a6xx_trace("after gmu irq");
+
+	if (gmu->hfi_irq < 0 || gmu->gmu_irq < 0)
+		goto err;
+
+	/* Set up a tasklet to handle GMU HFI responses */
+	tasklet_init(&gmu->hfi_tasklet, a6xx_hfi_task, (unsigned long) gmu);
+
+	/* Get the power levels for the GMU and GPU */
+	a6xx_trace("before pwrlevels");
+	a6xx_gmu_pwrlevels_probe(gmu);
+	a6xx_trace("after pwrlevels");
+
+	/* Set up the HFI queues */
+	a6xx_trace("before hfi_init");
+	a6xx_hfi_init(gmu);
+	a6xx_trace("after hfi_init -- PROBE COMPLETE");
+	prov138(gmu, "probe-end");
+	pr_info("BOOT_RACE_READY ms=%u uptime=%us n=%d\n",
+		jiffies_to_msecs(jiffies),
+		(unsigned)(jiffies / HZ), att138_n);
+	a6xx_snapshot_gmu = gmu;
+
+	return 0;
+err:
+	a6xx_gmu_memory_free(gmu, gmu->hfi);
+
+	if (gmu->domain) {
+		iommu_detach_device(gmu->domain, gmu->cb_dev);
+
+		iommu_domain_free(gmu->domain);
+	}
+
+	return -ENODEV;
+}
