+/*
+ * Diagnostic deferral of the GMU bring-up.
+ *
+ * The GMU probe programs the GPU power domain controller. On this platform
+ * that wedged the device during boot with no panic record (ramoops is wired
+ * up and stays empty), so there was no way to see how far init got: the
+ * kernel has no console= at all and pstore only captures panics.
+ *
+ * With a non-zero delay the probe body is queued and the machine boots
+ * normally, which lets the log be watched live right up to the hang. The
+ * default of 0 keeps the original immediate behaviour.
+ */
+/*
+ * a6xx_gmu.o is a composite object inside the built-in msm_drm, so
+ * KBUILD_MODNAME would otherwise make the command-line name
+ * "a6xx_gmu.gpu_init_delay_ms". Pin the prefix explicitly so the documented
+ * name is the one that actually parses.
+ */
+#undef MODULE_PARAM_PREFIX
+#define MODULE_PARAM_PREFIX "a6xx."
+
+/*
+ * Not static: msm_drv.c's load_gpu() deferral reads the same value so one
+ * command-line parameter covers both the GMU probe and the GPU core attach.
+ */
+unsigned int gpu_init_delay_ms;
+module_param(gpu_init_delay_ms, uint, 0444);
+MODULE_PARM_DESC(gpu_init_delay_ms,
+	"Hold the A6xx GPU core attach for on-demand sysfs trigger (diagnostics)");
+
+module_param(gmu_hfi_probe, bool, 0444);
+MODULE_PARM_DESC(gmu_hfi_probe,
+	"Send one HFI GX_BW_PERF_VOTE after HFI START (diagnostics, default off)");
+
+module_param(secure_probe, int, 0444);
+MODULE_PARM_DESC(secure_probe,
+	"0=direct SECVID write (default), 1=skip it, 2=ZAP probe if available");
+
+module_param(secvid, int, 0644);
+MODULE_PARM_DESC(secvid,
+	"1=force the SECVID_TRUST_CNTL write even when experimental_nonlegacy would skip it (default 0, image 273)");
+
+/* IMAGE 274c */
+module_param(gmem_window, int, 0444);
+MODULE_PARM_DESC(gmem_window,
+	"UCHE GMEM window size in KB using CAF's formula (base=ALIGN(size,1M)); -1=keep the current degenerate window (image 282)");
+
+module_param(reg_match, int, 0444);
+MODULE_PARM_DESC(reg_match,
+	"1=program the init-time registers with the WORKING device's values (CP_RB_CNTL NO_UPDATE, INT_0_MASK, HANG_INT_CNTL) (image 286)");
+
+module_param(cp_protect_caf, int, 0444);
+MODULE_PARM_DESC(cp_protect_caf,
+	"1=program CAF's CP_PROTECT table verbatim plus the DT qcom,protect slots (image 285)");
