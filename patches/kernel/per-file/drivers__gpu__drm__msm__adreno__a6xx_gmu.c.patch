+bool slumber165 = false;
+module_param(slumber165, bool, 0444);
+MODULE_PARM_DESC(slumber165,
+	"1=post-hw_init slumber via suspend path (default off since 182)");
+/*
+ * Image 182 -- PROMOTE (quiet bring-up). Every post-success diagnostic
+ * thread (dw161 SHOTs, sw165 spinwatch with its cross-CPU IPI ping and
+ * 15s hot spin) is off unless explicitly armed. The bring-up flood
+ * (HFI/BС132/SELFTEST) already proved it can wedge console_unlock;
+ * post-success prints buy forensics at the price of the machine's
+ * responsiveness. Mesa needs the CPUs more than the logs do.
