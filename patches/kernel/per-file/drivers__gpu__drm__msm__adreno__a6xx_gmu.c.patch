+static irqreturn_t a6xx_gmu_irq(int irq, void *data)
+{
+	struct a6xx_gmu *gmu = data;
+	u32 status;
+
+	bw124_gmu_irqs++;
+
+	status = gmu_read(gmu, REG_A6XX_GMU_AO_HOST_INTERRUPT_STATUS);
+	gmu_write(gmu, REG_A6XX_GMU_AO_HOST_INTERRUPT_CLR, status);
+
+	if (status & A6XX_GMU_AO_HOST_INTERRUPT_STATUS_WDOG_BITE) {
+		dev_err_ratelimited(gmu->dev, "GMU watchdog expired\n");
+		/* TEMPORARY image 139 WDT forensics -- state before BUG. */
+		pr_info("WDT139: AO_STATUS=0x%x NMI=0x%x INITRES=0x%x FWBUSY=0x%x SPTPRAC=0x%x RPMHPWR=0x%x OOB_H2G=0x%x\n",
+			status,
+			gmu_read(gmu, REG_A6XX_GMU_NMI_CONTROL_STATUS),
+			gmu_read(gmu, REG_A6XX_GMU_CM3_FW_INIT_RESULT),
+			gmu_read(gmu, REG_A6XX_GMU_CM3_FW_BUSY),
+			gmu_read(gmu, REG_A6XX_GMU_SPTPRAC_PWR_CLK_STATUS),
+			gmu_read(gmu, REG_A6XX_GPU_GMU_CX_GMU_RPMH_POWER_STATE),
+			gmu_read(gmu, REG_A6XX_GMU_HOST2GMU_INTR_RAW_INFO));
+
+		/*
+		 * TEMPORARY image 166 -- PROMOTE: never BUG in an IRQ
+		 * handler on a firmware event (that panic was
+		 * self-inflicted). Recover from process context instead.
+		 */
+		pr_info("RECOVER166: GMU WDT bite, scheduling recovery\n");
+		recover166_ag = container_of(gmu, struct a6xx_gpu, gmu);
+		schedule_work(&recover166_work);
+	}
+
+	if (status &  A6XX_GMU_AO_HOST_INTERRUPT_STATUS_HOST_AHB_BUS_ERROR)
+		dev_err_ratelimited(gmu->dev, "GMU AHB bus error\n");
+
+	if (status & A6XX_GMU_AO_HOST_INTERRUPT_STATUS_FENCE_ERR)
+		dev_err_ratelimited(gmu->dev, "GMU fence error: 0x%x\n",
+			gmu_read(gmu, REG_A6XX_GMU_AHB_FENCE_STATUS));
+
+	return IRQ_HANDLED;
+}
