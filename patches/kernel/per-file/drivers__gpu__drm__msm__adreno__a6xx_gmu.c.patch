+/*
+ * TEMPORARY experiment image 118 -- REMOVE AFTER RESULT. Forensic capture
+ * of GMU firmware self-init (GOOD=BABEFACE vs BAD=BADDFACE). Read-only:
+ * no init write, no reset, no HFI, no retry semantics are changed.
+ */
+#define F118_ITCM_A_OFF 0x0000
+#define F118_ITCM_A_N 256
+#define F118_ITCM_B_OFF 0x1e00
+#define F118_ITCM_B_N 72
+#define F118_ITCM_C_OFF 0x0200
+#define F118_ITCM_C_N 96
+#define F118_DTCM_A_OFF 0x40000
+#define F118_DTCM_A_N 128
+#define F118_DTCM_B_OFF 0x40e00
+#define F118_DTCM_B_N 128
+#define F118_DTCM_C_OFF 0x0ff0
+#define F118_DTCM_C_N 8
+static u32 f118_pre_itcm_a[F118_ITCM_A_N];
+static u32 f118_pre_itcm_b[F118_ITCM_B_N];
+static u32 f118_pre_itcm_c[F118_ITCM_C_N];
+static u32 f118_pre_dtcm_a[F118_DTCM_A_N];
+static u32 f118_pre_dtcm_b[F118_DTCM_B_N];
+static u32 f118_pre_dtcm_c[F118_DTCM_C_N];
+static bool f118_pre_valid;
+
+static u32 f118_rd_itcm(struct a6xx_gmu *gmu, u32 byte_off)
+{
+	return gmu_read(gmu, REG_A6XX_GMU_CM3_ITCM_START + (byte_off >> 2));
+}
+
+static u32 f118_rd_dtcm(struct a6xx_gmu *gmu, u32 byte_off)
+{
+	u32 ap = (byte_off >= 0x40000) ? (byte_off - 0x40000) : byte_off;
+	return gmu_read(gmu, REG_A6XX_GMU_CM3_DTCM_START + (ap >> 2));
+}
+
+static void f118_store_pre(struct a6xx_gmu *gmu)
+{
+	u32 i;
+	for (i = 0; i < F118_ITCM_A_N; i++)
+		f118_pre_itcm_a[i] = f118_rd_itcm(gmu, F118_ITCM_A_OFF + (i << 2));
+	for (i = 0; i < F118_ITCM_B_N; i++)
+		f118_pre_itcm_b[i] = f118_rd_itcm(gmu, F118_ITCM_B_OFF + (i << 2));
+	for (i = 0; i < F118_ITCM_C_N; i++)
+		f118_pre_itcm_c[i] = f118_rd_itcm(gmu, F118_ITCM_C_OFF + (i << 2));
+	for (i = 0; i < F118_DTCM_A_N; i++)
+		f118_pre_dtcm_a[i] = f118_rd_dtcm(gmu, F118_DTCM_A_OFF + (i << 2));
+	for (i = 0; i < F118_DTCM_B_N; i++)
+		f118_pre_dtcm_b[i] = f118_rd_dtcm(gmu, F118_DTCM_B_OFF + (i << 2));
+	for (i = 0; i < F118_DTCM_C_N; i++)
+		f118_pre_dtcm_c[i] = f118_rd_dtcm(gmu, F118_DTCM_C_OFF + (i << 2));
+	f118_pre_valid = true;
+}
+
+static void f118_snap_regs(struct a6xx_gmu *gmu, const char *tag)
+{
+	pr_info("FORENSIC REGS %s SYSRESET=0x%x INITRES=0x%x BOOTCFG=0x%x CM3CFG=0x%x WFI=0x%x FWBUSY=0x%x NMI=0x%x\n",
+		tag,
+		gmu_read(gmu, REG_A6XX_GMU_CM3_SYSRESET),
+		gmu_read(gmu, REG_A6XX_GMU_CM3_FW_INIT_RESULT),
+		gmu_read(gmu, REG_A6XX_GMU_CM3_BOOT_CONFIG),
+		gmu_read(gmu, REG_A6XX_GMU_CM3_CFG),
+		gmu_read(gmu, REG_A6XX_GMU_CX_GMU_WFI_CONFIG),
+		gmu_read(gmu, REG_A6XX_GMU_CM3_FW_BUSY),
+		gmu_read(gmu, REG_A6XX_GMU_NMI_CONTROL_STATUS));
+	pr_info("FORENSIC REGS %s QTBL=0x%x QTBLINFO=0x%x SFR=0x%x CPMSG=0x%x G7=0x%x FENCE0=0x%x FENCE1=0x%x\n",
+		tag,
+		gmu_read(gmu, REG_A6XX_GMU_HFI_QTBL_ADDR),
+		gmu_read(gmu, REG_A6XX_GMU_HFI_QTBL_INFO),
+		gmu_read(gmu, REG_A6XX_GMU_HFI_SFR_ADDR),
+		gmu_read(gmu, REG_A6XX_GPU_GMU_CX_GMU_PWR_COL_CP_MSG),
+		gmu_read(gmu, REG_A6XX_GMU_GENERAL_7),
+		gmu_read(gmu, REG_A6XX_GMU_AHB_FENCE_RANGE_0),
+		gmu_read(gmu, REG_A6XX_GMU_AHB_FENCE_RANGE_1));
+	pr_info("FORENSIC REGS %s HFISTAT=0x%x G2HINFO=0x%x G2HMASK=0x%x H2GRAW=0x%x H2GINFO0=0x%x RPMHPWR=0x%x KEEPALIVE=0x%x\n",
+		tag,
+		gmu_read(gmu, REG_A6XX_GMU_HFI_CTRL_STATUS),
+		gmu_read(gmu, REG_A6XX_GMU_GMU2HOST_INTR_INFO),
+		gmu_read(gmu, REG_A6XX_GMU_GMU2HOST_INTR_MASK),
+		gmu_read(gmu, REG_A6XX_GMU_HOST2GMU_INTR_RAW_INFO),
+		gmu_read(gmu, REG_A6XX_GMU_HOST2GMU_INTR_INFO_0),
+		gmu_read(gmu, REG_A6XX_GPU_GMU_CX_GMU_RPMH_POWER_STATE),
+		gmu_read(gmu, REG_A6XX_GMU_GMU_PWR_COL_KEEPALIVE));
+	pr_info("FORENSIC NOTE %s G2HRAW=N/A-no-such-reg-in-this-gmu\n", tag);
+}
+
+static void f118_dump_log(struct a6xx_gmu *gmu)
+{
+	u32 *v;
+	int i;
+	if (!gmu->log || !gmu->log->virt) {
+		pr_info("FORENSIC LOG no-log-buffer\n");
+		return;
+	}
+	v = (u32 *)gmu->log->virt;
+	pr_info("FORENSIC LOGHDR w0=0x%08x w1=0x%08x w2=0x%08x w3=0x%08x w4=0x%08x w5=0x%08x w6=0x%08x w7=0x%08x (write-ptr-unknown-no-reg)\n",
+		v[0], v[1], v[2], v[3], v[4], v[5], v[6], v[7]);
+	for (i = 0; i < 0x1000; i += 16)
+		pr_info("FORENSIC LOG+%03x %08x %08x %08x %08x\n",
+			i, v[i>>2], v[(i>>2)+1], v[(i>>2)+2], v[(i>>2)+3]);
+	pr_info("FORENSIC LOG done\n");
+}
+
+static void f118_dump_focused(struct a6xx_gmu *gmu, const char *tag)
+{
+	int i;
+	u32 a, b, c, d;
+	for (i = 0; i < 0x400; i += 16) {
+		a = f118_rd_itcm(gmu, 0x0000 + i);
+		b = f118_rd_itcm(gmu, 0x0000 + i + 4);
+		c = f118_rd_itcm(gmu, 0x0000 + i + 8);
+		d = f118_rd_itcm(gmu, 0x0000 + i + 12);
+		pr_info("FORENSIC MEM %s ITCM+%04x %08x %08x %08x %08x\n", tag, i, a, b, c, d);
+	}
+	for (i = 0; i < 0x120; i += 16) {
+		a = f118_rd_itcm(gmu, 0x1e00 + i);
+		b = f118_rd_itcm(gmu, 0x1e00 + i + 4);
+		c = f118_rd_itcm(gmu, 0x1e00 + i + 8);
+		d = f118_rd_itcm(gmu, 0x1e00 + i + 12);
+		pr_info("FORENSIC MEM %s ITCM+%04x %08x %08x %08x %08x\n", tag, 0x1e00 + i, a, b, c, d);
+	}
+	for (i = 0; i < 0x180; i += 16) {
+		a = f118_rd_itcm(gmu, 0x0200 + i);
+		b = f118_rd_itcm(gmu, 0x0200 + i + 4);
+		c = f118_rd_itcm(gmu, 0x0200 + i + 8);
+		d = f118_rd_itcm(gmu, 0x0200 + i + 12);
+		pr_info("FORENSIC MEM %s ITCM+%04x %08x %08x %08x %08x\n", tag, 0x0200 + i, a, b, c, d);
+	}
+	for (i = 0; i < 0x200; i += 16) {
+		a = f118_rd_dtcm(gmu, 0x40000 + i);
+		b = f118_rd_dtcm(gmu, 0x40000 + i + 4);
+		c = f118_rd_dtcm(gmu, 0x40000 + i + 8);
+		d = f118_rd_dtcm(gmu, 0x40000 + i + 12);
+		pr_info("FORENSIC MEM %s DTCM+%05x %08x %08x %08x %08x\n", tag, 0x40000 + i, a, b, c, d);
+	}
+	for (i = 0; i < 0x200; i += 16) {
+		a = f118_rd_dtcm(gmu, 0x40e00 + i);
+		b = f118_rd_dtcm(gmu, 0x40e00 + i + 4);
+		c = f118_rd_dtcm(gmu, 0x40e00 + i + 8);
+		d = f118_rd_dtcm(gmu, 0x40e00 + i + 12);
+		pr_info("FORENSIC MEM %s DTCM+%05x %08x %08x %08x %08x\n", tag, 0x40e00 + i, a, b, c, d);
+	}
+	a = f118_rd_dtcm(gmu, 0x0ff0);
+	b = f118_rd_dtcm(gmu, 0x0ff4);
+	c = f118_rd_dtcm(gmu, 0x0ff8);
+	d = f118_rd_dtcm(gmu, 0x0ffc);
+	pr_info("FORENSIC MEM %s DTCM+00ff0 %08x %08x %08x %08x\n", tag, a, b, c, d);
+	a = f118_rd_dtcm(gmu, 0x1000);
+	b = f118_rd_dtcm(gmu, 0x1004);
+	c = f118_rd_dtcm(gmu, 0x1008);
+	d = f118_rd_dtcm(gmu, 0x100c);
+	pr_info("FORENSIC MEM %s DTCM+01000 %08x %08x %08x %08x\n", tag, a, b, c, d);
+	pr_info("FORENSIC MEM %s done\n", tag);
+}
+
+static void f118_diff(struct a6xx_gmu *gmu)
+{
+	u32 i, cur;
+	if (!f118_pre_valid) {
+		pr_info("FORENSIC DIFF no-pre-snapshot\n");
+		return;
+	}
+	for (i = 0; i < F118_ITCM_A_N; i++) {
+		cur = f118_rd_itcm(gmu, F118_ITCM_A_OFF + (i << 2));
+		if (cur != f118_pre_itcm_a[i])
+			pr_info("FORENSIC DIFF ITCM+%04x before=%08x after=%08x\n",
+				(unsigned)(F118_ITCM_A_OFF + (i << 2)), f118_pre_itcm_a[i], cur);
+	}
+	for (i = 0; i < F118_ITCM_B_N; i++) {
+		cur = f118_rd_itcm(gmu, F118_ITCM_B_OFF + (i << 2));
+		if (cur != f118_pre_itcm_b[i])
+			pr_info("FORENSIC DIFF ITCM+%04x before=%08x after=%08x\n",
+				(unsigned)(F118_ITCM_B_OFF + (i << 2)), f118_pre_itcm_b[i], cur);
+	}
+	for (i = 0; i < F118_ITCM_C_N; i++) {
+		cur = f118_rd_itcm(gmu, F118_ITCM_C_OFF + (i << 2));
+		if (cur != f118_pre_itcm_c[i])
+			pr_info("FORENSIC DIFF ITCM+%04x before=%08x after=%08x\n",
+				(unsigned)(F118_ITCM_C_OFF + (i << 2)), f118_pre_itcm_c[i], cur);
+	}
+	for (i = 0; i < F118_DTCM_A_N; i++) {
+		cur = f118_rd_dtcm(gmu, F118_DTCM_A_OFF + (i << 2));
+		if (cur != f118_pre_dtcm_a[i])
+			pr_info("FORENSIC DIFF DTCM+%05x before=%08x after=%08x\n",
+				(unsigned)(F118_DTCM_A_OFF + (i << 2)), f118_pre_dtcm_a[i], cur);
+	}
+	for (i = 0; i < F118_DTCM_B_N; i++) {
+		cur = f118_rd_dtcm(gmu, F118_DTCM_B_OFF + (i << 2));
+		if (cur != f118_pre_dtcm_b[i])
+			pr_info("FORENSIC DIFF DTCM+%05x before=%08x after=%08x\n",
+				(unsigned)(F118_DTCM_B_OFF + (i << 2)), f118_pre_dtcm_b[i], cur);
+	}
+	for (i = 0; i < F118_DTCM_C_N; i++) {
+		cur = f118_rd_dtcm(gmu, F118_DTCM_C_OFF + (i << 2));
+		if (cur != f118_pre_dtcm_c[i])
+			pr_info("FORENSIC DIFF DTCM+%04x before=%08x after=%08x\n",
+				(unsigned)(F118_DTCM_C_OFF + (i << 2)), f118_pre_dtcm_c[i], cur);
+	}
+	pr_info("FORENSIC DIFF done\n");
+}
+
+static void f118_hit_word(const char *where, u32 off, u32 w)
+{
+	if (w == 0xdeadbeef || w == 0xbabeface || w == 0xbaddface ||
+	    (w >= 0x60000000 && w < 0x60010000))
+		pr_info("FORENSIC HIT %s+0x%x =0x%08x\n", where, off, w);
+}
+
+static void f118_scan(struct a6xx_gmu *gmu)
+{
+	u32 i, w;
+	u32 *v;
+	for (i = 0; i < F118_ITCM_A_N; i++) {
+		w = f118_rd_itcm(gmu, F118_ITCM_A_OFF + (i << 2));
+		f118_hit_word("ITCM", F118_ITCM_A_OFF + (i << 2), w);
+	}
+	for (i = 0; i < F118_ITCM_B_N; i++) {
+		w = f118_rd_itcm(gmu, F118_ITCM_B_OFF + (i << 2));
+		f118_hit_word("ITCM", F118_ITCM_B_OFF + (i << 2), w);
+	}
+	for (i = 0; i < F118_ITCM_C_N; i++) {
+		w = f118_rd_itcm(gmu, F118_ITCM_C_OFF + (i << 2));
+		f118_hit_word("ITCM", F118_ITCM_C_OFF + (i << 2), w);
+	}
+	for (i = 0; i < F118_DTCM_A_N; i++) {
+		w = f118_rd_dtcm(gmu, F118_DTCM_A_OFF + (i << 2));
+		f118_hit_word("DTCM", F118_DTCM_A_OFF + (i << 2), w);
+	}
+	for (i = 0; i < F118_DTCM_B_N; i++) {
+		w = f118_rd_dtcm(gmu, F118_DTCM_B_OFF + (i << 2));
+		f118_hit_word("DTCM", F118_DTCM_B_OFF + (i << 2), w);
+	}
+	for (i = 0; i < F118_DTCM_C_N; i++) {
+		w = f118_rd_dtcm(gmu, F118_DTCM_C_OFF + (i << 2));
+		f118_hit_word("DTCM", F118_DTCM_C_OFF + (i << 2), w);
+	}
+	if (gmu->log && gmu->log->virt) {
+		v = (u32 *)gmu->log->virt;
+		for (i = 0; i < (0x1000 >> 2); i++)
+			f118_hit_word("LOG", i << 2, v[i]);
+	}
+	pr_info("FORENSIC SCAN done\n");
+}
+
+static void f118_verdict(struct a6xx_gmu *gmu, const char *tag)
+{
+	f118_snap_regs(gmu, tag);
+	f118_dump_log(gmu);
+	f118_dump_focused(gmu, tag);
+	f118_diff(gmu);
+	f118_scan(gmu);
+}
