+static int a6xx_gmu_start(struct a6xx_gmu *gmu)
+{
+	int ret;
+	u32 val;
+
+	a6xx_start_jiffies = jiffies;
+
+	/*
+	 * TEMPORARY experiment -- REMOVE OR PROMOTE ON RESULT. Vendor KGSL
+	 * writes WFI_CONFIG=0 immediately before SYSRESET release; our path
+	 * never did.
+	 */
+	A6XX_TRACE("before WFI_CONFIG write (off=0x%x value=0x0)", REG_A6XX_GMU_CX_GMU_WFI_CONFIG);
+	gmu_write(gmu, REG_A6XX_GMU_CX_GMU_WFI_CONFIG, 0x0);
+	A6XX_TRACE("after WFI_CONFIG write, readback=0x%x",
+		gmu_read(gmu, REG_A6XX_GMU_CX_GMU_WFI_CONFIG));
+	/*
+	 * TEMPORARY experiment image 97 -- REMOVE OR PROMOTE ON RESULT.
+	 * Vendor KGSL releases SYSRESET with a bare deassert (no 1->0 pulse).
+	 * Previous images asserted first; this single change drops the assert.
+	 * msm_writel() is ordered (writel), so no extra barrier is added.
+	 */
+	/* TEMPORARY image 118 forensic pre-snapshot (read-only). Focused
+	 * ITCM/DTCM stored + full register snapshot before SYSRESET release.
+	 * No init write changed. Full PRE megabyte dump dropped to protect
+	 * the kmsg ring for forensic output (dump function itself untouched).
+	 */
+	f118_snap_regs(gmu, "PRE");
+	/*
+	 * Image 183 -- PROMOTE (survivability). f118_store_pre() reads
+	 * 256+72+96 ITCM words and 264 DTCM words through the MMIO
+	 * aperture. That aperture is only safe on a cold power-on: after
+	 * a6xx_gmu_reset() cycles the clocks (retry path), the very same
+	 * read externally aborts (Synchronous External Abort at
+	 * GMU+0x3000 = ITCM_START, fw_start via gmu_start) and TZ takes
+	 * the machine down with TZBSP_ERR_FATAL_NOC_ERROR -- image 182's
+	 * first trigger died exactly here, 5s after a -110 retry, with
+	 * every control-reg read on the same path succeeding. Control
+	 * regs live on the always-on AHB; the TCM RAMs evidently sit
+	 * behind a switch the reset path does not restore. The PRE store
+	 * is pure forensics (pre/post diff input for a verdict era that
+	 * is over), so it runs only under a6xx_instr now. Post-boot
+	 * aperture reads (f118_verdict on GOOD/BAD, firmware alive) are
+	 * unaffected and stay.
+	 *
+	 * OPEN: why the TCM aperture dies across a clock disable/re-enable
+	 * cycle. Until root-caused, the retry path must not touch it.
+	 */
+	if (a6xx_instr) {
+		f118_store_pre(gmu);
+		pr_info("FORENSIC PRE stored focused regions\n");
+	}
+
+	gmu_write(gmu, REG_A6XX_GMU_CM3_SYSRESET, 0);
+
+	a6xx_gmu_capture_boot_state(gmu, "C-poll-enter");
+
+	/* TEMPORARY image 118 forensic poll -- REMOVE AFTER RESULT. Same
+	 * 100us x 10000 timing and same BABEFACE/BADDFACE breaks. Adds:
+	 * transition log, milestone samples (5/10/15/20/25/30/35/37/40/50ms),
+	 * and identical full forensic snapshot at either verdict.
+	 */
+	ret = -ETIMEDOUT;
+	{
+		int i;
+		u32 last = 0;
+		for (i = 0; i < 10000; i++) {
+			val = gmu_read(gmu, REG_A6XX_GMU_CM3_FW_INIT_RESULT);
+			if (val != last) {
+				pr_info("FORENSIC POLL ms~%u INITRES=0x%08x (change)\n",
+					(unsigned)(i / 10), val);
+				last = val;
+			} else if (i == 50 || i == 100 || i == 150 || i == 200 ||
+				   i == 250 || i == 300 || i == 350 || i == 370 ||
+				   i == 400 || i == 500) {
+				pr_info("FORENSIC POLL ms~%u INITRES=0x%08x (sample)\n",
+					(unsigned)(i / 10), val);
+			}
+			if (val == 0xbabeface) {
+				pr_info("FORENSIC VERDICT GOOD BABEFACE ms~%u\n",
+					(unsigned)(i / 10));
+				a6xx_gmu_capture_boot_state(gmu, "E-babeface");
+				f118_verdict(gmu, "GOOD");
+				ret = 0;
+				break;
+			}
+			if (val == 0xbaddface) {
+				pr_info("A6XX_SNAPSHOT: BADDFACE first seen @%ums\n",
+					jiffies_to_msecs(jiffies - a6xx_start_jiffies));
+				pr_info("FORENSIC VERDICT BAD BADDFACE ms~%u\n",
+					(unsigned)(i / 10));
+				a6xx_gmu_capture_boot_state(gmu, "E-baddface");
+				f118_verdict(gmu, "BAD");
+				ret = -EIO;
+				break;
+			}
+			udelay(100);
+		}
+	}
+
+if (ret == -ETIMEDOUT) {
+		dev_err(gmu->dev, "GMU firmware initialization timed out\n");
+		a6xx_gmu_capture_boot_state(gmu, "D-timeout");
+		a6xx_gmu_scratch_check(gmu, "at-timeout");
+	}
+
+	return ret;
+}
+
+static int a6xx_gmu_hfi_start(struct a6xx_gmu *gmu)
+{
+	u32 val;
+	int ret;
+
+	A6XX_TRACE("hfi_start entered");
+	gmu_rmw(gmu, REG_A6XX_GMU_GMU2HOST_INTR_MASK,
+		A6XX_GMU_GMU2HOST_INTR_INFO_MSGQ, 0);
+
+	gmu_write(gmu, REG_A6XX_GMU_HFI_CTRL_INIT, 1);
+
+	pr_info("POST_START: hfi poll enter (expect STATUS&1)\n");
+	ret = gmu_poll_timeout(gmu, REG_A6XX_GMU_HFI_CTRL_STATUS, val,
+		val & 1, 100, 10000);
+	pr_info("POST_START: hfi poll %s (STATUS=0x%x)\n",
+		ret ? "TIMEOUT" : "ok",
+		gmu_read(gmu, REG_A6XX_GMU_HFI_CTRL_STATUS));
+	if (ret)
+		dev_err(gmu->dev, "Unable to start the HFI queues\n");
+
+	return ret;
+}
