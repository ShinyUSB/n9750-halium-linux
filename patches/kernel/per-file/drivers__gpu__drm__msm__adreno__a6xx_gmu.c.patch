+static int a6xx_gmu_hfi_vote_probe(struct a6xx_gmu *gmu)
+{
+	int idx, ret;
+
+	if (gmu->nr_gpu_freqs <= 0) {
+		pr_info("GX132-PROBE-SKIP: nr_gpu_freqs=%d, no index to vote\n",
+			gmu->nr_gpu_freqs);
+		return 0;
+	}
+	idx = gmu->nr_gpu_freqs - 1;
+
+	gx132_snap(gmu, "PRE");
+	pr_info("GX132-VOTE: send ack_type=1 freq=%d(idx) bw=0\n", idx);
+	ret = a6xx_hfi_send_gx_vote(gmu, 1, (u32)idx, 0);
+	pr_info("GX132-VOTE: hfi_ret=%d\n", ret);
+	gx132_snap(gmu, "POST");
+	udelay(100);
+	gx132_snap(gmu, "PLUS100US");
+	usleep_range(1000, 1100);
+	gx132_snap(gmu, "PLUS1MS");
+	usleep_range(10000, 10200);
+	gx132_snap(gmu, "PLUS10MS");
+	if (!ret) {
+		gx_vote_done = true;
+		if (keepalive156) {
+			keepalive156_gmu = gmu;
+			schedule_delayed_work(&keepalive156_work,
+				msecs_to_jiffies(keepalive156_interval_ms));
+			pr_info("KEEPALIVE156: armed (10s period)\n");
+		}
+	}
+	return ret;
+}
+int a6xx_gmu_resume(struct a6xx_gpu *a6xx_gpu)
+{
+	struct a6xx_gmu *gmu = &a6xx_gpu->gmu;
+	int status, ret;
+
+	if (WARN(!gmu->mmio, "The GMU is not set up yet\n"))
+		return 0;
+
+	/*
+	 * IMAGE 230: ACD notification to AOP, FIRST -- matching KGSL's
+	 * gmu_start() ordering exactly (kgsl_gmu.c:1644), which does this
+	 * before gmu_enable_gdsc(), gmu_enable_clks() and the RPMh/GX vote.
+	 * It must precede everything: the host is telling the Always-On
+	 * Processor that the GPU's clock distribution is live before any
+	 * power or clock resource is touched.
+	 */
+	if (a6xx_gmu_send_acd_state(gmu, true))
+		pr_info("ACD230: AOP ACD-enable notification FAILED (channel unavailable or link down)\n");
+
+	/* Turn on the resources */
+	pr_info("GMU_PM: gmu->dev=%s gxpd=NULL (no gxpd in this tree; upstream takes a second runtime-PM ref)\n",
+		dev_name(gmu->dev));
+	bc132("RESUME_ENTRY", 0);
+	pr_info("GMU_PM: gmu_dev_runtime_enabled=%d\n",
+		pm_runtime_enabled(gmu->dev));
+	pm_runtime_get_sync(gmu->dev);
+	pr_info("GMU_PM: pm_runtime_get_sync(gmu->dev) done\n");
+	A6XX_TRACE("pm_runtime_get_sync done");
+
+	/*
+	 * Minimal equivalent of vendor KGSL gmu_enable_gdsc(), which runs
+	 * before gmu_enable_clks() in every gmu_start() state (INIT/SUSPEND/
+	 * SLUMBER/RESET). regulator_enable() is refcounted, so calling it on
+	 * an already-enabled rail only bumps the count -- safe either way.
+	 */
+	A6XX_TRACE("before CX GDSC enable (cx=%px already=%d)",
+		gmu->cx, gmu->cx ? regulator_is_enabled(gmu->cx) : -1);
+	if (gmu->cx) {
+		ret = regulator_enable(gmu->cx);
+		A6XX_TRACE("after CX GDSC enable (ret=%d already=%d)", ret,
+			regulator_is_enabled(gmu->cx));
+		if (ret)
+			goto out;
+	} else {
+		A6XX_TRACE("CX GDSC enable skipped (no regulator)");
+	}
+
+	/*
+	 * IMAGE 274c -- the one regulator operation KGSL does that this driver
+	 * has never done.
+	 *
+	 * Everything else in the KGSL power sequence has already been ported and
+	 * exercised (image 273's dmesg, in order):
+	 *
+	 *   ACD230: '{class: gpu, res: acd, value: 1}' ret=0   (KGSL step 1)
+	 *   GXVOTE225: idx=6/7 legacy=0 -> SPTPRAC=0xc0 GX_GDSCR=0x222001
+	 *   GXGDSC226: regulator_enable(vdd/gpu_gx_gdsc) ret=0 already=1
+	 *   GXCLK229: clk_prepare_enable(gpu_cc_gx_gmu_clk) ret=0 rate=200000000
+	 *   + the DDR/CNOC bus vote: msm_bus_scale_client_update_request(bw_pcl, 4)
+	 *     immediately before FW_START (a6xx_gmu.c:2139-2141)
+	 *
+	 * So the CX GDSC is ENABLED, the GX GDSC is enabled, both clocks are on,
+	 * the AOP has been told, the interconnect is voted -- and the GPU still
+	 * writes nothing.
+	 *
+	 * What is missing is the CX GDSC's MODE.  KGSL sets it:
+	 *
+	 *   kgsl_gmu.c:1599  regulator_set_mode(gmu->cx_gdsc, REGULATOR_MODE_IDLE);
+	 *   kgsl_gmu.c:1604  regulator_set_mode(gmu->cx_gdsc, REGULATOR_MODE_NORMAL);
+	 *
+	 * and, because the DT sets qcom,gpu-quirk-cx-gdsc, KGSL then answers
+	 * "is the CX domain on" from the regulator's own state rather than from
+	 * the register (adreno_a6xx_gmu.c:842-846).  This driver parses no
+	 * gpu-quirk property at all and never calls regulator_set_mode().
+	 *
+	 * The mode is what tells the PMIC how hard the GPU domain may be driven;
+	 * on this part the CX GDSC left in its default/IDLE mode is a plausible
+	 * reason for the GX side to stay quiescent even with every gate and
+	 * clock nominally open.
+	 *
+	 * MEASUREMENT, not a fix.  It prints the regulator's own view before and
+	 * after, plus the GX GDSC and SPTPRAC registers, so one boot gives an
+	 * A/B.  The CX_GDSCR register (0x2441B) is deliberately not read: it
+	 * lives in the GPU_CC window, not the GMU's, and this tree has no accessor
+	 * for it (and the project has already established that CPU-side GPU
+	 * registers on this part are context-banked and unreliable -- image 263).
+	 */
+	if (cxgdm) {
+		bool quirk = false;
+		struct msm_drm_private *priv = NULL;
+		struct device_node *gpu_node = NULL;
+		unsigned int mode = cxgdm;
+
+		/*
+		 * IMAGE 275 FIX: the quirk property lives on the GPU node
+		 * (qcom,kgsl-3d0), NOT on the GMU node (qcom,gpu-gmu):
+		 *
+		 *   sm8150-gpu.dtsi:116   qcom,gpu-quirk-cx-gdsc;   <- GPU node
+		 *   sm8150-gpu.dtsi:175   regulator-names = "vddcx", "vdd";
+		 *   sm8150-gpu.dtsi:403   regulator-names = "vddcx", "vdd";  <- GMU node
+		 *
+		 * Image 274 read it from gmu->dev->of_node (the GMU node)
+		 * and got 0.  KGSL reads it from the adreno device node.
+		 */
+		if (a6xx_gpu->base.base.dev && a6xx_gpu->base.base.dev->dev_private)
+			priv = a6xx_gpu->base.base.dev->dev_private;
+		if (priv && priv->gpu_pdev)
+			gpu_node = priv->gpu_pdev->dev.of_node;
+		if (gpu_node)
+			quirk = of_property_read_bool(gpu_node,
+					"qcom,gpu-quirk-cx-gdsc");
+
+		pr_info("CXMODE274: cx=%px gpu_node=%px quirk(cx-gdsc)=%d mode=%u\n",
+			(void *)gmu->cx, (void *)gpu_node, quirk, mode);
+
+		if (gmu->cx) {
+			pr_info("CXMODE274: before: enabled=%d mode=%d\n",
+				regulator_is_enabled(gmu->cx),
+				regulator_get_mode(gmu->cx));
+			ret = regulator_set_mode(gmu->cx, mode);
+			pr_info("CXMODE274: regulator_set_mode(vddcx, %u) = %d\n",
+				mode, ret);
+			pr_info("CXMODE274: after: enabled=%d mode=%d\n",
+				regulator_is_enabled(gmu->cx),
+				regulator_get_mode(gmu->cx));
+		} else {
+			pr_info("CXMODE274: no vddcx regulator, nothing to do\n");
+		}
+
+		/* give the PMIC a real window before sampling */
+		msleep(20);
+
+		pr_info("CXMODE274: +20ms SPTPRAC=0x%x GX_GDSCR=0x%x TCS0=0x%x RSC0=0x%x RPMHPWR=0x%x gx_is_on=%d\n",
+			gmu_read(gmu, REG_A6XX_GMU_SPTPRAC_PWR_CLK_STATUS),
+			gmu_read(gmu, REG_A6XX_GPU_CC_GX_GDSCR),
+			gmu_read(gmu, REG_A6XX_RSCC_TCS0_DRV0_STATUS),
+			gmu_read(gmu, REG_A6XX_GPU_RSCC_RSC_STATUS0_DRV0),
+			gmu_read(gmu, REG_A6XX_GPU_GMU_CX_GMU_RPMH_POWER_STATE),
+			a6xx_gmu_gx_is_on(gmu));
+	}
+
+	/* Use a known rate to bring up the GMU */
+	clk_set_rate(gmu->core_clk, 200000000);
+	A6XX_TRACE("clk_set_rate done");
+	a6xx_gmu_scratch_check(gmu, "pre-clocks");
+	A6XX_TRACE("before clk_bulk_prepare_enable");
+	pr_info("GMU_PM: clk_bulk_prepare_enable(nr=%d) enter\n",
+		gmu->nr_clocks);
+	ret = a6xx_gmu_clk_bulk_prepare_enable_traced(gmu->nr_clocks,
+			gmu->clocks);
+	A6XX_TRACE("clocks enabled (ret=%d)", ret);
+	if (!ret)
+		gmu_clks_live = true;
+	a6xx_gmu_scratch_check(gmu, "post-clocks");
+	if (ret)
+		goto out;
+
+	A6XX_TRACE("before GMU IRQ enable");
+	a6xx_gmu_irq_enable(gmu);
+	A6XX_TRACE("GMU IRQ enabled");
+
+	/* Check to see if we are doing a cold or warm boot */
+	status = gmu_read(gmu, REG_A6XX_GMU_GENERAL_7) == 1 ?
+		GMU_WARM_BOOT : GMU_COLD_BOOT;
+
+	/*
+	 * IMAGE 225 -- RESTORED from upstream v5.8 a6xx_gmu_resume().
+	 *
+	 * "Warm boot path does not work on newer GPUs. Presumably this is
+	 * because icache/dcache regions must be restored."
+	 *
+	 * Our port dropped this override, so it trusted GENERAL_7 alone. But
+	 * our own cold-boot fw_start sets GENERAL_7=1, so every resume after
+	 * the first selected WARM and skipped the firmware reload. That is a
+	 * second, independent way GX never comes up on a retried resume.
+	 */
+	if (!gmu->legacy)
+		status = GMU_COLD_BOOT;
+
+	A6XX_TRACE("boot status read (%s)",
+		status == GMU_WARM_BOOT ? "warm" : "cold");
+
+	/*
+	 * Minimal equivalent of vendor KGSL gmu_start(): DDR bandwidth vote
+	 * immediately before FW_START. KGSL votes
+	 * msm_bus_scale_client_update_request(gmu->pcl,
+	 * pwr->pwrlevels[default].bus_freq) with the comment "Vote for 300MHz
+	 * DDR for GMU to init"; on sm8150 grp3d that is index 4 (bus=300).
+	 * Observation only beyond the vote itself.
+	 */
+	A6XX_TRACE("before DDR vote (pcl=%u)", gmu->bw_pcl);
+	if (gmu->bw_pcl) {
+		ret = msm_bus_scale_client_update_request(gmu->bw_pcl, 4);
+		A6XX_TRACE("after DDR vote (ret=%d)", ret);
+		if (ret)
+			goto out;
+	} else {
+		A6XX_TRACE("DDR vote skipped (no bus client)");
+	}
+
+	/*
+	 * TEMPORARY SMMU/map diagnostics -- REMOVE ONCE FAULT IS UNDERSTOOD.
+	 *
+	 * The ARM SMMU reports faults by internal cbndx (cb=1 = second CB
+	 * allocated on kgsl-smmu, NOT hardware CB 5), so log our address
+	 * spaces by device + domain + aperture + fwspec SIDs, plus every GMU
+	 * buffer IOVA, before the GMU touches DMA.
+	 */
+	{
+		struct a6xx_gpu *ag = container_of(gmu, struct a6xx_gpu, gmu);
+		struct adreno_gpu *ad = &ag->base;
+		struct drm_device *drm = ad->base.dev;
+		struct msm_drm_private *priv = drm ? drm->dev_private : NULL;
+		struct msm_gpu *gpu = priv ? priv->gpu : NULL;
+		struct iommu_fwspec *fs;
+		int i;
+
+		A6XX_TRACE("SMMU gmu domain=%px dev=%s aperture=%llx-%llx",
+			gmu->domain, gmu->cb_dev ? dev_name(gmu->cb_dev) : "?",
+			gmu->domain ? gmu->domain->geometry.aperture_start : 0,
+			gmu->domain ? gmu->domain->geometry.aperture_end : 0);
+		if (gmu->cb_dev && gmu->cb_dev->iommu_fwspec) {
+			fs = gmu->cb_dev->iommu_fwspec;
+			for (i = 0; i < fs->num_ids; i++)
+				A6XX_TRACE("SMMU gmu fwspec SID[%d]=0x%x",
+					i, fs->ids[i]);
+		}
+		if (gpu && gpu->aspace)
+			A6XX_TRACE("SMMU gpu aspace=%px dev=%s",
+				gpu->aspace,
+				priv->gpu_pdev ? dev_name(&priv->gpu_pdev->dev) : "?");
+		if (priv && priv->gpu_pdev &&
+		    priv->gpu_pdev->dev.iommu_fwspec) {
+			fs = priv->gpu_pdev->dev.iommu_fwspec;
+			for (i = 0; i < fs->num_ids; i++)
+				A6XX_TRACE("SMMU gpu fwspec SID[%d]=0x%x",
+					i, fs->ids[i]);
+		}
+	}
+#define A6XX_BO_LOG(tag, bo) do { \
+		if (bo) \
+			A6XX_TRACE("SMMU map " tag " iova=0x%llx size=0x%zx %s", \
+				(unsigned long long)(bo)->iova, (bo)->size, \
+				IS_ERR(bo) ? "ERR" : "ok"); \
+		else \
+			A6XX_TRACE("SMMU map " tag " NULL"); \
+	} while (0)
+	A6XX_BO_LOG("itcmhole", gmu->itcm_hole);
+	A6XX_BO_LOG("hfi", gmu->hfi);
+	A6XX_BO_LOG("icache", gmu->icache);
+	A6XX_BO_LOG("dcache", gmu->dcache);
+	A6XX_BO_LOG("debug", gmu->debug);
+	A6XX_BO_LOG("dummy", gmu->dummy);
+	A6XX_BO_LOG("sentinel", gmu->sentinel);
+	A6XX_BO_LOG("log", gmu->log);
+#undef A6XX_BO_LOG
+
+	/*
+	 * TEMPORARY image 142 -- PROMOTE IF STABLE. Bounded retry beats the
+	 * firmware lottery (BADDFACE/NACK/silence): attempt 0 is the exact old
+	 * path; attempts 1-2 run the proven a6xx_gmu_reset() teardown+reboot
+	 * (fw RESET + hfi COLD_BOOT inside). Success path byte-identical.
+	 */
+	ret = -ETIMEDOUT;
+	{
+		int attempt;
+		for (attempt = 0; attempt < (recover166_fast ? 1 : 3); attempt++) {
+			if (attempt == 0) {
+				pr_info("A6XX_SNAPSHOT: FW_START state=%d\n", status);
+				pr_info("POST_START: fw_start begin\n");
+				A6XX_TRACE("before firmware start");
+				ret = a6xx_gmu_fw_start(gmu, status);
+				pr_info("POST_START: fw_start end ret=%d\n", ret);
+				A6XX_TRACE("fw_start returned (ret=%d)", ret);
+				if (ret)
+					goto next_attempt;
+
+				a6xx_gmu_bootstrap_active = true;
+				pr_info("=== GMU BOOTSTRAP BEGIN ===\n");
+				ret = a6xx_hfi_start(gmu, status);
+				a6xx_gmu_bootstrap_active = false;
+				pr_info("=== GMU BOOTSTRAP END ===\n");
+				A6XX_TRACE("hfi_start returned (ret=%d)", ret);
+			} else {
+				pr_info("RETRY142: attempt %d/2 after ret=%d\n",
+					attempt, ret);
+				bc132("RETRY", ret);
+				ret = a6xx_gmu_reset(a6xx_gpu);
+				pr_info("RETRY142: reset returned ret=%d\n", ret);
+			}
+			if (ret)
+				goto next_attempt;
+
+			/*
+			 * TEMPORARY image 132 gated probe + image 137 nonlegacy
+			 * mode.
+			 *
+			 * TEMPORARY image 194 -- PROMOTE IF THE RING APPEARS.
+			 *
+			 * This probe is an INSTRUMENT, not a bring-up
+			 * requirement. It used to be able to fail the bring-up,
+			 * and that is what stopped the GPU ever working.
+			 *
+			 * Observed on image 193:
+			 *
+			 *   fw_start end ret=0                 <- attempt 0 OK
+			 *   ... hfi_vote_probe fails ...
+			 *   GMU firmware initialization timed out
+			 *   after GMU start (ret=-110)         <- attempt 1
+			 *   BC132: ev=RESUME_RETURN ret=-110
+			 *   A6XX_DIAG: hw_init suppressed after GMU boot error -110
+			 *
+			 * A perfectly healthy GMU was booted (GOOD BABEFACE,
+			 * HFISTAT=0x1), a diagnostic vote probe failed, and the
+			 * loop then re-ran fw_start on the already-running GMU.
+			 * That retry timed out, the -110 latched
+			 * a6xx_gmu_boot_error in a6xx_pm_resume, and
+			 * msm_gpu_hw_init() skips hw_init while that is set -- so
+			 * the ring was never programmed (rb_iova=0x0, RB_BASE=0x0,
+			 * no RINGHW[] lines, "CP is NOT CLOCKING") even though
+			 * GL_RENDERER read FD640 and every GEM_SUBMIT returned 0.
+			 *
+			 * That is the entire reason wptr_dw stayed 0.
+			 *
+			 * Fix: log a probe failure and keep the successful fw_start
+			 * result instead of discarding it and retrying. bring-up is
+			 * already complete at this point; a failed read-only vote
+			 * probe must not undo it.
+			 */
+			if (gmu_hfi_probe || experimental_nonlegacy) {
+				int probe_ret = a6xx_gmu_hfi_vote_probe(gmu);
+
+				if (probe_ret && !ret) {
+					pr_info("A6XX_DIAG: hfi_vote_probe failed (%d) "
+						"-- keeping successful fw_start, "
+						"NOT retrying (image 194)\n",
+						probe_ret);
+				}
+			}
+
+			break;
+next_attempt:;
+		}
+	}
+	if (ret)
+		goto out;
+
+	/*
+	 * TEMPORARY image 140 -- PROMOTE IF STICKY. Nonlegacy mode keeps the
+	 * DCVS register writes (proven load-bearing: 133/136/138 sticky runs
+	 * all executed them; 137-att5 skipped them -> void). The OOB ack
+	 * timeout inside set_freq is harmless (all sticky runs had it).
+	 */
+	if (experimental_nonlegacy)
+		pr_info("NONLEGACY140: running legacy DCVS set_freq for its register writes (OOB result ignored as before)\n");
+	/* Set the GPU to the highest power frequency */
+	a6xx_gmu_set_freq(gmu, gmu->nr_gpu_freqs - 1);
+	A6XX_TRACE("set_freq done");
+
+	/*
+	 * IMAGE 225: immediate readback around the GX vote. This is the first
+	 * point in the whole project where we can see whether the vote had any
+	 * effect. Compare SPTPRAC / GX_GDSCR before (a6xx_gmu_resume entry) with
+	 * the values here, and GXSTATE ~1ms after via the poller.
+	 */
+	pr_info("GXVOTE225: idx=%d/%d legacy=%d -> SPTPRAC=0x%x GX_GDSCR=0x%x TCS0=0x%x RSC0=0x%x RPMHPWR=0x%x\n",
+		gmu->nr_gpu_freqs - 1, gmu->nr_gpu_freqs, gmu->legacy,
+		gmu_read(gmu, REG_A6XX_GMU_SPTPRAC_PWR_CLK_STATUS),
+		gmu_read(gmu, REG_A6XX_GPU_CC_GX_GDSCR),
+		gmu_read(gmu, REG_A6XX_RSCC_TCS0_DRV0_STATUS),
+		gmu_read(gmu, REG_A6XX_GPU_RSCC_RSC_STATUS0_DRV0),
+		gmu_read(gmu, REG_A6XX_GPU_GMU_CX_GMU_RPMH_POWER_STATE));
+
+	/*
+	 * IMAGE 226 -- THE DECISIVE EXPERIMENT. gpu_cc_gx_gmu_clk is still
+	 * en=0 after a correct, acked GX vote. Last remaining blocker.
+	 *
+	 * gpu_gx_gdsc is a REAL power domain, not a placeholder:
+	 *   sm8150-gdsc.dtsi:228  qcom,gdsc@0x2c9100c, sw-reset, domain-addr
+	 *   sm8150.dtsi:4121      status="ok", parent-supply=<&pm8150l_s2_level>
+	 * i.e. a genuine PMIC rail behind a GDSC CSR. We hold the handle
+	 * (devm_regulator_get(gmu->dev,"vdd")) and have NEVER enabled it --
+	 * resume enables CX only. IMAGE-83-84-RESULTS.md proposed exactly this
+	 * a hundred images ago; KGSL-DRM-POWER-COMPARE.md later closed it on
+	 * the claim that GX comes up via GMU/RPMh alone. That claim is now
+	 * testable, because the GMU/RPMh path has actually been exercised and
+	 * the gate is still shut.
+	 *
+	 * Placed AFTER the GXVOTE225 print so that print captures the clean
+	 * pre-enable state and this block captures the post-enable state: one
+	 * boot gives an A/B. Modelled on upstream's gmu_gxpd_get(), whose own
+	 * comment says the A6x/A7x host vote "won't actually do anything but
+	 * ... make sure that the refcounting is correct".
+	 *
+	 * Interpretation:
+	 *   GXGDSCR / SPTPRAC move  -> the rail IS host-reachable; the break is
+	 *                              strictly in the GMU->AOP path.
+	 *   nothing moves           -> the host cannot reach it at all, and the
+	 *                              AOP/QMP ACD notification is the fix.
+	 */
+	if (gmu->gx && !IS_ERR(gmu->gx) && enable_gx_gdsc) {
+		int gxret = regulator_enable(gmu->gx);
+
+		pr_info("GXGDSC226: regulator_enable(vdd/gpu_gx_gdsc) ret=%d already=%d\n",
+			gxret, regulator_is_enabled(gmu->gx));
+		gmu->gx_gdsc_enabled = !gxret;
+
+		/* give the rail/sequencer a real window before sampling */
+		msleep(5);
+
+		pr_info("GXGDSC226: +5ms SPTPRAC=0x%x GX_GDSCR=0x%x TCS0=0x%x RSC0=0x%x RPMHPWR=0x%x gx_is_on=%d\n",
+			gmu_read(gmu, REG_A6XX_GMU_SPTPRAC_PWR_CLK_STATUS),
+			gmu_read(gmu, REG_A6XX_GPU_CC_GX_GDSCR),
+			gmu_read(gmu, REG_A6XX_RSCC_TCS0_DRV0_STATUS),
+			gmu_read(gmu, REG_A6XX_GPU_RSCC_RSC_STATUS0_DRV0),
+			gmu_read(gmu, REG_A6XX_GPU_GMU_CX_GMU_RPMH_POWER_STATE),
+			a6xx_gmu_gx_is_on(gmu));
+	} else {
+		pr_info("GXGDSC226: skipped (handle %px, module param off)\n",
+			(void *)gmu->gx);
+	}
+
+	/*
+	 * IMAGE 229: enable the GX clock through the CLK FRAMEWORK.
+	 *
+	 * Images 227/228/229-previous each tried to poke the gate register
+	 * directly and all three failed for different reasons (of_iomap
+	 * garbage, -EBUSY, devm_ioremap garbage), twice Oopsing
+	 * a6xx_gmu_resume. Worse, the premise was wrong: I took the offset
+	 * 0x162 / mask 0x0F from debugcc-sm8150.c, which is a *measurement*
+	 * register. The real gate is in drivers/clk/qcom/gpucc-sm8150.c:
+	 *
+	 *   static struct clk_branch gpu_cc_gx_gmu_clk = {
+	 *           .enable_reg = 0x1064, .enable_mask = BIT(0), ...
+	 *
+	 * So: add GPU_CC_GX_GMU_CLK to the GMU node (done in
+	 * sm8150-gpu.dtsi) and let the clk driver enable it properly --
+	 * correct register, correct parent chain (gpu_cc_gx_gmu_clk_src),
+	 * correct refcounting. No raw MMIO, no resource conflicts.
+	 *
+	 * This is still a DIAGNOSTIC: if the fence now completes, the
+	 * firmware simply never opens this gate and the fix is the AOP/QMP
+	 * ACD notification. If the fence still hangs, the break is deeper
+	 * than power and the entire power story was a red herring.
+	 */
+	if (force_gx_clk) {
+		struct clk *gx;
+
+		gx = devm_clk_get(gmu->dev, "gx_gmu_clk");
+		if (IS_ERR(gx)) {
+			pr_info("GXCLK229: devm_clk_get(gx_gmu_clk) failed %ld\n",
+				PTR_ERR(gx));
+		} else {
+			int cret = clk_prepare_enable(gx);
+
+			pr_info("GXCLK229: clk_prepare_enable(gpu_cc_gx_gmu_clk) ret=%d rate=%lu\n",
+				cret, clk_get_rate(gx));
+
+			/* give the domain a real window before sampling */
+			msleep(20);
+
+			pr_info("GXCLK229: +20ms SPTPRAC=0x%x GX_GDSCR=0x%x TCS0=0x%x RSC0=0x%x RPMHPWR=0x%x gx_is_on=%d\n",
+				gmu_read(gmu, REG_A6XX_GMU_SPTPRAC_PWR_CLK_STATUS),
+				gmu_read(gmu, REG_A6XX_GPU_CC_GX_GDSCR),
+				gmu_read(gmu, REG_A6XX_RSCC_TCS0_DRV0_STATUS),
+				gmu_read(gmu, REG_A6XX_GPU_RSCC_RSC_STATUS0_DRV0),
+				gmu_read(gmu, REG_A6XX_GPU_GMU_CX_GMU_RPMH_POWER_STATE),
+				a6xx_gmu_gx_is_on(gmu));
+		}
+	}
+
+	/*
+	 * IMAGE 226: dump both sides of the OOB channel and clear a stale
+	 * host request. REG_A6XX_GMU_HOST2GMU_INTR_CLR (0x5195) is written
+	 * NOWHERE in this tree, so bit 16 -- set since image 1 and never
+	 * consumed -- has been un-retractable for the life of the project.
+	 */
+	{
+		u32 h2g = gmu_read(gmu, REG_A6XX_GMU_HOST2GMU_INTR_RAW_INFO);
+
+		pr_info("OOBDIAG226: H2G_RAW=0x%08x G2H_INFO=0x%08x G2H_SET=0x%08x G2H_MASK=0x%08x AO_STATUS=0x%08x\n",
+			h2g,
+			gmu_read(gmu, REG_A6XX_GMU_GMU2HOST_INTR_INFO),
+			gmu_read(gmu, REG_A6XX_GMU_GMU2HOST_INTR_SET),
+			gmu_read(gmu, REG_A6XX_GMU_GMU2HOST_INTR_MASK),
+			gmu_read(gmu, REG_A6XX_GMU_AO_HOST_INTERRUPT_STATUS));
+
+		if (h2g) {
+			gmu_write(gmu, REG_A6XX_GMU_HOST2GMU_INTR_CLR, h2g);
+			pr_info("OOBDIAG226: wrote HOST2GMU_INTR_CLR=0x%08x -> H2G_RAW=0x%08x G2H_INFO=0x%08x\n",
+				h2g,
+				gmu_read(gmu, REG_A6XX_GMU_HOST2GMU_INTR_RAW_INFO),
+				gmu_read(gmu, REG_A6XX_GMU_GMU2HOST_INTR_INFO));
+		}
+	}
+
+out:
+	/* Make sure to turn off the boot OOB request on error */
+	if (ret)
+		a6xx_gmu_clear_oob(gmu, GMU_OOB_BOOT_SLUMBER);
+
+	A6XX_TRACE("a6xx_gmu_resume RETURNING ret=%d", ret);
+
+	/*
+	 * IMAGE 226 -- FIX MY OWN BUG. The poller was gated on
+	 * `experimental_nonlegacy`, but the live cmdline sets
+	 * `al_nonlegacy=1`, which is a DIFFERENT parameter name. So the
+	 * poller never armed on the hardware and every RPMh/TCS diagnostic
+	 * living in it (RPV225) silently produced zero lines for the whole
+	 * image-225 run -- including the registers I added specifically to
+	 * interpret image 225's own result.
+	 *
+	 * Arm it unconditionally. The poller is observation-only.
+	 */
+	gvitals157_gmu = gmu;
+	schedule_delayed_work(&gvitals157_work, msecs_to_jiffies(5000));
+	pr_info("GVIT226: poller armed (first +5s, then 30s)\n");
+	bc132("RESUME_RETURN", ret);
+	return ret;
+}
+
+/*
+ * TEMPORARY image 166 -- PROMOTE with the IRQ-handler change above.
+ * Force the GMU off (upstream force_off shape, minus bus_halt which
+ * needs the absent interconnect driver) then cold re-bootstrap via
+ * the proven resume path (which retries the firmware lottery itself).
+ * Runs in process context under the DRM mutex, like a submit would.
+ * If resume fails, the machine stays alive (suppress philosophy) and
+ * the log shows exactly where.
+ */
+static void recover166_fn(struct work_struct *work)
+{
+	struct a6xx_gpu *ag = recover166_ag;
+	struct msm_gpu *gpu;
+	int ret;
+
+	if (!ag)
+		return;
+	gpu = &ag->base.base;
+
+	pr_info("RECOVER166: begin (force off + cold resume)\n");
+	mutex_lock(&gpu->dev->struct_mutex);
+	recover166_fast = true;
+
+	gmu_write(&ag->gmu, REG_A6XX_GMU_GMU_PWR_COL_KEEPALIVE, 0);
+	a6xx_hfi_stop(&ag->gmu);
+	a6xx_gmu_irq_disable(&ag->gmu);
+	a6xx_sptprac_disable(&ag->gmu);
+	gmu_write(&ag->gmu, REG_A6XX_GMU_AO_AHB_FENCE_CTRL, 0);
+	wmb();
+	gmu_write(&ag->gmu, REG_A6XX_GMU_CM3_SYSRESET, 1);
+	pr_info("RECOVER166: GMU halted, resuming\n");
+	a6xx_rpmh_stop(&ag->gmu);
+
+	ret = a6xx_gmu_resume(ag);
+
+	recover166_fast = false;
+	mutex_unlock(&gpu->dev->struct_mutex);
+	pr_info("RECOVER166: end ret=%d\n", ret);
+}
+
+bool a6xx_gmu_isidle(struct a6xx_gmu *gmu)
+{
+	u32 reg;
+
+	if (!gmu->mmio)
+		return true;
+
+	reg = gmu_read(gmu, REG_A6XX_GPU_GMU_AO_GPU_CX_BUSY_STATUS);
+
+	if (reg &  A6XX_GPU_GMU_AO_GPU_CX_BUSY_STATUS_GPUBUSYIGNAHB)
+		return false;
+
+	return true;
+}
+
+int a6xx_gmu_stop(struct a6xx_gpu *a6xx_gpu)
+{
+	struct a6xx_gmu *gmu = &a6xx_gpu->gmu;
+	u32 val;
+
+	/*
+	 * The GMU may still be in slumber unless the GPU started so check and
+	 * skip putting it back into slumber if so
+	 */
+	val = gmu_read(gmu, REG_A6XX_GPU_GMU_CX_GMU_RPMH_POWER_STATE);
+
+	if (val != 0xf) {
+		int ret = a6xx_gmu_wait_for_idle(a6xx_gpu);
+
+		/*
+		 * TEMPORARY image 165 -- PROMOTE WITH SLUMBER. Never BUG
+		 * in the trigger path: a failed slumber logs loudly and
+		 * continues awake (old behavior + full instrumentation).
+		 */
+		if (ret) {
+			pr_warn("a6xx: slumber wait_for_idle failed ret=%d, staying awake\n",
+				ret);
+			return ret;
+		}
+
+		if (a6xx_instr)
+			pr_info("SSTEP171: stop wait_for_idle done\n");
+		/* tell the GMU we want to slumber */
+		a6xx_gmu_notify_slumber(gmu);
+		if (a6xx_instr)
+			pr_info("SSTEP171: notify_slumber done\n");
+
+		ret = gmu_poll_timeout(gmu,
+			REG_A6XX_GPU_GMU_AO_GPU_CX_BUSY_STATUS, val,
+			!(val & A6XX_GPU_GMU_AO_GPU_CX_BUSY_STATUS_GPUBUSYIGNAHB),
+			100, 10000);
+
+		/*
+		 * Let the user know we failed to slumber but don't worry too
+		 * much because we are powering down anyway
+		 */
+
+		if (ret)
+			dev_err(gmu->dev,
+				"Unable to slumber GMU: status = 0%x/0%x\n",
+				gmu_read(gmu,
+					REG_A6XX_GPU_GMU_AO_GPU_CX_BUSY_STATUS),
+				gmu_read(gmu,
+					REG_A6XX_GPU_GMU_AO_GPU_CX_BUSY_STATUS2));
+	}
+
+	/*
+	 * TEMPORARY image 170 -- PROMOTE with the slumber lifecycle.
+	 * Drop our GX vote (upstream removes its OPP vote on shutdown;
+	 * stale votes are a known system-breaker). HFI still alive here;
+	 * a timeout just logs (bounded waiter inside the sender).
+	 */
+	if (experimental_nonlegacy) {
+		int zret = a6xx_hfi_send_gx_vote(gmu, 1, 0, 0);
+		if (a6xx_instr)
+			pr_info("SLUM170: zero-vote ret=%d\n", zret);
+	}
+
+	/* Turn off HFI */
+	a6xx_hfi_stop(gmu);
+	if (a6xx_instr)
+		pr_info("SSTEP171: hfi_stop done\n");
+
+	/* Stop the interrupts and mask the hardware */
+	a6xx_gmu_irq_disable(gmu);
+	if (a6xx_instr)
+		pr_info("SSTEP171: irq_disable done\n");
+
+	/* Tell RPMh to power off the GPU */
+	a6xx_rpmh_stop(gmu);
+	if (a6xx_instr)
+		pr_info("SSTEP171: rpmh_stop done\n");
+
+	clk_bulk_disable_unprepare(gmu->nr_clocks, gmu->clocks);
+	if (a6xx_instr)
+		pr_info("SSTEP171: clocks off done\n");
+
+	pm_runtime_put_sync(gmu->dev);
+
+	return 0;
+}
+
+static void a6xx_gmu_memory_free(struct a6xx_gmu *gmu, struct a6xx_gmu_bo *bo)
+{
+	int count, i;
+	u64 iova;
+
+	if (IS_ERR_OR_NULL(bo))
+		return;
+
+	count = bo->size >> PAGE_SHIFT;
+	iova = bo->iova;
+
+	/*
+	 * TEMPORARY image 202 update. Both allocation schemes now sit behind
+	 * this one free path and both use dma_alloc_attrs(): the HFI queue,
+	 * debug, log, dummy, sentinel, icache, dcache and itcm_hole. The
+	 * per-page alloc_page()/__free_pages() branch below is therefore dead
+	 * code (image 202 removed the last caller) and is retained only as a
+	 * safety net for any future buffer that sets `pages`.
+	 */
+	if (bo->phys) {
+		iommu_unmap(gmu->domain, iova, bo->size);
+		dma_free_attrs(gmu->dev, bo->size, bo->phys, bo->dma_addr, 0);
+		kfree(bo);
+		return;
+	}
+
+	for (i = 0; i < count; i++, iova += PAGE_SIZE) {
+		iommu_unmap(gmu->domain, iova, PAGE_SIZE);
+		__free_pages(bo->pages[i], 0);
+	}
+
+	kfree(bo->pages);
+	kfree(bo);
+}
+
+struct block_header {
+	u32 addr;
+	u32 size;
+	u32 type;
+	u32 value;
+	u32 data[];
+};
+
+/*
+ * Copy a firmware block into a CPU-visible GMU buffer if the block's address
+ * falls inside that buffer's IOVA range. Ported from upstream v5.8.
+ */
+static bool fw_block_mem(struct a6xx_gmu_bo *bo,
+		const struct block_header *blk)
+{
+	if (!bo)
+		return false;
+
+	if (blk->addr < bo->iova || blk->addr >= bo->iova + bo->size)
+		return false;
+
+	memcpy(bo->virt + (blk->addr - bo->iova), blk->data, blk->size);
+	return true;
+}
+
+/*
+ * Iteration step for the block list.
+ *
+ * Upstream v5.8 (and every version up to 2025) stepped with
+ *     &blk->data[blk->size >> 2]
+ * i.e. dword-based arithmetic, which silently truncates the advance whenever a
+ * block size is not a multiple of 4 and desynchronises the walk. The 2025 fix
+ * uses byte arithmetic instead.
+ *
+ * VERIFIED against the real Samsung blob (artifacts/display/GPU-FIRMWARE.md):
+ * all 7 block sizes in a640_gmu.bin are 4-aligned (0x30, 0x140, 0x38bc, 0x3a58,
+ * 0x1b20, 0x14, 0x308), so both formulas produce identical offsets for this
+ * firmware and the 2025 fix is NOT required here. It is used regardless because
+ * it is unconditionally correct and costs nothing.
+ */
+#define NEXT_BLK(blk) \
+	((const struct block_header *)((const char *)(blk) + \
+		sizeof(*(blk)) + (blk)->size))
+
+/*
+ * Load the GMU firmware.
+ *
+ * Legacy (A618/A630): the firmware is one flat image copied into ITCM, which
+ * is why it is capped at 0x8000 bytes. The cap is NOT raised.
+ *
+ * A640/A650: the firmware is a list of blocks, each carrying its destination
+ * address, so it can span ITCM, DTCM and the i/d caches. No size cap applies.
+ * Ported from upstream v5.8.
+ */
+static int a6xx_gmu_fw_load(struct a6xx_gmu *gmu)
+{
+	struct a6xx_gpu *a6xx_gpu = container_of(gmu, struct a6xx_gpu, gmu);
+	struct adreno_gpu *adreno_gpu = &a6xx_gpu->base;
+	const struct firmware *fw_image = adreno_gpu->fw[ADRENO_FW_GMU];
+	const struct block_header *blk;
+	u32 reg_offset;
+
+	u32 itcm_base = 0x00000000;
+	u32 dtcm_base = 0x00040000;
+
+	if (WARN(!fw_image, "GMU firmware is not loaded\n"))
+		return -ENOENT;
+
+	if (gmu->legacy) {
+		/* Sanity check the size of the firmware that was loaded */
+		if (fw_image->size > 0x8000) {
+			dev_err(gmu->dev,
+				"GMU firmware is bigger than the available region\n");
+			return -EINVAL;
+		}
+
+		for (reg_offset = 0; reg_offset < fw_image->size >> 2;
+				reg_offset++)
+			gmu_write(gmu,
+				REG_A6XX_GMU_CM3_ITCM_START + reg_offset,
+				((u32 *)fw_image->data)[reg_offset]);
+		return 0;
+	}
+
+	for (blk = (const struct block_header *) fw_image->data;
+	     (const u8 *)blk < fw_image->data + fw_image->size;
+	     blk = NEXT_BLK(blk)) {
+		if (blk->size == 0)
+			continue;
+
+		if (blk->addr >= itcm_base && blk->addr < itcm_base + SZ_16K) {
+			reg_offset = (blk->addr - itcm_base) >> 2;
+			gmu_write_bulk(gmu,
+				REG_A6XX_GMU_CM3_ITCM_START + reg_offset,
+				blk->data, blk->size);
+		} else if (blk->addr >= dtcm_base &&
+				blk->addr < dtcm_base + SZ_16K) {
+			reg_offset = (blk->addr - dtcm_base) >> 2;
+			gmu_write_bulk(gmu,
+				REG_A6XX_GMU_CM3_DTCM_START + reg_offset,
+				blk->data, blk->size);
+		} else if (!fw_block_mem(gmu->icache, blk) &&
+			   !fw_block_mem(gmu->dcache, blk) &&
+			   !fw_block_mem(gmu->dummy, blk)) {
+			dev_err(gmu->dev,
+				"failed to match fw block (addr=%.8x size=%d)\n",
+				blk->addr, blk->size);
+		}
+	}
+
+	return 0;
+}
+
+/*
+ * Allocate a GMU buffer at a FIXED IOVA. Used for the A640 i/d caches, whose
+ * IOVAs are dictated by the firmware block addresses. Ported from v5.8's
+ * a6xx_gmu_memory_alloc(), reduced to this tree's page/iommu_map() model.
+ */
+static struct a6xx_gmu_bo *a6xx_gmu_memory_alloc_fixed(struct a6xx_gmu *gmu,
+		size_t size, u64 iova, unsigned int prot)
+{
+	struct a6xx_gmu_bo *bo;
+	int ret;
+
+	bo = kzalloc(sizeof(*bo), GFP_KERNEL);
+	if (!bo)
+		return ERR_PTR(-ENOMEM);
+
+	bo->size = PAGE_ALIGN(size);
+	bo->iova = iova;
+
+	/*
+	 * TEMPORARY image 202 -- the icache/dcache coherency fix.
+	 *
+	 * This helper previously did alloc_page() + vmap(pgprot_writecombine).
+	 * It is now byte-for-byte the same coherent allocation that image 199
+	 * applied to the HFI queue and debug region, at the SAME caller-supplied
+	 * fixed IOVA, with the SAME iommu flags. CAF KGSL does exactly this for
+	 * every GMU buffer including GMU_ICACHE and GMU_DCACHE -- see
+	 * drivers/gpu/msm/kgsl_gmu.c alloc_and_map(), which reaches
+	 * dma_alloc_attrs() for both (only GMU_ITCM/GMU_DTCM return early).
+	 *
+	 * Why this is the fix for "INITRES stuck at 0x0, no SMMU fault":
+	 *
+	 * Decoding the real a640_gmu.bin block table shows where the firmware
+	 * actually lands:
+	 *
+	 *   ITCM   0x00000  14892 B  -> gmu_write_bulk() -> memcpy_toio(), ordered
+	 *   DTCM   0x40000   6964 B  -> gmu_write_bulk() -> memcpy_toio(), ordered
+	 *   ICACHE 0x04000  14936 B  -> fw_block_mem() -> memcpy() into a WC vmap
+	 *   DCACHE 0x57000    776 B  -> fw_block_mem() -> memcpy() into a WC vmap
+	 *
+	 * i.e. 41.7% of the image -- including the single largest block, the
+	 * CM3's instruction cache -- was written through a write-combine CPU
+	 * mapping. The CM3 is a separate bus master that reads that memory
+	 * through the SMMU. Stores to a WC mapping sit in the CPU's store
+	 * buffer and are not observable by any other master until they drain.
+	 * There was also no wmb() anywhere between a6xx_gmu_fw_load() and the
+	 * CM3_SYSRESET=0 release.
+	 *
+	 * The resulting signature is exactly what we observe and is why this
+	 * was so hard to see for 200 images: the CM3 executes stale or zero
+	 * instructions, so it never reaches __main and INITRES never becomes
+	 * 0xBABEFACE -- but the mapping is valid and the permissions are
+	 * correct, so arm-smmu reports ZERO unhandled context faults. Only the
+	 * DATA is wrong. Drain timing is nondeterministic, which is why the
+	 * failure is a lottery rather than deterministic.
+	 *
+	 * It also explains why images 195 (wmb on the HFI TX path) and 199
+	 * (coherent HFI queue) changed nothing: both are downstream of the
+	 * firmware LOAD. If the CM3 never starts, it never reads an HFI queue.
+	 *
+	 * Note the aliasing hazard that a bare wmb() would NOT fix:
+	 * alloc_page() pages are also reachable through the cacheable linear
+	 * map. __GFP_ZERO dirties cache lines through that alias, while the
+	 * firmware memcpy bypasses cache through the WC alias, so a later
+	 * eviction could overwrite the firmware with zeros. dma_alloc_attrs()
+	 * gives one coherent (non-snooped) mapping and performs the required
+	 * cache maintenance itself.
+	 *
+	 * Buffers affected: icache, dcache, itcm_hole, log, sentinel, dummy.
+	 * itcm_hole keeps its exact IOVA/size/flags -- image 192 proved it
+	 * load-bearing (SMMU faults 5->0) and it is NOT a CAF buffer.
+	 *
+	 * DMA_ATTR_FORCE_CONTIGUOUS: a single iommu_map() over dma_addr is only
+	 * valid if the allocation is physically contiguous. Without the flag
+	 * the DMA API gives no contiguity guarantee (this kernel has a 16 MiB
+	 * CMA, and 240 KiB icache/dcache allocations would be served from it
+	 * without a hard promise). The flag routes the allocation through
+	 * dma_alloc_from_contiguous() and makes failure explicit rather than
+	 * silently mapping a partial range. Sizes here are 4 KiB..240 KiB, well
+	 * inside the atomic pool, so the strong path is also the fast one.
+	 *
+	 * IOVA safety re-checked: no overlap. itcm_hole 0x0-0x4000 ends exactly
+	 * where icache begins; icache 0x4000-0x40000 ends exactly where dcache
+	 * begins; dummy 0x60000000 is taken by a FIXED mapping and
+	 * gmu->uncached_iova_base is then explicitly set to 0x60001000 so the
+	 * dynamically allocated HFI queue (which advances by 1 MiB) lands at
+	 * 0x60010000, clear of the fixed log at 0x60006000. sentinel at
+	 * 0xDEADB000 is in its own window.
+	 *
+	 * prot is passed through unchanged, so IOMMU_PRIV on icache/dcache/
+	 * itcm_hole is preserved.
+	 */
+	bo->phys = dma_alloc_attrs(gmu->dev, bo->size, &bo->dma_addr,
+			GFP_KERNEL | __GFP_ZERO, DMA_ATTR_FORCE_CONTIGUOUS);
+	if (!bo->phys) {
+		kfree(bo);
+		return ERR_PTR(-ENOMEM);
+	}
+
+	ret = iommu_map(gmu->domain, bo->iova, bo->dma_addr, bo->size, prot);
+
+	if (ret) {
+		dev_err(gmu->dev, "Unable to map GMU buffer object\n");
+		goto err;
+	}
+
+	/*
+	 * TEMPORARY image 202 -- contiguity proof, logged once per buffer.
+	 *
+	 * A single iommu_map() over dma_addr is only correct if the allocation
+	 * is physically contiguous. DMA_ATTR_FORCE_CONTIGUOUS should guarantee
+	 * it, but "should" is not a measurement, and this whole bug class has
+	 * been invisible precisely because it was assumed correct. Walking the
+	 * pages via the CPU pointer costs nothing at probe time and settles it
+	 * in the log for every boot, forever.
+	 */
+	{
+		size_t k;
+		uintptr_t p0 = (uintptr_t)bo->phys;
+		u64 phys0 = (u64)virt_to_phys(bo->phys);
+		int discontig = 0;
+
+		for (k = PAGE_SIZE; k < bo->size; k += PAGE_SIZE) {
+			if ((uintptr_t)(bo->phys + k) != p0 + k ||
+			    (u64)virt_to_phys(bo->phys + k) != phys0 + k) {
+				discontig = 1;
+				break;
+			}
+		}
+		A6XX_TRACE("ALLOC202 iova=0x%llx size=0x%zx phys=0x%llx contiguous=%d\n",
+			(unsigned long long)bo->iova, bo->size,
+			(unsigned long long)phys0, !discontig);
+		if (discontig)
+			dev_err(gmu->dev,
+				"GMU buffer iova=0x%llx is NOT physically contiguous\n",
+				(unsigned long long)bo->iova);
+	}
+
+	/* Coherent CPU pointer straight from dma_alloc_attrs(). No vmap. */
+	bo->virt = bo->phys;
+
+	return bo;
+
+err:
+	dma_free_attrs(gmu->dev, bo->size, bo->phys, bo->dma_addr, 0);
+	kfree(bo);
+
+	return ERR_PTR(-ENOMEM);
+}
+static struct a6xx_gmu_bo *a6xx_gmu_memory_alloc(struct a6xx_gmu *gmu,
+		size_t size)
+{
+	struct a6xx_gmu_bo *bo;
+	int ret, count, i;
+
+	bo = kzalloc(sizeof(*bo), GFP_KERNEL);
+	if (!bo)
+		return ERR_PTR(-ENOMEM);
+
+	bo->size = PAGE_ALIGN(size);
+
+	count = bo->size >> PAGE_SHIFT;
+
+	/*
+	 * TEMPORARY image 199 -- PROMOTE IF HFI STOPS TIMING OUT.
+	 *
+	 * Use dma_alloc_attrs(), matching CAF KGSL exactly
+	 * (drivers/gpu/msm/kgsl_gmu.c, alloc_and_map()):
+	 *
+	 *   md->hostptr = dma_alloc_attrs(&gmu->pdev->dev, md->size,
+	 *                                  &md->physaddr, GFP_KERNEL, 0);
+	 *   iommu_map(domain, md->gmuaddr, md->physaddr, md->size, attrs);
+	 *
+	 * We previously used alloc_page(GFP_KERNEL|__GFP_ZERO) followed by
+	 *   vmap(bo->pages, count, VM_IOREMAP, pgprot_writecombine(PAGE_KERNEL));
+	 *
+	 * pgprot_writecombine is the bug. A write-combine mapping is NOT
+	 * coherent with a separate bus master: the CPU's stores are merged in
+	 * a WC buffer that the GMU cannot snoop, because the GMU is its own
+	 * processor reading through the SMMU, not the CPU reading a cache
+	 * line.
+	 *
+	 * This is why image 195's wmb() fix was necessary but NOT sufficient.
+	 * wmb() orders the CPU's stores with respect to subsequent MMIO
+	 * writes, so the doorbell cannot be reordered before the queue data.
+	 * But it does not push a write-combine buffer out to a point where a
+	 * different coherently-provisioned agent can observe it. The GMU
+	 * therefore intermittently read rd==wr and found nothing to do, which
+	 * is exactly the observed symptom: 6 ACKs once, timeouts otherwise.
+	 *
+	 * dma_alloc_attrs() returns memory coherent with respect to the
+	 * device by construction, because the GMU platform device was
+	 * of_dma_configure()d. That is the property the GMU needs and a WC
+	 * mapping cannot provide.
+	 *
+	 * Physically contiguous as a bonus: one dma_alloc_attrs() replaces
+	 * the per-page alloc_page loop and needs only a single iommu_map()
+	 * for the whole buffer, instead of one per page.
+	 *
+	 * TEMPORARY image 202: DMA_ATTR_FORCE_CONTIGUOUS added so that single
+	 * iommu_map() is provably valid. The HFI buffer is only 20 KiB, so the
+	 * strong path costs nothing.
+	 */
+	bo->phys = dma_alloc_attrs(gmu->dev, bo->size, &bo->dma_addr,
+			GFP_KERNEL | __GFP_ZERO, DMA_ATTR_FORCE_CONTIGUOUS);
+	if (!bo->phys) {
+		kfree(bo);
+		return ERR_PTR(-ENOMEM);
+	}
+
+	memset(bo->phys, 0, bo->size);
+
+	bo->iova = gmu->uncached_iova_base;
+
+	ret = iommu_map(gmu->domain, bo->iova, bo->dma_addr, bo->size,
+		IOMMU_READ | IOMMU_WRITE);
+
+	if (ret) {
+		dev_err(gmu->dev, "Unable to map GMU buffer object\n");
+		goto err;
+	}
+
+	/*
+	 * Coherent CPU pointer straight from dma_alloc_attrs(). No vmap and
+	 * definitely no pgprot_writecombine() -- that mapping is precisely
+	 * what left the GMU unable to see our queue writes. See the comment at
+	 * the allocation above.
+	 */
+	bo->virt = bo->phys;
+
+	/* Align future IOVA addresses on 1MB boundaries */
+	gmu->uncached_iova_base += ALIGN(size, SZ_1M);
+
+	return bo;
+
+err:
+	dma_free_attrs(gmu->dev, bo->size, bo->phys, bo->dma_addr, 0);
+	kfree(bo);
+
+	return ERR_PTR(-ENOMEM);
+}
+
+static int a6xx_gmu_memory_probe(struct device *mmu_dev,
+		struct a6xx_gmu *gmu)
+{
+	int ret;
+
+	/*
+	 * The GMU address space is hardcoded to treat the range
+	 * 0x60000000 - 0x80000000 as un-cached memory. All buffers shared
+	 * between the GMU and the CPU will live in this space
+	 */
+	gmu->uncached_iova_base = 0x60000000;
+
+	/*
+	 * Get an IOMMU domain for the GMU's kernel context bank.
+	 *
+	 * The GMU node itself carries no "iommus" property; the context banks
+	 * gmu_user (CB 4) and gmu_kernel (CB 5) are its children. KGSL maps GMU
+	 * kernel buffers (HFI queues, icache/dcache, debug region) through
+	 * gmu_kernel - see kgsl_gmu.c alloc_and_map(GMU_CONTEXT_KERNEL) - so
+	 * that is the bank used here.
+	 *
+	 * msm_gpu_cb_domain_get() populates the CB as a platform device and
+	 * allocates + attaches a domain, exactly as CAF's
+	 * gmu_iommu_cb_probe() does, without requiring KGSL.
+	 */
+	gmu->domain = NULL;
+	gmu->cb_dev = NULL;
+
+	ret = msm_gpu_cb_domain_get("gmu_kernel", &gmu->domain, &gmu->cb_dev);
+	if (ret) {
+		dev_err(mmu_dev,
+			"failed to obtain GMU context bank 'gmu_kernel': %d\n",
+			ret);
+		return ret;
+	}
+
+	/*
+	 * TEMPORARY experiment image 122 -- PROMOTE IF OPP FIXES.
+	 * Upstream ownership: gmu->dev stays on the real GMU platform
+	 * device; the context-bank device lives only in gmu->cb_dev and
+	 * is passed explicitly (mmu_dev) where the IOMMU adapter needs
+	 * a device. The old "gmu->dev = gmu->cb_dev" reassignment is
+	 * removed so OPP/clocks/regulators see the GMU node.
+	 */
+
+	mmu_dbg(mmu_dev, "GMU using context bank gmu_kernel, domain=%p\n",
+		gmu->domain);
+
+	return 0;
+}
+
+/* Get the list of RPMh voltage levels from cmd-db */
+static int a6xx_gmu_rpmh_arc_cmds(const char *id, void *vals, int size)
+{
+	u32 len = cmd_db_get_aux_data_len(id);
+
+	if (!len)
+		return 0;
+
+	if (WARN_ON(len > size))
+		return -EINVAL;
+
+	cmd_db_get_aux_data(id, vals, len);
+
+	/*
+	 * The data comes back as an array of unsigned shorts so adjust the
+	 * count accordingly
+	 */
+	return len >> 1;
+}
+
+/*
+ * dev_pm_opp_get_of_node() was added upstream in 4.16 and is absent from this
+ * 4.14-era PM framework. Resolve the DT node of an operating point by walking
+ * the device's "operating-points-v2" table and matching opp-hz instead.
+ */
+static struct device_node *__maybe_unused a6xx_opp_node_by_freq(struct device *dev,
+		unsigned long freq)
+{
+	struct device_node *tbl, *opp_np, *match = NULL;
+	u64 opp_freq;
+
+	tbl = of_parse_phandle(dev->of_node, "operating-points-v2", 0);
+	if (!tbl)
+		return NULL;
+
+	for (opp_np = of_get_next_available_child(tbl, NULL);
+			opp_np;
+			opp_np = of_get_next_available_child(tbl, opp_np)) {
+		if (of_property_read_u64(opp_np, "opp-hz", &opp_freq))
+			continue;
+
+		if (opp_freq != freq)
+			continue;
+
+		match = of_node_get(opp_np);
+		break;
+	}
+
+	return match;
+}
+
+/* Return the 'arc-level' for the given frequency */
+static u32 a6xx_gmu_get_arc_level(struct device *dev, unsigned long freq)
+{
+	struct dev_pm_opp *opp;
+	u32 val = 0;
+
+	if (!freq)
+		return 0;
+
+	opp  = dev_pm_opp_find_freq_exact(dev, freq, true);
+	if (IS_ERR(opp))
+		return 0;
+
+	/*
+	 * TEMPORARY experiment image 123 -- PROMOTE IF BW ACKS.
+	 * 4.14 has no dev_pm_opp_get_level()/opp->level (4.19+); the
+	 * downstream DT convention stores the RPMh ARC corner in
+	 * opp-microvolt, so dev_pm_opp_get_voltage() returns exactly the
+	 * existing OPP-attached level. No qcom,level, no invented values.
+	 */
+	val = (u32) dev_pm_opp_get_voltage(opp);
+
+	dev_pm_opp_put(opp);
+
+	return val;
+}
+
+static int a6xx_gmu_rpmh_arc_votes_init(struct device *dev, u32 *votes,
+		unsigned long *freqs, int freqs_count,
+		u16 *pri, int pri_count,
+		u16 *sec, int sec_count)
+{
+	int i, j;
+
+	/* Construct a vote for each frequency */
+	for (i = 0; i < freqs_count; i++) {
+		u8 pindex = 0, sindex = 0;
+		u32 level = a6xx_gmu_get_arc_level(dev, freqs[i]);
+
+		/* Get the primary index that matches the arc level */
+		for (j = 0; j < pri_count; j++) {
+			if (pri[j] >= level) {
+				pindex = j;
+				break;
+			}
+		}
+
+		if (j == pri_count) {
+			dev_err(dev,
+				"Level %u not found in in the RPMh list\n",
+					level);
+			dev_err(dev, "Available levels:\n");
+			for (j = 0; j < pri_count; j++)
+				dev_err(dev, "  %u\n", pri[j]);
+
+			return -EINVAL;
+		}
+
+		/*
+		 * Look for a level in in the secondary list that matches. If
+		 * nothing fits, use the maximum non zero vote
+		 */
+
+		for (j = 0; j < sec_count; j++) {
+			if (sec[j] >= level) {
+				sindex = j;
+				break;
+			} else if (sec[j]) {
+				sindex = j;
+			}
+		}
+
+		/* Construct the vote */
+		votes[i] = ((pri[pindex] & 0xffff) << 16) |
+			(sindex << 8) | pindex;
+		pr_info("ARC123: dev=%s freq=%lu level=%u vote=0x%08x\n",
+			dev_name(dev), freqs[i], level, votes[i]);
+	}
+
+	return 0;
+}
+
+/*
+ * The GMU votes with the RPMh for itself and on behalf of the GPU but we need
+ * to construct the list of votes on the CPU and send it over. Query the RPMh
+ * voltage levels and build the votes
+ */
+
+static int a6xx_gmu_rpmh_votes_init(struct a6xx_gmu *gmu)
+{
+	struct a6xx_gpu *a6xx_gpu = container_of(gmu, struct a6xx_gpu, gmu);
+	struct adreno_gpu *adreno_gpu = &a6xx_gpu->base;
+	struct msm_gpu *gpu = &adreno_gpu->base;
+
+	u16 gx[16], cx[16], mx[16];
+	u32 gxcount, cxcount, mxcount;
+	int ret;
+
+	/* Get the list of available voltage levels for each component */
+	gxcount = a6xx_gmu_rpmh_arc_cmds("gfx.lvl", gx, sizeof(gx));
+	cxcount = a6xx_gmu_rpmh_arc_cmds("cx.lvl", cx, sizeof(cx));
+	mxcount = a6xx_gmu_rpmh_arc_cmds("mx.lvl", mx, sizeof(mx));
+	pr_info("ARC123: cmd_db counts gfx.lvl=%u cx.lvl=%u mx.lvl=%u\n",
+		gxcount, cxcount, mxcount);
+
+	/* Build the GX votes */
+	ret = a6xx_gmu_rpmh_arc_votes_init(&gpu->pdev->dev, gmu->gx_arc_votes,
+		gmu->gpu_freqs, gmu->nr_gpu_freqs,
+		gx, gxcount, mx, mxcount);
+
+	/* Build the CX votes */
+	ret |= a6xx_gmu_rpmh_arc_votes_init(gmu->dev, gmu->cx_arc_votes,
+		gmu->gmu_freqs, gmu->nr_gmu_freqs,
+		cx, cxcount, mx, mxcount);
+
+	return ret;
+}
+
+static int a6xx_gmu_build_freq_table(struct device *dev, unsigned long *freqs,
+		u32 size)
+{
+	int count = dev_pm_opp_get_opp_count(dev);
+	struct dev_pm_opp *opp;
+	int i, index = 0;
+	unsigned long freq = 1;
+
+	/*
+	 * The OPP table doesn't contain the "off" frequency level so we need to
+	 * add 1 to the table size to account for it
+	 */
+
+	if (WARN(count + 1 > size,
+		"The GMU frequency table is being truncated\n"))
+		count = size - 1;
+
+	/* Set the "off" frequency */
+	freqs[index++] = 0;
+
+	for (i = 0; i < count; i++) {
+		opp = dev_pm_opp_find_freq_ceil(dev, &freq);
+		if (IS_ERR(opp))
+			break;
+
+		dev_pm_opp_put(opp);
+		freqs[index++] = freq++;
+	}
+
+	return index;
+}
+
+static int a6xx_gmu_pwrlevels_probe(struct a6xx_gmu *gmu)
+{
+	struct a6xx_gpu *a6xx_gpu = container_of(gmu, struct a6xx_gpu, gmu);
+	struct adreno_gpu *adreno_gpu = &a6xx_gpu->base;
+	struct msm_gpu *gpu = &adreno_gpu->base;
+
+	int ret = 0;
+
+	/*
+	 * The GMU handles its own frequency switching so build a list of
+	 * available frequencies to send during initialization
+	 */
+	ret = dev_pm_opp_of_add_table(gmu->dev);
+	pr_info("OPP121: GMU OPP probe ret=%d\n", ret);
+	if (ret) {
+		dev_err(gmu->dev, "Unable to set the OPP table for the GMU\n");
+		return ret;
+	}
+
+	gmu->nr_gmu_freqs = a6xx_gmu_build_freq_table(gmu->dev,
+		gmu->gmu_freqs, ARRAY_SIZE(gmu->gmu_freqs));
+
+	/*
+	 * The GMU also handles GPU frequency switching so build a list
+	 * from the GPU OPP table
+	 */
+	gmu->nr_gpu_freqs = a6xx_gmu_build_freq_table(&gpu->pdev->dev,
+		gmu->gpu_freqs, ARRAY_SIZE(gmu->gpu_freqs));
+
+	/* Build the list of RPMh votes that we'll send to the GMU */
+	/* TEMPORARY image 121 diagnostics -- REMOVE AFTER RESULT. */
+	{
+		int _i121;
+		for (_i121 = 0; _i121 < gmu->nr_gmu_freqs; _i121++)
+			pr_info("OPP121: gmu_freqs[%d]=%lu\n", _i121, gmu->gmu_freqs[_i121]);
+		for (_i121 = 0; _i121 < gmu->nr_gpu_freqs; _i121++)
+			pr_info("OPP121: gpu_freqs[%d]=%lu\n", _i121, gmu->gpu_freqs[_i121]);
+		pr_info("OPP121: nr_gmu_freqs=%d nr_gpu_freqs=%d entering rpmh_votes_init\n",
+			gmu->nr_gmu_freqs, gmu->nr_gpu_freqs);
+	}
+	ret = a6xx_gmu_rpmh_votes_init(gmu);
+	pr_info("OPP121: rpmh_votes_init ret=%d\n", ret);
+	pr_info("OPP122: gmudev=%s opp_probe_ret=0 nr_gmu_freqs=%d nr_gpu_freqs=%d rpmh_ret=%d\n",
+		dev_name(gmu->dev),
+		gmu->nr_gmu_freqs, gmu->nr_gpu_freqs, ret);
+	return ret;
+}
+
+static int a6xx_gmu_clocks_probe(struct a6xx_gmu *gmu)
+{
+	int ret = msm_clk_bulk_get(gmu->dev, &gmu->clocks);
+
+	if (ret < 1)
+		return ret;
+
+	gmu->nr_clocks = ret;
+
+	pr_info("A6XX_TRACE: GMU clocks: count=%d array=%zu bytes (%zu each)\n",
+		gmu->nr_clocks,
+		gmu->nr_clocks * sizeof(struct clk_bulk_data),
+		sizeof(struct clk_bulk_data));
+
+	gmu->core_clk = msm_clk_bulk_get_clock(gmu->clocks,
+		gmu->nr_clocks, "gmu");
+
+	return 0;
+}
