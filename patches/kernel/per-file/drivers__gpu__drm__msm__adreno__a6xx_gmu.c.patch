+bool a6xx_instr;
+module_param(a6xx_instr, bool, 0444);
+MODULE_PARM_DESC(a6xx_instr,
+	"1=arm post-success instruments (SHOTs, spinwatch; default off)");
+/*
+ * TEMPORARY image 178 -- PROMOTE IFF SURVIVAL EXTENDS. Halt the GMU
+ * firmware (CM3 SYSRESET) right after a successful bring-up, before
+ * slumber. If the firmware's autonomous post-boot activity (NoC
+ * floods/death throes/power games) is what destabilizes the system,
+ * a halted firmware can't do any of it; the GPU stays usable at
