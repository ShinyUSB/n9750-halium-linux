+/* Trigger a OOB (out of band) request to the GMU */
+int a6xx_gmu_set_oob(struct a6xx_gmu *gmu, enum a6xx_gmu_oob_state state)
+{
+	int ret;
+
+
+	u32 val;
+	int request, ack, clear;
+	const char *name;
+
+	/*
+	 * TEMPORARY experiment image 117 -- REMOVE OR PROMOTE ON RESULT.
+	 * Suppress async DCVS OOB doorbells while HFI bootstrap runs; the
+	 * resume's own post-bootstrap set_freq is unaffected (flag cleared).
+	 * Suppressed, not faked: no write, no poll, return 0 (all in-tree
+	 * DCVS callers ignore the result).
+	 */
+	if (state == GMU_OOB_DCVS_SET && a6xx_gmu_bootstrap_active) {
+		pr_info("GPU_DCVS deferred during GMU bootstrap\n");
+		return 0;
+	}
+
+	switch (state) {
+	case GMU_OOB_GPU_SET:
+		/*
+		 * IMAGE 225: select the interrupt vector by firmware
+		 * generation. gmu->legacy is true only for HFI v1; our A640
+		 * firmware reports HFI_VERSION=0x20000001 (v2.1), so we must
+		 * use the *_NEW bits. See a6xx_gmu.h for the full account.
+		 */
+		if (gmu->legacy) {
+			request = GMU_OOB_GPU_SET_REQUEST;
+			ack = GMU_OOB_GPU_SET_ACK;
+			clear = GMU_OOB_GPU_SET_CLEAR;
+		} else {
+			request = GMU_OOB_GPU_SET_REQUEST_NEW;
+			ack = GMU_OOB_GPU_SET_ACK_NEW;
+			clear = GMU_OOB_GPU_SET_CLEAR_NEW;
+		}
+		name = "GPU_SET";
+		break;
+	case GMU_OOB_BOOT_SLUMBER:
+		if (!gmu->legacy) {
+			/*
+			 * Upstream has no non-legacy mapping for
+			 * BOOT_SLUMBER and returns -EINVAL here. A640's
+			 * GMU is woken over HFI, not OOB. gfx_rail_on() is
+			 * legacy-only so this should be unreachable; if it
+			 * is, the GMU never saw the request.
+			 */
+			pr_info("OOB225: BOOT_SLUMBER is legacy-only, "
+				"HFI_VERSION=0x%08x -- skipping\n",
+				gmu_read(gmu, REG_A6XX_GMU_HFI_VERSION_INFO));
+			return 0;
+		}
+		request = GMU_OOB_BOOT_SLUMBER_REQUEST;
+		ack = GMU_OOB_BOOT_SLUMBER_ACK;
+		clear = GMU_OOB_BOOT_SLUMBER_CLEAR;
+		name = "BOOT_SLUMBER";
+		break;
+	case GMU_OOB_DCVS_SET:
+		if (!gmu->legacy) {
+			/* Frequency is set over HFI on v2.x; see header. */
+			pr_info("OOB225: DCVS_SET is legacy-only -- "
+				"skipping (HFI handles freq on v2.x)\n");
+			return 0;
+		}
+		request = GMU_OOB_DCVS_REQUEST;
+		ack = GMU_OOB_DCVS_ACK;
+		clear = GMU_OOB_DCVS_CLEAR;
+		name = "GPU_DCVS";
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	pr_info("OOB225 %s: legacy=%d SET_MASK=0x%x ACK_MASK=0x%x CLEAR_MASK=0x%x\n",
+		name, gmu->legacy, 1 << request, 1 << ack, 1 << clear);
+	/* Trigger the equested OOB operation */
+	gmu_write(gmu, REG_A6XX_GMU_HOST2GMU_INTR_SET, 1 << request);
+
+	pr_info("POST_START: oob %s ack-wait enter\n", name);
+	/* Wait for the acknowledge interrupt */
+	ret = gmu_poll_timeout(gmu, REG_A6XX_GMU_GMU2HOST_INTR_INFO, val,
+		val & (1 << ack), 100, 10000);
+	pr_info("POST_START: oob %s ack-wait %s (INTR_INFO=0x%x)\n", name,
+		ret ? "TIMEOUT" : "ok",
+		gmu_read(gmu, REG_A6XX_GMU_GMU2HOST_INTR_INFO));
+
+	if (ret)
+		dev_err(gmu->dev,
+			"Timeout waiting for GMU OOB set %s: 0x%x\n",
+				name,
+				gmu_read(gmu, REG_A6XX_GMU_GMU2HOST_INTR_INFO));
+
+	/*
+	 * TEMPORARY image 223 -- GMU LIVENESS, read where it MATTERS.
+	 *
+	 * The GVIT157 poller that was supposed to print this never fired
+	 * (image 222: armed, then silent for 120s), so read it inline here,
+	 * in a code path that demonstrably executes.
+	 *
+	 * REG_A6XX_GMU_HFI_VERSION_INFO (0x5181) is the GMU firmware's own
+	 * version handshake reply. Nothing host-side writes this register --
+	 * only the running GMU firmware does.
+	 *
+	 *   real version    -> GMU firmware IS running; the fault is in the
+	 *                      OOB/boot-slumber sequencing we use
+	 *   0x00000000      -> GMU firmware is NOT executing at all
+	 *   0xffffffff      -> GMU register block not responding (bus/MMIO)
+	 *
+	 * Dumped only on failure, so no cost on the happy path.
+	 */
+	if (ret)
+		pr_info("GMUDEAD[%s]: HFI_VERSION=0x%08x OOB_G2H_INFO=0x%08x OOB_G2H_MASK=0x%08x HOST2GMU_RAW=0x%08x HOST2GMU_SET=0x%08x GX_VOTE=0x%08x MX_VOTE=0x%08x SPTPRAC_PWR=0x%08x\n",
+			name,
+			gmu_read(gmu, REG_A6XX_GMU_HFI_VERSION_INFO),
+			gmu_read(gmu, REG_A6XX_GMU_GMU2HOST_INTR_INFO),
+			gmu_read(gmu, REG_A6XX_GMU_GMU2HOST_INTR_MASK),
+			gmu_read(gmu, REG_A6XX_GMU_HOST2GMU_INTR_RAW_INFO),
+			gmu_read(gmu, REG_A6XX_GMU_HOST2GMU_INTR_SET),
+			gmu_read(gmu, REG_A6XX_GMU_GX_VOTE_IDX),
+			gmu_read(gmu, REG_A6XX_GMU_MX_VOTE_IDX),
+			gmu_read(gmu, REG_A6XX_GMU_SPTPRAC_PWR_CLK_STATUS));
+
+	/* Clear the acknowledge interrupt */
+	gmu_write(gmu, REG_A6XX_GMU_GMU2HOST_INTR_CLR, 1 << ack);
+
+	pr_info("OOB132: set %s ret=%d\n", name, ret);
+	bc132("OOB_SET", ret);
+	return ret;
+}
+
+/* Clear a pending OOB state in the GMU */
+void a6xx_gmu_clear_oob(struct a6xx_gmu *gmu, enum a6xx_gmu_oob_state state)
+{
+	pr_info("OOB132: clear state=%d\n", state);
+	/* IMAGE 225: clear bit must match the request vector we rang. */
+	switch (state) {
+	case GMU_OOB_GPU_SET:
+		gmu_write(gmu, REG_A6XX_GMU_HOST2GMU_INTR_SET,
+			1 << (gmu->legacy ? GMU_OOB_GPU_SET_CLEAR :
+					   GMU_OOB_GPU_SET_CLEAR_NEW));
+		break;
+	case GMU_OOB_BOOT_SLUMBER:
+		gmu_write(gmu, REG_A6XX_GMU_HOST2GMU_INTR_SET,
+			1 << GMU_OOB_BOOT_SLUMBER_CLEAR);
+		break;
+	case GMU_OOB_DCVS_SET:
+		gmu_write(gmu, REG_A6XX_GMU_HOST2GMU_INTR_SET,
+			1 << GMU_OOB_DCVS_CLEAR);
+		break;
+	}
+}
+
+/*
+ * IMAGE 224 -- REAL FIX. Power on SPTPRAC instead of skipping it.
+ *
+ * Image 198 replaced this function with a no-op that just logged, because the
+ * poll timed out on every boot and bring-up never reached HFI. That "fix" is
+ * the reason nothing has ever been rendered.
+ *
+ * Why the poll always timed out: the port polled for the WRONG BIT.
+ *
+ *   REG_A6XX_GMU_SPTPRAC_PWR_CLK_STATUS (0x50d0) is not a pure status
+ *   register in this layout -- CAF writes it to COMMAND the power sequence:
+ *
+ *     0x01  SPTPRAC_GDSC_POWERING_OFF
+ *     0x02  SPTPRAC_GDSC_POWERING_ON   <- write this to start power-up
+ *     0x04  SPTPRAC_GDSC_POWER_ON      <- poll for THIS
+ *     0x08  SPTPRAC_GDSC_POWER_OFF     <- the old code polled for this
+ *
+ * The port polled BIT(3) = 0x08 = POWER_OFF, i.e. it waited for SPTPRAC to be
+ * switched OFF as a way of asking for it to come on. It could never succeed,
+ * so it always timed out, so image 198 made it a no-op, so SPTPRAC was never
+ * powered.
+ *
+ * The status we read confirms the consequence. The old 0xc0 decodes as:
+ *     0x40 = GX_HM_GDSC_POWER_OFF
+ *     0x80 = GX_HM_CLK_OFF
+ * i.e. the graphics hardware block is powered down, and SPTPRAC reads 0x0 --
+ * not powering on, not on, not off. The GMU firmware can answer plain MMIO
+ * (which is why HFI_VERSION=0x20000001 reads back fine) but cannot run its
+ * main loop without SPTPRAC. Hence: OOB requests unconsumed
+ * (HOST2GMU_RAW stays set), the GX vote written and immediately discarded
+ * (VOTE151 writes gx=0x9, readback 0x0), the GX clock domain never enabled
+ * (gpu_cc_gx_gmu_clk en=0), and therefore no blit and no render ever.
+ *
+ * This restores CAF's sequence.
+ */
+static int a6xx_sptprac_enable(struct a6xx_gmu *gmu)
+{
+	int ret;
+	u32 val;
+
+	/*
+	 * IMAGE 225: upstream's real sequence.
+	 *
+	 * Image 224 wrote POWERING_ON into SPTPRAC_PWR_CLK_STATUS (0x50d0),
+	 * which is why it read 0xc0 before AND after -- that register is
+	 * status-only and does not latch the write. The command goes to
+	 * REG_A6XX_GMU_GX_SPTPRAC_POWER_CONTROL (0x81), value 0x778000.
+	 *
+	 * The completion condition is also not a single bit: (val & 0x38)
+	 * == 0x28, i.e. SP_CLOCK_OFF clear and GMU_UP_POWER_STATE set.
+	 * Polling a single bit can pass on a half-finished power sequence.
+	 */
+	if (!gmu->legacy) {
+		/*
+		 * Upstream WARN_ONs here and only calls this under
+		 * `if (gmu->legacy)`. SPTPRAC on HFI v2.x is managed by the
+		 * GMU firmware itself; the host must not take it over.
+		 */
+		pr_info("SPTPRAC225: skipping, legacy=%d (GMU manages it on HFI v2.x)\n",
+			gmu->legacy);
+		return 0;
+	}
+
+	pr_info("SPTPRAC225: before PWR_CLK_STATUS=0x%x\n",
+		gmu_read(gmu, REG_A6XX_GMU_SPTPRAC_PWR_CLK_STATUS));
+
+	gmu_write(gmu, REG_A6XX_GMU_GX_SPTPRAC_POWER_CONTROL, 0x778000);
+
+	pr_info("SPTPRAC225: after request 0x778000 PWR_CLK_STATUS=0x%x\n",
+		gmu_read(gmu, REG_A6XX_GMU_SPTPRAC_PWR_CLK_STATUS));
+
+	ret = gmu_poll_timeout(gmu, REG_A6XX_GMU_SPTPRAC_PWR_CLK_STATUS, val,
+			(val & 0x38) == 0x28, 1, 100);
+
+	pr_info("SPTPRAC225: poll %s status=0x%x\n",
+		ret ? "TIMEOUT" : "ok",
+		gmu_read(gmu, REG_A6XX_GMU_SPTPRAC_PWR_CLK_STATUS));
+
+	if (ret)
+		dev_err(gmu->dev, "Unable to power on SPTPRAC: 0x%x\n",
+			gmu_read(gmu, REG_A6XX_GMU_SPTPRAC_PWR_CLK_STATUS));
+
+	/* CAF/upstream return 0 even on timeout; keep that. */
+	return 0;
+}
+
+/* Disable CPU control of SPTP power power collapse */
+static void a6xx_sptprac_disable(struct a6xx_gmu *gmu)
+{
+	u32 val;
+	int ret;
+
+	/* Make sure retention is on */
+	gmu_rmw(gmu, REG_A6XX_GPU_CC_GX_GDSCR, 0, (1 << 11));
+
+	gmu_write(gmu, REG_A6XX_GMU_GX_SPTPRAC_POWER_CONTROL, 0x778001);
+
+	ret = gmu_poll_timeout(gmu, REG_A6XX_GMU_SPTPRAC_PWR_CLK_STATUS, val,
+		(val & 0x04), 100, 10000);
+
+	if (ret)
+		dev_err(gmu->dev, "failed to power off SPTPRAC: 0x%x\n",
+			gmu_read(gmu, REG_A6XX_GMU_SPTPRAC_PWR_CLK_STATUS));
+}
+
+/* Let the GMU know we are starting a boot sequence */
+static int a6xx_gmu_gfx_rail_on(struct a6xx_gmu *gmu)
+{
+	u32 vote;
+
+	/* Let the GMU know we are getting ready for boot */
+	gmu_write(gmu, REG_A6XX_GMU_BOOT_SLUMBER_OPTION, 0);
+
+	/* Choose the "default" power level as the highest available */
+	vote = gmu->gx_arc_votes[gmu->nr_gpu_freqs - 1];
+
+	gmu_write(gmu, REG_A6XX_GMU_GX_VOTE_IDX, vote & 0xff);
+	gmu_write(gmu, REG_A6XX_GMU_MX_VOTE_IDX, (vote >> 8) & 0xff);
+
+	/* Let the GMU know the boot sequence has started */
+	return a6xx_gmu_set_oob(gmu, GMU_OOB_BOOT_SLUMBER);
+}
+
+/* Let the GMU know that we are about to go into slumber */
+static int a6xx_gmu_notify_slumber(struct a6xx_gmu *gmu)
+{
+	int ret;
+
+	/* Disable the power counter so the GMU isn't busy */
+	gmu_write(gmu, REG_A6XX_GMU_CX_GMU_POWER_COUNTER_ENABLE, 0);
+
+	/* Disable SPTP_PC if the CPU is responsible for it */
+	if (gmu->idle_level < GMU_IDLE_STATE_SPTP)
+		a6xx_sptprac_disable(gmu);
+
+	/*
+	 * TEMPORARY image 170 -- PROMOTE with the slumber lifecycle.
+	 * Nonlegacy firmware takes PREPARE_SLUMBER over HFI (upstream);
+	 * try it first, then the legacy OOB dance regardless
+	 * (belt and suspenders; the 0x0f check below judges).
+	 */
+	if (experimental_nonlegacy) {
+		ret = a6xx_hfi_send_prep_slumber(gmu);
+		if (a6xx_instr)
+			pr_info("SLUM170: prep_slumber HFI ret=%d\n", ret);
+	}
+
+	/* Tell the GMU to get ready to slumber */
+	gmu_write(gmu, REG_A6XX_GMU_BOOT_SLUMBER_OPTION, 1);
+
+	ret = a6xx_gmu_set_oob(gmu, GMU_OOB_BOOT_SLUMBER);
+	a6xx_gmu_clear_oob(gmu, GMU_OOB_BOOT_SLUMBER);
+
+	if (!ret) {
+		/* Check to see if the GMU really did slumber */
+		if (gmu_read(gmu, REG_A6XX_GPU_GMU_CX_GMU_RPMH_POWER_STATE)
+			!= 0x0f) {
+			dev_err(gmu->dev, "The GMU did not go into slumber\n");
+			ret = -ETIMEDOUT;
+		}
+	}
+
+	/* Put fence into allow mode */
+	gmu_write(gmu, REG_A6XX_GMU_AO_AHB_FENCE_CTRL, 0);
+	return ret;
+}
+
+static int a6xx_rpmh_start(struct a6xx_gmu *gmu)
+{
+	int ret;
+	u32 val;
+
+	pr_info("RPMH132: rpmh_start enter\n");
+	gmu_write(gmu, REG_A6XX_GMU_RSCC_CONTROL_REQ, 1 << 1);
+	/* Wait for the register to finish posting */
+	wmb();
+
+	ret = gmu_poll_timeout(gmu, REG_A6XX_GMU_RSCC_CONTROL_ACK, val,
+		val & (1 << 1), 100, 10000);
+	if (ret) {
+		dev_err(gmu->dev, "Unable to power on the GPU RSC\n");
+		return ret;
+	}
+
+	ret = gmu_poll_timeout(gmu, REG_A6XX_RSCC_SEQ_BUSY_DRV0, val,
+		!val, 100, 10000);
+
+	if (!ret) {
+		gmu_write(gmu, REG_A6XX_GMU_RSCC_CONTROL_REQ, 0);
+
+		/* Re-enable the power counter */
+		gmu_write(gmu, REG_A6XX_GMU_CX_GMU_POWER_COUNTER_ENABLE, 1);
+		pr_info("RPMH132: rpmh_start ret=0 (TCS handshake ok)\n");
+		return 0;
+	}
+
+	dev_err(gmu->dev, "GPU RSC sequence stuck while waking up the GPU\n");
+	pr_info("RPMH132: rpmh_start TIMEOUT ret=%d\n", ret);
+	return ret;
+}
+
+static void a6xx_rpmh_stop(struct a6xx_gmu *gmu)
+{
+	int ret;
+	u32 val;
+
+	gmu_write(gmu, REG_A6XX_GMU_RSCC_CONTROL_REQ, 1);
+
+	ret = gmu_poll_timeout(gmu, REG_A6XX_GPU_RSCC_RSC_STATUS0_DRV0,
+		val, val & (1 << 16), 100, 10000);
+	if (ret)
+		dev_err(gmu->dev, "Unable to power off the GPU RSC\n");
+
+	gmu_write(gmu, REG_A6XX_GMU_RSCC_CONTROL_REQ, 0);
+}
+
+static void a6xx_gmu_rpmh_init(struct a6xx_gmu *gmu)
+{
+	pr_info("RPMH132: rpmh_init enter\n");
+	A6XX_TRACE("PRE_PDCSEQ mmio=%px pdc_mmio=%px seq_mmio=%px",
+		gmu->mmio, gmu->pdc_mmio, gmu->seq_mmio);
+	/* Disable SDE clock gating */
+	gmu_write(gmu, REG_A6XX_GPU_RSCC_RSC_STATUS0_DRV0, BIT(24));
+
+	/* Setup RSC PDC handshake for sleep and wakeup */
+	gmu_write(gmu, REG_A6XX_RSCC_PDC_SLAVE_ID_DRV0, 1);
+	gmu_write(gmu, REG_A6XX_RSCC_HIDDEN_TCS_CMD0_DATA, 0);
+	gmu_write(gmu, REG_A6XX_RSCC_HIDDEN_TCS_CMD0_ADDR, 0);
+	gmu_write(gmu, REG_A6XX_RSCC_HIDDEN_TCS_CMD0_DATA + 2, 0);
+	gmu_write(gmu, REG_A6XX_RSCC_HIDDEN_TCS_CMD0_ADDR + 2, 0);
+	gmu_write(gmu, REG_A6XX_RSCC_HIDDEN_TCS_CMD0_DATA + 4, 0x80000000);
+	gmu_write(gmu, REG_A6XX_RSCC_HIDDEN_TCS_CMD0_ADDR + 4, 0);
+	gmu_write(gmu, REG_A6XX_RSCC_OVERRIDE_START_ADDR, 0);
+	gmu_write(gmu, REG_A6XX_RSCC_PDC_SEQ_START_ADDR, 0x4520);
+	gmu_write(gmu, REG_A6XX_RSCC_PDC_MATCH_VALUE_LO, 0x4510);
+	gmu_write(gmu, REG_A6XX_RSCC_PDC_MATCH_VALUE_HI, 0x4514);
+
+	/* Load RSC sequencer uCode for sleep and wakeup */
+	gmu_write(gmu, REG_A6XX_RSCC_SEQ_MEM_0_DRV0, 0xa7a506a0);
+	gmu_write(gmu, REG_A6XX_RSCC_SEQ_MEM_0_DRV0 + 1, 0xa1e6a6e7);
+	gmu_write(gmu, REG_A6XX_RSCC_SEQ_MEM_0_DRV0 + 2, 0xa2e081e1);
+	gmu_write(gmu, REG_A6XX_RSCC_SEQ_MEM_0_DRV0 + 3, 0xe9a982e2);
+	gmu_write(gmu, REG_A6XX_RSCC_SEQ_MEM_0_DRV0 + 4, 0x0020e8a8);
+
+	/*
+	 * Load PDC sequencer uCode for power up and power down sequence.
+	 *
+	 * Region-relative offsets, verified against working vendor KGSL
+	 * (a6xx_reg.h: PDC_GPU_SEQ_MEM_0 = 0x0) and upstream v5.8
+	 * (pdc_write(seqptr, SEQ_MEM_0, ...)).
+	 *
+	 * The transplanted v4.19 XML defines REG_A6XX_PDC_GPU_SEQ_MEM_0 as
+	 * 0xa0000 (block-relative within a combined PDC aperture this DT does
+	 * not provide). Samsung splits PDC into 64KB cfg (0xb290000, v2) +
+	 * 64KB seq (0xb490000, v2); KGSL writes SEQ_MEM at seq+0x0.
+	 * Using the XML value here targets seq+0x280000, far beyond the
+	 * 0x10000 mapping -- this was the image 78 data abort.
+	 */
+	pdcseq_write(gmu, 0x0, 0xfebea1e1);
+	pdcseq_write(gmu, 0x0 + 1, 0xa5a4a3a2);
+	pdcseq_write(gmu, 0x0 + 2, 0x8382a6e0);
+	pdcseq_write(gmu, 0x0 + 3, 0xbce3e284);
+	pdcseq_write(gmu, 0x0 + 4, 0x002081fc);
+
+	/*
+	 * Set TCS commands used by PDC sequence for low power modes.
+	 *
+	 * All target the cfg (pdc) region per upstream v5.8 (pdcptr) and vendor
+	 * KGSL (_regwrite(cfg, ...)). Offsets are region-relative: the v4.19
+	 * XML values are block-relative (ours = KGSL + 0x20000, e.g. 0x21573
+	 * vs 0x1573), so subtract the 0x20000 cfg-block prefix to fit the
+	 * 64KB cfg window (0xb290000 v2). Without this every TCS write lands
+	 * at cfg+0x855cc, beyond the mapping -- same fault class as SEQ_MEM.
+	 * TCS*_CMD0_ADDR+8 = 0x30090 for A640 per v5.8 pdc_address_offset
+	 * and KGSL (v4.19 used 0x30080 for older GPUs).
+	 */
+	pdc_write(gmu->pdc_mmio, ( REG_A6XX_PDC_GPU_TCS1_CMD_ENABLE_BANK - 0x20000 ), 7);
+	pdc_write(gmu->pdc_mmio, ( REG_A6XX_PDC_GPU_TCS1_CMD_WAIT_FOR_CMPL_BANK - 0x20000 ), 0);
+	pdc_write(gmu->pdc_mmio, ( REG_A6XX_PDC_GPU_TCS1_CONTROL - 0x20000 ), 0);
+	pdc_write(gmu->pdc_mmio, ( REG_A6XX_PDC_GPU_TCS1_CMD0_MSGID - 0x20000 ), 0x10108);
+	pdc_write(gmu->pdc_mmio, ( REG_A6XX_PDC_GPU_TCS1_CMD0_ADDR - 0x20000 ), 0x30010);
+	pdc_write(gmu->pdc_mmio, ( REG_A6XX_PDC_GPU_TCS1_CMD0_DATA - 0x20000 ), 1);
+	pdc_write(gmu->pdc_mmio, ( REG_A6XX_PDC_GPU_TCS1_CMD0_MSGID - 0x20000 ) + 4, 0x10108);
+	pdc_write(gmu->pdc_mmio, ( REG_A6XX_PDC_GPU_TCS1_CMD0_ADDR - 0x20000 ) + 4, 0x30000);
+	pdc_write(gmu->pdc_mmio, ( REG_A6XX_PDC_GPU_TCS1_CMD0_DATA - 0x20000 ) + 4, 0x0);
+	pdc_write(gmu->pdc_mmio, ( REG_A6XX_PDC_GPU_TCS1_CMD0_MSGID - 0x20000 ) + 8, 0x10108);
+	pdc_write(gmu->pdc_mmio, ( REG_A6XX_PDC_GPU_TCS1_CMD0_ADDR - 0x20000 ) + 8, 0x30090 /* A640 */);
+	pdc_write(gmu->pdc_mmio, ( REG_A6XX_PDC_GPU_TCS1_CMD0_DATA - 0x20000 ) + 8, 0x0);
+	pdc_write(gmu->pdc_mmio, ( REG_A6XX_PDC_GPU_TCS3_CMD_ENABLE_BANK - 0x20000 ), 7);
+	pdc_write(gmu->pdc_mmio, ( REG_A6XX_PDC_GPU_TCS3_CMD_WAIT_FOR_CMPL_BANK - 0x20000 ), 0);
+	pdc_write(gmu->pdc_mmio, ( REG_A6XX_PDC_GPU_TCS3_CONTROL - 0x20000 ), 0);
+	pdc_write(gmu->pdc_mmio, ( REG_A6XX_PDC_GPU_TCS3_CMD0_MSGID - 0x20000 ), 0x10108);
+	pdc_write(gmu->pdc_mmio, ( REG_A6XX_PDC_GPU_TCS3_CMD0_ADDR - 0x20000 ), 0x30010);
+	pdc_write(gmu->pdc_mmio, ( REG_A6XX_PDC_GPU_TCS3_CMD0_DATA - 0x20000 ), 2);
+	pdc_write(gmu->pdc_mmio, ( REG_A6XX_PDC_GPU_TCS3_CMD0_MSGID - 0x20000 ) + 4, 0x10108);
+	pdc_write(gmu->pdc_mmio, ( REG_A6XX_PDC_GPU_TCS3_CMD0_ADDR - 0x20000 ) + 4, 0x30000);
+	pdc_write(gmu->pdc_mmio, ( REG_A6XX_PDC_GPU_TCS3_CMD0_DATA - 0x20000 ) + 4, 0x3);
+	pdc_write(gmu->pdc_mmio, ( REG_A6XX_PDC_GPU_TCS3_CMD0_MSGID - 0x20000 ) + 8, 0x10108);
+	pdc_write(gmu->pdc_mmio, ( REG_A6XX_PDC_GPU_TCS3_CMD0_ADDR - 0x20000 ) + 8, 0x30090 /* A640 per v5.8/KGSL */);
+	pdc_write(gmu->pdc_mmio, ( REG_A6XX_PDC_GPU_TCS3_CMD0_DATA - 0x20000 ) + 8, 0x3);
+
+	/* Setup GPU PDC */
+	pdc_write(gmu->pdc_mmio, ( REG_A6XX_PDC_GPU_SEQ_START_ADDR - 0x20000 ), 0); /* cfg per v5.8/KGSL; was pdcseq_write with block-relative const */
+	pdc_write(gmu->pdc_mmio, ( REG_A6XX_PDC_GPU_ENABLE_PDC - 0x20000 ), 0x80000001);
+
+	/* ensure no writes happen before the uCode is fully written */
+	wmb();
+}
+
+/*
+ * The lowest 16 bits of this value are the number of XO clock cycles for main
+ * hysteresis which is set at 0x1680 cycles (300 us).  The higher 16 bits are
+ * for the shorter hysteresis that happens after main - this is 0xa (.5 us)
+ */
+
+#define GMU_PWR_COL_HYST 0x000a1680
+
+/* Set up the idle state for the GMU */
+static void a6xx_gmu_power_config(struct a6xx_gmu *gmu)
+{
+	/* Disable GMU WB/RB buffer */
+	gmu_write(gmu, REG_A6XX_GMU_SYS_BUS_CONFIG, 0x1);
+
+	/*
+	 * TEMPORARY bring-up experiment -- REMOVE OR PROMOTE ON RESULT.
+	 * Upstream v5.8 enables the GMU caches here; our port never did.
+	 * Offsets converted from vendor KGSL byte offsets
+	 * (0x1F400/0x1F401 - gmu2gpu_offset 0x1A800 = 0x4C00/0x4C01),
+	 * cross-checked against GENERAL_7 which matches exactly.
+	 */
+	A6XX_TRACE("before ICACHE_CONFIG write (value=0x1)");
+	gmu_write(gmu, REG_A6XX_GMU_ICACHE_CONFIG, 0x1);
+	A6XX_TRACE("after ICACHE_CONFIG write");
+	A6XX_TRACE("before DCACHE_CONFIG write (value=0x1)");
+	gmu_write(gmu, REG_A6XX_GMU_DCACHE_CONFIG, 0x1);
+	A6XX_TRACE("after DCACHE_CONFIG write");
+
+	gmu_write(gmu, REG_A6XX_GMU_PWR_COL_INTER_FRAME_CTRL, 0x9c40400);
+
+	switch (gmu->idle_level) {
+	case GMU_IDLE_STATE_IFPC:
+		gmu_write(gmu, REG_A6XX_GMU_PWR_COL_INTER_FRAME_HYST,
+			GMU_PWR_COL_HYST);
+		gmu_rmw(gmu, REG_A6XX_GMU_PWR_COL_INTER_FRAME_CTRL, 0,
+			A6XX_GMU_PWR_COL_INTER_FRAME_CTRL_IFPC_ENABLE |
+			A6XX_GMU_PWR_COL_INTER_FRAME_CTRL_HM_POWER_COLLAPSE_ENABLE);
+		/* Fall through */
+	case GMU_IDLE_STATE_SPTP:
+		gmu_write(gmu, REG_A6XX_GMU_PWR_COL_SPTPRAC_HYST,
+			GMU_PWR_COL_HYST);
+		gmu_rmw(gmu, REG_A6XX_GMU_PWR_COL_INTER_FRAME_CTRL, 0,
+			A6XX_GMU_PWR_COL_INTER_FRAME_CTRL_IFPC_ENABLE |
+			A6XX_GMU_PWR_COL_INTER_FRAME_CTRL_SPTPRAC_POWER_CONTROL_ENABLE);
+	}
+
+	/* Enable RPMh GPU client */
+	gmu_rmw(gmu, REG_A6XX_GMU_RPMH_CTRL, 0,
+		A6XX_GMU_RPMH_CTRL_RPMH_INTERFACE_ENABLE |
+		A6XX_GMU_RPMH_CTRL_LLC_VOTE_ENABLE |
+		A6XX_GMU_RPMH_CTRL_DDR_VOTE_ENABLE |
+		A6XX_GMU_RPMH_CTRL_MX_VOTE_ENABLE |
+		A6XX_GMU_RPMH_CTRL_CX_VOTE_ENABLE |
+		A6XX_GMU_RPMH_CTRL_GFX_VOTE_ENABLE);
+	pr_info("RPMH132: rpmh_init done (RPMH_CTRL=0x%x)\n",
+		gmu_read(gmu, REG_A6XX_GMU_RPMH_CTRL));
+}
+
+void a6xx_gmu_dump_mmio(struct platform_device *pdev,
+		struct a6xx_gmu *gmu, const char *when)
+{
+	static const char *names[] = {
+		"kgsl_gmu_reg", "kgsl_gmu_pdc_cfg", "kgsl_gmu_pdc_seq"
+	};
+	void __iomem *ptrs[3] = { gmu->mmio, gmu->pdc_mmio, gmu->seq_mmio };
+	int i;
+
+	for (i = 0; i < 3; i++) {
+		struct resource *res = platform_get_resource_byname(pdev,
+				IORESOURCE_MEM, names[i]);
+
+		if (res)
+			A6XX_TRACE("%s %s=%px res start=%pa end=%pa size=%pa flags=%lx",
+				when, names[i], ptrs[i], &res->start, &res->end,
+				&(resource_size_t){ resource_size(res) },
+				res->flags);
+		else
+			A6XX_TRACE("%s %s=%px res MISSING", when, names[i],
+				ptrs[i]);
+	}
+}
+
+static int a6xx_rpmh_start(struct a6xx_gmu *gmu);
+static int a6xx_gmu_fw_load(struct a6xx_gmu *gmu);
+
+static int a6xx_gmu_fw_start(struct a6xx_gmu *gmu, unsigned int state)
+{
+	static bool rpmh_init;
+	struct a6xx_gpu *a6xx_gpu = container_of(gmu, struct a6xx_gpu, gmu);
+	struct adreno_gpu *adreno_gpu = &a6xx_gpu->base;
+	int ret;
+	u32 chipid;
+
+	if (state == GMU_WARM_BOOT) {
+		ret = a6xx_rpmh_start(gmu);
+		if (ret)
+			return ret;
+	} else {
+		/* Turn on register retention */
+		gmu_write(gmu, REG_A6XX_GMU_GENERAL_7, 1);
+
+		/* We only need to load the RPMh microcode once */
+		if (!rpmh_init) {
+			{
+				struct device_node *pr_n =
+					of_node_get(gmu->dev->of_node);
+				struct platform_device *pr_p =
+					of_find_device_by_node(pr_n);
+				of_node_put(pr_n);
+				if (pr_p) {
+					a6xx_gmu_dump_mmio(pr_p, gmu, "PRE_RPMH");
+					put_device(&pr_p->dev);
+				} else {
+					A6XX_TRACE("PRE_RPMH pdev unresolved");
+				}
+			}
+			a6xx_gmu_rpmh_init(gmu);
+			rpmh_init = true;
+		} else if (state != GMU_RESET) {
+			ret = a6xx_rpmh_start(gmu);
+			if (ret)
+				return ret;
+		}
+
+		/*
+		 * Load the GMU firmware. A618/A630 take the legacy flat-ITCM
+		 * path (which enforces its 0x8000 cap); A640 takes the block
+		 * path, which has no such cap.
+		 */
+		ret = a6xx_gmu_fw_load(gmu);
+		if (ret)
+			return ret;
+
+		/*
+		 * TEMPORARY image 202 -- barrier between the firmware load and
+		 * the CM3_SYSRESET release further down this function.
+		 *
+		 * gmu_write_bulk() (the ITCM/DTCM path) already ends in wmb().
+		 * The fw_block_mem() path (icache/dcache) is a plain memcpy()
+		 * into normal memory and had NO barrier after it anywhere
+		 * before gmu_write(CM3_SYSRESET, 0).
+		 *
+		 * The CM3 is released by an MMIO (Device memory) store. Without
+		 * a barrier the Normal-memory stores holding the firmware are
+		 * not ordered before it, so the CM3 can be released while its
+		 * instruction image is still in this CPU's store buffer. Same
+		 * ordering class as images 195 and 200; this is the third and
+		 * last instance, on the load path.
+		 *
+		 * Redundant once alloc_fixed is coherent, but free and correct.
+		 */
+		wmb();
+
+	a6xx_gmu_scratch_check(gmu, "post-fw_load");
+	}
+
+	gmu_write(gmu, REG_A6XX_GMU_CM3_FW_INIT_RESULT, 0);
+	gmu_write(gmu, REG_A6XX_GMU_CM3_BOOT_CONFIG, 0x02);
+
+	/* Write the iova of the HFI table */
+	gmu_write(gmu, REG_A6XX_GMU_HFI_QTBL_ADDR, gmu->hfi->iova);
+	gmu_write(gmu, REG_A6XX_GMU_HFI_QTBL_INFO, 1);
+
+	/*
+	 * TEMPORARY experiment image 98 -- REMOVE OR PROMOTE ON RESULT.
+	 * Vendor KGSL GMU_FENCE_RANGE_MASK = 0x80A008A0; v5.8/ours used
+	 * 0x802800A0. Single-value change, ordering untouched.
+	 */
+	A6XX_TRACE("FENCE_RANGE_0 write (value=0x80A008A0)");
+	gmu_write(gmu, REG_A6XX_GMU_AHB_FENCE_RANGE_0,
+		(0x1 << 31) | ((0xA << 2) << 18) | (0x8A0));
+
+	chipid = adreno_gpu->rev.core << 24;
+	chipid |= adreno_gpu->rev.major << 16;
+	chipid |= adreno_gpu->rev.minor << 12;
+	chipid |= adreno_gpu->rev.patchid << 8;
+
+	gmu_write(gmu, REG_A6XX_GMU_HFI_SFR_ADDR, chipid);
+
+	/*
+	 * TEMPORARY experiment image 102 -- REMOVE OR PROMOTE ON RESULT.
+	 * CP_MSG = log.iova | (log.size/4K - 1), exactly as upstream v5.8
+	 * and vendor KGSL. With a 4 KiB log this evaluates to 0x60006000.
+	 */
+	A6XX_TRACE("before CP_MSG write (value=0x%llx)",
+		(unsigned long long)(gmu->log->iova | (gmu->log->size / SZ_4K - 1)));
+	gmu_write(gmu, REG_A6XX_GPU_GMU_CX_GMU_PWR_COL_CP_MSG,
+		gmu->log->iova | (gmu->log->size / SZ_4K - 1));
+	A6XX_TRACE("after CP_MSG write, readback=0x%x",
+		gmu_read(gmu, REG_A6XX_GPU_GMU_CX_GMU_PWR_COL_CP_MSG));
+
+	/*
+	 * CM3 boot correctness, matching vendor KGSL a6xx_gmu_fw_start()
+	 * exactly in ordering: QTBL regs -> FENCE -> CM3_CFG -> SFR ->
+	 * power_config -> gmu_start -> gfx_rail_on -> sptprac -> hfi_start.
+	 *
+	 * KGSL comment: snapshot changes the NMI bit; if GMU boots with NMI
+	 * set it jumps straight to the NMI handler and never executes
+	 * __main. 0x4052 puts CM3 back to its reset state before boot.
+	 * Without this the GMU runs unintended code and reads unintended
+	 * addresses -> the SMMU read faults seen at odd varying IOVAs.
+	 */
+	A6XX_TRACE("before CM3_CFG write (value=0x4052)");
+	gmu_write(gmu, REG_A6XX_GMU_CM3_CFG, 0x4052);
+	A6XX_TRACE("after CM3_CFG write");
+
+	/* Set up the lowest idle level on the GMU */
+	a6xx_gmu_power_config(gmu);
+	a6xx_gmu_scratch_check(gmu, "post-power_config");
+
+	A6XX_TRACE("before GMU start");
+	/*
+	 * TEMPORARY readback -- REMOVE WITH READBACK CODE. Verifies what the
+	 * GMU actually sees: every host-written value read back, plus CP_MSG
+	 * (never written; exposes reset value) and the HFI/icache/dcache
+	 * buffer heads from host RAM (ITCM/DTCM have no host copy and no
+	 * known-safe MMIO read path, so they are verified statically from
+	 * the blob + loader audit instead).
+	 */
+	A6XX_TRACE("RB QTBL_ADDR=0x%x (expect 0x%llx)",
+		gmu_read(gmu, REG_A6XX_GMU_HFI_QTBL_ADDR),
+		(unsigned long long)(gmu->hfi ? gmu->hfi->iova : ~0ULL));
+	A6XX_TRACE("RB QTBL_INFO=0x%x (expect 1)",
+		gmu_read(gmu, REG_A6XX_GMU_HFI_QTBL_INFO));
+	A6XX_TRACE("RB SFR_ADDR=0x%x BOOT_CONFIG=0x%x CM3_CFG=0x%x GENERAL_7=0x%x",
+		gmu_read(gmu, REG_A6XX_GMU_HFI_SFR_ADDR),
+		gmu_read(gmu, REG_A6XX_GMU_CM3_BOOT_CONFIG),
+		gmu_read(gmu, REG_A6XX_GMU_CM3_CFG),
+		gmu_read(gmu, REG_A6XX_GMU_GENERAL_7));
+	A6XX_TRACE("RB CP_MSG=0x%x (img102: written value)",
+		gmu_read(gmu, REG_A6XX_GPU_GMU_CX_GMU_PWR_COL_CP_MSG));
+	if (gmu->hfi && gmu->hfi->virt) {
+		u32 *hv = gmu->hfi->virt;
+		int qi;
+		A6XX_TRACE("RB hfi[0..3]=%08x %08x %08x %08x",
+			hv[0], hv[1], hv[2], hv[3]);
+		for (qi = 0; qi < 4; qi++) {
+			u32 *qh = hv + 6 + qi * 12;
+			A6XX_TRACE("RB q%d status=%u type=0x%x iova=0x%x size=0x%x idx=%u/%u",
+				qi, qh[0], qh[2], qh[1], qh[3], qh[10], qh[11]);
+		}
+	}
+	if (gmu->icache && gmu->icache->virt)
+		A6XX_TRACE("RB icache[0..3]=%08x %08x %08x %08x",
+			((u32 *)gmu->icache->virt)[0], ((u32 *)gmu->icache->virt)[1],
+			((u32 *)gmu->icache->virt)[2], ((u32 *)gmu->icache->virt)[3]);
+	if (gmu->dcache && gmu->dcache->virt)
+		A6XX_TRACE("RB dcache[0..3]=%08x %08x %08x %08x",
+			((u32 *)gmu->dcache->virt)[0], ((u32 *)gmu->dcache->virt)[1],
+			((u32 *)gmu->dcache->virt)[2], ((u32 *)gmu->dcache->virt)[3]);
+	ret = a6xx_gmu_start(gmu);
+	A6XX_TRACE("after GMU start (ret=%d)", ret);
+	if (ret)
+		return ret;
+
+	/*
+	 * TEMPORARY experiment image 105 -- REMOVE OR PROMOTE ON RESULT.
+	 * Upstream v5.8 runs gfx_rail_on() ONLY when gmu->legacy; our A640
+	 * (legacy=false) wrongly executed it, and its BOOT_SLUMBER OOB has
+	 * no ack on the HFI-v2 path. sptprac keeps the upstream idle-level
+	 * guard unchanged (v5.8 runs it for A640 too).
+	 */
+	pr_info("POST_START: legacy=%d\n", gmu->legacy);
+	if (gmu->legacy) {
+		pr_info("POST_START: entering gfx_rail_on\n");
+		ret = a6xx_gmu_gfx_rail_on(gmu);
+		pr_info("POST_START: gfx_rail_on returned ret=%d\n", ret);
+		if (ret)
+			return ret;
+	} else {
+		/*
+		 * TEMPORARY image 151 -- PROMOTE IF STICKY. The legacy skip
+		 * threw out the vote-idx writes with the un-acked OOB. Do the
+		 * writes (plain MMIO, no ack needed), skip only the OOB.
+		 * Guarded: without OPP data there is no vote to cast.
+		 */
+		if (gmu->nr_gpu_freqs > 0) {
+			u32 vote = gmu->gx_arc_votes[gmu->nr_gpu_freqs - 1];
+
+			gmu_write(gmu, REG_A6XX_GMU_BOOT_SLUMBER_OPTION, 0);
+			gmu_write(gmu, REG_A6XX_GMU_GX_VOTE_IDX, vote & 0xff);
+			gmu_write(gmu, REG_A6XX_GMU_MX_VOTE_IDX,
+				(vote >> 8) & 0xff);
+			pr_info("VOTE151: gx=0x%x mx=0x%x (writes only, no OOB)\n",
+				vote & 0xff, (vote >> 8) & 0xff);
+		} else {
+			pr_info("VOTE151: skipped, no OPP data (nr_gpu_freqs=0)\n");
+		}
+	}
+
+	/* Enable SPTP_PC if the CPU is responsible for it */
+	pr_info("POST_START: enter sptprac_enable (idle=%d, threshold=%d)\n",
+		gmu->idle_level, GMU_IDLE_STATE_SPTP);
+	if (gmu->idle_level < GMU_IDLE_STATE_SPTP) {
+		/*
+		 * NOTE: a6xx_sptprac_enable() always returns 0 even when its
+		 * poll times out -- it logs "sptprac poll TIMEOUT" and returns
+		 * success. So ret here is 0 and the old `if (ret) return ret;`
+		 * was already dead code. An image-194 experiment that tried to
+		 * make this non-fatal was therefore a no-op and has been reverted.
+		 * The real -110 comes from a6xx_gmu_hfi_vote_probe() below.
+		 */
+		ret = a6xx_sptprac_enable(gmu);
+		if (ret)
+			return ret;
+	}
+
+	pr_info("POST_START: entering hfi_start\n");
+	ret = a6xx_gmu_hfi_start(gmu);
+	pr_info("POST_START: hfi_start returned ret=%d\n", ret);
+	if (ret)
+		return ret;
+
+	/* FIXME: Do we need this wmb() here? */
+	wmb();
+
+	return 0;
+}
+
+#define A6XX_HFI_IRQ_MASK \
+	(A6XX_GMU_GMU2HOST_INTR_INFO_MSGQ | \
+	 A6XX_GMU_GMU2HOST_INTR_INFO_CM3_FAULT)
+
+#define A6XX_GMU_IRQ_MASK \
+	(A6XX_GMU_AO_HOST_INTERRUPT_STATUS_WDOG_BITE | \
+	 A6XX_GMU_AO_HOST_INTERRUPT_STATUS_HOST_AHB_BUS_ERROR | \
+	 A6XX_GMU_AO_HOST_INTERRUPT_STATUS_FENCE_ERR)
+
+static void a6xx_gmu_irq_enable(struct a6xx_gmu *gmu)
+{
+	gmu_write(gmu, REG_A6XX_GMU_AO_HOST_INTERRUPT_CLR, ~0);
+	gmu_write(gmu, REG_A6XX_GMU_GMU2HOST_INTR_CLR, ~0);
+
+	gmu_write(gmu, REG_A6XX_GMU_AO_HOST_INTERRUPT_MASK,
+		~A6XX_GMU_IRQ_MASK);
+	gmu_write(gmu, REG_A6XX_GMU_GMU2HOST_INTR_MASK,
+		~A6XX_HFI_IRQ_MASK);
+
+	enable_irq(gmu->gmu_irq);
+	enable_irq(gmu->hfi_irq);
+}
+
+static void a6xx_gmu_irq_disable(struct a6xx_gmu *gmu)
+{
+	disable_irq(gmu->gmu_irq);
+	disable_irq(gmu->hfi_irq);
+
+	gmu_write(gmu, REG_A6XX_GMU_AO_HOST_INTERRUPT_MASK, ~0);
+	gmu_write(gmu, REG_A6XX_GMU_GMU2HOST_INTR_MASK, ~0);
+}
+
+int a6xx_gmu_reset(struct a6xx_gpu *a6xx_gpu)
+{
+	struct a6xx_gmu *gmu = &a6xx_gpu->gmu;
+	int ret;
+	u32 val;
+
+	/* Flush all the queues */
+	a6xx_hfi_stop(gmu);
+
+	/*
+	 * TEMPORARY image 160 -- PROMOTE IF RETRY RECOVERS. Re-zero HFI queue
+	 * memory so each retry attempt starts from identical clean state
+	 * (firmware may have scribbled partial responses). Queues are idle
+	 * here (just flushed); host-virt memset is safe.
+	 */
+	if (gmu->hfi && gmu->hfi->virt)
+		memset(gmu->hfi->virt, 0, gmu->hfi->size);
+	pr_info("RETRY160: HFI queues re-zeroed for fresh attempt\n");
+
+	/* Stop the interrupts */
+	a6xx_gmu_irq_disable(gmu);
+
+	/* Force off SPTP in case the GMU is managing it */
+	a6xx_sptprac_disable(gmu);
+
+	/* Make sure there are no outstanding RPMh votes */
+	gmu_poll_timeout(gmu, REG_A6XX_RSCC_TCS0_DRV0_STATUS, val,
+		(val & 1), 100, 10000);
+	gmu_poll_timeout(gmu, REG_A6XX_RSCC_TCS1_DRV0_STATUS, val,
+		(val & 1), 100, 10000);
+	gmu_poll_timeout(gmu, REG_A6XX_RSCC_TCS2_DRV0_STATUS, val,
+		(val & 1), 100, 10000);
+	gmu_poll_timeout(gmu, REG_A6XX_RSCC_TCS3_DRV0_STATUS, val,
+		(val & 1), 100, 1000);
+
+	/* Force off the GX GSDC */
+	/* TEMPORARY image 148 -- PROMOTE: never force-disable an un-enabled
+	 * regulator (unbalanced-disable BUG panics; our resume enables CX
+	 * only, never GX). Vendor enables both GDSCs; until then, guard. */
+	if (gmu->gx && !IS_ERR(gmu->gx) && gmu->gx_gdsc_enabled &&
+	    regulator_is_enabled(gmu->gx)) {
+		regulator_force_disable(gmu->gx);
+		gmu->gx_gdsc_enabled = false;
+	} else {
+		pr_info("GXGUARD148/226: gx not host-enabled here, skip force_disable\n");
+	}
+	gmu_clks_live = false;
+
+	/* Disable the resources */
+	gmu_clks_live = false;
+	clk_bulk_disable_unprepare(gmu->nr_clocks, gmu->clocks);
+	pm_runtime_put_sync(gmu->dev);
+
+	/* Re-enable the resources */
+	pm_runtime_get_sync(gmu->dev);
+
+	/* Use a known rate to bring up the GMU */
+	clk_set_rate(gmu->core_clk, 200000000);
+	ret = clk_bulk_prepare_enable(gmu->nr_clocks, gmu->clocks);
+	if (ret)
+		goto out;
+	gmu_clks_live = true;
+
+	a6xx_gmu_irq_enable(gmu);
+
+	/*
+	 * TEMPORARY image 202 -- re-assert CM3_SYSRESET before re-running
+	 * fw_start. Without this the retry cannot possibly work.
+	 *
+	 * The log proves it. On a good boot attempt 0 the PRE snapshot reads
+	 * SYSRESET=0x1 (the CM3 is still held in reset, then released). On every
+	 * retry the PRE snapshot reads SYSRESET=0x0 -- because
+	 * a6xx_gmu_fw_start() only ever DEASSERTS it. So a retry re-runs the
+	 * whole programming sequence and then writes 0 to a register that is
+	 * already 0: no reset edge, no CM3 restart, and INITRES can never
+	 * become 0xBABEFACE again. The "3 attempts" has always been one real
+	 * attempt per power cycle.
+	 *
+	 * Assert, let the CM3 quiesce, then let fw_start release it. The poll
+	 * for INITRES==0 confirms the CM3 is quiesced rather than racing us.
+	 */
+	gmu_write(gmu, REG_A6XX_GMU_CM3_SYSRESET, 1);
+	gmu_poll_timeout(gmu, REG_A6XX_GMU_CM3_FW_INIT_RESULT, val,
+			val != 0xbabeface, 100, 1000);
+	A6XX_TRACE("RETRY202: CM3 re-asserted SYSRESET, INITRES now 0x%x\n",
+			gmu_read(gmu, REG_A6XX_GMU_CM3_FW_INIT_RESULT));
+
+	ret = a6xx_gmu_fw_start(gmu, GMU_RESET);
+	if (!ret) {
+		a6xx_gmu_bootstrap_active = true;
+		ret = a6xx_hfi_start(gmu, GMU_COLD_BOOT);
+		a6xx_gmu_bootstrap_active = false;
+	}
+
+	/* Set the GPU back to the highest power frequency */
+	a6xx_gmu_set_freq(gmu, gmu->nr_gpu_freqs - 1);
+
+out:
+	if (ret)
+		a6xx_gmu_clear_oob(gmu, GMU_OOB_BOOT_SLUMBER);
+
+	return ret;
