+MODULE_PARM_DESC(skip_gpuset,
+	"1=skip GPU_SET OOB in hw_init (default off)");
+/*
+ * Image 182 -- default OFF (was on since 165). Post-success pm_suspend
+ * wedges the trigger thread inside printk (console_unlock, CPU3,
+ * images 179-181: SSH and OTG die while the phone looks alive), and
+ * even when it returns the VBIF poll never completes (79/79 archives:
+ * wait_for_idle done, never vbif halt done). Mesa needs a POWERED GPU
+ * anyway -- a slumbered GPU has no resume-on-submit yet, so slumbering
+ * before first render just guarantees userspace finds it asleep.
